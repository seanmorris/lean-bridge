{
  "name": "@lean-wasm/bridge-poc",
  "version": "0.0.0-poc",
  "private": true,
  "bin": {
    "lean-bridge": "scripts/lean-bridge.mjs"
  },
  "type": "module",
  "description": "Architecture-testing POC for a Vrzno-inspired Lean WebAssembly bridge",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap-toolchains.sh",
    "env:check": "bash scripts/inventory.sh",
    "build:lean-runtime": "bash scripts/build-lean-runtime.sh",
    "build:lean-runtime:threaded": "LEAN_WASM_RUNTIME_PROFILE=threaded bash scripts/build-lean-runtime.sh",
    "build:lean-runtime:native": "bash scripts/build-lean-native-runtime.sh",
    "build:lean-link-spike": "bash scripts/build-lean-link-spike.sh",
    "build:lean-link-spike:threaded": "LEAN_WASM_RUNTIME_PROFILE=threaded bash scripts/build-lean-link-spike.sh",
    "build:php-native-package": "node scripts/build-php-native-package.mjs --manifest poc/lean-link-spike/bindings/php-native.package.json --output build/php-native-package",
    "build:php-wasm-package": "node scripts/build-php-wasm-package.mjs --manifest poc/lean-link-spike/bindings/php-wasm.package.json --php-source build/php-wasm-sdk/php8.4-src --output build/php-wasm-package",
    "build:npm-package": "nix --extra-experimental-features 'nix-command flakes' build .#npm-package",
    "build:link-spike": "bash scripts/build-link-spike.sh",
    "build:nix": "nix --extra-experimental-features 'nix-command flakes' build .#wasm-poc",
    "build:builder-image": "node scripts/build-builder-image.mjs",
    "benchmark:poc": "node scripts/benchmark-native-api.mjs",
    "benchmark:php": "node scripts/benchmark-php-transports.mjs",
    "binding-ir": "node scripts/binding-ir.mjs",
    "cli": "node scripts/lean-bridge.mjs",
    "binding-packages": "node scripts/binding-package-gate.mjs check poc/lean-link-spike/bindings/alpha.binding-ir.json poc/lean-link-spike/bindings/generated-package-gate.json",
    "binding-parity": "node scripts/binding-semantic-parity.mjs poc/lean-link-spike/bindings/alpha.binding-ir.json",
    "release:rehearse": "node scripts/rehearse-release.mjs",
    "release:reproducibility": "node scripts/check-release-reproducibility.mjs",
    "verify:release-authorization": "node scripts/verify-release-authorization.mjs",
    "audit:php-wasm": "node scripts/audit-php-wasm-sources.mjs",
    "test:link-spike": "npm run build:link-spike && node --test tests/link-spike.test.mjs",
    "test:lean-link-spike": "npm run build:lean-link-spike && node --test tests/lean-link-spike.test.mjs",
    "test:cargo-package": "node --test tests/cargo-package.test.mjs",
    "test:c-family-package": "node --test tests/c-family-package.test.mjs",
    "test:nix": "nix --extra-experimental-features 'nix-command flakes' build .#wasm-poc --no-link",
    "test:php-native-package": "node --test tests/php-native-package.test.mjs",
    "test:php-wasm-adapter": "node --test tests/php-wasm-adapter.test.mjs",
    "test:php-wasm-package": "node --test tests/php-wasm-package.test.mjs",
    "test:php-wasm-package:host": "node scripts/test-php-wasm-package-host.mjs",
    "test:php-wasm-package:release": "node scripts/check-php-wasm-package-release.mjs",
    "test:php-wasm-composition": "node scripts/check-php-wasm-composition.mjs",
    "test:php-transport-parity": "node scripts/check-php-transport-parity.mjs",
    "test:npm-package": "node --test tests/npm-package.test.mjs",
    "test:pypi-package": "node --test tests/pypi-package.test.mjs",
    "test:release-rehearsal": "node --test tests/release-rehearsal.test.mjs",
    "test:release-install-gate": "node --test tests/release-install-gate.test.mjs",
    "test:analyze": "node --test tests/lean-project-analyzer.test.mjs tests/cli-contract.test.mjs",
    "test:canonical-build": "node --test tests/canonical-build.test.mjs tests/cli-contract.test.mjs",
    "test:php-release": "node scripts/check-php-release-gate.mjs",
    "test:reproducibility": "bash scripts/check-cross-root-reproducibility.sh",
    "test:release-authorization": "node --test tests/reproducibility-gate.test.mjs",
    "test": "npm run build:link-spike && npm run build:lean-link-spike && npm run build:lean-link-spike:threaded && node --test tests/**/*.test.mjs",
    "check": "npm run env:check && npm test"
  },
  "dependencies": {
    "weaker": "0.0.10"
  }
}
