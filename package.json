  "type": "module",
  "description": "Architecture-testing POC for a Vrzno-inspired Lean WebAssembly bridge",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap-toolchains.sh",
    "env:check": "bash scripts/inventory.sh",
    "env:check:core": "bash scripts/inventory.sh --profile core",
    "env:check:json": "bash scripts/inventory.sh --json",
    "build:lean-runtime": "bash scripts/build-lean-runtime.sh",
    "build:lean-runtime:threaded": "LEAN_WASM_RUNTIME_PROFILE=threaded bash scripts/build-lean-runtime.sh",
    "build:lean-runtime:native": "bash scripts/build-lean-native-runtime.sh",
    "build:native-ffi": "node scripts/build-native-ffi-artifacts.mjs --output build/native-ffi-artifacts",
    "build:managed-bindings": "node scripts/build-managed-binding-artifacts.mjs --output build/managed-binding-artifacts",
    "build:nuget-package": "nix --extra-experimental-features 'nix-command flakes' build .#nuget-package",
    "build:maven-package": "nix --extra-experimental-features 'nix-command flakes' build .#maven-package",
    "build:rubygems-package": "nix --extra-experimental-features 'nix-command flakes' build .#rubygems-package",
    "build:wasi-package": "nix --extra-experimental-features 'nix-command flakes' build .#wasi-package",
    "build:lean-link-spike": "bash scripts/build-lean-link-spike.sh",
    "build:lean-link-spike:threaded": "LEAN_WASM_RUNTIME_PROFILE=threaded bash scripts/build-lean-link-spike.sh",
    "build:performance-wasm": "bash scripts/build-performance-wasm.sh",
    "build:performance-scaling": "bash scripts/build-performance-scaling.sh",
    "build:demos": "bash demos/lean-dijkstra/build.sh && bash demos/lean-flood-fill/build.sh && bash demos/lean-union-find/build.sh && bash demos/lean-topological-sort/build.sh && bash demos/lean-aho-corasick/build.sh && bash demos/lean-lru-cache/build.sh && bash demos/lean-a-star/build.sh && bash demos/lean-tarjan/build.sh && bash demos/lean-token-bucket/build.sh && bash demos/lean-dinic/build.sh && bash demos/lean-myers/build.sh && bash demos/lean-sweep-and-prune/build.sh && bash demos/lean-tutte/build.sh",
    "demos:site": "node scripts/build-demos-site.mjs",
    "demos:archive": "node scripts/package-pages-artifact.mjs",
    "site:dev": "node scripts/site-preflight.mjs && node scripts/generate-site-content.mjs && cd site && react-router dev --host 0.0.0.0",
    "site:build": "node scripts/site-preflight.mjs && node scripts/generate-site-content.mjs && node scripts/build-react-site.mjs",
    "site:typecheck": "node scripts/site-preflight.mjs && node scripts/generate-site-content.mjs && cd site && react-router typegen && tsc --noEmit",
    "site:test": "node scripts/generate-site-content.mjs && node --test site/*.test.mjs demos/shared/*.test.mjs demos/lean-myers/*.test.mjs demos/lean-sweep-and-prune/*.test.mjs demos/lean-dinic/*.test.mjs demos/lean-tutte/test.mjs",
    "site:browser": "node site/browser-check.mjs && node site/tutte-browser-check.mjs",
    "demos:browser": "node demos/browser-check.mjs",
    "demos:verify": "npm run build:demos && npm run demos:site && node --test demos/site.test.mjs demos/lean-tutte/test.mjs demos/lean-dijkstra/test.mjs demos/lean-flood-fill/test.mjs demos/lean-union-find/test.mjs demos/lean-topological-sort/test.mjs demos/lean-aho-corasick/test.mjs demos/lean-lru-cache/test.mjs demos/lean-a-star/test.mjs demos/lean-tarjan/test.mjs demos/lean-token-bucket/test.mjs demos/lean-dinic/test.mjs demos/lean-myers/test.mjs demos/lean-sweep-and-prune/test.mjs && node demos/lean-dijkstra/benchmark.mjs --assert && node demos/lean-flood-fill/benchmark.mjs --assert && node demos/lean-union-find/benchmark.mjs --assert && node demos/lean-topological-sort/benchmark.mjs --assert && node demos/lean-aho-corasick/benchmark.mjs --assert && node demos/lean-lru-cache/benchmark.mjs --assert && node demos/lean-a-star/benchmark.mjs --assert && node demos/lean-tarjan/benchmark.mjs --assert && node demos/lean-token-bucket/benchmark.mjs --assert && node demos/lean-dinic/benchmark.mjs --assert && node demos/lean-myers/benchmark.mjs --assert && node demos/lean-sweep-and-prune/benchmark.mjs --assert && node demos/lean-tutte/benchmark.mjs --assert",
    "build:php-native-package": "node scripts/build-php-native-package.mjs --manifest poc/lean-link-spike/bindings/php-native.package.json --output build/php-native-package",
    "build:php-wasm-package": "node scripts/build-php-wasm-package.mjs --manifest poc/lean-link-spike/bindings/php-wasm.package.json --php-source build/php-wasm-sdk/php8.4-src --output build/php-wasm-package",
    "build:npm-package": "nix --extra-experimental-features 'nix-command flakes' build .#npm-package",
    "build:cli-package": "node scripts/build-cli-npm-package.mjs",
    "build:php-wasm-inputs": "node scripts/build-php-wasm-compiler-inputs.mjs",
    "test:cli-package": "node --test tests/cli-npm-package.test.mjs",
    "test:builder-ownership": "node scripts/check-builder-ownership.mjs",
    "acceptance:cli-package": "node scripts/check-cli-package.mjs",
    "build:link-spike": "bash scripts/build-link-spike.sh",
    "build:nix": "nix --extra-experimental-features 'nix-command flakes' build .#wasm-poc",
    "build:builder-image": "node scripts/build-builder-image.mjs",
    "benchmark:poc": "node scripts/benchmark-native-api.mjs",
    "benchmark:php": "node scripts/benchmark-php-transports.mjs",
    "benchmark:spatial": "npm run build:performance-wasm && node scripts/benchmark-spatial-runtime.mjs",
    "benchmark:scaling": "npm run build:performance-scaling && node scripts/benchmark-library-scaling.mjs",
    "benchmark:overhead": "npm run build:lean-link-spike && node scripts/benchmark-native-overhead.mjs",
    "benchmark:lifecycle": "npm run build:lean-link-spike && node --expose-gc scripts/benchmark-lifecycle-stability.mjs",
    "benchmark:self-consistency": "npm run build:performance-wasm && node scripts/benchmark-self-consistency.mjs",
    "benchmark:baseline": "node scripts/collect-performance-baseline.mjs",
    "performance:ci": "node scripts/performance-ci.mjs",
    "performance:evidence-bundle": "node scripts/build-performance-evidence-bundle.mjs",
    "performance:derive-budget": "node scripts/derive-performance-budget.mjs",
    "performance:check-regression": "node scripts/check-performance-regression.mjs",
    "verify:performance-builds": "node scripts/compare-performance-builds.mjs",
    "verify:performance-reproducibility": "bash scripts/check-performance-build-reproducibility.sh",
    "verify:performance-methodology": "node scripts/check-performance-methodology.mjs",
    "inspect:performance-workloads": "node scripts/inspect-performance-workloads.mjs",
    "generate:lean-link-projection": "node scripts/generate-lean-link-projection.mjs",
