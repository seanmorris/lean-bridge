{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.invalid/schema/elaborated-export-metadata.schema.json",
  "title": "Lean Bridge elaborated export metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "profile", "producer", "modules", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "lean-bridge-elaborated-exports" },
    "profile": { "enum": ["component-scalars-v1", "native-library-v1"] },
    "producer": { "$ref": "#/$defs/producer" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "adapterVersion",
        "tool",
        "toolVersion",
        "toolchain",
        "invocationIdentitySha256"
      ],
      "properties": {
        "adapter": { "const": "lean-bridge-elaborator" },
        "adapterVersion": { "const": 2 },
        "tool": { "const": "Lean" },
        "toolVersion": { "type": "string", "minLength": 1 },
        "toolchain": { "type": "string", "minLength": 1 },
        "invocationIdentitySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourcePath",
        "sourceSha256",
        "interfaceSha256",
        "directImports",
        "declarations"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "interfaceSha256": { "$ref": "#/$defs/sha256" },
        "directImports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "declarations": {
          "type": "array",
          "items": { "$ref": "#/$defs/declaration" }
        }
      }
    },
    "sourcePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 0 }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "binderInfo", "typeExpression"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "binderInfo": {
          "enum": ["explicit", "implicit", "strict-implicit", "instance-implicit"]
        },
        "typeExpression": { "type": "string", "minLength": 1 }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind",
        "visibility",
        "selected",
        "source",
        "documentation",
        "typeExpression",
        "parameters",
        "resultExpression",
        "effects",
        "theoremReferences",
        "projection"
      ],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["definition", "opaque", "abbreviation", "theorem"]
        },
        "visibility": { "enum": ["public", "protected", "private"] },
        "selected": { "type": "boolean" },
        "source": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sourcePosition" }] },
        "documentation": { "type": ["string", "null"] },
        "typeExpression": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "resultExpression": { "type": "string", "minLength": 1 },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "theoremReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "projection": { "$ref": "#/$defs/projection" },
        "specialization": {
          "type": "object", "additionalProperties": false,
          "required": ["declaration", "types", "application"],
          "properties": {
            "declaration": { "$ref": "lean-export-configuration.schema.json#/$defs/specializationName" },
            "types": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "lean-export-configuration.schema.json#/$defs/specializationName" } },
            "application": { "type": ["string", "null"], "minLength": 1 }
          }
        }
      }
    },
    "projection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "bindingShape",
            "parameters",
            "result"
          ],
          "properties": {
            "status": {
              "const": "supported"
            },
            "bindingShape": {
              "const": "pure-function"
            },
            "parameters": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "$ref": "#/$defs/runtimeType"
                  }
                }
              }
            },
            "result": {
              "$ref": "#/$defs/runtimeType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "bindingShape",
            "parameters",
            "result"
          ],
          "properties": {
            "status": {
              "const": "supported"
            },
            "bindingShape": {
              "const": "native-function"
            },
            "parameters": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "$ref": "native-metadata-type.schema.json"
                  }
                }
              }
            },
            "result": {
              "$ref": "native-metadata-type.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "expression"
          ],
          "properties": {
            "status": {
              "const": "unsupported"
            },
            "reason": {
              "enum": [
                "implicit-parameter",
                "instance-parameter",
                "dependent-type",
                "unsupported-effect",
                "unsupported-parameter-type",
                "unsupported-result-type",
                "visibility",
                "specialization-required",
                "invalid-specialization",
                "type-declaration",
                "proof-only",
                "admitted-implementation",
                "unreviewed-implementation",
                "arity-limit",
                "export-contract-mismatch",
                "unsupported-native-type"
              ]
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "runtimeType": {
      "oneOf": [
        { "$ref": "#/$defs/copiedType" },
        { "type": "object", "additionalProperties": false, "required": ["kind", "parameters", "result"],
          "properties": {
            "kind": { "const": "callback" },
            "parameters": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/scalarType" } },
            "result": { "$ref": "#/$defs/scalarType" }
          }
        }
      ]
    },
    "copiedType": {
      "oneOf": [
        { "$ref": "#/$defs/scalarType" },
        { "type": "object", "additionalProperties": false, "required": ["kind", "element"],
          "properties": { "kind": { "const": "array" }, "element": { "$ref": "#/$defs/copiedType" } }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind", "name", "fields"],
          "properties": {
            "kind": { "const": "record" }, "name": { "type": "string", "minLength": 1 },
            "fields": { "type": "array", "maxItems": 1024, "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "type"],
              "properties": { "name": { "type": "string", "minLength": 1 }, "type": { "$ref": "#/$defs/copiedType" } }
            } }
          }
        }
      ]
    },
    "scalarType": {
      "type": "object", "additionalProperties": false, "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "primitive" },
        "name": { "enum": ["unit", "bool", "uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "int64", "nat", "int", "float32", "float64", "string", "bytes", "char", "usize", "isize"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "severity", "message", "module", "declaration"],
      "properties": {
        "category": {
          "enum": ["unsupported-meaning", "extractor-failure", "stale-metadata"]
        },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "severity": { "enum": ["warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "module": { "type": ["string", "null"] },
        "declaration": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "native-library-v1"
          }
        }
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "properties": {
                "declarations": {
                  "items": {
                    "properties": {
                      "projection": {
                        "properties": {
                          "bindingShape": {
                            "const": "native-function"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "modules": {
            "items": {
              "properties": {
                "declarations": {
                  "items": {
                    "properties": {
                      "projection": {
                        "properties": {
                          "bindingShape": {
                            "const": "pure-function"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
