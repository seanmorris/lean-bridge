{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Lean export configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "modules": {"$ref": "#/$defs/selection"},
    "exports": {"$ref": "#/$defs/selection"},
    "resources": {"$ref": "#/$defs/names"},
    "arities": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 32}},
    "specializations": {"$ref": "#/$defs/specializations"},
    "contracts": {"$ref": "#/$defs/contracts"},
    "generators": {"$ref": "lake-generator-configuration.schema.json"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string", "maxLength": 214,
              "pattern": "^(?:[a-z0-9][a-z0-9._-]*|@[a-z0-9._-]+/[a-z0-9._-]+)$(?![\\s\\S])",
              "not": {"anyOf": [
                {"enum": ["node_modules", "favicon.ico", "@lean-bridge/runtime"]},
                {"pattern": "^@\\.{1,2}/|/\\.{1,2}$"}
              ]}
            },
            "version": {
              "type": "string", "maxLength": 256,
              "description": "Exact npm version. Build metadata is rejected because npm strips it when publishing.",
              "not": {"pattern": "\\+"},
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])"
            }
          }
        },
        "pypi": {"$ref": "#/$defs/package"},
        "cargo": {"$ref": "#/$defs/package"},
        "c": {"$ref": "#/$defs/package"},
        "cpp": {"$ref": "#/$defs/package"},
        "nuget": {"$ref": "#/$defs/package"},
        "maven": {"$ref": "#/$defs/package"},
        "rubygems": {"$ref": "#/$defs/package"},
        "cpan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module": {"type": "string", "pattern": "^LeanBridge::[A-Za-z][A-Za-z0-9_]*(::[A-Za-z][A-Za-z0-9_]*)*$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}(_[0-9]{2})?$"}
          }
        },
        "php-native": {"$ref": "#/$defs/package"},
        "php-wasm": {"$ref": "#/$defs/package"},
        "wit-wasi": {"$ref": "#/$defs/package"}
      }
    }
  },
  "$defs": {
    "contracts": {
      "type": "object", "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/specializationName"},
      "additionalProperties": {
        "type": "object", "minProperties": 1, "additionalProperties": false,
        "properties": {
          "parameters": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/contractSite"}},
          "result": {"$ref": "#/$defs/contractSite"},
          "effects": {"type": "array", "uniqueItems": true, "items": {"enum": ["allocates", "reads-resource", "writes-resource", "fails", "host-call", "async", "nondeterministic"]}}
        }
      }
    },
    "contractSite": {
      "type": "object", "additionalProperties": false, "required": ["ownership", "lifetime"],
      "properties": {
        "ownership": {"enum": ["copy", "borrow", "lease", "transfer"]},
        "lifetime": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/contractLifetime"}]},
        "refinement": {"oneOf": [
          {"const": "reject"},
          {"type": "object", "additionalProperties": false, "required": ["constructor"], "properties": {"constructor": {"$ref": "#/$defs/specializationName"}}}
        ]}
      },
      "if": {"properties": {"ownership": {"const": "copy"}}},
      "then": {"properties": {"lifetime": {"type": "null"}}},
      "else": {"properties": {"lifetime": {"$ref": "#/$defs/contractLifetime"}}}
    },
    "contractLifetime": {
      "type": "object", "additionalProperties": false, "required": ["scope", "anchor"],
      "properties": {
        "scope": {"enum": ["call", "receiver", "parameter", "explicit", "runtime"]},
        "anchor": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^arg(0|[1-9][0-9]*)$(?![\\s\\S])"}]}
      },
      "if": {"properties": {"scope": {"const": "parameter"}}},
      "then": {"properties": {"anchor": {"type": "string"}}},
      "else": {"properties": {"anchor": {"type": "null"}}}
    },
    "specializations": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "declaration", "types"],
        "properties": {
          "name": {"$ref": "#/$defs/specializationName"},
          "declaration": {"$ref": "#/$defs/specializationName"},
          "types": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/specializationName"}}
        }
      }
    },
    "specializationName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$(?![\\s\\S])"},
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "selection": {"allOf": [{"$ref": "#/$defs/names"}], "minItems": 1},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9_@./:+-]*$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
