{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Lean export configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "modules": {"$ref": "#/$defs/selection"},
    "exports": {"$ref": "#/$defs/selection"},
    "resources": {"$ref": "#/$defs/names"},
    "arities": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 32}},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {"$ref": "#/$defs/package"},
        "pypi": {"$ref": "#/$defs/package"},
        "cargo": {"$ref": "#/$defs/package"},
        "c": {"$ref": "#/$defs/package"},
        "cpp": {"$ref": "#/$defs/package"},
        "nuget": {"$ref": "#/$defs/package"},
        "maven": {"$ref": "#/$defs/package"},
        "rubygems": {"$ref": "#/$defs/package"},
        "cpan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module": {"type": "string", "pattern": "^LeanBridge::[A-Za-z][A-Za-z0-9_]*(::[A-Za-z][A-Za-z0-9_]*)*$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}(_[0-9]{2})?$"}
          }
        },
        "php-native": {"$ref": "#/$defs/package"},
        "php-wasm": {"$ref": "#/$defs/package"},
        "wit-wasi": {"$ref": "#/$defs/package"}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "selection": {"allOf": [{"$ref": "#/$defs/names"}], "minItems": 1},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9_@./:+-]*$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
