{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.dev/schema/publication-attestation.schema.json",
  "title": "Lean Bridge signed publication authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "policySha256",
    "statement",
    "statementSha256",
    "envelope",
    "envelopeSha256",
    "audit"
  ],
  "properties": {
    "policy": { "$ref": "publication-signer-policy.schema.json" },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "statement": { "$ref": "#/$defs/statement" },
    "statementSha256": { "$ref": "#/$defs/sha256" },
    "envelope": { "$ref": "#/$defs/envelope" },
    "envelopeSha256": { "$ref": "#/$defs/sha256" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "bytes", "sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "backendPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "ecosystem", "coordinate", "operation", "destination", "idempotencyKey", "backendPlan", "archives"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "coordinate": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["publish", "retain"] },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "endpoint"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "endpoint": { "type": ["string", "null"] }
          }
        },
        "idempotencyKey": { "$ref": "#/$defs/sha256" },
        "backendPlan": { "$ref": "#/$defs/backendPlan" },
        "archives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "acceptedSigner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "keyId", "algorithm"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "keyId": { "$ref": "#/$defs/sha256" },
        "algorithm": { "const": "ed25519" }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_type", "subject", "predicateType", "predicate"],
      "properties": {
        "_type": { "const": "https://in-toto.io/Statement/v1" },
        "subject": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/subject" } },
        "predicateType": { "const": "https://lean-bridge.dev/attestations/publication-authorization/v1" },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "authorization", "assuranceArtifacts", "publication", "signerPolicy"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "authorization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256", "candidate", "reproducibilityReport", "reproducibilityAttestation"],
              "properties": {
                "sha256": { "$ref": "#/$defs/sha256" },
                "candidate": { "$ref": "reproducibility-report.schema.json#/$defs/candidate" },
                "reproducibilityReport": { "$ref": "#/$defs/artifact" },
                "reproducibilityAttestation": { "$ref": "#/$defs/artifact" }
              }
            },
            "assuranceArtifacts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifests", "locks", "assurance", "sbom", "provenance"],
              "properties": {
                "manifests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
                "locks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
                "assurance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
                "sbom": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
                "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
              }
            },
            "publication": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifestSha256", "plannedEcosystems", "targets"],
              "properties": {
                "manifestSha256": { "$ref": "#/$defs/sha256" },
                "plannedEcosystems": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } }
              }
            },
            "signerPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256", "threshold", "acceptedSigners"],
              "properties": {
                "sha256": { "$ref": "#/$defs/sha256" },
                "threshold": { "const": 1 },
                "acceptedSigners": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptedSigner" } }
              }
            }
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadType", "payload", "signatures"],
      "properties": {
        "payloadType": { "const": "application/vnd.in-toto+json" },
        "payload": { "type": "string", "minLength": 1 },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyid", "sig"],
            "properties": {
              "keyid": { "$ref": "#/$defs/sha256" },
              "sig": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "providerKind", "signer", "policySha256", "statementSha256", "envelopeSha256", "privateMaterialReceived"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "status": { "const": "verified" },
        "providerKind": { "type": "string", "minLength": 1 },
        "signer": { "$ref": "#/$defs/acceptedSigner" },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "statementSha256": { "$ref": "#/$defs/sha256" },
        "envelopeSha256": { "$ref": "#/$defs/sha256" },
        "privateMaterialReceived": { "const": false }
      }
    }
  }
}
