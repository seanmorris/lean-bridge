{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:registry-transaction:v1",
  "title": "Lean Bridge durable multi-registry transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "predicateType",
    "transactionId",
    "candidateId",
    "manifest",
    "attestation",
    "status",
    "atomicity",
    "attemptCount",
    "createdAt",
    "updatedAt",
    "externalRegistryWrites",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "predicateType": { "const": "urn:lean-bridge:registry-transaction:v1" },
    "transactionId": { "$ref": "#/$defs/sha256" },
    "candidateId": { "$ref": "#/$defs/sha256" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statementSha256", "envelopeSha256"],
      "properties": {
        "statementSha256": { "$ref": "#/$defs/sha256" },
        "envelopeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "status": {
      "enum": ["preflighting", "ready", "publishing", "partial", "blocked", "complete"]
    },
    "atomicity": { "const": "independent-registry-commits" },
    "attemptCount": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "externalRegistryWrites": {
      "oneOf": [
        { "type": "boolean" },
        { "const": "unknown" }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "status"],
      "properties": {
        "coordinate": { "type": "string", "minLength": 1 },
        "status": { "enum": ["available", "planned-earlier", "unavailable"] }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission",
        "coordinateState",
        "immutable",
        "registryReference",
        "artifacts",
        "dependencies"
      ],
      "properties": {
        "permission": { "enum": ["granted", "denied", "not-required"] },
        "coordinateState": { "enum": ["available", "matching", "collision", "local"] },
        "immutable": { "type": "boolean" },
        "registryReference": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependency" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "registryReference", "artifacts", "externalWrite"],
      "properties": {
        "status": { "enum": ["published", "already-published", "retained"] },
        "registryReference": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "externalWrite": { "type": "boolean" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "retryable": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "command", "effect", "source"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "command": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "effect": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "ecosystem",
        "coordinate",
        "operation",
        "idempotencyKey",
        "status",
        "attempts",
        "preflight",
        "result",
        "failure",
        "recovery"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "coordinate": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["publish", "retain"] },
        "idempotencyKey": { "$ref": "#/$defs/sha256" },
        "status": {
          "enum": [
            "pending",
            "ready",
            "publishing",
            "published",
            "already-published",
            "retained",
            "failed",
            "blocked"
          ]
        },
        "attempts": { "type": "integer", "minimum": 0 },
        "preflight": {
          "oneOf": [
            { "$ref": "#/$defs/preflight" },
            { "type": "null" }
          ]
        },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/result" },
            { "type": "null" }
          ]
        },
        "failure": {
          "oneOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "null" }
          ]
        },
        "recovery": { "$ref": "#/$defs/recovery" }
      }
    }
  }
}
