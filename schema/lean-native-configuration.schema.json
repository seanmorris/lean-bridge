{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Perl source configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "module": {"type": "string", "pattern": "^LeanBridge::[A-Za-z][A-Za-z0-9_]*(::[A-Za-z][A-Za-z0-9_]*)*$"},
    "modules": {"$ref": "#/$defs/names"},
    "exports": {"$ref": "#/$defs/names"},
    "resources": {"$ref": "#/$defs/names"},
    "arities": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 32}},
    "cpanVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}(_[0-9]{2})?$"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
  }
}
