{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.dev/schema/lake-generator-definition.schema.json",
  "title": "Internal captured Lean text generator definition",
  "description": "An internal runner contract. Normal CLI builds do not yet select or execute these generators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "name",
    "declaration",
    "modules",
    "inputs",
    "arguments",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "const": "lean-text-v1"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "declaration": {
      "$ref": "#/$defs/module"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "path"
        ],
        "properties": {
          "module": {
            "$ref": "#/$defs/module"
          },
          "path": {
            "allOf": [
              {
                "$ref": "#/$defs/path"
              },
              {
                "pattern": "\\.lean$(?![\\s\\S])"
              }
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/namedPath"
      }
    },
    "arguments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 16384,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "path": {
            "allOf": [
              {
                "$ref": "#/$defs/path"
              },
              {
                "pattern": "\\.(lean|c|h)$(?![\\s\\S])"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"
    },
    "module": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!.*[\\\\:*?\\x00-\\x1f\\x7f])(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git|\\.lake|\\.env|\\.npmrc|\\.lean-bridge-[^/]*)(?:/|$))(?:root|packages/[^/]+)/[^/]+(?:/[^/]+)*$(?![\\s\\S])"
    },
    "namedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
