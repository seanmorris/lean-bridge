{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.dev/schema/analysis-policy-report.schema.json",
  "title": "Lean Bridge analysis policy report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisSha256", "policy", "passed", "metrics", "violations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisSha256": { "$ref": "#/$defs/sha256" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "sha256", "document"],
      "properties": {
        "source": { "enum": ["builtin", "file"] },
        "path": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "document": { "$ref": "analysis-policy.schema.json" }
      }
    },
    "passed": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "requiredHints",
        "proposedExports",
        "undocumentedExports",
        "compiledExports",
        "semanticVersionPresent",
        "bindingIrOrigin"
      ],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "requiredHints": { "type": "integer", "minimum": 0 },
        "proposedExports": { "type": "integer", "minimum": 0 },
        "undocumentedExports": { "type": "integer", "minimum": 0 },
        "compiledExports": { "type": "integer", "minimum": 0 },
        "semanticVersionPresent": { "type": "boolean" },
        "bindingIrOrigin": {
          "oneOf": [
            { "enum": ["existing-validated", "statically-inferred"] },
            { "type": "null" }
          ]
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "expected", "actual"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "expected": { "type": "string" },
          "actual": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
