{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-wasm.invalid/schema/project-analysis-v2.schema.json",
  "title": "Lean Bridge project analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sourceTreeSha256",
    "inputs",
    "buildGraph",
    "compiledEnvironment",
    "declarations",
    "exportCandidates",
    "proposedExports",
    "bindingIr",
    "adapterHints",
    "diagnostics",
    "readOnly",
    "elaboration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "name",
        "version",
        "toolchain",
        "lakefile"
      ],
      "properties": {
        "root": {
          "const": "."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "lakefile": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sourceTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "buildGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imports",
        "flake",
        "lockfiles"
      ],
      "properties": {
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "source"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "flake": {
          "type": "boolean"
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "compiledEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "format",
        "modules",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "absent",
            "available"
          ]
        },
        "format": {
          "const": "Lean elaborated metadata"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "declarations",
              "directImports",
              "sha256"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "declarations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "directImports": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "path",
          "line",
          "signature",
          "documented",
          "compiled"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "definition",
              "opaque",
              "abbreviation",
              "theorem"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "documented": {
            "type": "boolean"
          },
          "compiled": {
            "type": "boolean"
          }
        }
      }
    },
    "exportCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "proposedExports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bindingIr": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "path",
            "semanticSha256",
            "document"
          ],
          "properties": {
            "origin": {
              "enum": [
                "existing-validated",
                "lean-elaborated"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "semanticSha256": {
              "$ref": "#/$defs/sha256"
            },
            "document": {
              "$ref": "binding-ir.schema.json"
            }
          }
        }
      ]
    },
    "adapterHints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hint"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "readOnly": {
      "const": true
    },
    "elaboration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "lake-entry-elaboration.schema.json"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration",
        "kind",
        "path",
        "line",
        "documentation",
        "confidence",
        "status",
        "reasons",
        "shape",
        "theoremCandidates",
        "evidence"
      ],
      "properties": {
        "declaration": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "definition",
            "opaque",
            "abbreviation",
            "theorem",
            "reviewed-ir"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceModule": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "documentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "lean-elaborated",
            "reviewed-ir",
            "blocked"
          ]
        },
        "status": {
          "enum": [
            "exportable",
            "blocked"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shape": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "elaborated-export-metadata.schema.json#/$defs/projection"
            }
          ]
        },
        "theoremCandidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "declaration",
        "reason",
        "question",
        "choices",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "declaration": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "path",
        "hint",
        "category",
        "module",
        "declaration"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "enum": [
            null,
            "unsupported-meaning",
            "extractor-failure",
            "stale-metadata"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "declaration": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
