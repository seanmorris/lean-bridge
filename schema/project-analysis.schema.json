{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-wasm.invalid/schema/project-analysis-v1.schema.json",
  "title": "Lean Bridge project analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sourceTreeSha256",
    "inputs",
    "buildGraph",
    "compiledEnvironment",
    "declarations",
    "exportCandidates",
    "proposedExports",
    "bindingIr",
    "adapterHints",
    "diagnostics",
    "readOnly"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "name", "version", "toolchain", "lakefile"],
      "properties": {
        "root": { "const": "." },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "toolchain": { "type": "string", "minLength": 1 },
        "lakefile": { "type": ["string", "null"] }
      }
    },
    "sourceTreeSha256": { "$ref": "#/$defs/sha256" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "buildGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imports", "flake", "lockfiles"],
      "properties": {
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "source"],
            "properties": {
              "module": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "flake": { "type": "boolean" },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "compiledEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "format", "modules", "note"],
      "properties": {
        "status": { "enum": ["absent", "available"] },
        "format": { "const": "Lean ilean" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "declarations", "directImports", "sha256"],
            "properties": {
              "module": { "type": "string", "minLength": 1 },
              "declarations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "directImports": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "path", "line", "signature", "documented", "foreign", "compiled"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["def", "opaque", "abbrev", "theorem", "structure", "inductive", "class"] },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "signature": { "type": "string", "minLength": 1 },
          "documented": { "type": "boolean" },
          "foreign": { "type": "boolean" },
          "compiled": { "type": "boolean" }
        }
      }
    },
    "exportCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "proposedExports": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "bindingIr": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "path", "semanticSha256", "document"],
          "properties": {
            "origin": { "enum": ["existing-validated", "statically-inferred"] },
            "path": { "type": ["string", "null"] },
            "semanticSha256": { "$ref": "#/$defs/sha256" },
            "document": { "$ref": "binding-ir.schema.json" }
          }
        }
      ]
    },
    "adapterHints": {
      "type": "array",
      "items": { "$ref": "#/$defs/hint" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "readOnly": { "const": true }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "typeRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "primitive" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "constructor", "arguments"],
          "properties": {
            "kind": { "const": "apply" },
            "constructor": { "enum": ["array", "option", "result"] },
            "arguments": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/typeRef" }
            }
          }
        }
      ]
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocker"],
          "properties": {
            "blocker": { "type": "string", "minLength": 1 },
            "leanType": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameters", "resultType", "result"],
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "leanType", "type"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "leanType": { "type": "string", "minLength": 1 },
                  "type": { "$ref": "#/$defs/typeRef" }
                }
              }
            },
            "resultType": { "type": "string", "minLength": 1 },
            "result": { "$ref": "#/$defs/typeRef" }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration", "kind", "path", "line", "documentation", "externSymbol",
        "confidence", "status", "reasons", "shape", "theoremCandidates", "evidence"
      ],
      "properties": {
        "declaration": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["def", "opaque", "abbrev"] },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "documentation": { "type": ["string", "null"] },
        "externSymbol": { "type": ["string", "null"] },
        "confidence": { "enum": ["safe-static", "blocked"] },
        "status": { "enum": ["exportable", "blocked"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "shape": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shape" }] },
        "theoremCandidates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "declaration", "reason", "question", "choices", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "declaration": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "choices": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "path", "hint"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "hint": { "type": ["string", "null"] }
      }
    }
  }
}
