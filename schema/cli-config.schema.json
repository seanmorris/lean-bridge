{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.dev/schema/cli-config.schema.json",
  "title": "Lean Bridge CLI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "directory"],
      "properties": {
        "policy": { "enum": ["use", "refresh", "off"] },
        "directory": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "format": { "enum": ["human", "json"] },
    "progress": { "enum": ["auto", "none", "plain", "json"] }
  }
}
