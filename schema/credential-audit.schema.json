{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.dev/schema/credential-audit.schema.json",
  "title": "Lean Bridge credential boundary audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "providerKind",
    "valuesRead",
    "valuesRetained",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["ready", "complete", "blocked", "failed"] },
    "providerKind": { "type": "string", "minLength": 1 },
    "valuesRead": { "type": "boolean" },
    "valuesRetained": { "const": false },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "ecosystem",
          "coordinate",
          "requiredNames",
          "available",
          "accessCount"
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "ecosystem": { "type": "string", "minLength": 1 },
          "coordinate": { "type": "string", "minLength": 1 },
          "requiredNames": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "available": { "type": "boolean" },
          "accessCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
