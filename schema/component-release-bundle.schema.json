{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:component-release-bundle:v1",
  "title": "Lean Bridge component release bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "component", "identitySha256", "componentArtifactManifestSha256", "bindingIrSemanticSha256", "runtime", "files", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lean-bridge-component-release-bundle" },
    "component": { "$ref": "#/$defs/component" },
    "identitySha256": { "$ref": "#/$defs/sha256" },
    "componentArtifactManifestSha256": { "$ref": "#/$defs/sha256" },
    "bindingIrSemanticSha256": { "$ref": "#/$defs/sha256" },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifactIncluded", "abiVersion", "leanCommit", "patchSetSha256", "profile", "shared", "requiredImports"],
      "properties": { "kind": { "const": "content-addressed-peer" }, "artifactIncluded": { "const": false }, "abiVersion": { "type": "integer", "minimum": 1 }, "leanCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "patchSetSha256": { "$ref": "#/$defs/sha256" }, "profile": { "const": "side-lazy" }, "shared": { "const": true }, "requiredImports": { "const": ["memory", "__indirect_function_table"] } }
    },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["backendNeutral", "compileOnce", "sourceReadOnly", "runtimeBinaryIncluded", "targetPackagesIncluded"],
      "properties": { "backendNeutral": { "const": true }, "compileOnce": { "const": true }, "sourceReadOnly": { "const": true }, "runtimeBinaryIncluded": { "const": false }, "targetPackagesIncluded": { "const": false } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "mediaType", "bytes", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "role": { "enum": ["component", "binding-ir", "private-abi", "assurance", "runtime-requirement", "source", "generated-source", "plan", "build-evidence", "provenance", "documentation"] }, "mediaType": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
