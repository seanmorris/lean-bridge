{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanbridge.dev/schema/zero-config-audit.schema.json",
  "title": "Lean Bridge zero-configuration exception audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "exceptions", "defaults"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "defaults": {
      "type": "array",
      "items": { "$ref": "#/$defs/default" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "stage", "fixture", "kind", "classification", "mandatory", "blocking",
        "targetSpecificRebuild", "description", "evidence", "remediation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["analyze", "generate", "build", "rebuild", "compare", "publish", "consume"] },
        "fixture": { "type": ["string", "null"], "minLength": 1 },
        "kind": {
          "enum": ["annotation", "hint", "manual-edit", "host-dependency", "registry-step", "target-special-case"]
        },
        "classification": { "enum": ["safely-inferable", "unavoidable-ambiguity", "policy-choice", "defect"] },
        "mandatory": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "targetSpecificRebuild": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "behavior", "visible", "reversible", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["analyze", "generate", "build", "rebuild", "compare", "publish", "consume"] },
        "behavior": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
