{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.dev/schema/publication-signer-policy.schema.json",
  "title": "Lean Bridge publication signer policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "predicateType",
    "threshold",
    "envelope",
    "payloadType",
    "statementType",
    "publicationPredicateType",
    "signers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "predicateType": { "const": "https://lean-bridge.dev/policies/publication-signer/v1" },
    "threshold": { "const": 1 },
    "envelope": { "const": "dsse-v1" },
    "payloadType": { "const": "application/vnd.in-toto+json" },
    "statementType": { "const": "https://in-toto.io/Statement/v1" },
    "publicationPredicateType": { "const": "https://lean-bridge.dev/attestations/publication-authorization/v1" },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "keyId", "algorithm", "publicKey"],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "keyId": { "$ref": "#/$defs/sha256" },
          "algorithm": { "const": "ed25519" },
          "publicKey": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "sha256", "value"],
            "properties": {
              "format": { "const": "spki-pem" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
