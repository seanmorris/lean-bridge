{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:compiler-adapter-plan:v1",
  "title": "Lean Bridge generated compiler adapter plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "component", "componentPlanSha256", "module", "imports", "exports", "privateAbi", "leanSourceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "component": { "type": "string", "minLength": 1 },
    "componentPlanSha256": { "$ref": "#/$defs/sha256" },
    "module": { "type": "string", "pattern": "^LeanBridgeGenerated[0-9a-f]{16}$" },
    "imports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "exports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/export" } },
    "privateAbi": { "$ref": "#/$defs/privateAbi" },
    "leanSourceSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "leanType"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*$" },
        "leanType": { "type": "string", "minLength": 1 }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId", "sourceDeclaration", "sourceModule", "wrapper", "symbol", "parameters", "leanResultType", "resultMode", "leanEffect"
      ],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "sourceDeclaration": { "type": "string", "minLength": 1 },
        "sourceApplication": { "type": "string", "minLength": 1 },
        "sourceModule": { "type": "string", "minLength": 1 },
        "wrapper": { "type": "string", "pattern": "^export_[0-9a-f]{20}$" },
        "symbol": { "type": "string", "pattern": "^lean_bridge_[0-9a-f]{24}$" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "leanResultType": { "type": "string", "minLength": 1 },
        "resultMode": { "enum": ["value", "promise"] },
        "leanEffect": { "type": ["string", "null"], "enum": ["IO", "Task", null] }
      }
    },
    "privateExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "symbol", "parameters", "result", "resultMode"],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "pattern": "^lean_bridge_[0-9a-f]{24}$" },
        "parameters": { "type": "array", "items": { "$ref": "binding-ir.schema.json#/$defs/typeRef" } },
        "result": { "$ref": "binding-ir.schema.json#/$defs/typeRef" },
        "resultMode": { "enum": ["value", "promise"] }
      }
    },
    "privateAbi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "dispatch", "exports"],
      "properties": {
        "version": { "enum": [2, 3, 4, 5, 6] },
        "dispatch": { "enum": ["scalar-frame-v2", "scalar-callable-frame-v1", "copied-array-frame-v1", "copied-record-frame-v1", "copied-compound-frame-v1"] },
        "records": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/record" } },
        "callbacks": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/callback" } },
        "exports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/privateExport" } }
      },
      "oneOf": [
        { "properties": { "version": { "const": 2 }, "dispatch": { "const": "scalar-frame-v2" } }, "not": { "anyOf": [{ "required": ["callbacks"] }, { "required": ["records"] }] } },
        { "properties": { "version": { "const": 3 }, "dispatch": { "const": "scalar-callable-frame-v1" } }, "required": ["callbacks"], "not": { "required": ["records"] } },
        { "properties": { "version": { "const": 4 }, "dispatch": { "const": "copied-array-frame-v1" } }, "not": { "anyOf": [{ "required": ["callbacks"] }, { "required": ["records"] }] } },
        { "properties": { "version": { "const": 5 }, "dispatch": { "const": "copied-record-frame-v1" }, "records": { "minItems": 1 } }, "required": ["records"], "not": { "required": ["callbacks"] } },
        { "properties": { "version": { "const": 6 }, "dispatch": { "const": "copied-compound-frame-v1" } }, "required": ["records"], "not": { "required": ["callbacks"] } }
      ]
    },
    "record": {
      "type": "object", "additionalProperties": false, "required": ["id", "fields"],
      "properties": {
        "id": { "type": "string", "pattern": "^lean:[A-Za-z_][A-Za-z0-9_'.]*$" },
        "fields": { "type": "array", "maxItems": 1024, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "type"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "type": { "$ref": "binding-ir.schema.json#/$defs/typeRef" }
          }
        } }
      }
    },
    "callback": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "key", "parameters", "result"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "key": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "parameters": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "elaborated-export-metadata.schema.json#/$defs/scalarType" } },
        "result": { "$ref": "elaborated-export-metadata.schema.json#/$defs/scalarType" }
      }
    }
  }
}
