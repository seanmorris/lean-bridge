{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:lean-target-c-manifest:v1",
  "title": "Lean Bridge target C manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "compilationPlanSha256", "compiler", "target", "modules", "sourceReadOnly"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "component": { "type": "string", "minLength": 1 },
    "compilationPlanSha256": { "$ref": "#/$defs/sha256" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": { "version": { "type": "string", "minLength": 1 }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "target": { "const": "wasm32-unknown-emscripten-c" },
    "modules": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/module" } },
    "sourceReadOnly": { "const": true },
    "lakeDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "resolution", "resolutionSha256"],
      "properties": {
        "snapshot": { "$ref": "lake-dependency-snapshot.schema.json" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "resolutionSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "sourceSha256", "targetC", "targetCSha256", "olean", "oleanSha256"],
      "properties": {
        "module": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "targetC": { "type": "string", "pattern": "^c/.+\\.c$" },
        "targetCSha256": { "$ref": "#/$defs/sha256" },
        "olean": { "type": "string", "pattern": "^olean/.+\\.olean$" },
        "oleanSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "leanModule": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resolver", "leanVersion", "leanCommit", "packages", "modules", "externalImports", "snapshotSha256", "resolverSha256", "leanCompilerSha256", "lakeLibrarySha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resolver": { "const": "lean-lake-locked" },
        "leanVersion": { "type": "string", "minLength": 1 },
        "leanCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "configFile", "dependencies"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "configFile": { "type": "string", "minLength": 1 },
              "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "path", "package", "imports", "source"],
            "properties": {
              "module": { "$ref": "#/$defs/leanModule" },
              "path": { "type": "string", "minLength": 1 },
              "package": { "type": "string", "minLength": 1 },
              "imports": { "type": "array", "items": { "$ref": "#/$defs/leanModule" } },
              "source": { "$ref": "lake-dependency-snapshot.schema.json#/$defs/file" }
            }
          }
        },
        "externalImports": { "type": "array", "items": { "$ref": "#/$defs/leanModule" }, "uniqueItems": true },
        "snapshotSha256": { "$ref": "#/$defs/sha256" },
        "resolverSha256": { "$ref": "#/$defs/sha256" },
        "leanCompilerSha256": { "$ref": "#/$defs/sha256" },
        "lakeLibrarySha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": {
        "required": ["lakeDependencies"],
        "properties": { "lakeDependencies": { "properties": { "snapshot": { "properties": { "schemaVersion": { "const": 2 } } } } } }
      },
      "else": { "not": { "required": ["lakeDependencies"] } }
    }
  ]
}
