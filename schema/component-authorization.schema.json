{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:component-authorization:v2",
  "title": "Lean Bridge ordinary component authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "candidate",
    "evidence",
    "authorizedArtifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "lean-bridge-component-authorization"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportPath",
        "reportSha256",
        "attestationPath",
        "attestationSha256"
      ],
      "properties": {
        "reportPath": {
          "const": "evidence/reproducibility.json"
        },
        "reportSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attestationPath": {
          "const": "evidence/reproducibility.intoto.json"
        },
        "attestationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authorizedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "mode", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRevision",
        "source",
        "component",
        "artifactInventorySha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "projectPath",
            "revision",
            "tree"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "projectPath": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            }
          }
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "artifactInventorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
