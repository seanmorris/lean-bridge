{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captured Lake text-generator recipes",
  "description": "Package-relative author intent for the internal prerequisite runner. Normal CLI package builds still reject nonempty generators.",
  "type": "array",
  "maxItems": 128,
  "items": {"$ref": "#/$defs/recipe"},
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "module", "declaration", "inputs", "arguments", "outputs"],
      "properties": {
        "name": {"allOf": [{"$ref": "#/$defs/name"}, {"$ref": "#/$defs/module"}]},
        "profile": {"const": "lean-text-v1"},
        "module": {"$ref": "#/$defs/module"},
        "declaration": {"$ref": "#/$defs/module"},
        "inputs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/namedPath"}},
        "arguments": {
          "type": "array", "maxItems": 128,
          "items": {"type": "string", "maxLength": 16384, "pattern": "^[^\\x00-\\x1f\\x7f\\uD800-\\uDFFF]*$(?![\\s\\S])"}
        },
        "outputs": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {"allOf": [
            {"$ref": "#/$defs/namedPath"},
            {"properties": {"path": {"pattern": "\\.(lean|c|h)$(?![\\s\\S])"}}}
          ]}
        }
      }
    },
    "name": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$(?![\\s\\S])"},
    "module": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"},
    "path": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?!/)(?!.*[\\\\:*?\\x00-\\x1f\\x7f\\uD800-\\uDFFF])(?!.*(?:^|/)(?:\\.{1,2}|\\.git|\\.lake|\\.env|\\.npmrc|build|dist|target|node_modules)(?:/|$))(?!.*(?:^|/)(?:\\.env\\.|\\.lean-bridge-))(?!.*//).*(?<!/)$(?![\\s\\S])"
    },
    "namedPath": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "path": {"$ref": "#/$defs/path"}}
    }
  }
}
