{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-bridge.example/schema/performance-corpus.schema.json",
  "title": "Lean Bridge performance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "coordinate",
    "dimensions",
    "ordering",
    "evidence",
    "interfaces",
    "resources",
    "components",
    "datasets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum", "maximum"],
      "properties": {
        "type": { "const": "int32" },
        "minimum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "maximum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 32 }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "duplicates", "queryResults", "nearestTies"],
      "properties": {
        "points": { "const": "coordinates-lexicographic-then-id" },
        "duplicates": { "const": "first" },
        "queryResults": { "const": "point-id-ascending" },
        "nearestTies": { "const": "lowest-point-id" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/interface" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/component" }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "scope", "basis", "theorem"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["proved", "asserted", "tested", "unknown"] },
        "scope": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "theorem": { "type": ["string", "null"] }
      }
    },
    "complexityMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "bound", "evidence"],
      "properties": {
        "state": { "enum": ["proved", "asserted", "unknown"] },
        "bound": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "ownership"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/id" },
        "ownership": { "enum": ["copy", "borrow", "own"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ownership"],
      "properties": {
        "type": { "$ref": "#/$defs/id" },
        "ownership": { "enum": ["copy", "own", "none"] }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "component", "kind", "owner", "mutability", "parameters", "result",
        "preconditions", "postconditions", "failures", "complexity"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "component": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["function", "constructor", "method", "lifecycle"] },
        "owner": { "type": ["string", "null"] },
        "mutability": { "enum": ["pure", "read", "write", "lifecycle"] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "result": { "$ref": "#/$defs/result" },
        "preconditions": { "$ref": "#/$defs/stringArray" },
        "postconditions": { "$ref": "#/$defs/stringArray" },
        "failures": { "$ref": "#/$defs/stringArray" },
        "complexity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "auxiliarySpace"],
          "properties": {
            "time": { "$ref": "#/$defs/complexityMetric" },
            "auxiliarySpace": { "$ref": "#/$defs/complexityMetric" }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "mutability", "owns", "aliases", "disposal", "invariants"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "identity": { "const": "resource" },
        "mutability": { "const": "mutable" },
        "owns": { "const": "copied-points" },
        "aliases": { "const": "canonical" },
        "disposal": { "const": "required-idempotent" },
        "invariants": { "$ref": "#/$defs/stringArray" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "provides", "requires", "runtime"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "minLength": 1 },
        "provides": { "$ref": "#/$defs/stringArray" },
        "requires": { "$ref": "#/$defs/stringArray" },
        "runtime": { "const": "shared-application-runtime" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinates"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "coordinates": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call", "arguments", "expected"],
      "properties": {
        "call": { "$ref": "#/$defs/id" },
        "arguments": { "type": "object" },
        "expected": { "type": "object" }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimensions", "initialPoints", "vectors"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 32 },
        "initialPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
        "vectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vector" } }
      }
    }
  }
}
