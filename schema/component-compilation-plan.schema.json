{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:component-compilation-plan:v1",
  "title": "Lean Bridge component compilation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "componentPlanSha256", "compilerAdapters", "source", "runtime", "target", "outputs", "policies"],
  "properties": {
    "schemaVersion": { "enum": [1, 2, 3, 4] },
    "component": { "$ref": "#/$defs/component" },
    "componentPlanSha256": { "$ref": "#/$defs/sha256" },
    "compilerAdapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planSha256", "leanSourceSha256", "module", "initializer", "directSymbols"],
      "properties": {
        "planSha256": { "$ref": "#/$defs/sha256" },
        "leanSourceSha256": { "$ref": "#/$defs/sha256" },
        "module": { "type": "string", "pattern": "^LeanBridgeGenerated[0-9a-f]{16}$" },
        "initializer": { "type": "string", "pattern": "^initialize_LeanBridgeGenerated[0-9a-f]{16}$" },
        "directSymbols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^lean_bridge_[0-9a-f]{24}$" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSha256", "toolchain", "modules"],
      "properties": {
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "toolchain": { "type": "string", "minLength": 1 },
        "modules": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/sourceModule" }, { "$ref": "#/$defs/lockedSourceModule" }, { "$ref": "#/$defs/elaboratedSourceModule" }] } },
        "compileOrder": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/module" } },
        "externalImports": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/module" } },
        "lakeSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "generatedSourcesSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "elaborationSha256": { "$ref": "#/$defs/sha256" },
        "requestedModules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/module" } }
      }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triple", "format", "linkMode", "exceptionHandling", "positionIndependent"],
      "properties": {
        "triple": { "const": "wasm32-unknown-emscripten" },
        "format": { "const": "wasm" },
        "linkMode": { "const": "side-module-2" },
        "exceptionHandling": { "const": "wasm" },
        "positionIndependent": { "const": true }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sideModule", "linkMap", "artifactManifest"],
      "properties": {
        "sideModule": { "type": "string", "pattern": "^[^/].*\\.so\\.wasm$" },
        "linkMap": { "type": "string", "pattern": "^[^/].*\\.link\\.map$" },
        "artifactManifest": { "type": "string", "pattern": "^[^/].*\\.json$" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compileOnce", "sourceReadOnly", "linksRuntime", "definesMemory", "definesTable", "publicGenericDispatch"],
      "properties": {
        "compileOnce": { "const": true },
        "sourceReadOnly": { "const": true },
        "linksRuntime": { "const": false },
        "definesMemory": { "const": false },
        "definesTable": { "const": false },
        "publicGenericDispatch": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "module": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abiVersion", "leanCommit", "patchSetSha256", "profile", "shared"],
      "properties": {
        "abiVersion": { "type": "integer", "minimum": 1 },
        "leanCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "patchSetSha256": { "$ref": "#/$defs/sha256" },
        "profile": { "const": "side-lazy" },
        "shared": { "const": true }
      }
    },
    "sourceModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "path", "bytes", "sha256", "imports", "localDependencies"],
      "properties": {
        "module": { "$ref": "#/$defs/module" },
        "path": { "type": "string", "pattern": "^[^/].*\\.lean$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "imports": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/module" } },
        "localDependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/module" } }
      }
    },
    "elaboratedSourceModule": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "path", "bytes", "sha256", "origin"],
      "properties": {
        "module": { "$ref": "#/$defs/module" }, "path": { "type": "string", "pattern": "^[^/].*\\.lean$" },
        "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" },
        "origin": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "snapshotSha256"], "properties": { "kind": { "const": "captured" }, "snapshotSha256": { "$ref": "#/$defs/sha256" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "generator", "receiptSha256"], "properties": { "kind": { "const": "generated" }, "generator": { "type": "string", "pattern": "^root/[A-Za-z][A-Za-z0-9_.-]*$" }, "receiptSha256": { "$ref": "#/$defs/sha256" } } }
        ] }
      }
    },
    "lockedSourceModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "path", "bytes", "sha256"],
      "properties": {
        "module": { "$ref": "#/$defs/module" },
        "path": { "type": "string", "pattern": "^[^/].*\\.lean$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "enum": [2, 3, 4] } } },
      "then": {
        "properties": {
          "source": {
            "required": ["lakeSnapshotSha256", "requestedModules"],
            "not": { "anyOf": [{ "required": ["compileOrder"] }, { "required": ["externalImports"] }] },
            "properties": { "modules": { "items": { "oneOf": [{ "$ref": "#/$defs/lockedSourceModule" }, { "$ref": "#/$defs/elaboratedSourceModule" }] } } }
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "required": ["compileOrder", "externalImports"],
            "not": { "anyOf": [{ "required": ["lakeSnapshotSha256"] }, { "required": ["requestedModules"] }] },
            "properties": { "modules": { "items": { "$ref": "#/$defs/sourceModule" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "enum": [3, 4] } } },
      "then": { "properties": { "source": {
        "required": ["generatedSourcesSha256", "elaborationSha256"],
        "properties": { "modules": { "items": { "$ref": "#/$defs/elaboratedSourceModule" } } }
      } } },
      "else": { "properties": { "source": { "not": { "anyOf": [{ "required": ["generatedSourcesSha256"] }, { "required": ["elaborationSha256"] }] }, "properties": { "modules": { "items": { "not": { "required": ["origin"] } } } } } } }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 3 } } },
      "then": { "properties": { "source": { "properties": {
        "generatedSourcesSha256": { "$ref": "#/$defs/sha256" },
        "modules": { "contains": { "properties": { "origin": { "properties": { "kind": { "const": "generated" } } } } } }
      } } } }
    },
    {
      "if": { "properties": { "source": { "properties": { "modules": { "contains": { "required": ["origin"], "properties": { "origin": { "properties": { "kind": { "const": "generated" } } } } } } } } } },
      "then": { "properties": { "source": { "properties": { "generatedSourcesSha256": { "$ref": "#/$defs/sha256" } } } } }
    }
  ]
}
