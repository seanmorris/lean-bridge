{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanbridge.dev/schema/component-build-plan.schema.json",
  "title": "Lean Bridge component build plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "source", "bindingIr", "runtime", "targets", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSha256", "toolchain", "inputs"],
      "properties": {
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "toolchain": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } }
      }
    },
    "bindingIr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "origin", "semanticSha256", "declarations"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "origin": { "enum": ["statically-inferred", "existing-validated"] },
        "semanticSha256": { "$ref": "#/$defs/sha256" },
        "declarations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abiVersion", "leanCommit", "patchSetSha256", "profile", "shared"],
      "properties": {
        "abiVersion": { "type": "integer", "minimum": 1 },
        "leanCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "patchSetSha256": { "$ref": "#/$defs/sha256" },
        "profile": { "const": "side-lazy" },
        "shared": { "const": true }
      }
    },
    "targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compileOnce", "sourceReadOnly", "privateRuntime", "targetSpecificRebuild"],
      "properties": {
        "compileOnce": { "const": true },
        "sourceReadOnly": { "const": true },
        "privateRuntime": { "const": false },
        "targetSpecificRebuild": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
