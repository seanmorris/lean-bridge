{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lean-bridge:schema:lake-entry-elaboration:v3",
  "title": "Fresh Lean metadata for captured public entry modules",
  "description": "Compiler-owned metadata bound to captured sources, generated outputs, extractor, compiler and complete fresh interfaces. Target compilation reproduces this record before linking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "snapshotSha256",
    "generatedSourcesSha256",
    "leanCompilerSha256",
    "extractorSha256",
    "request",
    "interfaces",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "lean-bridge-lake-entry-elaboration"
    },
    "snapshotSha256": {
      "$ref": "#/$defs/sha256"
    },
    "generatedSourcesSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "leanCompilerSha256": {
      "$ref": "#/$defs/sha256"
    },
    "extractorSha256": {
      "$ref": "#/$defs/sha256"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "exportModules",
        "exports",
        "resources",
        "arities",
        "metadata"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "exportModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "exports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "resources": {
          "const": []
        },
        "arities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "$ref": "#/$defs/name" },
              { "type": "integer", "minimum": 0, "maximum": 32 }
            ],
            "items": false
          }
        },
        "specializations": { "$ref": "lean-export-configuration.schema.json#/$defs/specializations" },
        "contracts": { "$ref": "lean-export-configuration.schema.json#/$defs/contracts" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolchain",
            "invocationIdentitySha256",
            "modules"
          ],
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "invocationIdentitySha256": {
              "$ref": "#/$defs/sha256"
            },
            "modules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "sourcePath",
                  "sourceSha256",
                  "interfaceSha256"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/name"
                  },
                  "sourcePath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "interfaceSha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "sourceSha256",
          "oleanSha256",
          "interfaceSha256"
        ],
        "properties": {
          "module": {
            "$ref": "#/$defs/name"
          },
          "sourceSha256": {
            "$ref": "#/$defs/sha256"
          },
          "oleanSha256": {
            "$ref": "#/$defs/sha256"
          },
          "interfaceSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "metadata": {
      "$ref": "elaborated-export-metadata.schema.json"
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "lake-dependency-snapshot.schema.json#/$defs/digest"
    },
    "name": {
      "$ref": "lake-generator-configuration.schema.json#/$defs/module"
    }
  }
}
