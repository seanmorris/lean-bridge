  "scope": "Dependent checked-record WIT installation parses pkg-config shell escaping into literal compiler arguments, preserving deliberate space-containing relocation paths without invoking a shell.",
  "updates": [
    {
      "currentSha256": "2dea7873d5edca1f397513208f42acf29a5213897325afcfb83bbddc348a664a",
      "edits": [
        {
          "current": "import { parseDependentCheckedRecordWitPkgConfigFlags } from \"./dependent-checked-record-wit-install.mjs\";\n",
          "previous": "",
          "start": 1652
        },
        {
          "current": "test(\"dependent checked-record WIT preserves shell-escaped pkg-config paths\", () => {\n\tassert.deepEqual(parseDependentCheckedRecordWitPkgConfigFlags(\n\t\t\"-I/tmp/lean-bridge-dependent\\\\ checked/include -L/tmp/lean-bridge-dependent\\\\ checked/lib -ldependent\\n\"\n\t), [\n\t\t\"-I/tmp/lean-bridge-dependent checked/include\"\n\t\t, \"-L/tmp/lean-bridge-dependent checked/lib\", \"-ldependent\"\n\t]);\n\tassert.deepEqual(parseDependentCheckedRecordWitPkgConfigFlags(\n\t\t\"'-I/single quoted' \\\"-L/double quoted\\\" plain\\\\ value empty''\\n\"\n\t), [\"-I/single quoted\", \"-L/double quoted\", \"plain value\", \"empty\"]);\n\tassert.deepEqual(parseDependentCheckedRecordWitPkgConfigFlags(\" \\n\\t\"), []);\n\tassert.throws(() => parseDependentCheckedRecordWitPkgConfigFlags(\"-I/tmp/ending\\\\\")\n\t\t, /ends in an escape/u);\n\tassert.throws(() => parseDependentCheckedRecordWitPkgConfigFlags(\"'-I/tmp/open\")\n\t\t, /unterminated quote/u);\n});\n\n",
          "previous": "",
          "start": 2104
        }
      ],
      "path": "tests/helpers/dependent-checked-record-wit-fixture-tests.mjs",
      "previousSha256": "c19a10db4c93a66128c1a0c05d99f28fa5bbe7ebde7b3d9a633a87922abda222"
    },
    {
      "currentSha256": "08eb5472035b01523ff06b2a168c5b94fcbedc09abae01b65027abfca5eb54b1",
      "edits": [
        {
          "current": "/**\n * Parse pkg-config's shell-escaped stdout into literal argv entries without\n * invoking a shell. In particular, pkg-config escapes spaces in a relocated\n * prefix with a backslash; splitting on whitespace corrupts that path.\n *\n * @param source - Complete pkg-config stdout.\n */\nexport const parseDependentCheckedRecordWitPkgConfigFlags = source => {\n\tassert.equal(typeof source, \"string\");\n\tconst flags = [];\n\tlet flag = \"\", quote = null, started = false;\n\tfor(let index = 0; index < source.length; index++)\n\t{\n\t\tconst character = source[index];\n\t\tif(quote !== null)\n\t\t{\n\t\t\tif(character === quote)\n\t\t\t{\n\t\t\t\tquote = null;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif(character === \"\\\\\" && quote === '\"')\n\t\t\t{\n\t\t\t\tassert.ok(index + 1 < source.length, \"pkg-config ends in an escape\");\n\t\t\t\tflag += source[++index];\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tflag += character;\n\t\t\tcontinue;\n\t\t}\n\t\tif(/\\s/u.test(character))\n\t\t{\n\t\t\tif(started)\n\t\t\t{\n\t\t\t\tflags.push(flag);\n\t\t\t\tflag = \"\";\n\t\t\t\tstarted = false;\n\t\t\t}\n\t\t\tcontinue;\n\t\t}\n\t\tstarted = true;\n\t\tif(character === \"'\" || character === '\"')\n\t\t{\n\t\t\tquote = character;\n\t\t\tcontinue;\n\t\t}\n\t\tif(character === \"\\\\\")\n\t\t{\n\t\t\tassert.ok(index + 1 < source.length, \"pkg-config ends in an escape\");\n\t\t\tflag += source[++index];\n\t\t\tcontinue;\n\t\t}\n\t\tflag += character;\n\t}\n\tassert.equal(quote, null, \"pkg-config contains an unterminated quote\");\n\tif(started) flags.push(flag);\n\treturn flags;\n};\n\n",
          "previous": "",
          "start": 1152
        },
        {
          "current": "\tconst flags = parseDependentCheckedRecordWitPkgConfigFlags((await capture(\n\t\t\"pkgConfig\", [\"--cflags\", \"--libs\", dependentCheckedRecordWitPkgConfig]\n\t\t, environment)).stdout);\n",
          "previous": "\tconst flags = (await capture(\"pkgConfig\", [\"--cflags\", \"--libs\", dependentCheckedRecordWitPkgConfig], environment)).stdout.trim().split(/\\s+/u);\n",
          "start": 7270
        }
      ],
