2026-10-08T06:12:03.9441214Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-08T06:12:03.9441439Z 
2026-10-08T06:12:03.9441693Z # To enable the settings / commands in this file for login shells as well,
2026-10-08T06:12:03.9442115Z # this file has to be sourced in /etc/profile.
2026-10-08T06:12:03.9442334Z 
2026-10-08T06:12:03.9442504Z # If not running interactively, don't do anything
2026-10-08T06:12:03.9442883Z [ -z "$PS1" ] && return
2026-10-08T06:12:03.9443046Z 
2026-10-08T06:12:03.9443303Z # check the window size after each command and, if necessary,
2026-10-08T06:12:03.9443725Z # update the values of LINES and COLUMNS.
2026-10-08T06:12:03.9444066Z shopt -s checkwinsize
2026-10-08T06:12:03.9444198Z 
2026-10-08T06:12:03.9444477Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-08T06:12:03.9444954Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-08T06:12:03.9445294Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-08T06:12:03.9445659Z fi
2026-10-08T06:12:03.9445750Z 
2026-10-08T06:12:03.9445978Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-08T06:12:03.9446442Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-08T06:12:03.9446882Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-08T06:12:03.9447225Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-08T06:12:03.9447495Z fi
2026-10-08T06:12:03.9447588Z 
2026-10-08T06:12:03.9447852Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-08T06:12:03.9448259Z # If this is an xterm set the title to user@host:dir
2026-10-08T06:12:03.9448434Z #case "$TERM" in
2026-10-08T06:12:03.9448586Z #xterm*|rxvt*)
2026-10-08T06:12:03.9448796Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-08T06:12:03.9448993Z #    ;;
2026-10-08T06:12:03.9449098Z #*)
2026-10-08T06:12:03.9449203Z #    ;;
2026-10-08T06:12:03.9449304Z #esac
2026-10-08T06:12:03.9449366Z 
