2026-10-08T06:12:03.9451302Z # sudo hint
2026-10-08T06:12:03.9451758Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-08T06:12:03.9452156Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-08T06:12:03.9452445Z     if [ -x /usr/bin/sudo ]; then
2026-10-08T06:12:03.9452669Z 	cat <<-EOF
2026-10-08T06:12:03.9452973Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-08T06:12:03.9453323Z 	See "man sudo_root" for details.
2026-10-08T06:12:03.9453540Z 	
2026-10-08T06:12:03.9453696Z 	EOF
2026-10-08T06:12:03.9453855Z     fi
