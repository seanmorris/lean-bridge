2026-10-09T18:49:03.7065799Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T18:49:03.7066304Z 
2026-10-09T18:49:03.7066881Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T18:49:03.7067897Z # this file has to be sourced in /etc/profile.
2026-10-09T18:49:03.7068309Z 
2026-10-09T18:49:03.7068684Z # If not running interactively, don't do anything
2026-10-09T18:49:03.7069299Z [ -z "$PS1" ] && return
2026-10-09T18:49:03.7069875Z 
2026-10-09T18:49:03.7070295Z # check the window size after each command and, if necessary,
2026-10-09T18:49:03.7071038Z # update the values of LINES and COLUMNS.
2026-10-09T18:49:03.7071566Z shopt -s checkwinsize
2026-10-09T18:49:03.7071816Z 
2026-10-09T18:49:03.7072395Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T18:49:03.7073361Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T18:49:03.7073912Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T18:49:03.7074221Z fi
2026-10-09T18:49:03.7074328Z 
2026-10-09T18:49:03.7074604Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T18:49:03.7075177Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T18:49:03.7075673Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T18:49:03.7076071Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T18:49:03.7076385Z fi
2026-10-09T18:49:03.7076493Z 
2026-10-09T18:49:03.7076802Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T18:49:03.7077325Z # If this is an xterm set the title to user@host:dir
2026-10-09T18:49:03.7077682Z #case "$TERM" in
2026-10-09T18:49:03.7077972Z #xterm*|rxvt*)
2026-10-09T18:49:03.7078472Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T18:49:03.7078862Z #    ;;
2026-10-09T18:49:03.7079053Z #*)
2026-10-09T18:49:03.7079246Z #    ;;
2026-10-09T18:49:03.7079719Z #esac
2026-10-09T18:49:03.7079850Z 
2026-10-09T18:49:03.7080046Z # enable bash completion in interactive shells
2026-10-09T18:49:03.7080439Z #if ! shopt -oq posix; then
2026-10-09T18:49:03.7080834Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-09T18:49:03.7081266Z #    . /usr/share/bash-completion/bash_completion
2026-10-09T18:49:03.7081644Z #  elif [ -f /etc/bash_completion ]; then
2026-10-09T18:49:03.7081953Z #    . /etc/bash_completion
2026-10-09T18:49:03.7082188Z #  fi
2026-10-09T18:49:03.7082377Z #fi
2026-10-09T18:49:03.7082478Z 
2026-10-09T18:49:03.7082567Z # sudo hint
2026-10-09T18:49:03.7083224Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T18:49:03.7083713Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T18:49:03.7084051Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T18:49:03.7084450Z 	cat <<-EOF
2026-10-09T18:49:03.7084802Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T18:49:03.7085222Z 	See "man sudo_root" for details.
2026-10-09T18:49:03.7085474Z 	
2026-10-09T18:49:03.7085651Z 	EOF
2026-10-09T18:49:03.7085839Z     fi
2026-10-09T18:49:03.7086024Z     esac
2026-10-09T18:49:03.7086209Z fi
2026-10-09T18:49:03.7086315Z 
2026-10-09T18:49:03.7086523Z # if the command-not-found package is installed, use it
2026-10-09T18:49:03.7087147Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T18:49:03.7087652Z 	function command_not_found_handle {
2026-10-09T18:49:03.7088045Z 	        # check because c-n-f could've been removed in the meantime
2026-10-09T18:49:03.7088487Z                 if [ -x /usr/lib/command-not-found ]; then
2026-10-09T18:49:03.7088849Z 		   /usr/lib/command-not-found -- "$1"
2026-10-09T18:49:03.7103210Z                    return $?
2026-10-09T18:49:03.7104063Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T18:49:03.7104912Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-10-09T18:49:03.7105508Z                    return $?
2026-10-09T18:49:03.7105911Z 		else
2026-10-09T18:49:03.7106355Z 		   printf "%s: command not found\n" "$1" >&2
2026-10-09T18:49:03.7106872Z 		   return 127
