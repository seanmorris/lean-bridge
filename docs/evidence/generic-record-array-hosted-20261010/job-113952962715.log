2026-10-09T18:41:47.2168642Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T18:41:47.2169140Z 
2026-10-09T18:41:47.2169477Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T18:41:47.2170080Z # this file has to be sourced in /etc/profile.
2026-10-09T18:41:47.2170363Z 
2026-10-09T18:41:47.2170579Z # If not running interactively, don't do anything
2026-10-09T18:41:47.2171223Z [ -z "$PS1" ] && return
2026-10-09T18:41:47.2171396Z 
2026-10-09T18:41:47.2171631Z # check the window size after each command and, if necessary,
2026-10-09T18:41:47.2172070Z # update the values of LINES and COLUMNS.
2026-10-09T18:41:47.2172388Z shopt -s checkwinsize
2026-10-09T18:41:47.2172531Z 
2026-10-09T18:41:47.2172844Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T18:41:47.2173448Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T18:41:47.2173854Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T18:41:47.2174137Z fi
2026-10-09T18:41:47.2174249Z 
2026-10-09T18:41:47.2174562Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T18:41:47.2175555Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T18:41:47.2176418Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T18:41:47.2177137Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T18:41:47.2177505Z fi
2026-10-09T18:41:47.2177607Z 
2026-10-09T18:41:47.2177908Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T18:41:47.2178419Z # If this is an xterm set the title to user@host:dir
2026-10-09T18:41:47.2178770Z #case "$TERM" in
2026-10-09T18:41:47.2179041Z #xterm*|rxvt*)
2026-10-09T18:41:47.2179521Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T18:41:47.2179893Z #    ;;
2026-10-09T18:41:47.2180079Z #*)
2026-10-09T18:41:47.2180254Z #    ;;
2026-10-09T18:41:47.2180428Z #esac
2026-10-09T18:41:47.2180538Z 
2026-10-09T18:41:47.2180999Z # enable bash completion in interactive shells
