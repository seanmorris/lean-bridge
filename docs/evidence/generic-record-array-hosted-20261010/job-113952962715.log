2026-10-09T18:41:47.2183656Z # sudo hint
2026-10-09T18:41:47.2184308Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T18:41:47.2184803Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T18:41:47.2185138Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T18:41:47.2185987Z 	cat <<-EOF
2026-10-09T18:41:47.2186665Z 	To run a command as administrator (user "root"), use "sudo <command>".
