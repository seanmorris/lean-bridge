2026-10-09T19:43:08.3409435Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T19:43:08.3409901Z 
2026-10-09T19:43:08.3410411Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T19:43:08.3411163Z # this file has to be sourced in /etc/profile.
2026-10-09T19:43:08.3411488Z 
2026-10-09T19:43:08.3411792Z # If not running interactively, don't do anything
2026-10-09T19:43:08.3412340Z [ -z "$PS1" ] && return
2026-10-09T19:43:08.3412570Z 
2026-10-09T19:43:08.3412831Z # check the window size after each command and, if necessary,
2026-10-09T19:43:08.3413527Z # update the values of LINES and COLUMNS.
2026-10-09T19:43:08.3413961Z shopt -s checkwinsize
2026-10-09T19:43:08.3414112Z 
2026-10-09T19:43:08.3414561Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T19:43:08.3415359Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T19:43:08.3415942Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T19:43:08.3416504Z fi
2026-10-09T19:43:08.3416710Z 
2026-10-09T19:43:08.3417107Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T19:43:08.3417639Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T19:43:08.3418093Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T19:43:08.3418479Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T19:43:08.3418795Z fi
2026-10-09T19:43:08.3418916Z 
