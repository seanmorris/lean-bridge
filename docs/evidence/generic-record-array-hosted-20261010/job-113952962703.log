2026-10-09T17:56:11.4206207Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T17:56:11.4206426Z 
2026-10-09T17:56:11.4206683Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T17:56:11.4207104Z # this file has to be sourced in /etc/profile.
2026-10-09T17:56:11.4207286Z 
2026-10-09T17:56:11.4207457Z # If not running interactively, don't do anything
2026-10-09T17:56:11.4207755Z [ -z "$PS1" ] && return
2026-10-09T17:56:11.4207888Z 
2026-10-09T17:56:11.4208102Z # check the window size after each command and, if necessary,
2026-10-09T17:56:11.4208663Z # update the values of LINES and COLUMNS.
2026-10-09T17:56:11.4208945Z shopt -s checkwinsize
2026-10-09T17:56:11.4209072Z 
2026-10-09T17:56:11.4209333Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T17:56:11.4209810Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T17:56:11.4210149Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T17:56:11.4210394Z fi
2026-10-09T17:56:11.4210484Z 
2026-10-09T17:56:11.4210713Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T17:56:11.4211178Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T17:56:11.4211581Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T17:56:11.4211918Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T17:56:11.4212181Z fi
2026-10-09T17:56:11.4212276Z 
