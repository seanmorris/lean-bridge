2026-10-09T19:24:33.7478737Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T19:24:33.7479185Z 
2026-10-09T19:24:33.7479700Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T19:24:33.7480538Z # this file has to be sourced in /etc/profile.
2026-10-09T19:24:33.7480921Z 
2026-10-09T19:24:33.7481252Z # If not running interactively, don't do anything
2026-10-09T19:24:33.7482107Z [ -z "$PS1" ] && return
2026-10-09T19:24:33.7482360Z 
2026-10-09T19:24:33.7482782Z # check the window size after each command and, if necessary,
2026-10-09T19:24:33.7483508Z # update the values of LINES and COLUMNS.
2026-10-09T19:24:33.7484026Z shopt -s checkwinsize
2026-10-09T19:24:33.7484269Z 
2026-10-09T19:24:33.7484800Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T19:24:33.7485766Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T19:24:33.7486414Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T19:24:33.7486740Z fi
2026-10-09T19:24:33.7486888Z 
2026-10-09T19:24:33.7487175Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T19:24:33.7487735Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T19:24:33.7488307Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T19:24:33.7489043Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T19:24:33.7489590Z fi
2026-10-09T19:24:33.7489767Z 
2026-10-09T19:24:33.7490345Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T19:24:33.7491330Z # If this is an xterm set the title to user@host:dir
2026-10-09T19:24:33.7491945Z #case "$TERM" in
2026-10-09T19:24:33.7492172Z #xterm*|rxvt*)
2026-10-09T19:24:33.7492555Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T19:24:33.7492923Z #    ;;
2026-10-09T19:24:33.7493112Z #*)
2026-10-09T19:24:33.7493291Z #    ;;
2026-10-09T19:24:33.7493465Z #esac
2026-10-09T19:24:33.7493577Z 
2026-10-09T19:24:33.7493760Z # enable bash completion in interactive shells
2026-10-09T19:24:33.7494092Z #if ! shopt -oq posix; then
2026-10-09T19:24:33.7494466Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-09T19:24:33.7494887Z #    . /usr/share/bash-completion/bash_completion
2026-10-09T19:24:33.7495245Z #  elif [ -f /etc/bash_completion ]; then
2026-10-09T19:24:33.7495544Z #    . /etc/bash_completion
2026-10-09T19:24:33.7495769Z #  fi
2026-10-09T19:24:33.7495964Z #fi
2026-10-09T19:24:33.7496063Z 
2026-10-09T19:24:33.7496153Z # sudo hint
2026-10-09T19:24:33.7496753Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T19:24:33.7497227Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T19:24:33.7497550Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T19:24:33.7497806Z 	cat <<-EOF
2026-10-09T19:24:33.7498281Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T19:24:33.7498677Z 	See "man sudo_root" for details.
2026-10-09T19:24:33.7498924Z 	
2026-10-09T19:24:33.7499100Z 	EOF
2026-10-09T19:24:33.7499286Z     fi
2026-10-09T19:24:33.7499467Z     esac
2026-10-09T19:24:33.7499647Z fi
2026-10-09T19:24:33.7499749Z 
2026-10-09T19:24:33.7499960Z # if the command-not-found package is installed, use it
2026-10-09T19:24:33.7500759Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T19:24:33.7501265Z 	function command_not_found_handle {
