2026-10-09T18:53:49.0915908Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T18:53:49.0916358Z 
2026-10-09T18:53:49.0916889Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T18:53:49.0917988Z # this file has to be sourced in /etc/profile.
2026-10-09T18:53:49.0918391Z 
2026-10-09T18:53:49.0918736Z # If not running interactively, don't do anything
2026-10-09T18:53:49.0919338Z [ -z "$PS1" ] && return
2026-10-09T18:53:49.0919598Z 
2026-10-09T18:53:49.0920012Z # check the window size after each command and, if necessary,
2026-10-09T18:53:49.0920793Z # update the values of LINES and COLUMNS.
2026-10-09T18:53:49.0921330Z shopt -s checkwinsize
2026-10-09T18:53:49.0921583Z 
2026-10-09T18:53:49.0922161Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T18:53:49.0923223Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T18:53:49.0923949Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T18:53:49.0924437Z fi
2026-10-09T18:53:49.0924617Z 
2026-10-09T18:53:49.0925112Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T18:53:49.0926041Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T18:53:49.0927171Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T18:53:49.0928170Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T18:53:49.0928711Z fi
2026-10-09T18:53:49.0928890Z 
2026-10-09T18:53:49.0929411Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T18:53:49.0930313Z # If this is an xterm set the title to user@host:dir
2026-10-09T18:53:49.0930853Z #case "$TERM" in
2026-10-09T18:53:49.0931232Z #xterm*|rxvt*)
2026-10-09T18:53:49.0931679Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T18:53:49.0932037Z #    ;;
2026-10-09T18:53:49.0932216Z #*)
2026-10-09T18:53:49.0932395Z #    ;;
2026-10-09T18:53:49.0932569Z #esac
2026-10-09T18:53:49.0932678Z 
2026-10-09T18:53:49.0932854Z # enable bash completion in interactive shells
2026-10-09T18:53:49.0933187Z #if ! shopt -oq posix; then
2026-10-09T18:53:49.0933567Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-09T18:53:49.0933987Z #    . /usr/share/bash-completion/bash_completion
2026-10-09T18:53:49.0934357Z #  elif [ -f /etc/bash_completion ]; then
