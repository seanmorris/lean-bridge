2026-10-09T18:53:49.0934897Z #  fi
2026-10-09T18:53:49.0935074Z #fi
2026-10-09T18:53:49.0935178Z 
2026-10-09T18:53:49.0935265Z # sudo hint
2026-10-09T18:53:49.0935904Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T18:53:49.0936387Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T18:53:49.0936858Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T18:53:49.0937118Z 	cat <<-EOF
2026-10-09T18:53:49.0937459Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T18:53:49.0938345Z 	See "man sudo_root" for details.
2026-10-09T18:53:49.0938701Z 	
2026-10-09T18:53:49.0938880Z 	EOF
2026-10-09T18:53:49.0939058Z     fi
2026-10-09T18:53:49.0939248Z     esac
2026-10-09T18:53:49.0939429Z fi
2026-10-09T18:53:49.0939534Z 
2026-10-09T18:53:49.0939745Z # if the command-not-found package is installed, use it
2026-10-09T18:53:49.0940352Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T18:53:49.0940846Z 	function command_not_found_handle {
