2026-10-09T17:56:10.7551369Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T17:56:10.7551593Z 
2026-10-09T17:56:10.7552068Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T17:56:10.7552481Z # this file has to be sourced in /etc/profile.
2026-10-09T17:56:10.7552668Z 
2026-10-09T17:56:10.7552831Z # If not running interactively, don't do anything
2026-10-09T17:56:10.7553131Z [ -z "$PS1" ] && return
2026-10-09T17:56:10.7553258Z 
2026-10-09T17:56:10.7553477Z # check the window size after each command and, if necessary,
2026-10-09T17:56:10.7553840Z # update the values of LINES and COLUMNS.
2026-10-09T17:56:10.7554100Z shopt -s checkwinsize
2026-10-09T17:56:10.7554226Z 
2026-10-09T17:56:10.7554649Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T17:56:10.7555118Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T17:56:10.7555451Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T17:56:10.7555691Z fi
2026-10-09T17:56:10.7555780Z 
2026-10-09T17:56:10.7556003Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T17:56:10.7556460Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T17:56:10.7556864Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T17:56:10.7557218Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T17:56:10.7557478Z fi
2026-10-09T17:56:10.7557570Z 
2026-10-09T17:56:10.7557822Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T17:56:10.7558216Z # If this is an xterm set the title to user@host:dir
2026-10-09T17:56:10.7558390Z #case "$TERM" in
2026-10-09T17:56:10.7558534Z #xterm*|rxvt*)
2026-10-09T17:56:10.7558773Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T17:56:10.7558972Z #    ;;
2026-10-09T17:56:10.7559080Z #*)
2026-10-09T17:56:10.7559185Z #    ;;
2026-10-09T17:56:10.7559287Z #esac
2026-10-09T17:56:10.7559350Z 
2026-10-09T17:56:10.7559467Z # enable bash completion in interactive shells
2026-10-09T17:56:10.7559657Z #if ! shopt -oq posix; then
2026-10-09T17:56:10.7559961Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-09T17:56:10.7560322Z #    . /usr/share/bash-completion/bash_completion
2026-10-09T17:56:10.7560639Z #  elif [ -f /etc/bash_completion ]; then
2026-10-09T17:56:10.7560902Z #    . /etc/bash_completion
2026-10-09T17:56:10.7561102Z #  fi
2026-10-09T17:56:10.7561266Z #fi
2026-10-09T17:56:10.7561385Z 
2026-10-09T17:56:10.7561467Z # sudo hint
2026-10-09T17:56:10.7562117Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T17:56:10.7562374Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T17:56:10.7562557Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T17:56:10.7562705Z 	cat <<-EOF
2026-10-09T17:56:10.7562899Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T17:56:10.7563119Z 	See "man sudo_root" for details.
2026-10-09T17:56:10.7563257Z 	
2026-10-09T17:56:10.7563357Z 	EOF
2026-10-09T17:56:10.7563463Z     fi
2026-10-09T17:56:10.7563572Z     esac
2026-10-09T17:56:10.7563677Z fi
2026-10-09T17:56:10.7563736Z 
2026-10-09T17:56:10.7563856Z # if the command-not-found package is installed, use it
2026-10-09T17:56:10.7564187Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T17:56:10.7564598Z 	function command_not_found_handle {
2026-10-09T17:56:10.7564819Z 	        # check because c-n-f could've been removed in the meantime
2026-10-09T17:56:10.7565053Z                 if [ -x /usr/lib/command-not-found ]; then
2026-10-09T17:56:10.7565247Z 		   /usr/lib/command-not-found -- "$1"
2026-10-09T17:56:10.7565408Z                    return $?
2026-10-09T17:56:10.7565617Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T17:56:10.7565871Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-10-09T17:56:10.7566058Z                    return $?
2026-10-09T17:56:10.7566187Z 		else
2026-10-09T17:56:10.7566329Z 		   printf "%s: command not found\n" "$1" >&2
2026-10-09T17:56:10.7566652Z 		   return 127
2026-10-09T17:56:10.7566768Z 		fi
2026-10-09T17:56:10.7566870Z 	}
