2026-10-09T17:56:44.2940728Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T17:56:44.2941211Z 
2026-10-09T17:56:44.2941828Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T17:56:44.2943119Z # this file has to be sourced in /etc/profile.
2026-10-09T17:56:44.2943595Z 
2026-10-09T17:56:44.2943986Z # If not running interactively, don't do anything
2026-10-09T17:56:44.2944664Z [ -z "$PS1" ] && return
2026-10-09T17:56:44.2944939Z 
2026-10-09T17:56:44.2945373Z # check the window size after each command and, if necessary,
2026-10-09T17:56:44.2946145Z # update the values of LINES and COLUMNS.
2026-10-09T17:56:44.2946695Z shopt -s checkwinsize
2026-10-09T17:56:44.2946968Z 
2026-10-09T17:56:44.2947563Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T17:56:44.2948575Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T17:56:44.2949165Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T17:56:44.2949464Z fi
2026-10-09T17:56:44.2949573Z 
2026-10-09T17:56:44.2949843Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T17:56:44.2950394Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T17:56:44.2950938Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T17:56:44.2951674Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T17:56:44.2952241Z fi
2026-10-09T17:56:44.2952447Z 
2026-10-09T17:56:44.2953876Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
