      "edits": [
        {
          "start": 346,
          "previous": "",
          "current": "import { describeComponentEngineFailure, encodeComponentEngineFailure } from \"../src/build/component-engine-failure.mjs\";\n"
        },
        {
          "start": 469,
          "previous": "const allowed = new Set([\"--request\", \"--component\", \"--output\", \"--engine\", \"--backend\"]);\nconst options = new Map();\nfor(let index = 2; index < process.argv.length; index += 2)\n",
          "current": "// Report failures as one structured stderr line so callers keep codes and details.\ntry\n"
        },
        {
          "start": 559,
          "previous": "\tconst flag = process.argv[index];\n\tconst value = process.argv[index + 1];\n\tif(!allowed.has(flag) || value === undefined || options.has(flag)) throw new Error(`unknown, duplicate, or incomplete argument ${flag ?? \"\"}`);\n\toptions.set(flag, value);\n}\nfor(const required of [\"--request\", \"--component\", \"--output\"]) if(!options.has(required)) throw new Error(`missing ${required}`);\n",
          "current": "\tconst allowed = new Set([\"--request\", \"--component\", \"--output\", \"--engine\", \"--backend\"]);\n\tconst options = new Map();\n\tfor(let index = 2; index < process.argv.length; index += 2)\n\t{\n\t\tconst flag = process.argv[index];\n\t\tconst value = process.argv[index + 1];\n\t\tif(!allowed.has(flag) || value === undefined || options.has(flag)) throw new Error(`unknown, duplicate, or incomplete argument ${flag ?? \"\"}`);\n\t\toptions.set(flag, value);\n\t}\n\tfor(const required of [\"--request\", \"--component\", \"--output\"]) if(!options.has(required)) throw new Error(`missing ${required}`);\n"
        },
        {
          "start": 1131,
          "previous": "const engineRoot = resolve(options.get(\"--engine\") ?? fileURLToPath(new URL(\"..\", import.meta.url)));\nconst controller = new AbortController();\nif([3, 4].includes(JSON.parse(await readFile(options.get(\"--request\"), \"utf8\")).schemaVersion))\n\tfor(const name of [\"SIGINT\", \"SIGTERM\"]) process.once(name, () => controller.abort(new Error(\"Compiler operation cancelled\")));\nconst result = await executeComponentEngineRequest({\n\trequestPath: resolve(options.get(\"--request\"))\n\t, inputRoot: resolve(options.get(\"--component\"))\n\t, outputRoot: resolve(options.get(\"--output\"))\n\t, engineRoot\n\t, backend: options.get(\"--backend\") ?? process.env.LEAN_BRIDGE_EXECUTION_BACKEND ?? \"direct\"\n\t, signal: controller.signal\n});\nprocess.stdout.write(canonicalJson({\n\toutput: result.output\n\t, component: result.report.component\n\t, requestSha256: result.report.requestSha256\n\t, ...(result.analysis ? { analysisSha256: result.report.analysisSha256 }\n\t\t: result.component ? { componentReceiptSha256: result.report.componentReceiptSha256 }\n\t\t\t: { bundleManifestSha256: result.report.bundleManifestSha256 })\n}));\n",
          "current": "\tconst engineRoot = resolve(options.get(\"--engine\") ?? fileURLToPath(new URL(\"..\", import.meta.url)));\n\tconst controller = new AbortController();\n\tif([3, 4].includes(JSON.parse(await readFile(options.get(\"--request\"), \"utf8\")).schemaVersion))\n\t\tfor(const name of [\"SIGINT\", \"SIGTERM\"]) process.once(name, () => controller.abort(new Error(\"Compiler operation cancelled\")));\n\tconst result = await executeComponentEngineRequest({\n\t\trequestPath: resolve(options.get(\"--request\"))\n\t\t, inputRoot: resolve(options.get(\"--component\"))\n\t\t, outputRoot: resolve(options.get(\"--output\"))\n\t\t, engineRoot\n\t\t, backend: options.get(\"--backend\") ?? process.env.LEAN_BRIDGE_EXECUTION_BACKEND ?? \"direct\"\n\t\t, signal: controller.signal\n\t});\n\tprocess.stdout.write(canonicalJson({\n\t\toutput: result.output\n\t\t, component: result.report.component\n\t\t, requestSha256: result.report.requestSha256\n\t\t, ...(result.analysis ? { analysisSha256: result.report.analysisSha256 }\n\t\t\t: result.component ? { componentReceiptSha256: result.report.componentReceiptSha256 }\n\t\t\t\t: { bundleManifestSha256: result.report.bundleManifestSha256 })\n\t}));\n} catch(error)\n{\n\tprocess.stderr.write(describeComponentEngineFailure(error) + encodeComponentEngineFailure(error));\n\tprocess.exitCode = 1;\n}\n"
        }
      ]
