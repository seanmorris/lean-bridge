              if-no-files-found: error
              retention-days: 30
          - name: Record native consumer observations
            if: always()
            shell: bash
            run: |
              test_result="${{ steps.consumer.outcome == 'success' && 'passed' || 'failed' }}"
              executed="${{ steps.consumer.outcome == 'success' && 'true' || 'false' }}"
              for consumer in ${{ matrix.consumers }}; do
                result="$test_result"
                installed="$executed"
                consumer_command="npm run test:consumer:native"
                if [ "$consumer" = c ] || [ "$consumer" = cpp ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_C_TEST=1 node --test tests/native-c-family.test.mjs tests/native-c-copied.test.mjs && npm run test:type-corpus:c-family && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=c,cpp node --test tests/type-corpus-reviewed-native.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_GRAPH_PACKAGE_TEST=1 node --test tests/native-graph-package.test.mjs"
                  consumer_command="$consumer_command && npm run test:native-fin"
                  consumer_command="$consumer_command && LEAN_BRIDGE_REVIEWED_FIN_REFUSALS=native-fin,fin-containers LEAN_BRIDGE_REVIEWED_FIN_REFUSAL_REPORT_DIR=build/reviewed-fin-refusals node --test --test-reporter=tap --test-concurrency=1 tests/reviewed-fin-refusals.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_FIN_CALLBACK_LEAN_TEST=1 LEAN_BRIDGE_FIN_CALLBACK_PROFILES=c,cpp LEAN_BRIDGE_NATIVE_FIN_REPLY_TEST=1 LEAN_BRIDGE_FIN_REPLY_PROFILES=c,cpp node --test --test-reporter=tap --test-concurrency=1 tests/native-fin-callbacks.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SPECIALIZATION_PROFILES=c,cpp node --test tests/native-specializations.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=c,cpp node --test tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=c,cpp node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_FIN_CONTAINER_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=c,cpp node --test tests/native-fin-containers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=c,cpp LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-c-cpp.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs c,cpp build/native-fin-container-edges/edges-c-cpp.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=c,cpp node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=c,cpp node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_RECORD_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=c,cpp node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=c,cpp LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/c-cpp.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-c-cpp.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs c,cpp build/native-fin-record-zero/c-cpp.json build/native-fin-record-zero/reviewed-c-cpp.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SUBTYPE_PROFILES=c,cpp node --test tests/native-subtype.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_CHECKED_RECORD_PROFILES=c,cpp node --test --test-concurrency=1 --test-name-pattern='C and C' tests/checked-records.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_C_CLOSURE_THREAD_TEST=1 node --test tests/closure-thread-contract.test.mjs tests/closure-thread-installed.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_RECURSIVE_CALLABLE_TEST=1 node --test tests/native-recursive-callable-compile.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-aggregate-native.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-native-values.test.mjs tests/owned-native-scalars.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-c-values.test.mjs"
                  consumer_command="$consumer_command && npm run test:owned-transfers"
                  consumer_command="$consumer_command && npm run test:owned-transfer-packages"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/reviewed-owned-source.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-c-packaging.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-host-callbacks.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-host-packaging.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-cpp-runtime.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-cpp-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-cpp-packaging.test.mjs"
                  consumer_command="$consumer_command && npm run test:owned-cpp-transfers"
                  consumer_command="$consumer_command && npm run test:owned-cpp-borrows"
                  consumer_command="$consumer_command && LEAN_BRIDGE_C_RECURSIVE_CALLABLE_TEST=1 node --test tests/c-recursive-callable-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_CPP_RECURSIVE_CALLABLE_TEST=1 node --test tests/cpp-recursive-callable-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_C_FAMILY_RECURSIVE_DOCUMENTATION_TEST=1 node --test tests/c-family-recursive-documentation.test.mjs"
                  if [ "${{ steps.ordinary_c.outcome }}" != success ] || [ "${{ steps.type_corpus_c_family.outcome }}" != success ]; then
                    result=failed
                    installed=false
                  fi
                fi
                if [ "$consumer" = c ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_C_CALLABLE_TEST=1 node --test tests/c-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_C_STRUCTURED_CALLABLE_TEST=1 node --test tests/c-structured-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_CPP_CALLABLE_TEST=1 node --test tests/cpp-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_CPP_STRUCTURED_CALLABLE_TEST=1 node --test tests/cpp-structured-callables.test.mjs"
                fi
                if [ "$consumer" = python ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_PYTHON_TEST=1 node --test tests/native-python.test.mjs && npm run test:type-corpus:python && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=python node --test tests/type-corpus-reviewed-native.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_CALLABLE_TEST=1 node --test tests/python-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_STRUCTURED_CALLABLE_TEST=1 node --test tests/python-structured-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_RECURSIVE_CALLABLE_TEST=1 node --test tests/python-recursive-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_COMPOUND_TEST=1 node --test tests/python-compounds.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_LIST_TEST=1 node --test tests/python-lists.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_ALIAS_TEST=1 node --test tests/python-aliases.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_FIN_TEST=1 node --test tests/python-fin.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SPECIALIZATION_PROFILES=python node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=python node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=python node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_GENERIC_RECORD_REPORT=build/generic-records/python312.json LEAN_BRIDGE_GENERIC_RECORD_SPECIALIZED_REPORT=build/generic-records/specialized-python312.json LEAN_BRIDGE_GENERIC_RECORD_PROFILES=python node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_GENERIC_RECORD_ARRAY_REPORT=build/generic-records/array-python312.json LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=python node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=python node --test tests/native-fin-containers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON='${{ steps.collection_python311.outputs.python-path }}' LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=python LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-python311.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs python build/native-fin-container-edges/edges-python311.json --python 3.11 && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=python LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-python312.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs python build/native-fin-container-edges/edges-python312.json --python 3.12 && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=python node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_FIN_PRODUCT_REPORT=build/native-fin-products/python312.json LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_REPORT=build/native-fin-products/reviewed-python312.json LEAN_BRIDGE_FIN_PRODUCT_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=python node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=python node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_FIN_PRODUCT_ARRAY_REPORT=build/native-fin-product-arrays/python312.json LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_REPORT=build/native-fin-product-arrays/reviewed-python312.json LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=python node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_RECORD_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=python node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_PYTHON='${{ steps.collection_python311.outputs.python-path }}' LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=python LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/python311.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-python311.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs python build/native-fin-record-zero/python311.json build/native-fin-record-zero/reviewed-python311.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_FIN_RECORD_REPORT=build/native-fin-records/python312.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_REPORT=build/native-fin-records/reviewed-python312.json LEAN_BRIDGE_FIN_RECORD_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=python node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_PYTHON='${{ steps.collection_python312.outputs.python-path }}' LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=python LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/python312.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-python312.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs python build/native-fin-record-zero/python312.json build/native-fin-record-zero/reviewed-python312.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SUBTYPE_PROFILES=python node --test tests/native-subtype.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_VARIANT_TEST=1 node --test tests/python-variants.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_COLLECTION_TEST=1 node --test tests/python-collections.test.mjs tests/python-collection-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_GRAPH_TEST=1 node --test tests/python-copied-graph-values.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_GRAPH_TEST=1 LEAN_BRIDGE_PYTHON_GRAPH_NATIVE_TEST=1 node --test tests/python-copied-graph-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_PYTHON_GRAPH_PACKAGE_TEST=1 node --test tests/python-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-python-runtime.test.mjs tests/owned-python-values.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-python-packaging.test.mjs tests/owned-python-scalar-packaging.test.mjs"
                  consumer_command="$consumer_command && npm run test:owned-python-transfers"
                  consumer_command="$consumer_command && npm run test:owned-python-borrows"
                  consumer_command="$consumer_command && npm run test:owned-python-receivers"
                  if [ "${{ steps.ordinary_python.outcome }}" != success ] || [ "${{ steps.type_corpus_python.outcome }}" != success ]; then
                    result=failed
                    installed=false
                  fi
                fi
                if [ "$consumer" = rust ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_RUST_TEST=1 node --test tests/native-rust.test.mjs && npm run test:type-corpus:rust && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=rust node --test tests/type-corpus-reviewed-native.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_CALLABLE_TEST=1 node --test tests/rust-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_STRUCTURED_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/rust-structured-callables.test.mjs tests/rust-structured-callable-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_RECURSIVE_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/rust-recursive-callables.test.mjs tests/rust-recursive-callable-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-rust-runtime.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-rust-values.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-rust-packaging.test.mjs"
                  consumer_command="$consumer_command && npm run test:owned-rust-transfers"
                  consumer_command="$consumer_command && npm run test:owned-rust-borrows"
                  consumer_command="$consumer_command && npm run test:owned-rust-receivers"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_COMPOUND_TEST=1 node --test tests/rust-compounds.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_LIST_TEST=1 node --test tests/rust-lists.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_ALIAS_TEST=1 node --test tests/rust-aliases.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_FIN_TEST=1 node --test tests/rust-fin.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SPECIALIZATION_PROFILES=rust node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=rust node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=rust node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_PROFILES=rust LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=rust node --test tests/native-fin-containers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=rust LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-rust.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs rust build/native-fin-container-edges/edges-rust.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=rust LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=rust node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=rust LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=rust node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_RECORD_PROFILES=rust LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=rust node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=rust LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=rust LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/rust.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-rust.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs rust build/native-fin-record-zero/rust.json build/native-fin-record-zero/reviewed-rust.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SUBTYPE_PROFILES=rust node --test tests/native-subtype.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_VARIANT_TEST=1 node --test tests/rust-variants.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_CONVERSION_TEST=1 node --test tests/rust-collection-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_GRAPH_TEST=1 node --test tests/rust-copied-graph-values.test.mjs tests/rust-copied-graph-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_GRAPH_NATIVE_TEST=1 node --test --test-name-pattern='ordinary and reviewed Lean graphs' tests/rust-copied-graph-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_GRAPH_TEST=1 LEAN_BRIDGE_RUST_GRAPH_PACKAGE_TEST=1 node --test tests/rust-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUST_COLLECTION_TEST=1 node --test tests/rust-collections.test.mjs"
                  if [ "${{ steps.ordinary_rust.outcome }}" != success ] || [ "${{ steps.type_corpus_rust.outcome }}" != success ]; then
                    result=failed
                    installed=false
                  fi
                fi
                node scripts/consumer-ci.mjs record --consumer "$consumer" --output "build/consumer-ci/results/native-${{ matrix.profile }}/$consumer.json" --performance "build/consumer-ci/performance/$consumer.json" --test-result "$result" --package-installation "$installed" --real-lean-execution "$installed" --command "$consumer_command"
              done
          - name: Upload native consumer observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-native-${{ matrix.profile }}-${{ github.sha }}
              path: build/consumer-ci/results/native-${{ matrix.profile }}/*.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce native consumer support
            if: always() && (steps.consumer.outcome != 'success' || (matrix.profile == 'c-family' && (steps.ordinary_c.outcome != 'success' || steps.type_corpus_c_family.outcome != 'success')) || (matrix.profile == 'python' && (steps.ordinary_python.outcome != 'success' || steps.type_corpus_python.outcome != 'success')) || (matrix.profile == 'rust' && (steps.ordinary_rust.outcome != 'success' || steps.type_corpus_rust.outcome != 'success')))
            run: exit 1
    
      managed-consumers:
        name: Managed consumer (${{ matrix.profile }})
        runs-on: ubuntu-24.04
        timeout-minutes: 240
        strategy:
          fail-fast: false
          matrix:
            profile: [dotnet, jvm, ruby]
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Restore packages and execute real Lean
            id: consumer
            continue-on-error: true
            run: npm run test:consumer:managed
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Prepare the pinned native compiler
            timeout-minutes: 20
            run: |
              sudo apt-get update && sudo apt-get install -y build-essential zstd m4
          - name: Prepare the pinned native compiler
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
          - name: Install the TAP log verifier
            timeout-minutes: 20
            run: sudo apt-get install -y ripgrep
          - name: Install the ordinary C# compiler
            if: matrix.profile == 'dotnet'
            uses: actions/setup-dotnet@v6
            with:
              dotnet-version: '8.0.424'
          - name: Install Ruby for the combined NuGet transfer build
            if: matrix.profile == 'dotnet'
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Compile ordinary Lean APIs and install relocated NuGet releases
            if: matrix.profile == 'dotnet'
            id: ordinary_dotnet
            continue-on-error: true
            env:
              LEAN_BRIDGE_NATIVE_DOTNET_TEST: "1"
            run: |
              source scripts/env.sh
              node --test tests/native-dotnet.test.mjs
          - name: Install dependencies for type_corpus_dotnet
            timeout-minutes: 20
            if: matrix.profile == 'dotnet'
            run: |
              sudo apt-get install -y python3-venv pkg-config gdb
              # Installed .NET Fin entry counters run the probe as GDB's own child; record the debugger and ptrace policy.
              test -x /usr/bin/gdb
              /usr/bin/gdb --version
              cat /proc/sys/kernel/yama/ptrace_scope
          - name: Compare installed NuGet corpus packages with fresh Lean results
            if: matrix.profile == 'dotnet'
            id: type_corpus_dotnet
            continue-on-error: true
            run: |
              bash scripts/bootstrap-rust-ci.sh
              export LEAN_BRIDGE_RUSTC="$PWD/.toolchains/rust-1.90.0/bin/rustc"
              export LEAN_BRIDGE_CARGO="$PWD/.toolchains/rust-1.90.0/bin/cargo"
              export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
              export LEAN_BRIDGE_PYTHON="$(command -v python3)"
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              export LEAN_BRIDGE_DOTNET="$(command -v dotnet)"
              source scripts/env.sh
              npm run test:type-corpus:dotnet && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=dotnet node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_CHAR_PROFILES=dotnet node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=dotnet node --test tests/native-words.test.mjs
              LEAN_BRIDGE_DOTNET_CALLABLE_TEST=1 node --test tests/dotnet-callables.test.mjs tests/dotnet-callable-contract.test.mjs
              LEAN_BRIDGE_DOTNET_STRUCTURED_CALLABLE_TEST=1 node --test tests/dotnet-structured-callables.test.mjs
              test -s build/structured-callables/dotnet.json
              LEAN_BRIDGE_DOTNET_RECURSIVE_CALLABLE_TEST=1 node --test tests/dotnet-recursive-callables.test.mjs
              test -s build/recursive-callables/dotnet.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-dotnet-runtime.test.mjs tests/owned-dotnet-layout.test.mjs tests/owned-dotnet-values.test.mjs tests/owned-dotnet-conversions.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-dotnet-callables.test.mjs tests/owned-dotnet-callback-signatures.test.mjs tests/owned-dotnet-package.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-dotnet-packaging.test.mjs tests/owned-dotnet-coexistence.test.mjs
              test -s build/owned-dotnet-packaging/compositions-ordinary.json
              test -s build/owned-dotnet-packaging/compositions-reviewed.json
              test -s build/owned-dotnet-packaging/scalars-ordinary.json
              test -s build/owned-dotnet-packaging/scalars-reviewed.json
              test -s build/owned-dotnet-packaging/coexistence.json
              npm run test:owned-dotnet-transfers
              npm run test:owned-dotnet-borrows > build/owned-dotnet-borrows.log 2>&1
              cat build/owned-dotnet-borrows.log
              rg '^# pass 7$' build/owned-dotnet-borrows.log
              rg '^# fail 0$' build/owned-dotnet-borrows.log
              rg '^# skipped 0$' build/owned-dotnet-borrows.log
              test -s build/owned-dotnet-borrows/ordinary.json
              test -s build/owned-dotnet-borrows/reviewed.json
              test -s build/owned-dotnet-borrows/borrow-only.json
              test -s build/owned-dotnet-borrow-packaging/ordinary.json
              test -s build/owned-dotnet-borrow-packaging/reviewed.json
              npm run test:owned-dotnet-receivers > build/owned-dotnet-receivers.log 2>&1
              cat build/owned-dotnet-receivers.log
              rg '^# tests 10$' build/owned-dotnet-receivers.log
              rg '^# pass 10$' build/owned-dotnet-receivers.log
              rg '^# fail 0$' build/owned-dotnet-receivers.log
              rg '^# cancelled 0$' build/owned-dotnet-receivers.log
              rg '^# skipped 0$' build/owned-dotnet-receivers.log
              test -s build/owned-dotnet-receivers/ordinary.json
              test -s build/owned-dotnet-receivers/ordinary-package.json
              test -s build/owned-dotnet-receivers/ordinary-plain.json
              test -s build/owned-dotnet-receivers/ordinary-consuming.json
              test -s build/owned-dotnet-receivers/reviewed.json
              test -s build/owned-dotnet-receivers/reviewed-package.json
              test -s build/owned-dotnet-receivers/reviewed-plain.json
              test -s build/owned-dotnet-receivers/reviewed-consuming.json
              test -s build/owned-dotnet-transfers/ordinary.json
              test -s build/owned-dotnet-transfers/reviewed.json
              test -s build/owned-dotnet-transfer-packaging/ordinary.json
              test -s build/owned-dotnet-transfer-packaging/reviewed.json
              LEAN_BRIDGE_DOTNET_COMPOUND_TEST=1 node --test tests/dotnet-compounds.test.mjs tests/dotnet-compound-contract.test.mjs
              test -s build/compounds/dotnet.json
              LEAN_BRIDGE_DOTNET_LIST_TEST=1 node --test tests/dotnet-lists.test.mjs tests/dotnet-list-contract.test.mjs
              test -s build/lists/dotnet.json
              LEAN_BRIDGE_DOTNET_ALIAS_TEST=1 node --test tests/dotnet-aliases.test.mjs
              test -s build/aliases/dotnet.json
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_DOTNET_FIN_TEST=1 node --test tests/dotnet-fin.test.mjs
              test -s build/native-fin/dotnet.json
              test -s build/native-fin/dotnet-reviewed.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=dotnet node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/dotnet.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=dotnet node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/dotnet.json
              test -s build/generic-records/specialized-dotnet.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=dotnet node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-dotnet.json
              LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=dotnet node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/dotnet.json
              test -s build/native-fin-containers/reviewed-dotnet.json
              node scripts/check-fin-container-entry-reports.mjs dotnet build/native-fin-containers/dotnet.json build/native-fin-containers/reviewed-dotnet.json
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=dotnet LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-dotnet.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs
              test -s build/native-fin-container-edges/edges-dotnet.json
              node scripts/check-fin-container-foreign-report.mjs dotnet build/native-fin-container-edges/edges-dotnet.json
              LEAN_BRIDGE_FIN_PRODUCT_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=dotnet node --test tests/native-fin-products.test.mjs
              test -s build/native-fin-products/dotnet.json
              test -s build/native-fin-products/reviewed-dotnet.json
              LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=dotnet node --test tests/native-fin-product-arrays.test.mjs
              test -s build/native-fin-product-arrays/dotnet.json
              test -s build/native-fin-product-arrays/reviewed-dotnet.json
              LEAN_BRIDGE_FIN_RECORD_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=dotnet node --test tests/native-fin-records.test.mjs
              test -s build/native-fin-records/dotnet.json
              test -s build/native-fin-records/reviewed-dotnet.json
              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=dotnet LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/dotnet.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-dotnet.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/dotnet.json
              test -s build/native-fin-record-zero/reviewed-dotnet.json
              node scripts/check-fin-record-zero-report.mjs dotnet build/native-fin-record-zero/dotnet.json build/native-fin-record-zero/reviewed-dotnet.json
              LEAN_BRIDGE_SUBTYPE_PROFILES=dotnet node --test tests/native-subtype.test.mjs
              test -s build/native-subtype/dotnet.json
              LEAN_BRIDGE_DOTNET_VARIANT_TEST=1 node --test tests/dotnet-variants.test.mjs
              test -s build/variants/dotnet.json
              LEAN_BRIDGE_DOTNET_CONVERSION_TEST=1 node --test tests/dotnet-collection-conversions.test.mjs
              test -s build/collections/dotnet-conversions.json
              LEAN_BRIDGE_DOTNET_COLLECTION_TEST=1 node --test tests/dotnet-collections.test.mjs
              test -s build/collections/dotnet.json
              LEAN_BRIDGE_DOTNET_EQUALITY_TEST=1 node --test tests/dotnet-value-equality.test.mjs
              test -s build/equality/dotnet.json
              LEAN_BRIDGE_DOTNET_GRAPH_TEST=1 node --test tests/dotnet-copied-graph-values.test.mjs
              test -s build/recursive/dotnet-values.json
              LEAN_BRIDGE_DOTNET_GRAPH_CONVERSION_TEST=1 LEAN_BRIDGE_DOTNET_GRAPH_NATIVE_TEST=1 node --test tests/dotnet-copied-graph-conversions.test.mjs
              test -s build/recursive/dotnet-conversions.json
              test -s build/recursive/dotnet-native.json
              LEAN_BRIDGE_DOTNET_GRAPH_PACKAGE_TEST=1 LEAN_BRIDGE_DOTNET_GRAPH_INSTALLED_TEST=1 node --test tests/dotnet-graph-package.test.mjs
              test -s build/recursive/dotnet-packages.json
              LEAN_BRIDGE_DOTNET_GRAPH_COMPOSITION_TEST=1 node --test tests/dotnet-graph-package.test.mjs
              test -s build/recursive/dotnet-composition.json
              LEAN_BRIDGE_DOTNET_GRAPH_REPRODUCIBILITY_TEST=1 node --test tests/dotnet-graph-package.test.mjs
              test -s build/recursive/dotnet-reproducibility.json
              LEAN_BRIDGE_DOTNET_GRAPH_CONFLICT_TEST=1 node --test tests/dotnet-graph-package.test.mjs
              test -s build/recursive/dotnet-conflicts.json
              test -s build/type-corpus/dotnet.json
              test -s build/type-corpus/reviewed-native-dotnet.json
          - name: Upload the .NET real-Lean type corpus report
            if: always() && matrix.profile == 'dotnet'
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-dotnet-${{ github.sha }}
              path: |
                build/type-corpus/dotnet.json
                build/type-corpus/reviewed-native-dotnet.json
                build/char-native/dotnet.json
                build/word-native/dotnet.json
                build/callables/dotnet.json
                build/structured-callables/dotnet.json
                build/recursive-callables/dotnet.json
                build/compounds/dotnet.json
                build/lists/dotnet.json
                build/aliases/dotnet.json
                build/native-fin/dotnet.json
                build/native-fin/dotnet-reviewed.json
                build/native-specializations/dotnet.json
                build/generic-records/dotnet.json
                build/generic-records/specialized-dotnet.json
                build/generic-records/array-dotnet.json
                build/native-fin-containers/dotnet.json
                build/native-fin-containers/reviewed-dotnet.json
                build/native-fin-container-edges/edges-dotnet.json
                build/native-fin-products/dotnet.json
                build/native-fin-products/reviewed-dotnet.json
                build/native-fin-product-arrays/dotnet.json
                build/native-fin-product-arrays/reviewed-dotnet.json
                build/native-fin-records/dotnet.json
                build/native-fin-records/reviewed-dotnet.json
                build/native-fin-record-zero/dotnet.json
                build/native-fin-record-zero/reviewed-dotnet.json
                build/native-subtype/dotnet.json
                build/variants/dotnet.json
                build/collections/dotnet-conversions.json
                build/collections/dotnet.json
                build/equality/dotnet.json
                build/recursive/dotnet-values.json
                build/recursive/dotnet-conversions.json
                build/recursive/dotnet-native.json
                build/recursive/dotnet-packages.json
                build/recursive/dotnet-composition.json
                build/recursive/dotnet-reproducibility.json
                build/recursive/dotnet-conflicts.json
                build/owned-dotnet-runtime/
                build/owned-dotnet-layout/
                build/owned-dotnet-values/
                build/owned-dotnet-conversions/
                build/owned-dotnet-callables/
                build/owned-dotnet-callback-signatures/
                build/owned-dotnet-loading/
                build/owned-dotnet-packaging/
                build/owned-dotnet-transfers/
                build/owned-dotnet-transfer-packaging/
                build/owned-dotnet-borrows/
                build/owned-dotnet-borrow-packaging/
                build/owned-dotnet-borrows.log
                build/owned-dotnet-receivers/
                build/owned-dotnet-receivers.log
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Install C# for the combined Maven receiver build
            if: matrix.profile == 'jvm'
            uses: actions/setup-dotnet@v6
            with:
              dotnet-version: '8.0.424'
          - name: Install Ruby for the combined Maven receiver build
            if: matrix.profile == 'jvm'
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Install the ordinary Java compiler
            if: matrix.profile == 'jvm'
            uses: actions/setup-java@v4
            with:
              distribution: temurin
              java-version: '22.0.2'
          - name: Install dependencies for ordinary_jvm
            timeout-minutes: 20
            if: matrix.profile == 'jvm'
            run: |
              sudo apt-get install -y maven unzip
          - name: Compile ordinary Lean APIs and install Maven packages in Java and Kotlin
            if: matrix.profile == 'jvm'
            id: ordinary_jvm
            continue-on-error: true
            env:
              LEAN_BRIDGE_NATIVE_JVM_TEST: "1"
            run: |
              mkdir -p build
              curl -fL --retry 3 --output build/kotlin-compiler.zip https://github.com/JetBrains/kotlin/releases/download/v2.2.0/kotlin-compiler-2.2.0.zip
              echo '1adb6f1a5845ba0aa5a59e412e44c8e405236b957de1a9683619f1dca3b16932  build/kotlin-compiler.zip' | sha256sum --check
              unzip -q build/kotlin-compiler.zip -d build/kotlin-tools
              export LEAN_BRIDGE_JAVAC="$JAVA_HOME/bin/javac"
              export LEAN_BRIDGE_JAVA="$JAVA_HOME/bin/java"
              export LEAN_BRIDGE_KOTLINC="$PWD/build/kotlin-tools/kotlinc/bin/kotlinc"
              export LEAN_BRIDGE_KOTLIN="$PWD/build/kotlin-tools/kotlinc/bin/kotlin"
              source scripts/env.sh
              node --test tests/native-jvm.test.mjs
          - name: Install dependencies for type_corpus_jvm
            timeout-minutes: 20
            if: matrix.profile == 'jvm'
            run: |
              sudo apt-get install -y python3-venv pkg-config gdb
              # Installed JVM Fin entry counters run each probe as GDB's own child; record the debugger and ptrace policy.
              test -x /usr/bin/gdb
              /usr/bin/gdb --version
              cat /proc/sys/kernel/yama/ptrace_scope
          - name: Compare isolated Java and Kotlin corpus consumers with fresh Lean
            if: matrix.profile == 'jvm'
            id: type_corpus_jvm
            continue-on-error: true
            run: |
              bash scripts/bootstrap-rust-ci.sh
              export LEAN_BRIDGE_RUSTC="$PWD/.toolchains/rust-1.90.0/bin/rustc"
              export LEAN_BRIDGE_CARGO="$PWD/.toolchains/rust-1.90.0/bin/cargo"
              export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
              export LEAN_BRIDGE_PYTHON="$(command -v python3)"
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              export LEAN_BRIDGE_DOTNET="$(command -v dotnet)"
              export LEAN_BRIDGE_JAVAC="$JAVA_HOME/bin/javac"
              export LEAN_BRIDGE_JAVA="$JAVA_HOME/bin/java"
              export LEAN_BRIDGE_MAVEN="$(command -v mvn)"
              export LEAN_BRIDGE_KOTLINC="$PWD/build/kotlin-tools/kotlinc/bin/kotlinc"
              source scripts/env.sh
              npm run test:type-corpus:jvm && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=java,kotlin node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_CHAR_PROFILES=java,kotlin node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=java,kotlin node --test tests/native-words.test.mjs
              LEAN_BRIDGE_JVM_CALLABLE_TEST=1 node --test tests/jvm-callables.test.mjs tests/jvm-callable-contract.test.mjs
              LEAN_BRIDGE_JVM_STRUCTURED_CALLABLE_TEST=1 node --test tests/jvm-structured-callables.test.mjs
              test -s build/structured-callables/jvm.json
              LEAN_BRIDGE_JVM_RECURSIVE_CALLABLE_TEST=1 node --test tests/jvm-recursive-callables.test.mjs
              test -s build/recursive-callables/jvm-recursive.json
              test -s build/recursive-callables/jvm-mixed.json
              LEAN_BRIDGE_JVM_COMPOUND_TEST=1 node --test tests/jvm-compounds.test.mjs tests/jvm-compound-contract.test.mjs
              test -s build/compounds/jvm.json
              LEAN_BRIDGE_JVM_LIST_TEST=1 node --test tests/jvm-lists.test.mjs tests/jvm-list-contract.test.mjs
              test -s build/lists/jvm.json
              LEAN_BRIDGE_JVM_ALIAS_TEST=1 node --test tests/jvm-aliases.test.mjs
              test -s build/aliases/jvm.json
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_JVM_FIN_TEST=1 node --test tests/jvm-fin.test.mjs
              test -s build/native-fin/jvm.json
              test -s build/native-fin/jvm-reviewed.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=java,kotlin node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/java-kotlin.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=java,kotlin node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/java-kotlin.json
              test -s build/generic-records/specialized-java-kotlin.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=java,kotlin node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-java-kotlin.json
              LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=java,kotlin node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/java-kotlin.json
              test -s build/native-fin-containers/reviewed-java-kotlin.json
              node scripts/check-fin-container-entry-reports.mjs java,kotlin build/native-fin-containers/java-kotlin.json build/native-fin-containers/reviewed-java-kotlin.json
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=java,kotlin LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-java-kotlin.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs
              test -s build/native-fin-container-edges/edges-java-kotlin.json
              node scripts/check-fin-container-foreign-report.mjs java,kotlin build/native-fin-container-edges/edges-java-kotlin.json
              LEAN_BRIDGE_FIN_PRODUCT_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=java,kotlin node --test tests/native-fin-products.test.mjs
              test -s build/native-fin-products/java-kotlin.json
              test -s build/native-fin-products/reviewed-java-kotlin.json
              LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=java,kotlin node --test tests/native-fin-product-arrays.test.mjs
              test -s build/native-fin-product-arrays/java-kotlin.json
              test -s build/native-fin-product-arrays/reviewed-java-kotlin.json
              LEAN_BRIDGE_FIN_RECORD_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=java,kotlin node --test tests/native-fin-records.test.mjs
              test -s build/native-fin-records/java-kotlin.json
              test -s build/native-fin-records/reviewed-java-kotlin.json
              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=java,kotlin LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/java-kotlin.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-java-kotlin.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/java-kotlin.json
              test -s build/native-fin-record-zero/reviewed-java-kotlin.json
              node scripts/check-fin-record-zero-report.mjs java,kotlin build/native-fin-record-zero/java-kotlin.json build/native-fin-record-zero/reviewed-java-kotlin.json
              LEAN_BRIDGE_SUBTYPE_PROFILES=java,kotlin node --test tests/native-subtype.test.mjs
              test -s build/native-subtype/java-kotlin.json
              LEAN_BRIDGE_JVM_VARIANT_TEST=1 node --test tests/jvm-variants.test.mjs
              test -s build/variants/jvm.json
              LEAN_BRIDGE_JVM_EQUALITY_TEST=1 node --test tests/jvm-value-equality.test.mjs
              test -s build/equality/jvm.json
              LEAN_BRIDGE_JVM_GRAPH_TEST=1 node --test tests/jvm-copied-graph-values.test.mjs
              test -s build/recursive/jvm-values.json
              LEAN_BRIDGE_JVM_GRAPH_CONVERSION_TEST=1 LEAN_BRIDGE_JVM_GRAPH_NATIVE_TEST=1 node --test tests/jvm-copied-graph-conversions.test.mjs
              test -s build/recursive/jvm-conversions.json
              test -s build/recursive/jvm-native.json
              LEAN_BRIDGE_KOTLIN_GRAPH_TEST=1 node --test tests/jvm-copied-graph-kotlin.test.mjs
              LEAN_BRIDGE_JVM_GRAPH_PACKAGE_TEST=1 LEAN_BRIDGE_JVM_GRAPH_INSTALLED_TEST=1 node --test tests/jvm-graph-package.test.mjs
              test -s build/recursive/kotlin-values.json
              test -s build/recursive/jvm-package-cold.json
              test -s build/recursive/jvm-packages.json
              LEAN_BRIDGE_JVM_GRAPH_REPRO_TEST=1 LEAN_BRIDGE_JVM_GRAPH_LOADING_TEST=1 node --test tests/jvm-graph-package.test.mjs
              test -s build/recursive/jvm-reproducibility.json
              test -s build/recursive/jvm-composition.json
              test -s build/recursive/jvm-conflicts.json
              LEAN_BRIDGE_JVM_CONVERSIONS_TEST=1 node --test tests/jvm-collection-conversions.test.mjs
              test -s build/collections/jvm-conversions.json
              LEAN_BRIDGE_JVM_COLLECTION_PREFLIGHT=1 LEAN_BRIDGE_JVM_COLLECTION_PROFILES=java,kotlin node --test tests/jvm-collection-callers.test.mjs
              LEAN_BRIDGE_JVM_COLLECTION_TEST=1 LEAN_BRIDGE_JVM_COLLECTION_PROFILES=java,kotlin node --test tests/jvm-collections.test.mjs
              test -s build/collections/jvm.json
              test -s build/type-corpus/java-kotlin.json
              test -s build/type-corpus/reviewed-native-java-kotlin.json
          - name: Upload installed Java and Kotlin corpus observations
            if: always() && matrix.profile == 'jvm'
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-jvm-${{ github.sha }}
              path: |
                build/type-corpus/java-kotlin.json
                build/type-corpus/reviewed-native-java-kotlin.json
                build/char-native/java-kotlin.json
                build/word-native/java-kotlin.json
                build/callables/jvm.json
                build/structured-callables/jvm.json
                build/recursive-callables/jvm-recursive.json
                build/recursive-callables/jvm-mixed.json
                build/compounds/jvm.json
                build/lists/jvm.json
                build/aliases/jvm.json
                build/native-fin/jvm.json
                build/native-fin/jvm-reviewed.json
                build/native-specializations/java-kotlin.json
                build/generic-records/java-kotlin.json
                build/generic-records/specialized-java-kotlin.json
                build/generic-records/array-java-kotlin.json
                build/native-fin-containers/java-kotlin.json
                build/native-fin-containers/reviewed-java-kotlin.json
                build/native-fin-container-edges/edges-java-kotlin.json
                build/native-fin-products/java-kotlin.json
                build/native-fin-products/reviewed-java-kotlin.json
                build/native-fin-product-arrays/java-kotlin.json
                build/native-fin-product-arrays/reviewed-java-kotlin.json
                build/native-fin-records/java-kotlin.json
                build/native-fin-records/reviewed-java-kotlin.json
                build/native-fin-record-zero/java-kotlin.json
                build/native-fin-record-zero/reviewed-java-kotlin.json
                build/native-subtype/java-kotlin.json
                build/variants/jvm.json
                build/equality/jvm.json
                build/recursive/jvm-values.json
                build/recursive/jvm-conversions.json
                build/recursive/jvm-native.json
                build/recursive/kotlin-values.json
                build/recursive/jvm-package-cold.json
                build/recursive/jvm-packages.json
                build/recursive/jvm-reproducibility.json
                build/recursive/jvm-composition.json
                build/recursive/jvm-conflicts.json
                build/collections/jvm-conversions.json
                build/collections/jvm.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Install the ordinary Ruby runtime
            if: matrix.profile == 'ruby'
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Build ordinary Lean APIs and install relocated RubyGems releases
            if: matrix.profile == 'ruby'
            id: ordinary_ruby
            env:
              LEAN_BRIDGE_NATIVE_RUBY_TEST: "1"
            run: |
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              source scripts/env.sh
              node --test tests/native-ruby.test.mjs
          - name: Install dependencies for type_corpus_ruby
            timeout-minutes: 20
            if: matrix.profile == 'ruby'
            run: |
              sudo apt-get install -y python3-venv pkg-config gdb
              # Installed Ruby Fin entry counters run the probe as GDB's own child; record the debugger and ptrace policy.
              test -x /usr/bin/gdb
              /usr/bin/gdb --version
              cat /proc/sys/kernel/yama/ptrace_scope
          - name: Compare installed Ruby corpus packages with fresh Lean results
            if: matrix.profile == 'ruby'
            id: type_corpus_ruby
            continue-on-error: true
            run: |
              bash scripts/bootstrap-rust-ci.sh
              export LEAN_BRIDGE_RUSTC="$PWD/.toolchains/rust-1.90.0/bin/rustc"
              export LEAN_BRIDGE_CARGO="$PWD/.toolchains/rust-1.90.0/bin/cargo"
              export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
              export LEAN_BRIDGE_PYTHON="$(command -v python3)"
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              source scripts/env.sh
              npm run test:type-corpus:ruby && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=ruby node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_CHAR_PROFILES=ruby node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=ruby node --test tests/native-words.test.mjs
              LEAN_BRIDGE_RUBY_CALLABLE_TEST=1 node --test tests/ruby-callables.test.mjs
              LEAN_BRIDGE_RUBY_STRUCTURED_CALLABLE_TEST=1 node --test tests/ruby-structured-callables.test.mjs
              LEAN_BRIDGE_RUBY_RECURSIVE_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/ruby-recursive-callables.test.mjs tests/ruby-recursive-callable-contract.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-ruby-runtime.test.mjs tests/owned-ruby-values.test.mjs tests/owned-ruby-layout.test.mjs tests/owned-ruby-conversions.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-ruby-gmp.test.mjs tests/owned-ruby-package.test.mjs tests/owned-ruby-packaging.test.mjs tests/owned-ruby-coexistence.test.mjs
              test -s build/owned-ruby-packaging/ordinary.json
              test -s build/owned-ruby-packaging/reviewed.json
              test -s build/owned-ruby-packaging/scalars-ordinary.json
              test -s build/owned-ruby-packaging/scalars-reviewed.json
              test -s build/owned-ruby-packaging/coexistence.json
              npm run test:owned-ruby-transfers
              test -s build/owned-ruby-transfers/ordinary.json
              test -s build/owned-ruby-transfers/reviewed.json
              test -s build/owned-ruby-transfer-packaging/ordinary.json
              test -s build/owned-ruby-transfer-packaging/reviewed.json
              npm run test:owned-ruby-borrows > build/owned-ruby-borrows.log 2>&1
              cat build/owned-ruby-borrows.log
              rg '^# pass 7$' build/owned-ruby-borrows.log
              rg '^# fail 0$' build/owned-ruby-borrows.log
              rg '^# skipped 0$' build/owned-ruby-borrows.log
              test -s build/owned-ruby-borrows/ordinary.json
              test -s build/owned-ruby-borrows/reviewed.json
              test -s build/owned-ruby-borrows/borrow-only.json
              test -s build/owned-ruby-borrow-packaging/ordinary.json
              test -s build/owned-ruby-borrow-packaging/reviewed.json
              npm run test:owned-ruby-receivers > build/owned-ruby-receivers.log 2>&1
              cat build/owned-ruby-receivers.log
              rg '^# tests 10$' build/owned-ruby-receivers.log
              rg '^# pass 10$' build/owned-ruby-receivers.log
              rg '^# fail 0$' build/owned-ruby-receivers.log
              rg '^# cancelled 0$' build/owned-ruby-receivers.log
              rg '^# skipped 0$' build/owned-ruby-receivers.log
              test -s build/owned-ruby-receivers/ordinary.json
              test -s build/owned-ruby-receivers/ordinary-package.json
              test -s build/owned-ruby-receivers/ordinary-plain.json
              test -s build/owned-ruby-receivers/ordinary-consuming.json
              test -s build/owned-ruby-receivers/reviewed.json
              test -s build/owned-ruby-receivers/reviewed-package.json
              test -s build/owned-ruby-receivers/reviewed-plain.json
              test -s build/owned-ruby-receivers/reviewed-consuming.json
              LEAN_BRIDGE_RUBY_COMPOUND_TEST=1 node --test tests/ruby-compounds.test.mjs tests/ruby-compound-contract.test.mjs
              LEAN_BRIDGE_RUBY_LIST_TEST=1 node --test tests/ruby-lists.test.mjs tests/ruby-list-contract.test.mjs
              LEAN_BRIDGE_RUBY_ALIAS_TEST=1 node --test tests/ruby-aliases.test.mjs
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_RUBY_FIN_TEST=1 node --test tests/ruby-fin.test.mjs
              LEAN_BRIDGE_RUBY_VARIANT_TEST=1 node --test tests/ruby-variants.test.mjs
              LEAN_BRIDGE_RUBY_COLLECTION_TEST=1 node --test tests/ruby-collections.test.mjs tests/ruby-collection-contract.test.mjs
              LEAN_BRIDGE_RUBY_GRAPH_TEST=1 node --test tests/ruby-copied-graph-values.test.mjs
              test -s build/recursive/ruby-values.json
              LEAN_BRIDGE_RUBY_GRAPH_TEST=1 LEAN_BRIDGE_RUBY_GRAPH_NATIVE_TEST=1 node --test tests/ruby-copied-graph-conversions.test.mjs
              test -s build/recursive/ruby-conversions.json
              test -s build/recursive/ruby-native.json
              LEAN_BRIDGE_RUBY_GRAPH_PACKAGE_TEST=1 node --test tests/ruby-graph-package.test.mjs
              test -s build/recursive/ruby-packages.json
              test -s build/callables/ruby.json
              test -s build/structured-callables/ruby.json
              test -s build/recursive-callables/ruby.json
              test -s build/compounds/ruby.json
              test -s build/lists/ruby.json
              test -s build/aliases/ruby.json
              test -s build/native-fin/ruby.json
              test -s build/native-fin/ruby-reviewed.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=ruby node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/ruby.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=ruby node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/ruby.json
              test -s build/generic-records/specialized-ruby.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=ruby node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-ruby.json
              LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=ruby node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/ruby.json
              test -s build/native-fin-containers/reviewed-ruby.json
              node scripts/check-fin-container-entry-reports.mjs ruby build/native-fin-containers/ruby.json build/native-fin-containers/reviewed-ruby.json
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=ruby LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-ruby.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs
              test -s build/native-fin-container-edges/edges-ruby.json
              node scripts/check-fin-container-foreign-report.mjs ruby build/native-fin-container-edges/edges-ruby.json
              LEAN_BRIDGE_FIN_PRODUCT_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=ruby node --test tests/native-fin-products.test.mjs
              test -s build/native-fin-products/ruby.json
              test -s build/native-fin-products/reviewed-ruby.json
              LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=ruby node --test tests/native-fin-product-arrays.test.mjs
              test -s build/native-fin-product-arrays/ruby.json
              test -s build/native-fin-product-arrays/reviewed-ruby.json
              LEAN_BRIDGE_FIN_RECORD_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=ruby node --test tests/native-fin-records.test.mjs
              test -s build/native-fin-records/ruby.json
              test -s build/native-fin-records/reviewed-ruby.json
              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=ruby LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/ruby.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-ruby.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/ruby.json
              test -s build/native-fin-record-zero/reviewed-ruby.json
              node scripts/check-fin-record-zero-report.mjs ruby build/native-fin-record-zero/ruby.json build/native-fin-record-zero/reviewed-ruby.json
              LEAN_BRIDGE_SUBTYPE_PROFILES=ruby node --test tests/native-subtype.test.mjs
              test -s build/native-subtype/ruby.json
              test -s build/variants/ruby.json
              test -s build/collections/ruby.json
              test -s build/type-corpus/ruby.json
              test -s build/type-corpus/reviewed-native-ruby.json
          - name: Upload the Ruby real-Lean type corpus report
            if: always() && matrix.profile == 'ruby'
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-ruby-${{ github.sha }}
              path: |
                build/type-corpus/ruby.json
                build/type-corpus/reviewed-native-ruby.json
                build/char-native/ruby.json
                build/word-native/ruby.json
                build/callables/ruby.json
                build/structured-callables/ruby.json
                build/recursive-callables/ruby.json
                build/compounds/ruby.json
                build/lists/ruby.json
                build/aliases/ruby.json
                build/native-fin/ruby.json
                build/native-fin/ruby-reviewed.json
                build/native-specializations/ruby.json
                build/generic-records/ruby.json
                build/generic-records/specialized-ruby.json
                build/generic-records/array-ruby.json
                build/native-fin-containers/ruby.json
                build/native-fin-containers/reviewed-ruby.json
                build/native-fin-container-edges/edges-ruby.json
                build/native-fin-products/ruby.json
                build/native-fin-products/reviewed-ruby.json
                build/native-fin-product-arrays/ruby.json
                build/native-fin-product-arrays/reviewed-ruby.json
                build/native-fin-records/ruby.json
                build/native-fin-records/reviewed-ruby.json
                build/native-fin-record-zero/ruby.json
                build/native-fin-record-zero/reviewed-ruby.json
                build/native-subtype/ruby.json
                build/variants/ruby.json
                build/collections/ruby.json
                build/recursive/ruby-values.json
                build/recursive/ruby-conversions.json
                build/recursive/ruby-native.json
                build/recursive/ruby-packages.json
                build/owned-ruby-runtime/
                build/owned-ruby-values/
                build/owned-ruby-layout/
                build/owned-ruby-conversions/
                build/owned-ruby-gmp/
                build/owned-ruby-loading/
                build/owned-ruby-transfers/
                build/owned-ruby-transfer-packaging/
                build/owned-ruby-borrows/
                build/owned-ruby-borrow-packaging/
                build/owned-ruby-borrows.log
                build/owned-ruby-receivers/
                build/owned-ruby-receivers.log
                build/owned-ruby-packaging/
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Record managed consumer observations
            if: always()
            shell: bash
            run: |
              for consumer in ${{ matrix.profile }}; do
                consumer_command="npm run test:consumer:managed"
                test_result="${{ steps.consumer.outcome == 'success' && 'passed' || 'failed' }}"
                executed="${{ steps.consumer.outcome == 'success' && 'true' || 'false' }}"
                if [ "$consumer" = dotnet ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_DOTNET_TEST=1 node --test tests/native-dotnet.test.mjs && npm run test:type-corpus:dotnet && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=dotnet node --test tests/type-corpus-reviewed-native.test.mjs && LEAN_BRIDGE_DOTNET_CALLABLE_TEST=1 node --test tests/dotnet-callables.test.mjs tests/dotnet-callable-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_STRUCTURED_CALLABLE_TEST=1 node --test tests/dotnet-structured-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_RECURSIVE_CALLABLE_TEST=1 node --test tests/dotnet-recursive-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-dotnet-runtime.test.mjs tests/owned-dotnet-layout.test.mjs tests/owned-dotnet-values.test.mjs tests/owned-dotnet-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-dotnet-callables.test.mjs tests/owned-dotnet-callback-signatures.test.mjs tests/owned-dotnet-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-dotnet-packaging.test.mjs tests/owned-dotnet-coexistence.test.mjs"
                  consumer_command="$consumer_command && npm run test:owned-dotnet-transfers"
                  consumer_command="$consumer_command && npm run test:owned-dotnet-borrows"
                  consumer_command="$consumer_command && npm run test:owned-dotnet-receivers"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_COMPOUND_TEST=1 node --test tests/dotnet-compounds.test.mjs tests/dotnet-compound-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_LIST_TEST=1 node --test tests/dotnet-lists.test.mjs tests/dotnet-list-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_ALIAS_TEST=1 node --test tests/dotnet-aliases.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_DOTNET_FIN_TEST=1 node --test tests/dotnet-fin.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SPECIALIZATION_PROFILES=dotnet node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=dotnet node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=dotnet node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=dotnet node --test tests/native-fin-containers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=dotnet LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-dotnet.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs dotnet build/native-fin-container-edges/edges-dotnet.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=dotnet node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=dotnet node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_RECORD_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=dotnet node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=dotnet LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=dotnet LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/dotnet.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-dotnet.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs dotnet build/native-fin-record-zero/dotnet.json build/native-fin-record-zero/reviewed-dotnet.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SUBTYPE_PROFILES=dotnet node --test tests/native-subtype.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_VARIANT_TEST=1 node --test tests/dotnet-variants.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_CONVERSION_TEST=1 node --test tests/dotnet-collection-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_COLLECTION_TEST=1 node --test tests/dotnet-collections.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_EQUALITY_TEST=1 node --test tests/dotnet-value-equality.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_GRAPH_TEST=1 node --test tests/dotnet-copied-graph-values.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_GRAPH_CONVERSION_TEST=1 LEAN_BRIDGE_DOTNET_GRAPH_NATIVE_TEST=1 node --test tests/dotnet-copied-graph-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_GRAPH_PACKAGE_TEST=1 LEAN_BRIDGE_DOTNET_GRAPH_INSTALLED_TEST=1 node --test tests/dotnet-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_GRAPH_COMPOSITION_TEST=1 node --test tests/dotnet-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_GRAPH_REPRODUCIBILITY_TEST=1 node --test tests/dotnet-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_DOTNET_GRAPH_CONFLICT_TEST=1 node --test tests/dotnet-graph-package.test.mjs"
                  if [ "${{ steps.ordinary_dotnet.outcome }}" != success ] || [ "${{ steps.type_corpus_dotnet.outcome }}" != success ]; then
                    test_result=failed
                    executed=false
                  fi
                fi
                if [ "$consumer" = jvm ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_JVM_TEST=1 node --test tests/native-jvm.test.mjs && npm run test:type-corpus:jvm && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=java,kotlin node --test tests/type-corpus-reviewed-native.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_CALLABLE_TEST=1 node --test tests/jvm-callables.test.mjs tests/jvm-callable-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_STRUCTURED_CALLABLE_TEST=1 node --test tests/jvm-structured-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_RECURSIVE_CALLABLE_TEST=1 node --test tests/jvm-recursive-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_COMPOUND_TEST=1 node --test tests/jvm-compounds.test.mjs tests/jvm-compound-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_LIST_TEST=1 node --test tests/jvm-lists.test.mjs tests/jvm-list-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_ALIAS_TEST=1 node --test tests/jvm-aliases.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_JVM_FIN_TEST=1 node --test tests/jvm-fin.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SPECIALIZATION_PROFILES=java,kotlin node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=java,kotlin node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=java,kotlin node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=java,kotlin node --test tests/native-fin-containers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=java,kotlin LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-java-kotlin.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs java,kotlin build/native-fin-container-edges/edges-java-kotlin.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=java,kotlin node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=java,kotlin node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_RECORD_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=java,kotlin node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=java,kotlin LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=java,kotlin LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/java-kotlin.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-java-kotlin.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs java,kotlin build/native-fin-record-zero/java-kotlin.json build/native-fin-record-zero/reviewed-java-kotlin.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SUBTYPE_PROFILES=java,kotlin node --test tests/native-subtype.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_VARIANT_TEST=1 node --test tests/jvm-variants.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_EQUALITY_TEST=1 node --test tests/jvm-value-equality.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_GRAPH_TEST=1 node --test tests/jvm-copied-graph-values.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_KOTLIN_GRAPH_TEST=1 node --test tests/jvm-copied-graph-kotlin.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_GRAPH_PACKAGE_TEST=1 LEAN_BRIDGE_JVM_GRAPH_INSTALLED_TEST=1 node --test tests/jvm-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_GRAPH_REPRO_TEST=1 LEAN_BRIDGE_JVM_GRAPH_LOADING_TEST=1 node --test tests/jvm-graph-package.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_GRAPH_CONVERSION_TEST=1 LEAN_BRIDGE_JVM_GRAPH_NATIVE_TEST=1 node --test tests/jvm-copied-graph-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_CONVERSIONS_TEST=1 node --test tests/jvm-collection-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_COLLECTION_PREFLIGHT=1 LEAN_BRIDGE_JVM_COLLECTION_PROFILES=java,kotlin node --test tests/jvm-collection-callers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_JVM_COLLECTION_TEST=1 LEAN_BRIDGE_JVM_COLLECTION_PROFILES=java,kotlin node --test tests/jvm-collections.test.mjs"
                  if [ "${{ steps.ordinary_jvm.outcome }}" != success ] || [ "${{ steps.type_corpus_jvm.outcome }}" != success ]; then
                    test_result=failed
                    executed=false
                  fi
                fi
                if [ "$consumer" = ruby ]; then
                  consumer_command="$consumer_command && LEAN_BRIDGE_NATIVE_RUBY_TEST=1 node --test tests/native-ruby.test.mjs && npm run test:type-corpus:ruby && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=ruby node --test tests/type-corpus-reviewed-native.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_CALLABLE_TEST=1 node --test tests/ruby-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_STRUCTURED_CALLABLE_TEST=1 node --test tests/ruby-structured-callables.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_RECURSIVE_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/ruby-recursive-callables.test.mjs tests/ruby-recursive-callable-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-ruby-runtime.test.mjs tests/owned-ruby-values.test.mjs tests/owned-ruby-layout.test.mjs tests/owned-ruby-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-ruby-gmp.test.mjs tests/owned-ruby-package.test.mjs tests/owned-ruby-packaging.test.mjs tests/owned-ruby-coexistence.test.mjs"
                  consumer_command="$consumer_command && npm run test:owned-ruby-transfers"
                  consumer_command="$consumer_command && npm run test:owned-ruby-borrows"
                  consumer_command="$consumer_command && npm run test:owned-ruby-receivers"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_COMPOUND_TEST=1 node --test tests/ruby-compounds.test.mjs tests/ruby-compound-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_LIST_TEST=1 node --test tests/ruby-lists.test.mjs tests/ruby-list-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_ALIAS_TEST=1 node --test tests/ruby-aliases.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_RUBY_FIN_TEST=1 node --test tests/ruby-fin.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SPECIALIZATION_PROFILES=ruby node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=ruby node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=ruby node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=ruby node --test tests/native-fin-containers.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=ruby LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-ruby.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs ruby build/native-fin-container-edges/edges-ruby.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=ruby node --test tests/native-fin-products.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=ruby node --test tests/native-fin-product-arrays.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_FIN_RECORD_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=ruby node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=ruby LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=ruby LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/ruby.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-ruby.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs ruby build/native-fin-record-zero/ruby.json build/native-fin-record-zero/reviewed-ruby.json"
                  consumer_command="$consumer_command && LEAN_BRIDGE_SUBTYPE_PROFILES=ruby node --test tests/native-subtype.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_VARIANT_TEST=1 node --test tests/ruby-variants.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_COLLECTION_TEST=1 node --test tests/ruby-collections.test.mjs tests/ruby-collection-contract.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_GRAPH_TEST=1 node --test tests/ruby-copied-graph-values.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_GRAPH_TEST=1 LEAN_BRIDGE_RUBY_GRAPH_NATIVE_TEST=1 node --test tests/ruby-copied-graph-conversions.test.mjs"
                  consumer_command="$consumer_command && LEAN_BRIDGE_RUBY_GRAPH_PACKAGE_TEST=1 node --test tests/ruby-graph-package.test.mjs"
                  if [ "${{ steps.ordinary_ruby.outcome }}" != success ] || [ "${{ steps.type_corpus_ruby.outcome }}" != success ]; then
                    test_result=failed
                    executed=false
                  fi
                fi
                node scripts/consumer-ci.mjs record --consumer "$consumer" --output "build/consumer-ci/results/$consumer.json" --performance "build/consumer-ci/performance/$consumer.json" --test-result "$test_result" --package-installation "$executed" --real-lean-execution "$executed" --command "$consumer_command"
              done
          - name: Upload managed consumer observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-managed-${{ matrix.profile }}-${{ github.sha }}
              path: build/consumer-ci/results/${{ matrix.profile }}.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce managed consumer support
            if: always() && (steps.consumer.outcome != 'success' || (matrix.profile == 'dotnet' && (steps.ordinary_dotnet.outcome != 'success' || steps.type_corpus_dotnet.outcome != 'success')) || (matrix.profile == 'jvm' && (steps.ordinary_jvm.outcome != 'success' || steps.type_corpus_jvm.outcome != 'success')) || (matrix.profile == 'ruby' && (steps.ordinary_ruby.outcome != 'success' || steps.type_corpus_ruby.outcome != 'success')))
            run: exit 1
    
      owned-jvm-values:
        name: Owned JVM values, transfers, borrows and receivers
        runs-on: ubuntu-24.04
        timeout-minutes: 240
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Prepare the pinned native compiler
            timeout-minutes: 20
            run: |
              sudo apt-get update && sudo apt-get install -y build-essential zstd m4
          - name: Prepare the pinned native compiler
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
          - name: Install the TAP log verifier
            timeout-minutes: 20
            run: sudo apt-get install -y ripgrep
          - name: Install C# for the combined Maven receiver build
            uses: actions/setup-dotnet@v6
            with:
              dotnet-version: '8.0.424'
          - name: Install Ruby for the combined Maven receiver build
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Install the ordinary Java compiler
            uses: actions/setup-java@v4
            with:
              distribution: temurin
              java-version: '22.0.2'
          - name: Install Maven and the corpus helper packages
            timeout-minutes: 20
            run: |
              sudo apt-get install -y maven unzip python3-venv pkg-config
          - name: Install the pinned Kotlin compiler
            run: |
              mkdir -p build
              curl -fL --retry 3 --output build/kotlin-compiler.zip https://github.com/JetBrains/kotlin/releases/download/v2.2.0/kotlin-compiler-2.2.0.zip
              echo '1adb6f1a5845ba0aa5a59e412e44c8e405236b957de1a9683619f1dca3b16932  build/kotlin-compiler.zip' | sha256sum --check
              unzip -q build/kotlin-compiler.zip -d build/kotlin-tools
          - name: Verify owned JVM values, transfers, borrows and receivers
            run: |
              bash scripts/bootstrap-rust-ci.sh
              export LEAN_BRIDGE_RUSTC="$PWD/.toolchains/rust-1.90.0/bin/rustc"
              export LEAN_BRIDGE_CARGO="$PWD/.toolchains/rust-1.90.0/bin/cargo"
              export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
              export LEAN_BRIDGE_PYTHON="$(command -v python3)"
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              export LEAN_BRIDGE_DOTNET="$(command -v dotnet)"
              export LEAN_BRIDGE_JAVAC="$JAVA_HOME/bin/javac"
              export LEAN_BRIDGE_JAVA="$JAVA_HOME/bin/java"
              export LEAN_BRIDGE_MAVEN="$(command -v mvn)"
              export LEAN_BRIDGE_KOTLINC="$PWD/build/kotlin-tools/kotlinc/bin/kotlinc"
              source scripts/env.sh
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-jvm-runtime.test.mjs tests/owned-jvm-values.test.mjs tests/owned-jvm-layout.test.mjs tests/owned-jvm-kotlin.test.mjs tests/owned-jvm-conversions.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-jvm-calls.test.mjs tests/verified-jvm-assets.test.mjs tests/owned-jvm-package.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-jvm-thread-exit.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-jvm-packaging.test.mjs tests/owned-jvm-coexistence.test.mjs tests/owned-jvm-documentation.test.mjs
              npm run test:owned-jvm-transfers
              test -s build/owned-jvm-transfers/ordinary.json
              test -s build/owned-jvm-transfers/reviewed.json
              test -s build/owned-jvm-transfer-packaging/ordinary.json
              test -s build/owned-jvm-transfer-packaging/reviewed.json
              npm run test:owned-jvm-borrows > build/owned-jvm-borrows.log 2>&1
              cat build/owned-jvm-borrows.log
              rg '^# pass 8$' build/owned-jvm-borrows.log
              rg '^# fail 0$' build/owned-jvm-borrows.log
              rg '^# skipped 0$' build/owned-jvm-borrows.log
              test -s build/owned-jvm-borrows/ordinary.json
              test -s build/owned-jvm-borrows/reviewed.json
              test -s build/owned-jvm-borrows/borrow-only.json
              test -s build/owned-jvm-borrows/ordinary-installed.json
              test -s build/owned-jvm-borrows/reviewed-installed.json
              npm run test:owned-jvm-receivers > build/owned-jvm-receivers.log 2>&1
              cat build/owned-jvm-receivers.log
              rg '^# tests 15$' build/owned-jvm-receivers.log
              rg '^# pass 15$' build/owned-jvm-receivers.log
              rg '^# fail 0$' build/owned-jvm-receivers.log
              rg '^# cancelled 0$' build/owned-jvm-receivers.log
              rg '^# skipped 0$' build/owned-jvm-receivers.log
              test -s build/owned-jvm-receiver-core/ordinary.json
              test -s build/owned-jvm-receiver-core/reviewed.json
              test -s build/owned-jvm-receiver-core/ordinary-plain.json
              test -s build/owned-jvm-receiver-core/reviewed-plain.json
              test -s build/owned-jvm-receiver-core/ordinary-consuming.json
              test -s build/owned-jvm-receiver-core/reviewed-consuming.json
              test -s build/owned-jvm-receiver-core/ordinary-unanchored.json
              test -s build/owned-jvm-receiver-core/reviewed-unanchored.json
              test -s build/owned-jvm-receiver-core/ordinary-package.json
              test -s build/owned-jvm-receiver-core/reviewed-package.json
              test -s build/owned-jvm-receiver-core/ordinary-resource-package.json
              test -s build/owned-jvm-receiver-core/reviewed-resource-package.json
              npm run test:owned-jvm-receiver-gc > build/owned-jvm-receiver-gc.log 2>&1
              cat build/owned-jvm-receiver-gc.log
              rg '^# tests 2$' build/owned-jvm-receiver-gc.log
              rg '^# pass 2$' build/owned-jvm-receiver-gc.log
              rg '^# fail 0$' build/owned-jvm-receiver-gc.log
              rg '^# cancelled 0$' build/owned-jvm-receiver-gc.log
              rg '^# skipped 0$' build/owned-jvm-receiver-gc.log
              test -s build/owned-jvm-receiver-gc/ordinary.json
              test -s build/owned-jvm-receiver-gc/reviewed.json
              test -s build/owned-jvm-thread-exit/ordinary.json
              test -s build/owned-jvm-thread-exit/reviewed.json
              test -s build/owned-jvm-runtime/ordinary.json
              test -s build/owned-jvm-runtime/reviewed.json
              test -s build/owned-jvm-values/public.json
              test -s build/owned-jvm-layout/ordinary.json
              test -s build/owned-jvm-layout/reviewed.json
              test -s build/owned-jvm-layout/scalars-ordinary.json
              test -s build/owned-jvm-layout/scalars-reviewed.json
              test -s build/owned-jvm-kotlin/composed.json
              test -s build/owned-jvm-kotlin/scalars.json
              test -s build/owned-jvm-conversions/ordinary.json
              test -s build/owned-jvm-conversions/reviewed.json
              test -s build/owned-jvm-conversions/scalars-ordinary.json
              test -s build/owned-jvm-conversions/scalars-reviewed.json
              test -s build/owned-jvm-calls/values-ordinary.json
              test -s build/owned-jvm-calls/values-reviewed.json
              test -s build/owned-jvm-calls/scalars-ordinary.json
              test -s build/owned-jvm-calls/scalars-reviewed.json
              test -s build/owned-jvm-calls/signatures-ordinary.json
              test -s build/owned-jvm-calls/signatures-reviewed.json
              test -s build/owned-jvm-packaging/callbacks-ordinary.json
              test -s build/owned-jvm-packaging/callbacks-reviewed.json
              test -s build/owned-jvm-packaging/scalars-ordinary.json
              test -s build/owned-jvm-packaging/scalars-reviewed.json
              test -s build/owned-jvm-packaging/coexistence.json
              test -s build/owned-jvm-packaging/documentation.json
          - name: Preserve owned JVM value acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-jvm-values-${{ github.sha }}
              path: |
                build/owned-jvm-runtime/
                build/owned-jvm-values/
                build/owned-jvm-layout/
                build/owned-jvm-kotlin/
                build/owned-jvm-conversions/
                build/owned-jvm-calls/
                build/owned-jvm-thread-exit/
                build/owned-jvm-packaging/
                build/owned-jvm-transfers/
                build/owned-jvm-transfer-packaging/
                build/owned-jvm-borrows/
                build/owned-jvm-borrows.log
                build/owned-jvm-receiver-core/
                build/owned-jvm-receivers.log
                build/owned-jvm-receiver-gc/
                build/owned-jvm-receiver-gc.log
              if-no-files-found: error
              retention-days: 30
    
      owned-wit-receivers:
        name: WIT receiver methods and properties
        runs-on: ubuntu-24.04
        timeout-minutes: 150
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Prepare the pinned WIT and native toolchains
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake pkg-config zstd ripgrep libgmp-dev
          - name: Prepare the pinned WIT and native toolchains
            shell: bash
            run: |
              set -euo pipefail
              bash scripts/bootstrap-toolchains.sh --lean-only
              bash scripts/bootstrap-toolchains.sh --wasm-tools-only
              nix build .#wasmtime-c-api --out-link build/wasmtime-c-api
          - name: Execute WIT receiver acceptance
            shell: bash
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              npm run test:owned-wit-receivers 2>&1 | tee build/wit-owned-receivers.log
              rg '^# tests 20$' build/wit-owned-receivers.log
              rg '^# pass 20$' build/wit-owned-receivers.log
              rg '^# fail 0$' build/wit-owned-receivers.log
              rg '^# cancelled 0$' build/wit-owned-receivers.log
              rg '^# skipped 0$' build/wit-owned-receivers.log
              test -s build/owned-wit-receivers/ordinary.json
              test -s build/owned-wit-receivers/ordinary-plain.json
              test -s build/owned-wit-receivers/ordinary-consuming.json
              test -s build/owned-wit-receivers/ordinary-unanchored.json
              test -s build/owned-wit-receivers/ordinary-package.json
              test -s build/owned-wit-receivers/ordinary-plain-package.json
              test -s build/owned-wit-receivers/ordinary-consuming-package.json
              test -s build/owned-wit-receivers/ordinary-unanchored-package.json
              test -s build/owned-wit-receivers/reviewed.json
              test -s build/owned-wit-receivers/reviewed-plain.json
              test -s build/owned-wit-receivers/reviewed-consuming.json
              test -s build/owned-wit-receivers/reviewed-unanchored.json
              test -s build/owned-wit-receivers/reviewed-package.json
              test -s build/owned-wit-receivers/reviewed-plain-package.json
              test -s build/owned-wit-receivers/reviewed-consuming-package.json
              test -s build/owned-wit-receivers/reviewed-unanchored-package.json
          - name: Preserve WIT receiver execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-wit-receivers-${{ github.sha }}
              path: |
                build/wit-owned-receivers.log
                build/owned-wit-receivers/ordinary.json
                build/owned-wit-receivers/ordinary-plain.json
                build/owned-wit-receivers/ordinary-consuming.json
                build/owned-wit-receivers/ordinary-unanchored.json
                build/owned-wit-receivers/ordinary-package.json
                build/owned-wit-receivers/ordinary-plain-package.json
                build/owned-wit-receivers/ordinary-consuming-package.json
                build/owned-wit-receivers/ordinary-unanchored-package.json
                build/owned-wit-receivers/reviewed.json
                build/owned-wit-receivers/reviewed-plain.json
                build/owned-wit-receivers/reviewed-consuming.json
                build/owned-wit-receivers/reviewed-unanchored.json
                build/owned-wit-receivers/reviewed-package.json
                build/owned-wit-receivers/reviewed-plain-package.json
                build/owned-wit-receivers/reviewed-consuming-package.json
                build/owned-wit-receivers/reviewed-unanchored-package.json
              if-no-files-found: error
              retention-days: 30
    
      wasi-consumer:
        name: WIT and WASI Component Model
        runs-on: ubuntu-24.04
        # Copied, recursive, owned and original-owner installed-package gates
        # share this job. The full sequence exceeds two hours on hosted runners.
        timeout-minutes: 240
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Verify frozen direct WIT callback-result acceptance
            run: npm run test:owned-wit-callback-evidence
          - name: Install the archive and invoke the component through Wasmtime
            id: consumer
            continue-on-error: true
            run: npm run test:consumer:wasi
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install dependencies for ordinary_wit
            timeout-minutes: 20
            run: |
              sudo apt-get update && sudo apt-get install -y build-essential cmake pkg-config zstd ripgrep
          - name: Compile ordinary Lean APIs and consume relocated WIT packages
            id: ordinary_wit
            continue-on-error: true
            env:
              LEAN_BRIDGE_NATIVE_WIT_TEST: "1"
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
              bash scripts/bootstrap-toolchains.sh --wasm-tools-only
              nix build .#wasmtime-c-api --out-link build/wasmtime-c-api
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              node --test tests/native-wit.test.mjs
              LEAN_BRIDGE_WIT_CALLABLE_COMPONENT_TEST=1 node --test tests/wit-callable-contract.test.mjs
              LEAN_BRIDGE_WIT_CALLABLE_TEST=1 node --test tests/wit-callables.test.mjs
              test -s build/callables/wit.json
              LEAN_BRIDGE_WIT_COMPOUND_TEST=1 node --test tests/wit-compounds.test.mjs tests/wit-compound-contract.test.mjs tests/wit-compound-conversions.test.mjs
              test -s build/compounds/wit.json
              test -s build/compounds/wit-conversions.json
              LEAN_BRIDGE_WIT_LIST_TEST=1 node --test tests/wit-lists.test.mjs tests/wit-list-contract.test.mjs tests/wit-list-conversions.test.mjs
              test -s build/lists/wit.json
              test -s build/lists/wit-conversions.json
              LEAN_BRIDGE_WIT_ALIAS_TEST=1 node --test --test-concurrency=1 tests/wit-aliases.test.mjs tests/wit-alias-contract.test.mjs tests/wit-alias-conversions.test.mjs
              LEAN_BRIDGE_WIT_FIN_TEST=1 node --test tests/wit-fin.test.mjs
              test -s build/aliases/wit.json
              test -s build/aliases/wit-conversions.json
              test -s build/native-fin/wit.json
              test -s build/native-fin/wit-reviewed.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=wit-wasi node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/wit-wasi.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=wit-wasi node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/wit-wasi.json
              test -s build/generic-records/specialized-wit-wasi.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=wit-wasi node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-wit-wasi.json
              LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_FIN_CONTAINER_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=wit-wasi node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/wit-wasi.json
              test -s build/native-fin-containers/reviewed-wit-wasi.json
              node scripts/check-fin-container-entry-reports.mjs wit-wasi build/native-fin-containers/wit-wasi.json build/native-fin-containers/reviewed-wit-wasi.json
              LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=wit-wasi LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-wit-wasi.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs
              test -s build/native-fin-container-edges/edges-wit-wasi.json
              node scripts/check-fin-container-foreign-report.mjs wit-wasi build/native-fin-container-edges/edges-wit-wasi.json
              LEAN_BRIDGE_FIN_PRODUCT_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=wit-wasi node --test tests/native-fin-products.test.mjs
              test -s build/native-fin-products/wit-wasi.json
              test -s build/native-fin-products/reviewed-wit-wasi.json
              LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=wit-wasi node --test tests/native-fin-product-arrays.test.mjs
              test -s build/native-fin-product-arrays/wit-wasi.json
              test -s build/native-fin-product-arrays/reviewed-wit-wasi.json
              LEAN_BRIDGE_FIN_RECORD_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=wit-wasi node --test tests/native-fin-records.test.mjs
              test -s build/native-fin-records/wit-wasi.json
              test -s build/native-fin-records/reviewed-wit-wasi.json
              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=wit-wasi LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/wit-wasi.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-wit-wasi.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/wit-wasi.json
              test -s build/native-fin-record-zero/reviewed-wit-wasi.json
              node scripts/check-fin-record-zero-report.mjs wit-wasi build/native-fin-record-zero/wit-wasi.json build/native-fin-record-zero/reviewed-wit-wasi.json
              LEAN_BRIDGE_SUBTYPE_PROFILES=wit-wasi node --test tests/native-subtype.test.mjs
              test -s build/native-subtype/wit-wasi.json
              LEAN_BRIDGE_WIT_VARIANT_TEST=1 node --test --test-concurrency=1 tests/wit-variants.test.mjs tests/wit-variant-contract.test.mjs tests/wit-variant-conversions.test.mjs
              test -s build/variants/wit.json
              test -s build/variants/wit-conversions.json
              LEAN_BRIDGE_WIT_COLLECTION_TEST=1 node --test --test-concurrency=1 tests/wit-collections.test.mjs tests/wit-collection-contract.test.mjs tests/wit-collection-conversions.test.mjs
              test -s build/collections/wit.json
              test -s build/collections/wit-conversions.json
              LEAN_BRIDGE_WIT_GRAPH_TEST=1 node --test tests/wit-copied-graph-conversions.test.mjs
              LEAN_BRIDGE_WIT_GRAPH_NATIVE_TEST=1 node --test tests/wit-copied-graph-native.test.mjs
              LEAN_BRIDGE_WIT_GRAPH_INSTALLED_TEST=1 node --test tests/wit-copied-graph-package.test.mjs
              LEAN_BRIDGE_WIT_GRAPH_REPRO_TEST=1 node --test tests/wit-copied-graph-package.test.mjs
              LEAN_BRIDGE_WIT_HOST_TEST=1 node --test tests/wit-host-evidence.test.mjs
              LEAN_BRIDGE_WIT_HOST_PACKAGES_TEST=1 node --test tests/wit-host-packages.test.mjs
              LEAN_BRIDGE_WIT_GRAPH_COMPOSITION_TEST=1 LEAN_BRIDGE_WIT_MIXED_PACKAGES_TEST=1 node --test tests/wit-graph-composition.test.mjs
              test -s build/recursive-wit/composition.json
              test -s build/recursive-wit/mixed-packages.json
              test -s build/recursive-wit/host-hash.json
              test -s build/recursive-wit/host-isolation.json
              test -s build/recursive-wit/conversions.json
              test -s build/recursive-wit/native.json
              test -s build/recursive/wit-packages.json
              test -s build/recursive/wit-reproducibility.json
          - name: Execute installed WIT structured callbacks and documentation
            id: structured_wit
            continue-on-error: true
            env:
              LEAN_BRIDGE_WIT_STRUCTURED_CALLABLE_TEST: "1"
            run: |
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              node --test --test-concurrency=1 tests/native-callback-alias-contract.test.mjs tests/wit-structured-callable-contract.test.mjs tests/wit-structured-callable-faults.test.mjs tests/wit-structured-callables.test.mjs tests/wit-structured-aliases.test.mjs tests/wit-structured-documentation.test.mjs
              test -s build/structured-callables/wit.json
              test -s build/structured-callables/wit-aliases.json
              test -s build/structured-callables/wit-faults.json
              test -s build/structured-callables/wit-documentation.json
          - name: Execute recursive WIT callbacks and owned closures
            id: recursive_wit
            continue-on-error: true
            run: |
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              npm run test:wit-recursive-generated
              npm run test:wit-recursive-packages
              test -s build/recursive-callables/wit-native.json
              test -s build/recursive-callables/wit-faults.json
              test -s build/recursive-callables/wit-packages.json
              test -s build/recursive-callables/wit-mixed-packages.json
          - name: Check nested WIT borrows and owned graph projections
            id: owned_wit_projection
            continue-on-error: true
            env:
              LEAN_BRIDGE_WIT_OWNED_CANONICAL_TEST: "1"
            run: |
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              node --test tests/wit-owned-canonical.test.mjs tests/wit-owned-graph-model.test.mjs
          - name: Execute owned WIT conversions and compiled Lean imports
            id: owned_wit_native
            env:
              LEAN_BRIDGE_WIT_OWNED_CONVERSIONS_TEST: "1"
              LEAN_BRIDGE_WIT_OWNED_NATIVE_TEST: "1"
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              node --test --test-concurrency=1 tests/wit-owned-graph-conversions.test.mjs tests/wit-owned-native-host.test.mjs 2>&1 | tee build/wit-owned-native.log
              test -s build/wit-owned-native.log
              rg '^# pass 5$' build/wit-owned-native.log
              rg '^# fail 0$' build/wit-owned-native.log
              rg '^# skipped 0$' build/wit-owned-native.log
          - name: Preserve owned WIT native execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: wit-owned-native-${{ github.sha }}
              path: build/wit-owned-native.log
              if-no-files-found: error
          - name: Execute owned WIT public sessions and host callbacks
            id: owned_wit_session
            env:
              LEAN_BRIDGE_WIT_OWNED_SESSION_TEST: "1"
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              node --test --test-concurrency=1 tests/wit-owned-session.test.mjs 2>&1 | tee build/wit-owned-session.log
              test -s build/wit-owned-session.log
              rg '^# pass 7$' build/wit-owned-session.log
              rg '^# fail 0$' build/wit-owned-session.log
              rg '^# skipped 0$' build/wit-owned-session.log
          - name: Preserve owned WIT public session execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: wit-owned-session-${{ github.sha }}
              path: build/wit-owned-session.log
              if-no-files-found: error
          - name: Install owned WIT packages without producer sources
            id: owned_wit_package
            env:
              LEAN_BRIDGE_WIT_OWNED_PACKAGE_TEST: "1"
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              node --test --test-concurrency=1 tests/wit-owned-packaging.test.mjs 2>&1 | tee build/wit-owned-packaging.log
              test -s build/wit-owned-packaging.log
              rg '^# pass 6$' build/wit-owned-packaging.log
              rg '^# fail 0$' build/wit-owned-packaging.log
              rg '^# skipped 0$' build/wit-owned-packaging.log
          - name: Preserve owned WIT installed execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: wit-owned-packaging-${{ github.sha }}
              path: |
                build/wit-owned-packaging.log
                build/owned-wit-packaging/*.json
              if-no-files-found: error
          - name: Install all six WIT callback-result package configurations
            id: owned_wit_callback_packages
            shell: bash
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              npm run test:owned-wit-callback-packages 2>&1 | tee build/owned-wit-callback-result-packaging.log
              rg '^# tests 6$' build/owned-wit-callback-result-packaging.log
              rg '^# pass 6$' build/owned-wit-callback-result-packaging.log
              rg '^# fail 0$' build/owned-wit-callback-result-packaging.log
              rg '^# cancelled 0$' build/owned-wit-callback-result-packaging.log
              rg '^# skipped 0$' build/owned-wit-callback-result-packaging.log
              for mode in ordinary reviewed; do
                for variant in no-host host combined; do
                  test -s "build/owned-wit-callback-result-packaging/$mode-$variant.json"
                done
              done
          - name: Preserve installed WIT callback-result execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: wit-owned-callback-results-${{ github.sha }}
              path: |
                build/owned-wit-callback-result-packaging.log
                build/owned-wit-callback-result-packaging/*.json
              if-no-files-found: error
          - name: Verify consuming WIT input ownership
            id: owned_wit_transfers
            shell: bash
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              npm run test:owned-wit-transfers 2>&1 | tee build/wit-owned-transfers.log
              rg '^# pass 5$' build/wit-owned-transfers.log
              rg '^# fail 0$' build/wit-owned-transfers.log
              rg '^# skipped 0$' build/wit-owned-transfers.log
              test -s build/owned-wit-transfers/ordinary.json
              test -s build/owned-wit-transfers/reviewed.json
              test -s build/owned-wit-transfers/ordinary-package.json
              test -s build/owned-wit-transfers/reviewed-package.json
          - name: Preserve consuming WIT execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: wit-owned-transfers-${{ github.sha }}
              path: |
                build/wit-owned-transfers.log
                build/owned-wit-transfers/ordinary.json
                build/owned-wit-transfers/reviewed.json
                build/owned-wit-transfers/ordinary-package.json
                build/owned-wit-transfers/reviewed-package.json
              if-no-files-found: error
          - name: Verify owner-anchored WIT results
            id: owned_wit_borrows
            shell: bash
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              npm run test:owned-wit-borrows 2>&1 | tee build/wit-owned-borrows.log
              rg '^# tests 8$' build/wit-owned-borrows.log
              rg '^# pass 8$' build/wit-owned-borrows.log
              rg '^# fail 0$' build/wit-owned-borrows.log
              rg '^# cancelled 0$' build/wit-owned-borrows.log
              rg '^# skipped 0$' build/wit-owned-borrows.log
              test -s build/owned-wit-borrows/ordinary.json
              test -s build/owned-wit-borrows/ordinary-borrow-only.json
              test -s build/owned-wit-borrows/ordinary-package.json
              test -s build/owned-wit-borrows/reviewed.json
              test -s build/owned-wit-borrows/reviewed-borrow-only.json
              test -s build/owned-wit-borrows/reviewed-package.json
          - name: Preserve owner-anchored WIT execution
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: wit-owned-borrows-${{ github.sha }}
              path: |
                build/wit-owned-borrows.log
                build/owned-wit-borrows/ordinary.json
                build/owned-wit-borrows/ordinary-borrow-only.json
                build/owned-wit-borrows/ordinary-package.json
                build/owned-wit-borrows/reviewed.json
                build/owned-wit-borrows/reviewed-borrow-only.json
                build/owned-wit-borrows/reviewed-package.json
              if-no-files-found: error
          - name: Compare installed WIT packages with the shared Lean corpus
            id: type_corpus_wit
            continue-on-error: true
            run: |
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              source scripts/env.sh
              npm run test:type-corpus:wit-wasi && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=wit-wasi node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_CHAR_PROFILES=wit-wasi node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=wit-wasi node --test tests/native-words.test.mjs
              test -s build/type-corpus/wit-wasi.json
              test -s build/type-corpus/reviewed-native-wit-wasi.json
          - name: Record WIT and WASI observations
            if: always()
            shell: bash
            run: |
              test_result="${{ steps.consumer.outcome == 'success' && steps.ordinary_wit.outcome == 'success' && steps.structured_wit.outcome == 'success' && steps.recursive_wit.outcome == 'success' && steps.type_corpus_wit.outcome == 'success' && steps.owned_wit_projection.outcome == 'success' && steps.owned_wit_native.outcome == 'success' && steps.owned_wit_session.outcome == 'success' && steps.owned_wit_package.outcome == 'success' && steps.owned_wit_callback_packages.outcome == 'success' && steps.owned_wit_transfers.outcome == 'success' && steps.owned_wit_borrows.outcome == 'success' && 'passed' || 'failed' }}"
              executed="${{ steps.consumer.outcome == 'success' && steps.ordinary_wit.outcome == 'success' && steps.structured_wit.outcome == 'success' && steps.recursive_wit.outcome == 'success' && steps.type_corpus_wit.outcome == 'success' && steps.owned_wit_projection.outcome == 'success' && steps.owned_wit_native.outcome == 'success' && steps.owned_wit_session.outcome == 'success' && steps.owned_wit_package.outcome == 'success' && steps.owned_wit_callback_packages.outcome == 'success' && steps.owned_wit_transfers.outcome == 'success' && steps.owned_wit_borrows.outcome == 'success' && 'true' || 'false' }}"
              node scripts/consumer-ci.mjs record --consumer wit-wasi --output build/consumer-ci/results/wit-wasi.json --performance build/consumer-ci/performance/wit-wasi.json --test-result "$test_result" --package-installation "$executed" --real-lean-execution "$executed" --command "npm run test:consumer:wasi && LEAN_BRIDGE_NATIVE_WIT_TEST=1 node --test tests/native-wit.test.mjs && LEAN_BRIDGE_WIT_CALLABLE_COMPONENT_TEST=1 node --test tests/wit-callable-contract.test.mjs && LEAN_BRIDGE_WIT_CALLABLE_TEST=1 node --test tests/wit-callables.test.mjs && LEAN_BRIDGE_WIT_COMPOUND_TEST=1 node --test tests/wit-compounds.test.mjs tests/wit-compound-contract.test.mjs tests/wit-compound-conversions.test.mjs && LEAN_BRIDGE_WIT_LIST_TEST=1 node --test tests/wit-lists.test.mjs tests/wit-list-contract.test.mjs tests/wit-list-conversions.test.mjs && LEAN_BRIDGE_WIT_ALIAS_TEST=1 node --test --test-concurrency=1 tests/wit-aliases.test.mjs tests/wit-alias-contract.test.mjs tests/wit-alias-conversions.test.mjs && LEAN_BRIDGE_WIT_FIN_TEST=1 node --test tests/wit-fin.test.mjs && LEAN_BRIDGE_SPECIALIZATION_PROFILES=wit-wasi node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=wit-wasi node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=wit-wasi node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs && LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_FIN_CONTAINER_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=wit-wasi node --test tests/native-fin-containers.test.mjs && LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=wit-wasi LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-wit-wasi.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs wit-wasi build/native-fin-container-edges/edges-wit-wasi.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=wit-wasi node --test tests/native-fin-products.test.mjs && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=wit-wasi node --test tests/native-fin-product-arrays.test.mjs && LEAN_BRIDGE_FIN_RECORD_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=wit-wasi node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=wit-wasi LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=wit-wasi LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/wit-wasi.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-wit-wasi.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs wit-wasi build/native-fin-record-zero/wit-wasi.json build/native-fin-record-zero/reviewed-wit-wasi.json && LEAN_BRIDGE_SUBTYPE_PROFILES=wit-wasi node --test tests/native-subtype.test.mjs && LEAN_BRIDGE_WIT_VARIANT_TEST=1 node --test --test-concurrency=1 tests/wit-variants.test.mjs tests/wit-variant-contract.test.mjs tests/wit-variant-conversions.test.mjs && LEAN_BRIDGE_WIT_COLLECTION_TEST=1 node --test --test-concurrency=1 tests/wit-collections.test.mjs tests/wit-collection-contract.test.mjs tests/wit-collection-conversions.test.mjs && LEAN_BRIDGE_WIT_GRAPH_TEST=1 node --test tests/wit-copied-graph-conversions.test.mjs && LEAN_BRIDGE_WIT_GRAPH_NATIVE_TEST=1 node --test tests/wit-copied-graph-native.test.mjs && LEAN_BRIDGE_WIT_GRAPH_INSTALLED_TEST=1 node --test tests/wit-copied-graph-package.test.mjs && LEAN_BRIDGE_WIT_GRAPH_REPRO_TEST=1 node --test tests/wit-copied-graph-package.test.mjs && LEAN_BRIDGE_WIT_HOST_TEST=1 node --test tests/wit-host-evidence.test.mjs && LEAN_BRIDGE_WIT_HOST_PACKAGES_TEST=1 node --test tests/wit-host-packages.test.mjs && LEAN_BRIDGE_WIT_GRAPH_COMPOSITION_TEST=1 LEAN_BRIDGE_WIT_MIXED_PACKAGES_TEST=1 node --test tests/wit-graph-composition.test.mjs && npm run test:type-corpus:wit-wasi && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=wit-wasi node --test tests/type-corpus-reviewed-native.test.mjs && LEAN_BRIDGE_WIT_STRUCTURED_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/native-callback-alias-contract.test.mjs tests/wit-structured-callable-contract.test.mjs tests/wit-structured-callable-faults.test.mjs tests/wit-structured-callables.test.mjs tests/wit-structured-aliases.test.mjs tests/wit-structured-documentation.test.mjs && npm run test:wit-recursive-generated && npm run test:wit-recursive-packages && npm run test:owned-wit-transfers && npm run test:owned-wit-borrows && npm run test:owned-wit-callback-packages"
          - name: Upload WIT shared corpus evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-wit-wasi-${{ github.sha }}
              path: |
                build/type-corpus/wit-wasi.json
                build/type-corpus/reviewed-native-wit-wasi.json
                build/char-native/wit-wasi.json
                build/word-native/wit-wasi.json
                build/callables/wit.json
                build/compounds/wit.json
                build/compounds/wit-conversions.json
                build/lists/wit.json
                build/lists/wit-conversions.json
                build/aliases/wit.json
                build/aliases/wit-conversions.json
                build/native-fin/wit.json
                build/native-fin/wit-reviewed.json
                build/native-specializations/wit-wasi.json
                build/generic-records/wit-wasi.json
                build/generic-records/specialized-wit-wasi.json
                build/generic-records/array-wit-wasi.json
                build/native-fin-containers/wit-wasi.json
                build/native-fin-containers/reviewed-wit-wasi.json
                build/native-fin-container-edges/edges-wit-wasi.json
                build/native-fin-products/wit-wasi.json
                build/native-fin-products/reviewed-wit-wasi.json
                build/native-fin-product-arrays/wit-wasi.json
                build/native-fin-product-arrays/reviewed-wit-wasi.json
                build/native-fin-records/wit-wasi.json
                build/native-fin-records/reviewed-wit-wasi.json
                build/native-fin-record-zero/wit-wasi.json
                build/native-fin-record-zero/reviewed-wit-wasi.json
                build/native-subtype/wit-wasi.json
                build/variants/wit.json
                build/variants/wit-conversions.json
                build/collections/wit.json
                build/collections/wit-conversions.json
                build/recursive-wit/conversions.json
                build/recursive-wit/native.json
                build/recursive/wit-packages.json
                build/recursive/wit-reproducibility.json
                build/recursive-wit/host-hash.json
                build/recursive-wit/host-isolation.json
                build/recursive-wit/composition.json
                build/recursive-wit/mixed-packages.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Upload WIT structured callback evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: structured-callables-wit-wasi-${{ github.sha }}
              path: |
                build/structured-callables/wit.json
                build/structured-callables/wit-aliases.json
                build/structured-callables/wit-faults.json
                build/structured-callables/wit-documentation.json
                build/recursive-callables/wit-native.json
                build/recursive-callables/wit-faults.json
                build/recursive-callables/wit-packages.json
                build/recursive-callables/wit-mixed-packages.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Upload WIT and WASI observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-wasi-${{ github.sha }}
              path: build/consumer-ci/results/*.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce WIT and WASI support
            if: steps.consumer.outcome != 'success' || steps.ordinary_wit.outcome != 'success' || steps.structured_wit.outcome != 'success' || steps.recursive_wit.outcome != 'success' || steps.type_corpus_wit.outcome != 'success' || steps.owned_wit_projection.outcome != 'success' || steps.owned_wit_native.outcome != 'success' || steps.owned_wit_session.outcome != 'success' || steps.owned_wit_package.outcome != 'success' || steps.owned_wit_callback_packages.outcome != 'success' || steps.owned_wit_transfers.outcome != 'success' || steps.owned_wit_borrows.outcome != 'success'
            run: exit 1
    
      docker-engine:
        name: Pinned Docker build path
        runs-on: ubuntu-24.04
        timeout-minutes: 180
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Restore pinned compiler toolchains
            uses: actions/cache@v5
            with:
              path: .toolchains
              key: consumer-docker-${{ runner.os }}-${{ hashFiles('scripts/bootstrap-toolchains.sh', 'containers/builder/manifest.json', 'lean-toolchain') }}
          - name: Install dependencies and pinned toolchains
            run: |
              npm ci --ignore-scripts
              npm run bootstrap
          - name: Build the pinned builder image
            run: npm run build:builder-image
          - name: Check the mounted repository ownership boundary
            run: npm run test:builder-ownership
          - name: Execute the clean consumer through Docker
            env:
              LEAN_BRIDGE_BUILD_BACKEND: docker
            run: npm run test:consumer:docker-ci
    
      perl-consumer:
        name: Perl
        uses: ./.github/workflows/perl-consumer.yml
    
      support-summary:
        name: Publish consumer support summary
        if: always()
        needs:
          - documentation
          - reviewed-ir-admission
          - nix-cache
          - node-consumers
          - reviewed-fin-wasm-entry
          - owned-javascript-wasm
          - owned-javascript-receivers
          - owned-ruby-callback-results
          - owned-dotnet-callback-results
          - owned-jvm-callback-results
          - owned-perl-callback-results
          - owned-php-callback-results
          - owned-python-callback-results
          - owned-rust-callback-results
          - owned-callback-results
          - owned-cpp-callback-results
          - browser-consumer
          - php-wasm-callback-results
          - php-multi-profile
          - php-consumers
          - php-wasm-consumers
          - php-receivers
          - php-wasm-receivers
          - native-consumers
          - managed-consumers
          - owned-jvm-values
          - perl-consumer
          - wasi-consumer
          - owned-wit-receivers
          - docker-engine
        runs-on: ubuntu-24.04
        steps:
          - name: Check out the support reporter
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
          - name: Download consumer observations
            uses: actions/download-artifact@v5
            with:
              pattern: consumer-results-*-${{ github.sha }}
              path: build/consumer-ci/results
              merge-multiple: true
          - name: Validate all fourteen targets and publish the table
            run: node scripts/consumer-ci.mjs summary --results build/consumer-ci/results --output build/consumer-ci/report.json
          - name: Upload the combined support report
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-support-report-${{ github.sha }}
              path: build/consumer-ci/report.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce owned JavaScript and Wasm execution
            if: needs.owned-javascript-wasm.result != 'success'
            run: exit 1
          - name: Enforce JavaScript receiver acceptance
            if: needs.owned-javascript-receivers.result != 'success'
            run: exit 1
          - name: Enforce Ruby callback-result acceptance
            if: needs.owned-ruby-callback-results.result != 'success'
            run: exit 1
          - name: Enforce .NET callback-result acceptance
            if: needs.owned-dotnet-callback-results.result != 'success'
            run: exit 1
          - name: Enforce JVM callback-result acceptance
            if: needs.owned-jvm-callback-results.result != 'success'
            run: exit 1
          - name: Enforce owned JVM value acceptance
            if: needs.owned-jvm-values.result != 'success'
            run: exit 1
          - name: Enforce Perl callback-result acceptance
            if: needs.owned-perl-callback-results.result != 'success'
            run: exit 1
          - name: Enforce native PHP callback-result acceptance
            if: needs.owned-php-callback-results.result != 'success'
            run: exit 1
          - name: Enforce PHP-Wasm callback-result acceptance
            if: needs.php-wasm-callback-results.result != 'success'
            run: exit 1
          - name: Enforce PHP-Wasm mixed-profile release
            if: needs.php-multi-profile.result != 'success'
            run: exit 1
          - name: Enforce Python callback-result acceptance
            if: needs.owned-python-callback-results.result != 'success'
            run: exit 1
          - name: Enforce Rust callback-result acceptance
            if: needs.owned-rust-callback-results.result != 'success'
            run: exit 1
          - name: Enforce callback-result acceptance
            if: needs.owned-callback-results.result != 'success'
            run: exit 1
          - name: Enforce C++ callback-result acceptance
            if: needs.owned-cpp-callback-results.result != 'success'
            run: exit 1
          - name: Enforce real Nix owned npm acceptance
            if: needs.node-consumers.result != 'success'
            run: exit 1
          - name: Enforce native PHP receiver acceptance
            if: needs.php-receivers.result != 'success'
            run: exit 1
          - name: Enforce PHP-Wasm receiver acceptance
            if: needs.php-wasm-receivers.result != 'success'
            run: exit 1
          - name: Enforce native PHP acceptance
            if: needs.php-consumers.result != 'success'
            run: exit 1
          - name: Enforce PHP-Wasm acceptance
            if: needs.php-wasm-consumers.result != 'success'
            run: exit 1
          - name: Enforce WIT receiver acceptance
            if: needs.owned-wit-receivers.result != 'success'
            run: exit 1
          - name: Enforce reviewed Fin Wasm entry acceptance
            if: needs.reviewed-fin-wasm-entry.result != 'success'
            run: exit 1
    
  actual: |-
    name: Downstream consumer contract
    
    on:
      push:
      pull_request:
      workflow_dispatch:
    
    permissions:
      contents: read
    
    concurrency:
      group: consumer-contract-${{ github.ref }}
      cancel-in-progress: true
    
    env:
      NODE_VERSION: "22"
      LEAN_BRIDGE_CONSUMER_PERFORMANCE_DIR: build/consumer-ci/performance
    
    jobs:
      reviewed-ir-admission:
        name: Reviewed IR admission corpus
        runs-on: ubuntu-24.04
        timeout-minutes: 15
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Check reviewed analysis and blocked builds against fresh source oracles
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
              source scripts/env.sh
              npm run test:type-corpus:reviewed
              LEAN_BRIDGE_REVIEWED_SUBTYPE_LEAN_TEST=1 LEAN_BRIDGE_REVIEWED_SOURCE_TEST=1 node --test tests/reviewed-source-build.test.mjs
          - name: Preserve reviewed admission evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-reviewed-ir-${{ github.sha }}
              path: build/type-corpus/reviewed-ir.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
    
      nix-cache:
        name: Signed Nix cache recipes
        runs-on: ubuntu-24.04
        timeout-minutes: 10
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
          - name: Install the documented Nix CLI
            uses: cachix/install-nix-action@v31
            with:
              install_url: https://releases.nixos.org/nix/nix-2.24.11/install
          - name: Execute the offline signing and loopback fetch acceptance
            run: npm run test:nix-cache
    
      documentation:
        name: Documentation contract
        runs-on: ubuntu-24.04
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Check documentation and the versioned support contract
            run: npm run test:docs
    
      owned-javascript-wasm:
        name: Owned JavaScript and production Wasm runtime
        runs-on: ubuntu-24.04
        timeout-minutes: 90
        env:
          LEAN_BRIDGE_OWNED_JS_WASM_TEST: "1"
          LEAN_BRIDGE_OWNED_JS_WASM_PREPARED_TEST: "1"
          LEAN_BRIDGE_OWNED_JS_WASM_BUILD_TEST: "1"
          LEAN_BRIDGE_OWNED_JS_WASM_BROWSER_TEST: "1"
          LEAN_BRIDGE_COMPILER_ANALYSIS_TEST: "1"
          EMCC_CORES: "2"
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install dependencies and pinned Lean and Wasm toolchains
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake git jq libgmp-dev libuv1-dev pkg-config python3 ripgrep zstd
          - name: Install dependencies and pinned Lean and Wasm toolchains
            run: |
              npm ci --ignore-scripts
              bash scripts/bootstrap-toolchains.sh
          - name: Install owned npm browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the production runtime with the shared ownership broker
            shell: bash
            run: |
              set -euo pipefail
              mkdir -p build/owned-javascript-wasm
              bash scripts/build-lean-link-spike.sh 2>&1 | tee build/owned-javascript-wasm/runtime.log
              test -s build/lean-link-spike/lazy/main.wasm
              test -s build/lean-link-spike/startup/main.wasm
              test -s build/lean-link-spike/final-static/main.wasm
          - name: Execute owned JavaScript values and generated public APIs
            shell: bash
            run: |
              set -euo pipefail
              node --test --test-concurrency=2 \
                tests/owned-javascript-package.test.mjs \
                tests/owned-javascript-wasm-layout.test.mjs \
                tests/owned-javascript-wasm-component.test.mjs \
                tests/owned-javascript-wasm-loader.test.mjs \
                tests/owned-wasm-scalars.test.mjs tests/owned-wasm-values.test.mjs \
                tests/owned-wasm-registry.test.mjs tests/owned-wasm-calls.test.mjs \
                tests/owned-wasm-bindings.test.mjs \
                tests/owned-javascript-wasm-native.test.mjs \
                tests/owned-javascript-wasm-callbacks.test.mjs \
                tests/owned-javascript-wasm-shared.test.mjs \
                tests/owned-javascript-wasm-prepared.test.mjs \
                tests/component-runtime.test.mjs tests/component-callable-runtime.test.mjs \
                tests/javascript-generator.test.mjs tests/javascript-coverage.test.mjs \
                2>&1 | tee build/owned-javascript-wasm/execution.log
              test -s build/owned-javascript-wasm/execution.log
              rg '^# fail 0$' build/owned-javascript-wasm/execution.log
              rg '^# skipped 0$' build/owned-javascript-wasm/execution.log
          - name: Build and install owned npm packages through the standalone CLI
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              node --test --test-concurrency=1 \
                tests/owned-javascript-wasm-model.test.mjs \
                tests/javascript-wasm-compiler-inputs.test.mjs \
                tests/owned-javascript-cli.test.mjs \
                tests/owned-javascript-wasm-build.test.mjs \
                2>&1 | tee build/owned-javascript-wasm/installed.log
              test -s build/owned-javascript-wasm/installed.log
              rg '^# fail 0$' build/owned-javascript-wasm/installed.log
              rg '^# skipped 0$' build/owned-javascript-wasm/installed.log
          - name: Verify consuming JavaScript input ownership
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              npm run test:owned-javascript-transfers 2>&1 | tee build/owned-javascript-wasm/transfers.log
              rg '^# fail 0$' build/owned-javascript-wasm/transfers.log
              rg '^# skipped 0$' build/owned-javascript-wasm/transfers.log
              test -s build/owned-javascript-transfers/ordinary.json
              test -s build/owned-javascript-transfers/reviewed.json
              test -s build/owned-javascript-transfer-packaging/report.json
          - name: Verify owner-anchored JavaScript results
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              npm run test:owned-javascript-borrows 2>&1 | tee build/owned-javascript-wasm/borrows.log
              rg '^# tests 25$' build/owned-javascript-wasm/borrows.log
              rg '^# fail 0$' build/owned-javascript-wasm/borrows.log
              rg '^# cancelled 0$' build/owned-javascript-wasm/borrows.log
              rg '^# skipped 0$' build/owned-javascript-wasm/borrows.log
              test -s build/owned-javascript-borrows/ordinary.json
              test -s build/owned-javascript-borrows/ordinary-borrow-only.json
              test -s build/owned-javascript-borrows/ordinary-mutants.json
              test -s build/owned-javascript-borrows/ordinary-owned-first.json
              test -s build/owned-javascript-borrows/ordinary-copied-first.json
              test -s build/owned-javascript-borrows/reviewed.json
              test -s build/owned-javascript-borrows/reviewed-borrow-only.json
              test -s build/owned-javascript-borrows/reviewed-mutants.json
              test -s build/owned-javascript-borrows/reviewed-owned-first.json
              test -s build/owned-javascript-borrows/reviewed-copied-first.json
              test -s build/owned-javascript-borrow-packaging/report.json
          - name: Verify installed copied and owned npm coexistence
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              node --test --test-concurrency=1 \
                tests/component-runtime-package-identity.test.mjs \
                tests/owned-javascript-npm-coexistence.test.mjs \
                2>&1 | tee build/owned-javascript-wasm/coexistence.log
              test -s build/owned-javascript-wasm/coexistence.log
              rg '^# fail 0$' build/owned-javascript-wasm/coexistence.log
              rg '^# skipped 0$' build/owned-javascript-wasm/coexistence.log
          - name: Compare ownership analysis with compiled APIs
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              node --test --test-concurrency=1 \
                tests/owned-compiler-analysis.test.mjs \
                tests/owned-analysis-build-parity.test.mjs \
                2>&1 | tee build/owned-javascript-wasm/analysis.log
              test -s build/owned-javascript-wasm/analysis.log
              rg '^# fail 0$' build/owned-javascript-wasm/analysis.log
              rg '^# skipped 0$' build/owned-javascript-wasm/analysis.log
          - name: Verify owned JavaScript engine and archive SDK contracts
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              node --test --test-concurrency=1 \
                tests/javascript-wasm-toolchain.test.mjs \
                tests/owned-javascript-archive-sdk.test.mjs \
                tests/owned-javascript-engine-request.test.mjs \
                tests/owned-javascript-engine.test.mjs \
                tests/owned-javascript-isolated-project.test.mjs \
                2>&1 | tee build/owned-javascript-wasm/engine.log
              test -s build/owned-javascript-wasm/engine.log
              rg '^# fail 0$' build/owned-javascript-wasm/engine.log
              rg '^# skipped 0$' build/owned-javascript-wasm/engine.log
          - name: Verify reproducible signed owned npm publication
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              node --test --test-concurrency=1 tests/owned-javascript-publication.test.mjs \
                2>&1 | tee build/owned-javascript-wasm/publication.log
              test -s build/owned-javascript-wasm/publication.log
              rg '^# fail 0$' build/owned-javascript-wasm/publication.log
              rg '^# skipped 0$' build/owned-javascript-wasm/publication.log
          - name: Preserve owned JavaScript and runtime execution logs
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-javascript-wasm-${{ github.sha }}
              path: |
                build/owned-javascript-wasm/runtime.log
                build/owned-javascript-wasm/execution.log
                build/owned-javascript-wasm/installed.log
                build/owned-javascript-wasm/transfers.log
                build/owned-javascript-transfers/ordinary.json
                build/owned-javascript-transfers/reviewed.json
                build/owned-javascript-transfer-packaging/report.json
                build/owned-javascript-wasm/borrows.log
                build/owned-javascript-borrows/ordinary.json
                build/owned-javascript-borrows/ordinary-borrow-only.json
                build/owned-javascript-borrows/ordinary-mutants.json
                build/owned-javascript-borrows/ordinary-owned-first.json
                build/owned-javascript-borrows/ordinary-copied-first.json
                build/owned-javascript-borrows/reviewed.json
                build/owned-javascript-borrows/reviewed-borrow-only.json
                build/owned-javascript-borrows/reviewed-mutants.json
                build/owned-javascript-borrows/reviewed-owned-first.json
                build/owned-javascript-borrows/reviewed-copied-first.json
                build/owned-javascript-borrow-packaging/report.json
                build/owned-javascript-wasm/coexistence.log
                build/owned-javascript-wasm/analysis.log
                build/owned-javascript-wasm/engine.log
                build/owned-javascript-wasm/publication.log
              if-no-files-found: error
              retention-days: 30
    
      owned-javascript-receivers:
        name: JavaScript and TypeScript receiver packages
        runs-on: ubuntu-24.04
        timeout-minutes: 150
        env:
          EMCC_CORES: "2"
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install compiler tools and log tooling
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake git jq libgmp-dev libuv1-dev pkg-config python3 ripgrep zstd
          - name: Install compiler tools and log tooling
            run: |
              npm ci --ignore-scripts --no-audit --no-fund
              bash scripts/bootstrap-toolchains.sh
          - name: Install all JavaScript browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the production runtime for receiver packages
            shell: bash
            run: |
              set -euo pipefail
              mkdir -p build
              bash scripts/build-lean-link-spike.sh 2>&1 | tee build/owned-javascript-receiver-runtime.log
              test -s build/lean-link-spike/lazy/main.wasm
          - name: Verify JavaScript receiver packages
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              npm run test:owned-javascript-receivers 2>&1 | tee build/owned-javascript-receivers.log
              rg '^# tests 28$' build/owned-javascript-receivers.log
              rg '^# pass 28$' build/owned-javascript-receivers.log
              rg '^# fail 0$' build/owned-javascript-receivers.log
              rg '^# cancelled 0$' build/owned-javascript-receivers.log
              rg '^# skipped 0$' build/owned-javascript-receivers.log
              test -s build/owned-javascript-receivers/ordinary.json
              test -s build/owned-javascript-receivers/ordinary-plain-false.json
              test -s build/owned-javascript-receivers/ordinary-plain-true.json
              test -s build/owned-javascript-receivers/ordinary-unanchored.json
              test -s build/owned-javascript-receivers/ordinary-gc.json
              test -s build/owned-javascript-receivers/ordinary-mutants.json
              test -s build/owned-javascript-receivers/ordinary-owned-first.json
              test -s build/owned-javascript-receivers/ordinary-copied-first.json
              test -s build/owned-javascript-receivers/ordinary-plain-package.json
              test -s build/owned-javascript-receivers/ordinary-consuming-package.json
              test -s build/owned-javascript-receivers/ordinary-unanchored-package.json
              test -s build/owned-javascript-receivers/reviewed.json
              test -s build/owned-javascript-receivers/reviewed-plain-false.json
              test -s build/owned-javascript-receivers/reviewed-plain-true.json
              test -s build/owned-javascript-receivers/reviewed-unanchored.json
              test -s build/owned-javascript-receivers/reviewed-gc.json
              test -s build/owned-javascript-receivers/reviewed-mutants.json
              test -s build/owned-javascript-receivers/reviewed-owned-first.json
              test -s build/owned-javascript-receivers/reviewed-copied-first.json
              test -s build/owned-javascript-receivers/reviewed-plain-package.json
              test -s build/owned-javascript-receivers/reviewed-consuming-package.json
              test -s build/owned-javascript-receivers/reviewed-unanchored-package.json
              test -s build/owned-javascript-receiver-packaging/report.json
          - name: Preserve JavaScript receiver acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: javascript-receivers-${{ github.sha }}
              path: |
                build/owned-javascript-receivers/
                build/owned-javascript-receiver-packaging/
                build/owned-javascript-receivers.log
                build/owned-javascript-receiver-runtime.log
              if-no-files-found: error
              retention-days: 30
    
      owned-dotnet-callback-results:
        name: Callback-result lifetimes in installed NuGet packages
        runs-on: ubuntu-24.04
        timeout-minutes: 240
        env:
          EMCC_CORES: "2"
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Select Python 3.11 for backported type aliases
            id: callback_python311
            uses: actions/setup-python@v7
            with:
              python-version: "3.11"
          - name: Select Python 3.12 for standard-library type aliases
            id: callback_python312
            uses: actions/setup-python@v7
            with:
              python-version: "3.12"
          - name: Select Ruby 3.3
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Select .NET 8 SDK
            uses: actions/setup-dotnet@v6
            with:
              dotnet-version: '8.0.424'
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install callback acceptance tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake git jq libgmp-dev libuv1-dev m4 pkg-config python3-venv ripgrep zstd
          - name: Install callback acceptance tools
            run: |
              npm ci --ignore-scripts --no-audit --no-fund
              bash scripts/bootstrap-toolchains.sh
              bash scripts/bootstrap-rust-ci.sh
              python3 -m pip download --no-cache-dir --only-binary=:all: --no-deps --dest build/python-typing-wheels/4.6.0 typing_extensions==4.6.0
              python3 -m pip download --no-cache-dir --only-binary=:all: --no-deps --dest build/python-typing-wheels/4.16.0 typing_extensions==4.16.0
              python3 -m venv build/python-collection-typecheck
              build/python-collection-typecheck/bin/python -m pip install --no-cache-dir mypy==2.3.1 typing_extensions==4.16.0 mypy_extensions==1.1.0 pathspec==1.1.1 librt==0.15.0 ast-serialize==0.11.2
          - name: Install all callback browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the callback shared runtime
            shell: bash
            run: |
              set -euo pipefail
              mkdir -p build
              bash scripts/build-lean-link-spike.sh 2>&1 | tee build/owned-dotnet-callback-result-runtime.log
              test -s build/lean-link-spike/lazy/main.wasm
          - name: Verify .NET callback-result lifetimes
            shell: bash
            env:
              LEAN_BRIDGE_PYTHON: ${{ steps.callback_python311.outputs.python-path }}
              LEAN_BRIDGE_COLLECTION_PYTHONS: '["${{ steps.callback_python311.outputs.python-path }}", "${{ steps.callback_python312.outputs.python-path }}"]'
            run: |
              set -euo pipefail
              source scripts/env.sh
              export LEAN_BRIDGE_DOTNET="$(command -v dotnet)"
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              npm run test:owned-dotnet-callback-results 2>&1 | tee build/owned-dotnet-callback-results.log
              rg '^# tests 26$' build/owned-dotnet-callback-results.log
              rg '^# pass 26$' build/owned-dotnet-callback-results.log
              rg '^# fail 0$' build/owned-dotnet-callback-results.log
              rg '^# cancelled 0$' build/owned-dotnet-callback-results.log
              rg '^# skipped 0$' build/owned-dotnet-callback-results.log
              test -s build/owned-dotnet-callback-results/ordinary-no-host.json
              test -s build/owned-dotnet-callback-results/ordinary-no-host-lifetime.json
              test -s build/owned-dotnet-callback-results/ordinary-host.json
              test -s build/owned-dotnet-callback-results/ordinary-host-lifetime.json
              test -s build/owned-dotnet-callback-results/ordinary-combined.json
              test -s build/owned-dotnet-callback-results/ordinary-combined-lifetime.json
              test -s build/owned-dotnet-callback-results/ordinary-no-host-process.json
              test -s build/owned-dotnet-callback-results/ordinary-no-host-sanitizers.json
              test -s build/owned-dotnet-callback-results/ordinary-no-host-package.json
              test -s build/owned-dotnet-callback-results/ordinary-combined-process.json
              test -s build/owned-dotnet-callback-results/ordinary-combined-sanitizers.json
              test -s build/owned-dotnet-callback-results/ordinary-combined-package.json
              test -s build/owned-dotnet-callback-results/ordinary-combined-release.json
              test -s build/owned-dotnet-callback-results/reviewed-no-host.json
              test -s build/owned-dotnet-callback-results/reviewed-no-host-lifetime.json
              test -s build/owned-dotnet-callback-results/reviewed-host.json
              test -s build/owned-dotnet-callback-results/reviewed-host-lifetime.json
              test -s build/owned-dotnet-callback-results/reviewed-combined.json
              test -s build/owned-dotnet-callback-results/reviewed-combined-lifetime.json
              test -s build/owned-dotnet-callback-results/reviewed-no-host-process.json
              test -s build/owned-dotnet-callback-results/reviewed-no-host-sanitizers.json
              test -s build/owned-dotnet-callback-results/reviewed-no-host-package.json
              test -s build/owned-dotnet-callback-results/reviewed-combined-process.json
              test -s build/owned-dotnet-callback-results/reviewed-combined-sanitizers.json
              test -s build/owned-dotnet-callback-results/reviewed-combined-package.json
              test -s build/owned-dotnet-callback-results/reviewed-combined-release.json
          - name: Reconstruct .NET callback execution evidence
            shell: bash
            run: |
              set -euo pipefail
              npm run test:owned-dotnet-callback-evidence 2>&1 | tee build/owned-dotnet-callback-evidence.log
              rg '^# tests 8$' build/owned-dotnet-callback-evidence.log
              rg '^# pass 8$' build/owned-dotnet-callback-evidence.log
              rg '^# fail 0$' build/owned-dotnet-callback-evidence.log
              rg '^# cancelled 0$' build/owned-dotnet-callback-evidence.log
              rg '^# skipped 0$' build/owned-dotnet-callback-evidence.log
          - name: Preserve .NET callback-result acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: dotnet-callback-results-${{ github.sha }}
              path: |
                build/owned-dotnet-callback-results/
                build/owned-dotnet-callback-results.log
                build/owned-dotnet-callback-evidence.log
                build/owned-dotnet-callback-result-runtime.log
              if-no-files-found: error
              retention-days: 30
    
      owned-perl-callback-results:
        name: Callback-result lifetimes in installed CPAN packages
        runs-on: ubuntu-24.04
        timeout-minutes: 240
        env:
          EMCC_CORES: "2"
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Select Java 22
            uses: actions/setup-java@v4
            with:
              distribution: temurin
              java-version: '22.0.2'
          - name: Select Python 3.11 for backported type aliases
            id: perl_callback_python311
            uses: actions/setup-python@v7
            with:
              python-version: "3.11"
          - name: Select Python 3.12 for standard-library type aliases
            id: perl_callback_python312
            uses: actions/setup-python@v7
            with:
              python-version: "3.12"
          - name: Select Ruby 3.3
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Select .NET 8 SDK
            uses: actions/setup-dotnet@v6
            with:
              dotnet-version: '8.0.424'
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install native tools, Maven, Lean and Kotlin
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake curl git jq libgmp-dev libuv1-dev m4 maven pkg-config python3-venv ripgrep unzip zstd
          - name: Install native tools, Maven, Lean and Kotlin
            shell: bash
            run: |
              set -euo pipefail
              npm ci --ignore-scripts --no-audit --no-fund
              bash scripts/bootstrap-toolchains.sh
              bash scripts/bootstrap-rust-ci.sh
              python3 -m pip download --no-cache-dir --only-binary=:all: --no-deps --dest build/python-typing-wheels/4.6.0 typing_extensions==4.6.0
              python3 -m pip download --no-cache-dir --only-binary=:all: --no-deps --dest build/python-typing-wheels/4.16.0 typing_extensions==4.16.0
              python3 -m venv build/python-collection-typecheck
              build/python-collection-typecheck/bin/python -m pip install --no-cache-dir mypy==2.3.1 typing_extensions==4.16.0 mypy_extensions==1.1.0 pathspec==1.1.1 librt==0.15.0 ast-serialize==0.11.2
              mkdir -p build
              curl -fL --retry 3 --output build/kotlin-compiler.zip https://github.com/JetBrains/kotlin/releases/download/v2.2.0/kotlin-compiler-2.2.0.zip
              echo '1adb6f1a5845ba0aa5a59e412e44c8e405236b957de1a9683619f1dca3b16932  build/kotlin-compiler.zip' | sha256sum --check
              unzip -q build/kotlin-compiler.zip -d build/kotlin-tools
          - name: Restore the four checksummed Perl ABIs
            uses: actions/cache@v4
            with:
              path: .toolchains/perl
              key: perl-callback-abis-v1-${{ runner.os }}-${{ hashFiles('scripts/build-perl-toolchains.mjs') }}
          - name: Build every pinned Perl ABI
            shell: bash
            run: |
              set -euo pipefail
              node scripts/build-perl-toolchains.mjs 5.36.3 threaded
              node scripts/build-perl-toolchains.mjs 5.36.3 unthreaded
              node scripts/build-perl-toolchains.mjs 5.38.2 threaded
              node scripts/build-perl-toolchains.mjs 5.38.2 unthreaded
          - name: Install all callback browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the callback shared runtime
            shell: bash
            run: |
              set -euo pipefail
              mkdir -p build
              bash scripts/build-lean-link-spike.sh 2>&1 | tee build/owned-perl-callback-result-runtime.log
              test -s build/lean-link-spike/lazy/main.wasm
          - name: Verify Perl callback-result lifetimes and installed consumers
            shell: bash
            env:
              LEAN_BRIDGE_PYTHON: ${{ steps.perl_callback_python311.outputs.python-path }}
              LEAN_BRIDGE_COLLECTION_PYTHONS: '["${{ steps.perl_callback_python311.outputs.python-path }}", "${{ steps.perl_callback_python312.outputs.python-path }}"]'
            run: |
              set -euo pipefail
              source scripts/env.sh
              export LEAN_BRIDGE_JAVAC="$JAVA_HOME/bin/javac"
              export LEAN_BRIDGE_JAVA="$JAVA_HOME/bin/java"
              export LEAN_BRIDGE_MAVEN="$(command -v mvn)"
              export LEAN_BRIDGE_KOTLINC="$PWD/build/kotlin-tools/kotlinc/bin/kotlinc"
              export LEAN_BRIDGE_DOTNET="$(command -v dotnet)"
              export LEAN_BRIDGE_RUBY="$(command -v ruby)"
              export LEAN_BRIDGE_GEM="$(command -v gem)"
              npm run test:owned-perl-callback-results 2>&1 | tee build/owned-perl-callback-results.log
              rg '^# tests 41$' build/owned-perl-callback-results.log
              rg '^# pass 41$' build/owned-perl-callback-results.log
              rg '^# fail 0$' build/owned-perl-callback-results.log
              rg '^# cancelled 0$' build/owned-perl-callback-results.log
              rg '^# skipped 0$' build/owned-perl-callback-results.log
              test -s build/owned-perl-callback-results/ordinary-no-host.json
              test -s build/owned-perl-callback-results/ordinary-host.json
              test -s build/owned-perl-callback-results/ordinary-combined.json
              test -s build/owned-perl-callback-results/ordinary-combined-package.json
              test -s build/owned-perl-callback-results/ordinary-combined-release.json
              test -s build/owned-perl-callback-results/reviewed-no-host.json
              test -s build/owned-perl-callback-results/reviewed-host.json
              test -s build/owned-perl-callback-results/reviewed-combined.json
              test -s build/owned-perl-callback-results/reviewed-combined-package.json
              test -s build/owned-perl-callback-results/reviewed-combined-release.json
              test -s build/owned-perl-callback-result-faults/ordinary.json
              test -s build/owned-perl-callback-result-faults/reviewed.json
              test -s build/owned-perl-callback-result-lifetime/ordinary.json
              test -s build/owned-perl-callback-result-lifetime/reviewed.json
              test -s build/owned-perl-callback-result-mutants/ordinary.json
              test -s build/owned-perl-callback-result-mutants/reviewed.json
              test -s build/owned-perl-callback-result-sanitizers/ordinary.json
              test -s build/owned-perl-callback-result-sanitizers/reviewed.json
              test -s build/owned-perl-callback-result-variants/ordinary-no-host-package.json
              test -s build/owned-perl-callback-result-variants/ordinary-host-package.json
              test -s build/owned-perl-callback-result-variants/reviewed-no-host-package.json
              test -s build/owned-perl-callback-result-variants/reviewed-host-package.json
          - name: Reconstruct Perl callback execution evidence
            shell: bash
            run: |
              set -euo pipefail
              npm run test:owned-perl-callback-evidence 2>&1 | tee build/owned-perl-callback-evidence.log
              rg '^# tests 16$' build/owned-perl-callback-evidence.log
              rg '^# pass 16$' build/owned-perl-callback-evidence.log
              rg '^# fail 0$' build/owned-perl-callback-evidence.log
              rg '^# cancelled 0$' build/owned-perl-callback-evidence.log
              rg '^# skipped 0$' build/owned-perl-callback-evidence.log
          - name: Preserve Perl callback-result acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: perl-callback-results-${{ github.sha }}
              path: |
                build/owned-perl-callback-results/
                build/owned-perl-callback-result-faults/
                build/owned-perl-callback-result-lifetime/
                build/owned-perl-callback-result-mutants/
                build/owned-perl-callback-result-sanitizers/
                build/owned-perl-callback-result-variants/
                build/owned-perl-callback-results.log
                build/owned-perl-callback-evidence.log
                build/owned-perl-callback-result-runtime.log
              if-no-files-found: error
              retention-days: 30
    
      owned-jvm-callback-results:
        name: Callback-result lifetimes in installed Maven packages
        runs-on: ubuntu-24.04
