              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=rust LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=rust LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/rust.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-rust.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/rust.json
              test -s build/native-fin-record-zero/reviewed-rust.json
