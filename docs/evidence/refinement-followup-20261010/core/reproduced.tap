              test -s build/collections/python.json
              test -s build/collections/python-docs.json
              LEAN_BRIDGE_PYTHON_GRAPH_TEST=1 node --test tests/python-copied-graph-values.test.mjs
              test -s build/recursive/python-values.json
              LEAN_BRIDGE_PYTHON_GRAPH_TEST=1 LEAN_BRIDGE_PYTHON_GRAPH_NATIVE_TEST=1 node --test tests/python-copied-graph-conversions.test.mjs
              test -s build/recursive/python-conversions.json
              test -s build/recursive/python-native.json
              LEAN_BRIDGE_PYTHON_GRAPH_PACKAGE_TEST=1 node --test tests/python-graph-package.test.mjs
              test -s build/recursive/python-packages.json
              bash scripts/bootstrap-rust-ci.sh
              export LEAN_BRIDGE_RUSTC="$PWD/.toolchains/rust-1.90.0/bin/rustc"
              export LEAN_BRIDGE_CARGO="$PWD/.toolchains/rust-1.90.0/bin/cargo"
              export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-python-runtime.test.mjs tests/owned-python-values.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-python-packaging.test.mjs tests/owned-python-scalar-packaging.test.mjs
              npm run test:owned-python-transfers
              test -s build/owned-python-transfers/ordinary.json
              test -s build/owned-python-transfers/reviewed.json
              test -s build/owned-python-transfer-packaging/ordinary.json
              test -s build/owned-python-transfer-packaging/reviewed.json
              npm run test:owned-python-borrows > build/owned-python-borrows.log 2>&1
              cat build/owned-python-borrows.log
              rg '^# pass 8$' build/owned-python-borrows.log
              rg '^# fail 0$' build/owned-python-borrows.log
              rg '^# skipped 0$' build/owned-python-borrows.log
              test -s build/owned-python-borrows/ordinary.json
              test -s build/owned-python-borrows/reviewed.json
              test -s build/owned-python-borrows/typing.json
              test -s build/owned-python-borrows/borrow-only.json
              test -s build/owned-python-borrow-packaging/ordinary.json
              test -s build/owned-python-borrow-packaging/reviewed.json
              npm run test:owned-python-receivers > build/owned-python-receivers.log 2>&1
              cat build/owned-python-receivers.log
              rg '^# tests 11$' build/owned-python-receivers.log
              rg '^# pass 11$' build/owned-python-receivers.log
              rg '^# fail 0$' build/owned-python-receivers.log
              rg '^# cancelled 0$' build/owned-python-receivers.log
              rg '^# skipped 0$' build/owned-python-receivers.log
              test -s build/owned-python-receivers/ordinary.json
              test -s build/owned-python-receivers/reviewed.json
              test -s build/owned-python-receivers/ordinary-package.json
              test -s build/owned-python-receivers/reviewed-package.json
              test -s build/owned-python-receivers/ordinary-plain.json
              test -s build/owned-python-receivers/reviewed-plain.json
              test -s build/owned-python-receivers/ordinary-consuming.json
              test -s build/owned-python-receivers/reviewed-consuming.json
              test -s build/owned-python-receivers/typing.json
              test -s build/owned-python-packaging/ordinary.json
              test -s build/owned-python-packaging/reviewed.json
              test -s build/owned-python-packaging/scalars-ordinary.json
              test -s build/owned-python-packaging/scalars-reviewed.json
              test -s build/type-corpus/python.json
              test -s build/type-corpus/reviewed-native-python.json
