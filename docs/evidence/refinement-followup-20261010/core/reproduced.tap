              test -s build/owned-python-callback-results/ordinary-no-host-package.json
              test -s build/owned-python-callback-results/ordinary-combined-package.json
              test -s build/owned-python-callback-results/ordinary-combined-release.json
              test -s build/owned-python-callback-results/runtime-reviewed-no-host.json
              test -s build/owned-python-callback-results/runtime-reviewed-host.json
              test -s build/owned-python-callback-results/runtime-reviewed-combined.json
              test -s build/owned-python-callback-results/reviewed-no-host-package.json
              test -s build/owned-python-callback-results/reviewed-combined-package.json
              test -s build/owned-python-callback-results/reviewed-combined-release.json
          - name: Preserve Python callback-result acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: python-callback-results-${{ github.sha }}
              path: |
                build/owned-python-callback-results/
                build/owned-python-callback-results.log
                build/owned-python-callback-result-runtime.log
              if-no-files-found: error
              retention-days: 30
    
      owned-rust-callback-results:
        name: Callback-result lifetimes in installed Rust packages
        runs-on: ubuntu-24.04
        timeout-minutes: 150
        env:
          EMCC_CORES: "2"
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install callback acceptance tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake git jq libgmp-dev libuv1-dev m4 pkg-config python3 ripgrep zstd
          - name: Install callback acceptance tools
            run: |
              npm ci --ignore-scripts --no-audit --no-fund
              bash scripts/bootstrap-toolchains.sh
              bash scripts/bootstrap-rust-ci.sh
          - name: Install all callback browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the callback shared runtime
            shell: bash
            run: |
              set -euo pipefail
              mkdir -p build
              bash scripts/build-lean-link-spike.sh 2>&1 | tee build/owned-rust-callback-result-runtime.log
              test -s build/lean-link-spike/lazy/main.wasm
          - name: Verify Rust callback-result lifetimes
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              npm run test:owned-rust-callback-results 2>&1 | tee build/owned-rust-callback-results.log
              rg '^# tests 13$' build/owned-rust-callback-results.log
              rg '^# pass 13$' build/owned-rust-callback-results.log
              rg '^# fail 0$' build/owned-rust-callback-results.log
              rg '^# cancelled 0$' build/owned-rust-callback-results.log
              rg '^# skipped 0$' build/owned-rust-callback-results.log
              test -s build/owned-rust-callback-results/ordinary-no-host.json
              test -s build/owned-rust-callback-results/ordinary-host.json
              test -s build/owned-rust-callback-results/ordinary-combined.json
              test -s build/owned-rust-callback-results/ordinary-no-host-package.json
              test -s build/owned-rust-callback-results/ordinary-combined-package.json
              test -s build/owned-rust-callback-results/ordinary-combined-release.json
              test -s build/owned-rust-callback-results/reviewed-no-host.json
              test -s build/owned-rust-callback-results/reviewed-host.json
              test -s build/owned-rust-callback-results/reviewed-combined.json
              test -s build/owned-rust-callback-results/reviewed-no-host-package.json
              test -s build/owned-rust-callback-results/reviewed-combined-package.json
              test -s build/owned-rust-callback-results/reviewed-combined-release.json
          - name: Preserve Rust callback-result acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: rust-callback-results-${{ github.sha }}
              path: |
                build/owned-rust-callback-results/
                build/owned-rust-callback-results.log
                build/owned-rust-callback-result-runtime.log
              if-no-files-found: error
              retention-days: 30
    
