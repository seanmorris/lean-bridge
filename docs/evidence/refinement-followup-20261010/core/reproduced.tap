      owned-callback-results:
        name: Callback-result lifetimes in installed C and npm packages
        runs-on: ubuntu-24.04
        timeout-minutes: 150
        env:
          EMCC_CORES: "2"
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install callback acceptance tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake git jq libgmp-dev libuv1-dev m4 pkg-config python3 ripgrep zstd
          - name: Install callback acceptance tools
            run: |
              npm ci --ignore-scripts --no-audit --no-fund
              bash scripts/bootstrap-toolchains.sh
          - name: Install all callback browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the callback shared runtime
            shell: bash
            run: |
              set -euo pipefail
              mkdir -p build
              bash scripts/build-lean-link-spike.sh 2>&1 | tee build/owned-callback-result-runtime.log
              test -s build/lean-link-spike/lazy/main.wasm
          - name: Verify callback-result lifetimes
            shell: bash
            run: |
              set -euo pipefail
              source scripts/env.sh
              npm run test:owned-callback-results 2>&1 | tee build/owned-callback-results.log
              rg '^# tests 33$' build/owned-callback-results.log
              rg '^# pass 33$' build/owned-callback-results.log
              rg '^# fail 0$' build/owned-callback-results.log
              rg '^# cancelled 0$' build/owned-callback-results.log
              rg '^# skipped 0$' build/owned-callback-results.log
              test -s build/owned-callback-results/metadata-ordinary.json
              test -s build/owned-callback-results/runtime-ordinary-false.json
              test -s build/owned-callback-results/runtime-ordinary-true.json
              test -s build/owned-callback-results/wasm-ordinary-false.json
              test -s build/owned-callback-results/wasm-ordinary-true.json
              test -s build/owned-callback-results/coexistence-ordinary-false.json
              test -s build/owned-callback-results/coexistence-ordinary-true.json
              test -s build/owned-callback-results/wasm-ordinary-mutants.json
              test -s build/owned-callback-results/wasm-ordinary-combinations.json
              test -s build/owned-callback-results/ordinary-c-package.json
              test -s build/owned-callback-results/ordinary-combined-package.json
              test -s build/owned-callback-results/metadata-reviewed.json
              test -s build/owned-callback-results/runtime-reviewed-false.json
              test -s build/owned-callback-results/runtime-reviewed-true.json
              test -s build/owned-callback-results/wasm-reviewed-false.json
              test -s build/owned-callback-results/wasm-reviewed-true.json
              test -s build/owned-callback-results/coexistence-reviewed-false.json
              test -s build/owned-callback-results/coexistence-reviewed-true.json
              test -s build/owned-callback-results/wasm-reviewed-mutants.json
              test -s build/owned-callback-results/wasm-reviewed-combinations.json
              test -s build/owned-callback-results/reviewed-c-package.json
              test -s build/owned-callback-results/reviewed-combined-package.json
              test -s build/owned-callback-results/npm-package.json
          - name: Preserve callback-result acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: callback-results-${{ github.sha }}
              path: |
                build/owned-callback-results/
                build/owned-callback-results.log
                build/owned-callback-result-runtime.log
              if-no-files-found: error
              retention-days: 30
    
      node-consumers:
        name: Node and browser npm consumers
        runs-on: ubuntu-24.04
        # Run 37805067353 hit three hours during the corpus. Leave time for the
        # remaining multi-profile, installed CLI and registry/browser gates.
        timeout-minutes: 330
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install documentation browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Install archive acceptance tools
            timeout-minutes: 20
            run: sudo apt-get update && sudo apt-get install -y xz-utils zstd ripgrep
          - name: Package and execute clean Node consumers
            id: consumer
            continue-on-error: true
            env:
              LEAN_BRIDGE_DOCUMENTATION_BROWSERS: chromium,firefox,webkit
            run: npm run test:consumer:node
          - name: Prepare the standalone CLI archive with its prebuilt runtime
            run: npm run build:cli-package -- --output build/cli-package --runtime build/consumer-ci-runtime/lazy
          - name: Compile locked and dependency-free projects and install relocated npm releases offline
            env:
              LEAN_BRIDGE_LAKE_WASM_TEST: "1"
              LEAN_BRIDGE_LAKE_GENERATED_PACKAGES_TEST: "1"
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
            run: |
              nix build .#component-build-engine --out-link build/locked-lake-engine
              node --test tests/component-publication.test.mjs
              node --test tests/lake-wasm.test.mjs
              node --test tests/unlocked-component.test.mjs
              node --test tests/scalar-fin-rejection.test.mjs
              test -s build/scalar-fin-rejection/report.json
              node --test tests/generic-records.test.mjs
              test -s build/generic-records/npm.json
              test -s build/generic-records/specialized-npm.json
              LEAN_BRIDGE_REVIEWED_NPM_PACKAGING_TEST=1 node --test --test-concurrency=1 tests/reviewed-npm-packaging.test.mjs
              LEAN_BRIDGE_REVIEWED_SPECIALIZATION_NPM_TEST=1 node --test --test-name-pattern='independently reviewed npm package' tests/reviewed-specializations.test.mjs
              test -s build/reviewed-specializations/npm.json
              LEAN_BRIDGE_CHECKED_RECORD_NPM_TEST=1 node --test --test-concurrency=1 --test-name-pattern='npm package' tests/checked-records.test.mjs
              test -s build/checked-records/npm.json
              test -s build/checked-records/reviewed-npm.json
              test -s build/checked-records/result-only-npm.json
              node --test --test-name-pattern='npm releases|publication dry run' tests/lake-generated-packages.test.mjs
          - name: Account Lean source entry on every installed scalar Fin call (instrumented probe packages)
            shell: bash
            env:
              LEAN_BRIDGE_LAKE_WASM_TEST: "1"
              LEAN_BRIDGE_SCALAR_FIN_SOURCE_ENTRY: "1"
              LEAN_BRIDGE_SCALAR_FIN_SOURCE_ENTRY_REPORT: build/scalar-fin-source-entry/report.json
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
            run: |
              set -euo pipefail
              mkdir -p build/scalar-fin-source-entry
              node --test --test-concurrency=1 --test-reporter=tap --test-name-pattern='^installed scalar Fin rejections never enter the Lean source on any private ABI$' tests/scalar-fin-rejection.test.mjs | tee build/scalar-fin-source-entry/run.tap
              node scripts/check-scalar-fin-source-entry-run.mjs build/scalar-fin-source-entry
          - name: Preserve reviewed specialization npm observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: reviewed-specializations-npm-${{ github.sha }}
              path: build/reviewed-specializations/npm.json
              if-no-files-found: error
              retention-days: 30
          - name: Preserve checked-record npm observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: checked-records-npm-${{ github.sha }}
              path: |
                build/checked-records/npm.json
                build/checked-records/reviewed-npm.json
                build/checked-records/result-only-npm.json
              if-no-files-found: error
              retention-days: 30
          - name: Check ordinary and reviewed Fin packages in Node, TypeScript and browsers
            id: reviewed_fin_npm
            timeout-minutes: 60
            env:
              LEAN_BRIDGE_REVIEWED_FIN_WASM_TEST: "1"
              LEAN_BRIDGE_REVIEWED_FIN_WASM_BROWSER_TEST: "1"
              LEAN_BRIDGE_TYPE_CORPUS_BROWSERS: chromium,firefox,webkit
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
            run: |
              node --test --test-concurrency=1 --test-name-pattern='Fin runs in source-free installed npm packages' tests/generic-records.test.mjs
              test -s build/reviewed-fin-wasm/ordinary-scalar.json
              test -s build/reviewed-fin-wasm/reviewed-scalar.json
              test -s build/reviewed-fin-wasm/ordinary-structural.json
              test -s build/reviewed-fin-wasm/reviewed-structural.json
          - name: Preserve ordinary and reviewed Fin npm observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: reviewed-fin-npm-${{ github.sha }}
              path: build/reviewed-fin-wasm/*.json
              if-no-files-found: error
              retention-days: 30
          - name: Check alias-named generic records in browser pages, React effects and workers
            id: generic_record_browser
            timeout-minutes: 60
            env:
              LEAN_BRIDGE_GENERIC_RECORD_BROWSER_TEST: "1"
              LEAN_BRIDGE_TYPE_CORPUS_BROWSERS: chromium,firefox,webkit
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
            run: |
              node --test --test-concurrency=1 tests/generic-records-browser.test.mjs
              test -s build/generic-records/browser.json
          - name: Preserve browser generic-record observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: generic-records-browser-${{ github.sha }}
              path: build/generic-records/browser.json
              if-no-files-found: error
              retention-days: 30
          - name: Build and install owned npm exports through real Nix
            shell: bash
            env:
              LEAN_BRIDGE_OWNED_JS_NIX_TEST: "1"
              LEAN_BRIDGE_NIX_TOOLCHAIN_TEST: "1"
              LEAN_BRIDGE_OWNED_JS_WASM_PREPARED_ROOT: build/consumer-ci-runtime
            run: |
              set -euo pipefail
              node --test --test-concurrency=1 \
                tests/nix-toolchain-installation.test.mjs \
                tests/owned-javascript-nix-installed.test.mjs \
                2>&1 | tee build/owned-nix-installed.log
              test -s build/owned-nix-installed.log
              rg '^# pass 7$' build/owned-nix-installed.log
              rg '^# fail 0$' build/owned-nix-installed.log
              rg '^# skipped 0$' build/owned-nix-installed.log
          - name: Preserve real Nix owned npm acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-nix-installed-${{ github.sha }}
              path: build/owned-nix-installed.log
              if-no-files-found: error
              retention-days: 30
          - name: Compare installed Node, browser, React and worker corpus packages with fresh Lean
            id: type_corpus_npm
            continue-on-error: true
            env:
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
              LEAN_BRIDGE_TYPE_CORPUS_BROWSERS: chromium,firefox,webkit
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
              npm run test:type-corpus:npm
              npm run test:type-corpus:reviewed-npm
              node --test tests/component-char.test.mjs
              node --test tests/component-words.test.mjs
              node --test tests/component-callables.test.mjs
              node --test tests/component-structured-callables.test.mjs
              node --test tests/component-arrays.test.mjs
              node --test tests/component-records.test.mjs
              node --test tests/component-compounds.test.mjs
              node --test tests/component-lists.test.mjs
              node --test tests/component-variant-runtime.test.mjs tests/component-variants.test.mjs
              node --test tests/component-aliases.test.mjs
              node --test tests/component-recursive.test.mjs
              LEAN_BRIDGE_LAKE_WASM_TEST=1 node --test tests/browser-refinements.test.mjs
              test -s build/browser-refinements/report.json
              test -s build/callables/npm/report.json
              test -s build/structured-callables/npm/report.json
              test -s build/arrays/npm/report.json
              test -s build/records/npm/report.json
              test -s build/compounds/npm/report.json
              test -s build/compounds/recordless/report.json
              test -s build/lists/npm/report.json
              test -s build/variants/npm/report.json
              test -s build/aliases/npm/report.json
              test -s build/recursive/npm/report.json
              test -s build/word-npm/report.json
              test -s build/char-npm/report.json
              test -s build/type-corpus/browser-javascript-browser-react-browser-worker-node-javascript-node-typescript.json
              test -s build/type-corpus/reviewed-wasm-browser-javascript-browser-react-browser-worker-node-javascript-node-typescript.json
          - name: Preserve installed npm corpus observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-npm-${{ github.sha }}
              path: |
                build/type-corpus/browser-javascript-browser-react-browser-worker-node-javascript-node-typescript.json
                build/type-corpus/reviewed-wasm-browser-javascript-browser-react-browser-worker-node-javascript-node-typescript.json
                build/browser-refinements/report.json
                build/scalar-fin-rejection/report.json
                build/scalar-fin-source-entry/
                build/generic-records/npm.json
                build/generic-records/specialized-npm.json
                build/char-npm/
                build/word-npm/
                build/callables/npm/
                build/structured-callables/npm/
                build/arrays/npm/
                build/records/npm/
                build/compounds/
                build/lists/npm/
                build/variants/npm/
                build/aliases/npm/
                build/recursive/npm/
              if-no-files-found: error
              retention-days: 30
          - name: Install C# for the combined native projection
            uses: actions/setup-dotnet@v6
            with:
              dotnet-version: '8.0.424'
          - name: Install Java for the combined native projection
            uses: actions/setup-java@v4
            with:
              distribution: temurin
              java-version: '22.0.2'
          - name: Install Ruby for the combined native projection
            uses: ruby/setup-ruby@v1
            with:
              ruby-version: '3.3.12'
          - name: Install dependencies for Build one captured API for npm, CPAN, C, C++, NuGet, Maven, RubyGems, WIT, PyPI, Cargo and PHP and execute installations
            timeout-minutes: 20
            run: |
              sudo apt-get update && sudo apt-get install -y build-essential libperl-dev pkg-config python3-venv php-cli php-common composer zstd m4 unzip
          - name: Build one captured API for npm, CPAN, C, C++, NuGet, Maven, RubyGems, WIT, PyPI, Cargo and PHP and execute installations
            env:
              LEAN_BRIDGE_MULTI_PROFILE_TEST: "1"
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
              bash scripts/bootstrap-toolchains.sh --wasm-tools-only
              bash scripts/bootstrap-rust-ci.sh
              export LEAN_BRIDGE_RUSTC="$PWD/.toolchains/rust-1.90.0/bin/rustc"
              export LEAN_BRIDGE_CARGO="$PWD/.toolchains/rust-1.90.0/bin/cargo"
              nix build .#wasmtime-c-api --out-link build/wasmtime-c-api
              export LEAN_BRIDGE_WASMTIME_C_API="$PWD/build/wasmtime-c-api"
              curl -fL --retry 3 --output build/combined-kotlin-compiler.zip https://github.com/JetBrains/kotlin/releases/download/v2.2.0/kotlin-compiler-2.2.0.zip
              echo '1adb6f1a5845ba0aa5a59e412e44c8e405236b957de1a9683619f1dca3b16932  build/combined-kotlin-compiler.zip' | sha256sum --check
              unzip -q build/combined-kotlin-compiler.zip -d build/combined-kotlin-tools
              export LEAN_BRIDGE_JAVAC="$JAVA_HOME/bin/javac"
              export LEAN_BRIDGE_JAVA="$JAVA_HOME/bin/java"
              export LEAN_BRIDGE_KOTLINC="$PWD/build/combined-kotlin-tools/kotlinc/bin/kotlinc"
              source scripts/env.sh
              node --test tests/multi-profile-project.test.mjs
          - name: Check documentation API captures through compiler-backed public analysis
            run: LEAN_BRIDGE_BUILD_BACKEND=nix node scripts/capture-reference-apis.mjs
          - name: Build and consume a Lean project through the tarball-installed CLI
            run: npm run acceptance:cli-package -- --candidate build/cli-package --output build/cli-package-acceptance --backend nix
          - name: Install the disposable npm registry
            run: npm install --prefix build/registry-tools --ignore-scripts --no-audit --no-fund verdaccio@6.2.0
          - name: Publish through the installed CLI and consume only the component
            run: >-
              node scripts/check-local-npm-release.mjs
              --verdaccio build/registry-tools/node_modules/.bin/verdaccio
              --candidate build/cli-package --output build/cli-registry-acceptance
              --backend nix --browsers chromium,firefox,webkit
          - name: Preserve the CLI candidate and installed-author evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: cli-package-acceptance-${{ github.sha }}
              path: |
                build/cli-package/*.tgz
                build/cli-package/cli-package-report.json
                build/cli-package-acceptance
                build/cli-registry-acceptance
              if-no-files-found: warn
              retention-days: 30
          - name: Record Node observations
            if: always()
            shell: bash
            run: |
              test_result="${{ steps.consumer.outcome == 'success' && steps.type_corpus_npm.outcome == 'success' && steps.reviewed_fin_npm.outcome == 'success' && 'passed' || 'failed' }}"
              executed="${{ steps.consumer.outcome == 'success' && steps.type_corpus_npm.outcome == 'success' && steps.reviewed_fin_npm.outcome == 'success' && 'true' || 'false' }}"
              node scripts/consumer-ci.mjs record --consumer node-javascript --output build/consumer-ci/results/node-javascript.json --performance build/consumer-ci/performance/node-javascript.json --test-result "$test_result" --package-installation "$executed" --real-lean-execution "$executed" --command "npm run test:consumer:node && npm run test:type-corpus:npm && npm run test:type-corpus:reviewed-npm && node --test tests/component-char.test.mjs && node --test tests/component-words.test.mjs && node --test tests/component-callables.test.mjs && node --test tests/component-structured-callables.test.mjs && node --test tests/component-arrays.test.mjs && node --test tests/component-records.test.mjs && node --test tests/component-compounds.test.mjs && node --test tests/component-lists.test.mjs && node --test tests/component-variant-runtime.test.mjs tests/component-variants.test.mjs && node --test tests/component-aliases.test.mjs && node --test tests/component-recursive.test.mjs && LEAN_BRIDGE_REVIEWED_FIN_WASM_BROWSER_TEST=1 node --test --test-concurrency=1 --test-name-pattern='Fin runs in source-free installed npm packages' tests/generic-records.test.mjs"
              node scripts/consumer-ci.mjs record --consumer node-typescript --output build/consumer-ci/results/node-typescript.json --performance build/consumer-ci/performance/node-typescript.json --test-result "$test_result" --package-installation "$executed" --real-lean-execution "$executed" --command "npm run test:consumer:node && npm run test:type-corpus:npm && npm run test:type-corpus:reviewed-npm && node --test tests/component-char.test.mjs && node --test tests/component-words.test.mjs && node --test tests/component-callables.test.mjs && node --test tests/component-structured-callables.test.mjs && node --test tests/component-arrays.test.mjs && node --test tests/component-records.test.mjs && node --test tests/component-compounds.test.mjs && node --test tests/component-lists.test.mjs && node --test tests/component-variant-runtime.test.mjs tests/component-variants.test.mjs && node --test tests/component-aliases.test.mjs && node --test tests/component-recursive.test.mjs && LEAN_BRIDGE_REVIEWED_FIN_WASM_BROWSER_TEST=1 node --test --test-concurrency=1 --test-name-pattern='Fin runs in source-free installed npm packages' tests/generic-records.test.mjs"
          - name: Upload Node observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-node-${{ github.sha }}
              path: build/consumer-ci/results/*.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce Node support and the browser corpus
            if: steps.consumer.outcome != 'success' || steps.type_corpus_npm.outcome != 'success' || steps.reviewed_fin_npm.outcome != 'success'
            run: exit 1
          - name: Preserve executable documentation observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: documentation-consumer-results-${{ github.sha }}
              path: build/documentation-consumer-acceptance
              if-no-files-found: warn
              retention-days: 30
    
      reviewed-fin-wasm-entry:
        name: Reviewed Fin Wasm entry (${{ matrix.mode }})
        runs-on: ubuntu-24.04
        timeout-minutes: 180
        strategy:
          fail-fast: false
          matrix:
            mode: [original, probe]
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install browser engines
            timeout-minutes: 20
            run: bash scripts/install-playwright-browsers.sh chromium firefox webkit
          - name: Build the locked engine and prepared runtime
            run: |
              nix build .#universal-core-artifacts --out-link build/consumer-ci-runtime
              nix build .#component-build-engine --out-link build/locked-lake-engine
          - name: Account installed Wasm adapter and Lean source entry in Node and every browser context
            shell: bash
            env:
              LEAN_BRIDGE_REVIEWED_FIN_WASM_ENTRY_BROWSER_TEST: "1"
              LEAN_BRIDGE_TYPE_CORPUS_BROWSERS: chromium,firefox,webkit
              LEAN_BRIDGE_REVIEWED_FIN_WASM_ENTRY_REPORT_DIR: build/reviewed-fin-wasm-entry
              LEAN_BRIDGE_LAKE_ENGINE: build/locked-lake-engine/bin/lean-bridge-component-engine
              LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/consumer-ci-runtime/lazy
            run: |
              set -euo pipefail
              mkdir -p build/reviewed-fin-wasm-entry
              node --test --test-concurrency=1 --test-reporter=tap --test-name-pattern='^${{ matrix.mode }} (ordinary|independently reviewed) (scalar|structural) Fin entry is accounted in installed npm packages$' tests/reviewed-fin-wasm-entry.test.mjs 2>&1 | tee build/reviewed-fin-wasm-entry/run.tap
              node scripts/check-reviewed-fin-wasm-entry-run.mjs build/reviewed-fin-wasm-entry --mode=${{ matrix.mode }}
          - name: Preserve Wasm entry observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: reviewed-fin-wasm-entry-${{ matrix.mode }}-${{ github.sha }}-${{ github.run_attempt }}
              path: build/reviewed-fin-wasm-entry/
              if-no-files-found: error
              retention-days: 30
    
      browser-consumer:
        name: Browser npm boundary
        runs-on: ubuntu-24.04
        timeout-minutes: 120
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install dependencies and browser
            timeout-minutes: 20
            run: |
              npm ci --ignore-scripts
              npx playwright install --with-deps chromium
          - name: Install the npm archive and execute real Lean in Chromium
            id: consumer
            continue-on-error: true
            run: npm run test:consumer:browser
          - name: Record browser observations
            if: always()
            shell: bash
            run: |
              test_result="${{ steps.consumer.outcome == 'success' && 'passed' || 'failed' }}"
              executed="${{ steps.consumer.outcome == 'success' && 'true' || 'false' }}"
              node scripts/consumer-ci.mjs record --consumer browser-javascript --output build/consumer-ci/results/browser-javascript.json --performance build/consumer-ci/performance/browser-javascript.json --test-result "$test_result" --package-installation "$executed" --real-lean-execution "$executed" --command "npm run test:consumer:browser"
          - name: Upload browser observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-browser-${{ github.sha }}
              path: build/consumer-ci/results/*.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce the browser boundary
            if: steps.consumer.outcome != 'success'
            run: exit 1
    
      owned-php-callback-results:
        name: Native PHP callback-result acceptance
        runs-on: ubuntu-24.04
        timeout-minutes: 150
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install native PHP callback tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake composer curl libgmp-dev libuv1-dev pkg-config php-cli php-common php-mbstring php-zip unzip zstd ripgrep
          - name: Install native PHP callback tools
            run: |
              npm ci --ignore-scripts
              bash scripts/bootstrap-toolchains.sh --lean-only
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
          - name: Execute ordinary and reviewed native callback-result shapes
            shell: bash
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_PHP="$(command -v php)"
              source scripts/env.sh
              mkdir -p build
              npm run test:owned-php-callback-results 2>&1 | tee build/owned-php-callback-results.log
              rg '^# tests 12$' build/owned-php-callback-results.log
              rg '^# pass 12$' build/owned-php-callback-results.log
              rg '^# fail 0$' build/owned-php-callback-results.log
              rg '^# cancelled 0$' build/owned-php-callback-results.log
              rg '^# skipped 0$' build/owned-php-callback-results.log
              for mode in ordinary reviewed; do
                for variant in no-host host combined; do
                  test -s "build/owned-php-callback-results/$mode-$variant.json"
                done
              done
          - name: Build and install all six native Composer package configurations
            shell: bash
            run: |
              set -euo pipefail
              export LEAN_BRIDGE_PHP="$(command -v php)"
              export LEAN_BRIDGE_COMPOSER="$(command -v composer)"
              source scripts/env.sh
              npm run test:owned-php-callback-packages 2>&1 | tee build/owned-php-callback-packages.log
              rg '^# tests 6$' build/owned-php-callback-packages.log
              rg '^# pass 6$' build/owned-php-callback-packages.log
              rg '^# fail 0$' build/owned-php-callback-packages.log
              rg '^# cancelled 0$' build/owned-php-callback-packages.log
              rg '^# skipped 0$' build/owned-php-callback-packages.log
              for mode in ordinary reviewed; do
                for variant in no-host host combined; do
                  test -s "build/owned-php-callback-result-packaging/$mode-$variant.json"
                done
              done
          - name: Verify frozen native PHP callback acceptance
            shell: bash
            run: |
              set -euo pipefail
              npm run test:owned-php-callback-evidence 2>&1 | tee build/owned-php-callback-evidence.log
              rg '^# tests 13$' build/owned-php-callback-evidence.log
              rg '^# pass 13$' build/owned-php-callback-evidence.log
              rg '^# fail 0$' build/owned-php-callback-evidence.log
              rg '^# cancelled 0$' build/owned-php-callback-evidence.log
              rg '^# skipped 0$' build/owned-php-callback-evidence.log
          - name: Preserve native callback-result observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-php-callback-results-${{ github.sha }}
              path: |
                build/owned-php-callback-results/
                build/owned-php-callback-results.log
                build/owned-php-callback-result-packaging/
                build/owned-php-callback-packages.log
                build/owned-php-callback-evidence.log
                build/owned-aggregate-native/php-callback-results-*-inputs.json
              if-no-files-found: warn
              retention-days: 30
    
      php-receivers:
        name: Native PHP receiver methods and properties
        runs-on: ubuntu-24.04
        timeout-minutes: 90
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install native PHP receiver tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential cmake curl libgmp-dev libuv1-dev pkg-config php-cli php-common php-zip php-mbstring composer unzip zstd ripgrep
          - name: Install native PHP receiver tools
            run: |
              npm ci --ignore-scripts
              bash scripts/bootstrap-toolchains.sh --lean-only
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
          - name: Verify receiver lifetimes and installed Composer releases
            run: |
              export LEAN_BRIDGE_PHP="$(command -v php)"
              export LEAN_BRIDGE_COMPOSER="$(command -v composer)"
              source scripts/env.sh
              mkdir -p build
              npm run test:owned-php-receivers > build/owned-php-receivers.log 2>&1
              cat build/owned-php-receivers.log
              rg '^# tests 16$' build/owned-php-receivers.log
              rg '^# pass 16$' build/owned-php-receivers.log
              rg '^# fail 0$' build/owned-php-receivers.log
              rg '^# cancelled 0$' build/owned-php-receivers.log
              rg '^# skipped 0$' build/owned-php-receivers.log
              test -s build/owned-php-receivers/ordinary.json
              test -s build/owned-php-receivers/reviewed.json
              test -s build/owned-php-receivers/ordinary-plain-false.json
              test -s build/owned-php-receivers/ordinary-plain-true.json
              test -s build/owned-php-receivers/reviewed-plain-false.json
              test -s build/owned-php-receivers/reviewed-plain-true.json
              test -s build/owned-php-receivers/ordinary-unanchored.json
              test -s build/owned-php-receivers/reviewed-unanchored.json
              test -s build/owned-php-receiver-packaging/ordinary.json
              test -s build/owned-php-receiver-packaging/reviewed.json
              test -s build/owned-php-receiver-packaging/ordinary-resource.json
              test -s build/owned-php-receiver-packaging/reviewed-resource.json
              test -s build/owned-php-receiver-packaging/documentation.json
          - name: Upload native PHP receiver acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-php-receivers-${{ github.sha }}
              path: |
                build/owned-php-receivers/
                build/owned-php-receiver-packaging/
                build/owned-php-receivers.log
              if-no-files-found: error
              retention-days: 30
    
      php-wasm-receivers:
        name: PHP-Wasm receiver packages
        runs-on: ubuntu-24.04
        timeout-minutes: 180
        env:
          LEAN_WASM_RUNTIME_PROFILE: browser
          LEAN_WASM_RUNTIME_VARIANT: php-wasm-3.1.68
          LEAN_WASM_ARTIFACT_TARGET: php-wasm-emscripten-3.1.68
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Restore pinned PHP and compiler inputs
            uses: actions/cache@v5
            with:
              path: |
                .toolchains
                build/php-wasm-sdk
                build/php-wasm-host
              key: consumer-php-receivers-${{ runner.os }}-${{ hashFiles('flake.lock', 'lean-toolchain', 'scripts/bootstrap-toolchains.sh', 'scripts/bootstrap-php-wasm-ci.sh', 'poc/lean-link-spike/bindings/php-wasm.package.json') }}
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts --no-audit --no-fund
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install PHP, compiler tools and log tooling
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential autoconf automake bison flex gperf libtool re2c cmake pkg-config php-cli php-dev php-common php-zip php-mbstring composer zstd ripgrep
          - name: Install PHP, compiler tools and log tooling
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh --check-prerequisites
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
              env -i PATH=/usr/bin:/bin /usr/bin/php -r 'if (extension_loaded("xdebug")) { fwrite(STDERR, "Consumer PHP must run without Xdebug.\n"); exit(1); }'
          - name: Install dependencies for Build the pinned PHP-Wasm runtime and browser host
            timeout-minutes: 20
            run: |
              npx playwright install --with-deps chromium
          - name: Build the pinned PHP-Wasm runtime and browser host
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh
              bash scripts/bootstrap-toolchains.sh
              export LEAN_WASM_EMSDK="$GITHUB_WORKSPACE/.toolchains/emsdk-php-wasm"
              bash scripts/build-lean-runtime.sh
              source scripts/env.sh
              node --input-type=module -e 'import {prepareOwnedPhpWasmRuntime} from "./tests/helpers/owned-php-wasm-runtime.mjs"; await prepareOwnedPhpWasmRuntime("build/php-wasm-receiver-input");'
          - name: Verify PHP-Wasm receivers and installed npm and Composer packages
            env:
              LEAN_BRIDGE_TEST_PHP_COPIED_RUNTIME: build/php-wasm-receiver-input/php-wasm-runtime
            run: |
              source scripts/env.sh
              npm run test:owned-php-wasm-receivers > build/owned-php-wasm-receivers.log 2>&1
              cat build/owned-php-wasm-receivers.log
              rg '^# tests 17$' build/owned-php-wasm-receivers.log
              rg '^# pass 17$' build/owned-php-wasm-receivers.log
              rg '^# fail 0$' build/owned-php-wasm-receivers.log
              rg '^# cancelled 0$' build/owned-php-wasm-receivers.log
              rg '^# skipped 0$' build/owned-php-wasm-receivers.log
              test -s build/owned-php-wasm-receivers/ordinary.json
              test -s build/owned-php-wasm-receivers/reviewed.json
              test -s build/owned-php-wasm-receivers/native-fibers.json
              test -s build/owned-php-wasm-receivers/ordinary-plain-false.json
              test -s build/owned-php-wasm-receivers/ordinary-plain-true.json
              test -s build/owned-php-wasm-receivers/reviewed-plain-false.json
              test -s build/owned-php-wasm-receivers/reviewed-plain-true.json
              test -s build/owned-php-wasm-receivers/ordinary-unanchored.json
              test -s build/owned-php-wasm-receivers/reviewed-unanchored.json
              test -s build/owned-php-wasm-receivers/packages.json
              test -s build/owned-php-wasm-receivers/ordinary-resource-package.json
              test -s build/owned-php-wasm-receivers/reviewed-resource-package.json
              test -s build/owned-php-wasm-receivers/documentation.json
          - name: Preserve PHP-Wasm receiver acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: php-wasm-receivers-${{ github.sha }}
              path: |
                build/owned-php-wasm-receivers/
                build/owned-php-wasm-receivers.log
              if-no-files-found: error
              retention-days: 30
    
      php-wasm-callback-results:
        name: PHP-Wasm callback-result packages
        runs-on: ubuntu-24.04
        timeout-minutes: 180
        env:
          LEAN_WASM_RUNTIME_PROFILE: browser
          LEAN_WASM_RUNTIME_VARIANT: php-wasm-3.1.68
          LEAN_WASM_ARTIFACT_TARGET: php-wasm-emscripten-3.1.68
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Restore pinned PHP and compiler inputs
            uses: actions/cache@v5
            with:
              path: |
                .toolchains
                build/php-wasm-sdk
                build/php-wasm-host
              key: consumer-php-callback-results-${{ runner.os }}-${{ hashFiles('flake.lock', 'lean-toolchain', 'scripts/bootstrap-toolchains.sh', 'scripts/bootstrap-php-wasm-ci.sh', 'poc/lean-link-spike/bindings/php-wasm.package.json') }}
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts --no-audit --no-fund
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install PHP, compiler tools and log tooling
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential autoconf automake bison flex gperf libtool re2c cmake pkg-config php-cli php-dev php-common php-zip php-mbstring composer zstd ripgrep
          - name: Install PHP, compiler tools and log tooling
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh --check-prerequisites
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
              env -i PATH=/usr/bin:/bin /usr/bin/php -r 'if (extension_loaded("xdebug")) { fwrite(STDERR, "Consumer PHP must run without Xdebug.\n"); exit(1); }'
          - name: Install dependencies for Build the pinned PHP-Wasm runtime and browser host
            timeout-minutes: 20
            run: |
              npx playwright install --with-deps chromium
          - name: Build the pinned PHP-Wasm runtime and browser host
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh
              bash scripts/bootstrap-toolchains.sh
              export LEAN_WASM_EMSDK="$GITHUB_WORKSPACE/.toolchains/emsdk-php-wasm"
              bash scripts/build-lean-runtime.sh
              source scripts/env.sh
              node --input-type=module -e 'import {prepareOwnedPhpWasmRuntime} from "./tests/helpers/owned-php-wasm-runtime.mjs"; await prepareOwnedPhpWasmRuntime("build/php-wasm-callback-result-input");'
          - name: Verify callback-result owners and installed packages
            env:
              LEAN_BRIDGE_TEST_PHP_COPIED_RUNTIME: build/php-wasm-callback-result-input/php-wasm-runtime
            run: |
              source scripts/env.sh
              npm run test:owned-php-wasm-callback-results > build/owned-php-wasm-callback-results.log 2>&1
              cat build/owned-php-wasm-callback-results.log
              rg '^# tests 7$' build/owned-php-wasm-callback-results.log
              rg '^# pass 7$' build/owned-php-wasm-callback-results.log
              rg '^# fail 0$' build/owned-php-wasm-callback-results.log
              rg '^# cancelled 0$' build/owned-php-wasm-callback-results.log
              rg '^# skipped 0$' build/owned-php-wasm-callback-results.log
              test -s build/owned-php-wasm-callback-results/no-host-packages.json
              test -s build/owned-php-wasm-callback-results/host-packages.json
              test -s build/owned-php-wasm-callback-results/combined-packages.json
              npm run test:owned-php-wasm-callback-evidence
          - name: Preserve PHP-Wasm callback-result acceptance
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: php-wasm-callback-results-${{ github.sha }}
              path: |
                build/owned-php-wasm-callback-results/
                build/owned-php-wasm-callback-results.log
              if-no-files-found: error
              retention-days: 30
    
      php-consumers:
        name: Native PHP
        runs-on: ubuntu-24.04
        # Native PHP installed acceptance runs alone; PHP-Wasm has its own job (#1450).
        timeout-minutes: 240
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Restore pinned PHP and compiler inputs
            uses: actions/cache@v5
            with:
              path: |
                .toolchains
                build/php-wasm-sdk
                build/php-wasm-host
              key: consumer-php-${{ runner.os }}-${{ hashFiles('flake.lock', 'lean-toolchain', 'scripts/bootstrap-toolchains.sh', 'scripts/bootstrap-php-wasm-ci.sh', 'poc/lean-link-spike/bindings/php-wasm.package.json') }}
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install native PHP and PHP-Wasm host build tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential autoconf automake bison flex gperf libtool re2c cmake pkg-config php-cli php-dev php-common php-zip php-mbstring composer zstd ripgrep gdb
          - name: Install native PHP and PHP-Wasm host build tools
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh --check-prerequisites
          - name: Disable host PHP debugging instrumentation
            run: |
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
              env -i PATH=/usr/bin:/bin /usr/bin/php -r 'if (extension_loaded("xdebug")) { fwrite(STDERR, "Consumer PHP must run without Xdebug.\n"); exit(1); }'
          - name: Build ordinary PHP packages and execute relocated Composer installations
            id: ordinary_php
            continue-on-error: true
            env:
              LEAN_BRIDGE_NATIVE_PHP_TEST: "1"
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
              source scripts/env.sh
              node --test tests/php-brick-math.test.mjs tests/native-php.test.mjs
          - name: Compare weak and strict installed Composer callers with fresh Lean
            id: type_corpus_php_native
            continue-on-error: true
            run: |
              export LEAN_BRIDGE_PHP="$(command -v php)"
              export LEAN_BRIDGE_COMPOSER="$(command -v composer)"
              source scripts/env.sh
              npm run test:type-corpus:php-native && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=php-native node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_PHP_GRAPH_VALUES_TEST=1 node --test tests/php-copied-graph-values.test.mjs
              test -s build/recursive/php-values.json
              LEAN_BRIDGE_PHP_GRAPH_CONVERSION_TEST=1 LEAN_BRIDGE_PHP_GRAPH_NATIVE_TEST=1 node --test tests/php-copied-graph-conversions.test.mjs
              test -s build/recursive/php-conversions.json
              test -s build/recursive/php-native.json
              LEAN_BRIDGE_PHP_GRAPH_PACKAGE_TEST=1 LEAN_BRIDGE_PHP_GRAPH_INSTALLED_TEST=1 node --test tests/php-graph-package.test.mjs
              test -s build/recursive/php-package-cold.json
              test -s build/recursive/php-packages.json
              LEAN_BRIDGE_PHP_GRAPH_REPRO_TEST=1 node --test tests/php-graph-package.test.mjs
              test -s build/recursive/php-reproducibility.json
              LEAN_BRIDGE_PHP_GRAPH_LOADING_TEST=1 node --test tests/php-graph-package.test.mjs
              test -s build/recursive/php-composition.json
              test -s build/recursive/php-conflicts.json
              LEAN_BRIDGE_CHAR_PROFILES=php-native node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=php-native node --test tests/native-words.test.mjs
              LEAN_BRIDGE_PHP_CALLABLE_TEST=1 node --test tests/php-callables.test.mjs tests/php-callable-contract.test.mjs
              LEAN_BRIDGE_PHP_STRUCTURED_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/php-structured-callables.test.mjs tests/php-structured-callable-contract.test.mjs
              test -s build/structured-callables/php-native.json
              npm run test:php-recursive-callables
              test -s build/recursive-callables/php-recursive.json
              test -s build/recursive-callables/php-mixed.json
              LEAN_BRIDGE_PHP_COMPOUND_TEST=1 node --test tests/php-compounds.test.mjs tests/php-compound-contract.test.mjs
              LEAN_BRIDGE_PHP_LIST_TEST=1 node --test tests/php-lists.test.mjs tests/php-list-contract.test.mjs
              LEAN_BRIDGE_PHP_ALIAS_TEST=1 node --test tests/php-aliases.test.mjs tests/php-alias-contract.test.mjs
              LEAN_BRIDGE_PHP_FIN_TEST=1 node --test tests/php-fin.test.mjs
              LEAN_BRIDGE_PHP_VARIANT_TEST=1 node --test tests/php-variants.test.mjs tests/php-variant-contract.test.mjs
              LEAN_BRIDGE_PHP_CONVERSIONS_TEST=1 node --test tests/php-collection-conversions.test.mjs
              LEAN_BRIDGE_PHP_EQUALITY_TEST=1 node --test tests/php-value-equality.test.mjs
              LEAN_BRIDGE_PHP_COLLECTION_TEST=1 node --test tests/php-collections.test.mjs tests/php-collection-contract.test.mjs
              test -s build/collections/php-native-conversions.json
              test -s build/equality/php.json
              test -s build/collections/php-native.json
              test -s build/variants/php-native.json
              test -s build/aliases/php-native.json
              test -s build/native-fin/php.json
              test -s build/native-fin/php-reviewed.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=php-native node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/php-native.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=php-native node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/php-native.json
              test -s build/generic-records/specialized-php-native.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=php-native node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-php-native.json
              LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_FIN_CONTAINER_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=php-native node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/php-native.json
              test -s build/native-fin-containers/reviewed-php-native.json
              node scripts/check-fin-container-entry-reports.mjs php-native build/native-fin-containers/php-native.json build/native-fin-containers/reviewed-php-native.json
              LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=php-native LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-php-native.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs
              test -s build/native-fin-container-edges/edges-php-native.json
              node scripts/check-fin-container-foreign-report.mjs php-native build/native-fin-container-edges/edges-php-native.json
              LEAN_BRIDGE_FIN_PRODUCT_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=php-native node --test tests/native-fin-products.test.mjs
              test -s build/native-fin-products/php-native.json
              test -s build/native-fin-products/reviewed-php-native.json
              LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=php-native node --test tests/native-fin-product-arrays.test.mjs
              test -s build/native-fin-product-arrays/php-native.json
              test -s build/native-fin-product-arrays/reviewed-php-native.json
              LEAN_BRIDGE_FIN_RECORD_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=php-native node --test tests/native-fin-records.test.mjs
              test -s build/native-fin-records/php-native.json
              test -s build/native-fin-records/reviewed-php-native.json
              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=php-native LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/php-native.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-php-native.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/php-native.json
              test -s build/native-fin-record-zero/reviewed-php-native.json
              node scripts/check-fin-record-zero-report.mjs php-native build/native-fin-record-zero/php-native.json build/native-fin-record-zero/reviewed-php-native.json
              LEAN_BRIDGE_SUBTYPE_PROFILES=php-native node --test tests/native-subtype.test.mjs
              test -s build/native-subtype/php-native.json
              test -s build/lists/php-native.json
              test -s build/type-corpus/php-native.json
              test -s build/type-corpus/reviewed-native-php-native.json
          - name: Execute owned native PHP values and source-free Composer releases
            id: owned_php
            continue-on-error: true
            run: |
              export LEAN_BRIDGE_PHP="$(command -v php)"
              export LEAN_BRIDGE_COMPOSER="$(command -v composer)"
              source scripts/env.sh
              LEAN_BRIDGE_OWNED_PHP_VALUES_TEST=1 node --test --test-name-pattern='^(?!.*32-bit PHP-Wasm)' tests/owned-php-values.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-php-runtime.test.mjs tests/owned-php-conversions.test.mjs tests/owned-php-calls.test.mjs tests/owned-php-package.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-php-packaging.test.mjs tests/owned-php-coexistence.test.mjs tests/owned-php-documentation.test.mjs
              npm run test:owned-php-transfers
              npm run test:owned-php-borrows
              test -s build/owned/php-values.json
              test -s build/owned-php-runtime/ordinary.json
              test -s build/owned-php-runtime/reviewed.json
              test -s build/owned-php-conversions/composition-ordinary.json
              test -s build/owned-php-conversions/composition-reviewed.json
              test -s build/owned-php-conversions/scalars-ordinary.json
              test -s build/owned-php-conversions/scalars-reviewed.json
              test -s build/owned-php-calls/ordinary.json
              test -s build/owned-php-calls/reviewed.json
              test -s build/owned-php-packaging/ordinary.json
              test -s build/owned-php-packaging/reviewed.json
              test -s build/owned-php-packaging/coexistence.json
              test -s build/owned-php-packaging/documentation.json
              test -s build/owned-php-transfers/ordinary.json
              test -s build/owned-php-transfers/reviewed.json
              test -s build/owned-php-transfer-packaging/ordinary.json
              test -s build/owned-php-transfer-packaging/reviewed.json
              test -s build/owned-php-transfer-packaging/documentation.json
              test -s build/owned-php-borrows/ordinary.json
              test -s build/owned-php-borrows/reviewed.json
              test -s build/owned-php-borrows/borrow-only.json
              test -s build/owned-php-borrow-packaging/ordinary.json
              test -s build/owned-php-borrow-packaging/reviewed.json
              test -s build/owned-php-borrow-packaging/documentation.json
          - name: Upload installed PHP corpus observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-php-native-${{ github.sha }}
              path: |
                build/recursive/php-values.json
                build/owned/php-values.json
                build/owned-php-runtime/
                build/owned-php-conversions/
                build/owned-php-calls/
                build/owned-php-packaging/
                build/owned-php-transfers/
                build/owned-php-transfer-packaging/
                build/owned-php-borrows/
                build/owned-php-borrow-packaging/
                build/recursive/php-conversions.json
                build/recursive/php-native.json
                build/recursive/php-package-cold.json
                build/recursive/php-packages.json
                build/recursive/php-reproducibility.json
                build/recursive/php-composition.json
                build/recursive/php-conflicts.json
                build/type-corpus/php-native.json
                build/type-corpus/reviewed-native-php-native.json
                build/char-native/php-native.json
                build/word-native/php-native.json
                build/callables/php-native.json
                build/structured-callables/php-native.json
                build/recursive-callables/php-recursive.json
                build/recursive-callables/php-mixed.json
                build/compounds/php-native.json
                build/lists/php-native.json
                build/aliases/php-native.json
                build/native-fin/php.json
                build/native-fin/php-reviewed.json
                build/native-specializations/php-native.json
                build/generic-records/php-native.json
                build/generic-records/specialized-php-native.json
                build/generic-records/array-php-native.json
                build/native-fin-containers/php-native.json
                build/native-fin-containers/reviewed-php-native.json
                build/native-fin-container-edges/edges-php-native.json
                build/native-fin-products/php-native.json
                build/native-fin-products/reviewed-php-native.json
                build/native-fin-product-arrays/php-native.json
                build/native-fin-product-arrays/reviewed-php-native.json
                build/native-fin-records/php-native.json
                build/native-fin-records/reviewed-php-native.json
                build/native-fin-record-zero/php-native.json
                build/native-fin-record-zero/reviewed-php-native.json
                build/native-subtype/php-native.json
                build/variants/php-native.json
                build/collections/php-native-conversions.json
                build/equality/php.json
                build/collections/php-native.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Build twice, install, and execute the native PHP transport
            id: consumer
            continue-on-error: true
            run: npm run test:consumer:php-native
          - name: Record PHP observations
            if: always()
            shell: bash
            run: |
              test_result="${{ steps.consumer.outcome == 'success' && 'passed' || 'failed' }}"
              executed="${{ steps.consumer.outcome == 'success' && 'true' || 'false' }}"
              native_result="$test_result"
              native_executed="$executed"
              if [ "${{ steps.ordinary_php.outcome }}" != success ] || [ "${{ steps.type_corpus_php_native.outcome }}" != success ] || [ "${{ steps.owned_php.outcome }}" != success ]; then
                native_result=failed
                native_executed=false
              fi
              node scripts/consumer-ci.mjs record --consumer php-native --output build/consumer-ci/results/php-native.json --performance build/consumer-ci/performance/php-native.json --test-result "$native_result" --package-installation "$native_executed" --real-lean-execution "$native_executed" --command "npm run test:consumer:php-native && LEAN_BRIDGE_NATIVE_PHP_TEST=1 node --test tests/native-php.test.mjs && npm run test:type-corpus:php-native && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=php-native node --test tests/type-corpus-reviewed-native.test.mjs && LEAN_BRIDGE_PHP_CALLABLE_TEST=1 node --test tests/php-callables.test.mjs tests/php-callable-contract.test.mjs && LEAN_BRIDGE_PHP_STRUCTURED_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/php-structured-callables.test.mjs tests/php-structured-callable-contract.test.mjs && npm run test:php-recursive-callables && LEAN_BRIDGE_PHP_COMPOUND_TEST=1 node --test tests/php-compounds.test.mjs tests/php-compound-contract.test.mjs && LEAN_BRIDGE_PHP_LIST_TEST=1 node --test tests/php-lists.test.mjs tests/php-list-contract.test.mjs && LEAN_BRIDGE_PHP_ALIAS_TEST=1 node --test tests/php-aliases.test.mjs tests/php-alias-contract.test.mjs && LEAN_BRIDGE_PHP_FIN_TEST=1 node --test tests/php-fin.test.mjs && LEAN_BRIDGE_SPECIALIZATION_PROFILES=php-native node --test tests/native-specializations.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_PROFILES=php-native node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs && LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=php-native node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs && LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_FIN_CONTAINER_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=php-native node --test tests/native-fin-containers.test.mjs && LEAN_BRIDGE_GDB=/usr/bin/gdb LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=php-native LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-php-native.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs && node scripts/check-fin-container-foreign-report.mjs php-native build/native-fin-container-edges/edges-php-native.json && LEAN_BRIDGE_FIN_PRODUCT_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=php-native node --test tests/native-fin-products.test.mjs && LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=php-native node --test tests/native-fin-product-arrays.test.mjs && LEAN_BRIDGE_FIN_RECORD_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=php-native node --test tests/native-fin-records.test.mjs && LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=php-native LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=php-native LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/php-native.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-php-native.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs && node scripts/check-fin-record-zero-report.mjs php-native build/native-fin-record-zero/php-native.json build/native-fin-record-zero/reviewed-php-native.json && LEAN_BRIDGE_SUBTYPE_PROFILES=php-native node --test tests/native-subtype.test.mjs && LEAN_BRIDGE_PHP_VARIANT_TEST=1 node --test tests/php-variants.test.mjs tests/php-variant-contract.test.mjs && LEAN_BRIDGE_PHP_CONVERSIONS_TEST=1 node --test tests/php-collection-conversions.test.mjs && LEAN_BRIDGE_PHP_EQUALITY_TEST=1 node --test tests/php-value-equality.test.mjs && LEAN_BRIDGE_PHP_COLLECTION_TEST=1 node --test tests/php-collections.test.mjs tests/php-collection-contract.test.mjs && LEAN_BRIDGE_OWNED_PHP_VALUES_TEST=1 node --test --test-name-pattern='^(?!.*32-bit PHP-Wasm)' tests/owned-php-values.test.mjs && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-php-runtime.test.mjs tests/owned-php-conversions.test.mjs tests/owned-php-calls.test.mjs tests/owned-php-package.test.mjs && LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test --test-concurrency=1 tests/owned-php-packaging.test.mjs tests/owned-php-coexistence.test.mjs tests/owned-php-documentation.test.mjs && npm run test:owned-php-transfers && npm run test:owned-php-borrows"
          - name: Upload PHP observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-php-native-${{ github.sha }}
              path: build/consumer-ci/results/php-native.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce PHP support
            if: steps.consumer.outcome != 'success' || steps.ordinary_php.outcome != 'success' || steps.type_corpus_php_native.outcome != 'success' || steps.owned_php.outcome != 'success'
            run: exit 1
    
      php-wasm-consumers:
        name: PHP-Wasm
        runs-on: ubuntu-24.04
        # The shared PHP-Wasm corpus is the growing tail; 330 minutes leaves room below the hosted six-hour limit.
        timeout-minutes: 330
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Restore pinned PHP and compiler inputs
            uses: actions/cache@v5
            with:
              path: |
                .toolchains
                build/php-wasm-sdk
                build/php-wasm-host
              key: consumer-php-${{ runner.os }}-${{ hashFiles('flake.lock', 'lean-toolchain', 'scripts/bootstrap-toolchains.sh', 'scripts/bootstrap-php-wasm-ci.sh', 'poc/lean-link-spike/bindings/php-wasm.package.json') }}
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install native PHP and PHP-Wasm host build tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential autoconf automake bison flex gperf libtool re2c cmake pkg-config php-cli php-dev php-common php-zip php-mbstring composer zstd ripgrep
          - name: Install native PHP and PHP-Wasm host build tools
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh --check-prerequisites
          - name: Disable host PHP debugging instrumentation
            run: |
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
              env -i PATH=/usr/bin:/bin /usr/bin/php -r 'if (extension_loaded("xdebug")) { fwrite(STDERR, "Consumer PHP must run without Xdebug.\n"); exit(1); }'
          - name: Build twice, install, and execute the PHP-Wasm transport
            id: consumer
            continue-on-error: true
            run: npm run test:consumer:php-wasm
          - name: Exercise generic copied Zend conversions in 32-bit PHP-Wasm
            id: copied_zend
            continue-on-error: true
            env:
              LEAN_BRIDGE_PHP_WASM_ZEND_TEST: "1"
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh
              node --test tests/php-copied-zend.test.mjs
          - name: Install dependencies for ordinary_php_wasm
            timeout-minutes: 20
            run: |
              npx playwright install --with-deps chromium
          - name: Compile ordinary Lean APIs and execute installed PHP-Wasm packages
            id: ordinary_php_wasm
            continue-on-error: true
            env:
              LEAN_BRIDGE_PHP_WASM_ORDINARY_TEST: "1"
              LEAN_BRIDGE_PHP_WASM_BROWSER_TEST: "1"
              LEAN_WASM_RUNTIME_PROFILE: browser
              LEAN_WASM_RUNTIME_VARIANT: php-wasm-3.1.68
              LEAN_WASM_ARTIFACT_TARGET: php-wasm-emscripten-3.1.68
            run: |
              bash scripts/bootstrap-toolchains.sh
              export LEAN_WASM_EMSDK="$GITHUB_WORKSPACE/.toolchains/emsdk-php-wasm"
              bash scripts/build-lean-runtime.sh
              node --test tests/php-wasm-ordinary.test.mjs
              test -s build/recursive/php-wasm-shared-regressions.json
          - name: Execute owned PHP-Wasm values and installed CLI releases
            id: owned_php_wasm
            continue-on-error: true
            run: |
              source scripts/env.sh
              LEAN_BRIDGE_OWNED_PHP_WASM_VALUES_TEST=1 node --test --test-name-pattern='32-bit PHP-Wasm' tests/owned-php-values.test.mjs
              LEAN_BRIDGE_OWNED_PHP_ZEND_TEST=1 LEAN_BRIDGE_OWNED_ZEND_FIBER_TEST=1 node --test --test-concurrency=1 tests/owned-php-zend-model.test.mjs tests/owned-php-zend-ownership.test.mjs tests/owned-php-zend-extension.test.mjs tests/owned-php-zend-generated.test.mjs
              LEAN_BRIDGE_OWNED_PHP_WASM_PACKAGE_TEST=1 node --test tests/owned-php-wasm-package.test.mjs
              LEAN_BRIDGE_OWNED_PHP_WASM_MULTI_PROFILE_TEST=1 node --test tests/owned-php-wasm-multi-profile.test.mjs
              LEAN_BRIDGE_OWNED_PHP_WASM_DOCUMENTATION_TEST=1 node --test tests/owned-php-wasm-documentation.test.mjs
              npm run test:owned-php-wasm-transfers
              npm run test:owned-php-wasm-borrows 2>&1 | tee build/owned-php-wasm-borrows.log
              rg '^# tests 12$' build/owned-php-wasm-borrows.log
              rg '^# fail 0$' build/owned-php-wasm-borrows.log
              rg '^# cancelled 0$' build/owned-php-wasm-borrows.log
              rg '^# skipped 0$' build/owned-php-wasm-borrows.log
              test -s build/owned-php-wasm-borrows/ordinary.json
              test -s build/owned-php-wasm-borrows/reviewed.json
              test -s build/owned-php-wasm-borrows/ordinary-borrow-only.json
              test -s build/owned-php-wasm-borrows/reviewed-borrow-only.json
              test -s build/owned-php-wasm-borrows/native-fibers.json
              test -s build/owned-php-wasm-borrows/packages.json
              test -s build/owned-php-wasm-borrows/documentation.json
              test -s build/owned/php-wasm-values.json
              test -s build/owned-php-zend/lifetime.json
              test -s build/owned-php-zend/native-fibers.json
              test -s build/owned-php-zend/generated.json
              test -s build/owned-php-zend/generated-reviewed.json
              test -s build/owned-php-wasm/packages-cli.json
              test -s build/owned-php-wasm/multi-profile.json
              test -s build/owned-php-wasm/documentation.json
              test -s build/owned-php-wasm-transfers/ordinary.json
              test -s build/owned-php-wasm-transfers/reviewed.json
              test -s build/owned-php-wasm-transfers/packages.json
              test -s build/owned-php-wasm-transfers/documentation.json
          - name: Upload owned PHP-Wasm execution evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-php-wasm-${{ github.sha }}
              path: |
                build/owned/php-wasm-values.json
                build/owned-php-zend/lifetime.json
                build/owned-php-zend/native-fibers.json
                build/owned-php-zend/generated.json
                build/owned-php-zend/generated-reviewed.json
                build/owned-php-wasm/packages-cli.json
                build/owned-php-wasm/multi-profile.json
                build/owned-php-wasm/documentation.json
                build/owned-php-wasm-transfers/ordinary.json
                build/owned-php-wasm-transfers/reviewed.json
                build/owned-php-wasm-transfers/packages.json
                build/owned-php-wasm-transfers/documentation.json
                build/owned-php-wasm-borrows.log
                build/owned-php-wasm-borrows/ordinary.json
                build/owned-php-wasm-borrows/reviewed.json
                build/owned-php-wasm-borrows/ordinary-borrow-only.json
                build/owned-php-wasm-borrows/reviewed-borrow-only.json
                build/owned-php-wasm-borrows/native-fibers.json
                build/owned-php-wasm-borrows/packages.json
                build/owned-php-wasm-borrows/documentation.json
              if-no-files-found: error
              retention-days: 30
          - name: Compare installed PHP-Wasm packages with the shared Lean corpus
            id: type_corpus_php_wasm
            continue-on-error: true
            run: |
              source scripts/env.sh
              npm run test:type-corpus:php-wasm
              npm run test:type-corpus:reviewed-php-wasm
              LEAN_BRIDGE_PHP_WASM_GRAPH_VALUES_TEST=1 node --test tests/php-copied-graph-values.test.mjs
              test -s build/recursive/php-wasm-values.json
              LEAN_BRIDGE_CHAR_PROFILES=php-wasm node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=php-wasm node --test tests/native-words.test.mjs
              LEAN_BRIDGE_PHP_WASM_CALLABLE_TEST=1 node --test tests/php-wasm-callables.test.mjs tests/php-wasm-callable-contract.test.mjs
              LEAN_BRIDGE_PHP_WASM_STRUCTURED_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/php-wasm-structured-callables.test.mjs tests/php-wasm-structured-callable-zend.test.mjs
              test -s build/structured-callables/php-wasm.json
              test -s build/structured-callables/php-wasm-zend-faults.json
              npm run test:php-wasm-recursive-generated
              test -s build/recursive-callables/php-wasm-generated.json
              npm run test:php-wasm-recursive-packages
              test -s build/recursive-callables/php-wasm-packages.json
              test -s build/recursive-callables/php-wasm-mixed-packages.json
              LEAN_BRIDGE_WASM32_RECURSIVE_TEST=1 node --test tests/wasm32-recursive-transport.test.mjs
              test -s build/recursive/wasm32-transport.json
              LEAN_BRIDGE_OWNED_WASM32_TEST=1 node --test --test-concurrency=1 tests/owned-wasm32-transport.test.mjs
              test -s build/owned-wasm32/owned-scalars.json
              test -s build/owned-wasm32/owned-aggregates.json
              LEAN_BRIDGE_PHP_WASM_GRAPH_ZEND_TEST=1 LEAN_BRIDGE_PHP_WASM_GRAPH_LEAN_TEST=1 node --test tests/php-copied-graph-zend.test.mjs
              test -s build/recursive/php-wasm-zend.json
              test -s build/recursive/php-wasm-zend-lean.json
              LEAN_BRIDGE_PHP_WASM_GRAPH_PACKAGE_TEST=1 node --test tests/php-wasm-graph-package.test.mjs
              test -s build/recursive/php-wasm-graph-packages.json
              LEAN_BRIDGE_PHP_WASM_GRAPH_REPRO_TEST=1 node --test tests/php-wasm-graph-reproduction.test.mjs
              test -s build/recursive/php-wasm-graph-reproduction.json
              LEAN_BRIDGE_PHP_WASM_GRAPH_LOADING_TEST=1 node --test tests/php-wasm-graph-loading.test.mjs
              test -s build/recursive/php-wasm-graph-loading.json
              LEAN_BRIDGE_PHP_WASM_COMPOUND_TEST=1 node --test tests/php-wasm-compounds.test.mjs tests/php-wasm-compound-contract.test.mjs tests/php-wasm-compound-zend.test.mjs
              test -s build/compounds/php-wasm.json
              test -s build/compounds/php-wasm-zend-faults.json
              LEAN_BRIDGE_PHP_WASM_LIST_TEST=1 node --test tests/php-wasm-lists.test.mjs tests/php-wasm-list-contract.test.mjs tests/php-wasm-list-zend.test.mjs
              test -s build/lists/php-wasm.json
              test -s build/lists/php-wasm-zend-faults.json
              LEAN_BRIDGE_PHP_WASM_ALIAS_TEST=1 node --test --test-concurrency=1 tests/php-wasm-aliases.test.mjs tests/php-wasm-alias-contract.test.mjs tests/php-wasm-alias-zend.test.mjs
              test -s build/aliases/php-wasm.json
              test -s build/aliases/php-wasm-zend-faults.json
              LEAN_BRIDGE_PHP_WASM_VARIANT_TEST=1 node --test --test-concurrency=1 tests/php-wasm-variants.test.mjs tests/php-wasm-variant-contract.test.mjs tests/php-wasm-variant-zend.test.mjs
              test -s build/variants/php-wasm.json
              test -s build/variants/php-wasm-zend-faults.json
              LEAN_BRIDGE_PHP_WASM_COLLECTION_TEST=1 node --test --test-concurrency=1 tests/php-wasm-collections.test.mjs tests/php-wasm-collection-contract.test.mjs tests/php-wasm-collection-zend.test.mjs
              test -s build/collections/php-wasm.json
              test -s build/collections/php-wasm-zend-faults.json
              LEAN_BRIDGE_PHP_WASM_FIN_TEST=1 node --test --test-concurrency=1 tests/php-wasm-fin.test.mjs
              test -s build/php-wasm-fin/ordinary.json
              LEAN_BRIDGE_PHP_WASM_REVIEWED_FIN_LEAN_TEST=1 LEAN_BRIDGE_PHP_WASM_REVIEWED_FIN_TEST=1 node --test --test-concurrency=1 --test-name-pattern='independent Fin reviews reconcile|independently reviewed PHP-Wasm packages' tests/php-wasm-fin.test.mjs
              test -s build/php-wasm-fin/reviewed.json
              LEAN_BRIDGE_PHP_WASM_DIRECT_FIN_TEST=1 LEAN_BRIDGE_PHP_WASM_DIRECT_FIN_LEAN_TEST=1 node --test --test-concurrency=1 tests/helpers/php-wasm-fin-direct-tests.mjs
              node scripts/check-php-wasm-direct-fin-reports.mjs --directory build/php-wasm-fin-direct
              LEAN_BRIDGE_PHP_WASM_SUBTYPE_TEST=1 LEAN_BRIDGE_PHP_WASM_SUBTYPE_LEAN_TEST=1 node --test --test-concurrency=1 tests/helpers/php-wasm-subtype-tests.mjs
              node scripts/check-php-wasm-subtype-reports.mjs --directory build/php-wasm-subtype
              set -euo pipefail
              mkdir -p build/php-wasm-subtype-entry
              node scripts/prepare-php-wasm-subtype-entry-runtime.mjs --output build/php-wasm-subtype-entry-input/php-wasm-runtime 2>&1 | tee build/php-wasm-subtype-entry/runtime-prepare.log
              LEAN_BRIDGE_TEST_PHP_COPIED_RUNTIME=build/php-wasm-subtype-entry-input/php-wasm-runtime LEAN_BRIDGE_PHP_WASM_SUBTYPE_ENTRY_TEST=1 LEAN_BRIDGE_PHP_WASM_SUBTYPE_ENTRY_OUTPUT=build/php-wasm-subtype-entry node --test --test-concurrency=1 --test-reporter=tap --test-name-pattern='^(ordinary|reviewed) installed PHP-Wasm Subtype entry probes record constructor and source calls$' tests/helpers/php-wasm-subtype-entry-installed-tests.mjs 2>&1 | tee build/php-wasm-subtype-entry/run.tap
              node scripts/check-php-wasm-subtype-entry-reports.mjs --directory build/php-wasm-subtype-entry --tap build/php-wasm-subtype-entry/run.tap
              LEAN_BRIDGE_PHP_WASM_GENERIC_RECORD_TEST=1 node --test --test-concurrency=1 tests/php-wasm-generic-records.test.mjs
              test -s build/generic-records/php-wasm.json
              test -s build/type-corpus/php-wasm.json
              test -s build/type-corpus/reviewed-wasm-php-wasm.json
          - name: Upload PHP-Wasm corpus evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-php-wasm-${{ github.sha }}
              path: |
                build/recursive/php-wasm-values.json
                build/recursive/wasm32-transport.json
                build/recursive/php-wasm-zend.json
                build/recursive/php-wasm-zend-lean.json
                build/recursive/php-wasm-graph-packages.json
                build/recursive/php-wasm-graph-reproduction.json
                build/recursive/php-wasm-graph-loading.json
                build/recursive/php-wasm-shared-regressions.json
                build/type-corpus/php-wasm.json
                build/type-corpus/reviewed-wasm-php-wasm.json
                build/char-native/php-wasm.json
                build/word-native/php-wasm.json
                build/callables/php-wasm.json
                build/structured-callables/php-wasm.json
                build/structured-callables/php-wasm-zend-faults.json
                build/recursive-callables/php-wasm-generated.json
                build/recursive-callables/php-wasm-packages.json
                build/recursive-callables/php-wasm-mixed-packages.json
                build/compounds/php-wasm.json
                build/compounds/php-wasm-zend-faults.json
                build/lists/php-wasm.json
                build/lists/php-wasm-zend-faults.json
                build/aliases/php-wasm.json
                build/aliases/php-wasm-zend-faults.json
                build/variants/php-wasm.json
                build/variants/php-wasm-zend-faults.json
                build/collections/php-wasm.json
                build/collections/php-wasm-zend-faults.json
                build/php-wasm-fin/ordinary.json
                build/php-wasm-fin/reviewed.json
                build/php-wasm-fin-direct/ordinary.json
                build/php-wasm-fin-direct/reviewed.json
                build/php-wasm-subtype/ordinary.json
                build/php-wasm-subtype/reviewed.json
                build/php-wasm-subtype-entry/
                build/generic-records/php-wasm.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Upload owned wasm32 transport evidence
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: owned-wasm32-${{ github.sha }}
              path: |
                build/owned-wasm32/owned-scalars.json
                build/owned-wasm32/owned-aggregates.json
              if-no-files-found: error
              retention-days: 30
          - name: Record PHP observations
            if: always()
            shell: bash
            run: |
              test_result="${{ steps.consumer.outcome == 'success' && 'passed' || 'failed' }}"
              executed="${{ steps.consumer.outcome == 'success' && 'true' || 'false' }}"
              wasm_result="$test_result"
              wasm_executed="$executed"
              if [ "${{ steps.ordinary_php_wasm.outcome }}" != success ] || [ "${{ steps.copied_zend.outcome }}" != success ] || [ "${{ steps.owned_php_wasm.outcome }}" != success ] || [ "${{ steps.type_corpus_php_wasm.outcome }}" != success ]; then
                wasm_result=failed
                wasm_executed=false
              fi
              node scripts/consumer-ci.mjs record --consumer php-wasm --output build/consumer-ci/results/php-wasm.json --performance build/consumer-ci/performance/php-wasm.json --test-result "$wasm_result" --package-installation "$wasm_executed" --real-lean-execution "$wasm_executed" --command "npm run test:consumer:php-wasm && LEAN_BRIDGE_PHP_WASM_ZEND_TEST=1 node --test tests/php-copied-zend.test.mjs && LEAN_BRIDGE_PHP_WASM_ORDINARY_TEST=1 LEAN_BRIDGE_PHP_WASM_BROWSER_TEST=1 node --test tests/php-wasm-ordinary.test.mjs && npm run test:type-corpus:php-wasm && npm run test:type-corpus:reviewed-php-wasm && LEAN_BRIDGE_PHP_WASM_CALLABLE_TEST=1 node --test tests/php-wasm-callables.test.mjs tests/php-wasm-callable-contract.test.mjs && LEAN_BRIDGE_PHP_WASM_STRUCTURED_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/php-wasm-structured-callables.test.mjs tests/php-wasm-structured-callable-zend.test.mjs && npm run test:php-wasm-recursive-generated && npm run test:php-wasm-recursive-packages && LEAN_BRIDGE_OWNED_WASM32_TEST=1 node --test --test-concurrency=1 tests/owned-wasm32-transport.test.mjs && LEAN_BRIDGE_PHP_WASM_COMPOUND_TEST=1 node --test tests/php-wasm-compounds.test.mjs tests/php-wasm-compound-contract.test.mjs tests/php-wasm-compound-zend.test.mjs && LEAN_BRIDGE_PHP_WASM_LIST_TEST=1 node --test tests/php-wasm-lists.test.mjs tests/php-wasm-list-contract.test.mjs tests/php-wasm-list-zend.test.mjs && LEAN_BRIDGE_PHP_WASM_ALIAS_TEST=1 node --test --test-concurrency=1 tests/php-wasm-aliases.test.mjs tests/php-wasm-alias-contract.test.mjs tests/php-wasm-alias-zend.test.mjs && LEAN_BRIDGE_PHP_WASM_VARIANT_TEST=1 node --test --test-concurrency=1 tests/php-wasm-variants.test.mjs tests/php-wasm-variant-contract.test.mjs tests/php-wasm-variant-zend.test.mjs && LEAN_BRIDGE_PHP_WASM_COLLECTION_TEST=1 node --test --test-concurrency=1 tests/php-wasm-collections.test.mjs tests/php-wasm-collection-contract.test.mjs tests/php-wasm-collection-zend.test.mjs && LEAN_BRIDGE_PHP_WASM_FIN_TEST=1 node --test --test-concurrency=1 tests/php-wasm-fin.test.mjs && LEAN_BRIDGE_PHP_WASM_REVIEWED_FIN_LEAN_TEST=1 LEAN_BRIDGE_PHP_WASM_REVIEWED_FIN_TEST=1 node --test --test-concurrency=1 --test-name-pattern='independent Fin reviews reconcile|independently reviewed PHP-Wasm packages' tests/php-wasm-fin.test.mjs && LEAN_BRIDGE_PHP_WASM_DIRECT_FIN_TEST=1 LEAN_BRIDGE_PHP_WASM_DIRECT_FIN_LEAN_TEST=1 node --test --test-concurrency=1 tests/helpers/php-wasm-fin-direct-tests.mjs && node scripts/check-php-wasm-direct-fin-reports.mjs --directory build/php-wasm-fin-direct && LEAN_BRIDGE_PHP_WASM_SUBTYPE_TEST=1 LEAN_BRIDGE_PHP_WASM_SUBTYPE_LEAN_TEST=1 node --test --test-concurrency=1 tests/helpers/php-wasm-subtype-tests.mjs && node scripts/check-php-wasm-subtype-reports.mjs --directory build/php-wasm-subtype && set -euo pipefail && mkdir -p build/php-wasm-subtype-entry && node scripts/prepare-php-wasm-subtype-entry-runtime.mjs --output build/php-wasm-subtype-entry-input/php-wasm-runtime 2>&1 | tee build/php-wasm-subtype-entry/runtime-prepare.log && LEAN_BRIDGE_TEST_PHP_COPIED_RUNTIME=build/php-wasm-subtype-entry-input/php-wasm-runtime LEAN_BRIDGE_PHP_WASM_SUBTYPE_ENTRY_TEST=1 LEAN_BRIDGE_PHP_WASM_SUBTYPE_ENTRY_OUTPUT=build/php-wasm-subtype-entry node --test --test-concurrency=1 --test-reporter=tap --test-name-pattern='^(ordinary|reviewed) installed PHP-Wasm Subtype entry probes record constructor and source calls$' tests/helpers/php-wasm-subtype-entry-installed-tests.mjs 2>&1 | tee build/php-wasm-subtype-entry/run.tap && node scripts/check-php-wasm-subtype-entry-reports.mjs --directory build/php-wasm-subtype-entry --tap build/php-wasm-subtype-entry/run.tap && LEAN_BRIDGE_PHP_WASM_GENERIC_RECORD_TEST=1 node --test --test-concurrency=1 tests/php-wasm-generic-records.test.mjs && LEAN_BRIDGE_OWNED_PHP_WASM_VALUES_TEST=1 node --test --test-name-pattern='32-bit PHP-Wasm' tests/owned-php-values.test.mjs && LEAN_BRIDGE_OWNED_PHP_ZEND_TEST=1 LEAN_BRIDGE_OWNED_ZEND_FIBER_TEST=1 node --test --test-concurrency=1 tests/owned-php-zend-model.test.mjs tests/owned-php-zend-ownership.test.mjs tests/owned-php-zend-extension.test.mjs tests/owned-php-zend-generated.test.mjs && LEAN_BRIDGE_OWNED_PHP_WASM_PACKAGE_TEST=1 node --test tests/owned-php-wasm-package.test.mjs && LEAN_BRIDGE_OWNED_PHP_WASM_MULTI_PROFILE_TEST=1 node --test tests/owned-php-wasm-multi-profile.test.mjs && LEAN_BRIDGE_OWNED_PHP_WASM_DOCUMENTATION_TEST=1 node --test tests/owned-php-wasm-documentation.test.mjs && npm run test:owned-php-wasm-transfers && npm run test:owned-php-wasm-borrows"
          - name: Upload PHP observations
            if: always()
            uses: actions/upload-artifact@v7
            with:
              name: consumer-results-php-wasm-${{ github.sha }}
              path: build/consumer-ci/results/php-wasm.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Enforce PHP support
            if: steps.consumer.outcome != 'success' || steps.copied_zend.outcome != 'success' || steps.ordinary_php_wasm.outcome != 'success' || steps.type_corpus_php_wasm.outcome != 'success' || steps.owned_php_wasm.outcome != 'success'
            run: exit 1
    
      php-multi-profile:
        name: PHP-Wasm mixed-profile release
        runs-on: ubuntu-24.04
        timeout-minutes: 180
        env:
          LEAN_WASM_RUNTIME_PROFILE: browser
          LEAN_WASM_RUNTIME_VARIANT: php-wasm-3.1.68
          LEAN_WASM_ARTIFACT_TARGET: php-wasm-emscripten-3.1.68
          LEAN_BRIDGE_PHP_MULTI_PROFILE_TEST: "1"
          LEAN_BRIDGE_LAKE_ENGINE: build/php-multi-engine/bin/lean-bridge-component-engine
          LEAN_BRIDGE_LAKE_RUNTIME_ROOT: build/php-multi-runtime/lazy
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              fetch-depth: 0
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Restore pinned PHP and compiler inputs
            uses: actions/cache@v5
            with:
              path: |
                .toolchains
                build/php-wasm-sdk
                build/php-wasm-host
              key: consumer-php-${{ runner.os }}-${{ hashFiles('flake.lock', 'lean-toolchain', 'scripts/bootstrap-toolchains.sh', 'scripts/bootstrap-php-wasm-ci.sh', 'poc/lean-link-spike/bindings/php-wasm.package.json') }}
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts --no-audit --no-fund
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Install PHP and compiler tools
            timeout-minutes: 20
            run: |
              sudo apt-get update
              sudo apt-get install -y build-essential autoconf automake bison flex gperf libtool re2c cmake pkg-config php-cli php-dev php-common php-zip php-mbstring composer zstd ripgrep
          - name: Install PHP and compiler tools
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh --check-prerequisites
              if /usr/bin/php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
                sudo phpdismod -s cli xdebug
              fi
              env -i PATH=/usr/bin:/bin /usr/bin/php -r 'if (extension_loaded("xdebug")) { fwrite(STDERR, "Consumer PHP must run without Xdebug.\n"); exit(1); }'
          - name: Prepare the pinned PHP-Wasm and Lean runtimes
            run: |
              bash scripts/bootstrap-php-wasm-ci.sh
              bash scripts/bootstrap-toolchains.sh
              export LEAN_WASM_EMSDK="$GITHUB_WORKSPACE/.toolchains/emsdk-php-wasm"
              bash scripts/build-lean-runtime.sh
          - name: Combine PHP-Wasm with native PHP and JavaScript from one captured API
            run: |
              nix build .#universal-core-artifacts --out-link build/php-multi-runtime
              nix build .#component-build-engine --out-link build/php-multi-engine
              source scripts/env.sh
              node --test tests/php-wasm-multi-profile.test.mjs
              LEAN_BRIDGE_REVIEWED_MULTI_PROFILE_TEST=1 node --test tests/php-wasm-multi-profile.test.mjs
    
      native-consumers:
        name: Native consumer (${{ matrix.profile }})
        runs-on: ubuntu-24.04
        # Run 37873560469 cut the c-family Compare step off at 240 minutes while it was still
        # passing tests. Python and Rust keep their 240-minute budget.
        timeout-minutes: ${{ matrix.profile == 'c-family' && 360 || 240 }}
        strategy:
          fail-fast: false
          matrix:
            profile: [c-family, python, rust]
            include:
              - profile: c-family
                consumers: c cpp
              - profile: python
                consumers: python
              - profile: rust
                consumers: rust
        steps:
          - name: Check out the exact revision
            uses: actions/checkout@v6
            with:
              persist-credentials: false
          - name: Install Node.js
            uses: actions/setup-node@v6
            with:
              node-version: ${{ env.NODE_VERSION }}
              cache: npm
          - name: Install Nix
            uses: cachix/install-nix-action@v31
          - name: Install dependencies without lifecycle scripts
            run: npm ci --ignore-scripts
          - name: Install every package and execute real Lean
            id: consumer
            continue-on-error: true
            run: npm run test:consumer:native
          - name: Bound apt network waits
            uses: ./.github/actions/bounded-apt
            timeout-minutes: 1
          - name: Install apt dependencies for Prepare native compiler for this shard
            timeout-minutes: 20
            run: |
              sudo apt-get update && sudo apt-get install -y build-essential cmake pkg-config zstd m4 libgmp-dev
          - name: Prepare native compiler for this shard
            run: |
              bash scripts/bootstrap-toolchains.sh --lean-only
          - name: Install the TAP log verifier
            timeout-minutes: 20
            run: sudo apt-get install -y ripgrep
          - name: Compile ordinary Lean APIs once for relocated C and C++ consumers
            id: ordinary_c
            if: matrix.profile == 'c-family'
            continue-on-error: true
            env:
              LEAN_BRIDGE_NATIVE_C_TEST: "1"
            run: |
              source scripts/env.sh
              node --test tests/native-c-family.test.mjs tests/native-c-copied.test.mjs
          - name: Compare relocated C and C++ corpus consumers with fresh Lean
            id: type_corpus_c_family
            if: matrix.profile == 'c-family'
            continue-on-error: true
            run: |
              source scripts/env.sh
              npm run test:type-corpus:c-family && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=c,cpp node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_CHAR_PROFILES=c,cpp node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=c,cpp node --test tests/native-words.test.mjs
              LEAN_BRIDGE_NATIVE_COMPOUND_TEST=1 node --test tests/native-compounds.test.mjs
              test -s build/compounds/native.json
              LEAN_BRIDGE_NATIVE_LIST_TEST=1 node --test tests/native-lists.test.mjs
              test -s build/lists/native.json
              LEAN_BRIDGE_NATIVE_COLLECTION_TEST=1 node --test tests/native-collections.test.mjs
              test -s build/collections/native.json
              LEAN_BRIDGE_NATIVE_ALIAS_TEST=1 node --test tests/native-aliases.test.mjs
              test -s build/aliases/native.json
              npm run test:native-fin
              test -s build/native-fin/native.json
              test -s build/native-fin/native-reviewed.json
              mkdir -p build/reviewed-fin-refusals
              set -o pipefail
              LEAN_BRIDGE_REVIEWED_FIN_REFUSALS=native-fin,fin-containers LEAN_BRIDGE_REVIEWED_FIN_REFUSAL_REPORT_DIR=build/reviewed-fin-refusals node --test --test-reporter=tap --test-concurrency=1 tests/reviewed-fin-refusals.test.mjs 2>&1 | tee build/reviewed-fin-refusals/acceptance.tap
              rg '^ok [0-9]+ - changed native-fin reviews are refused against fresh Lean beside a publishing control$' build/reviewed-fin-refusals/acceptance.tap
              rg '^ok [0-9]+ - changed fin-containers reviews are refused against fresh Lean beside a publishing control$' build/reviewed-fin-refusals/acceptance.tap
              rg '^# tests 23$' build/reviewed-fin-refusals/acceptance.tap
              rg '^# pass 23$' build/reviewed-fin-refusals/acceptance.tap
              rg '^# fail 0$' build/reviewed-fin-refusals/acceptance.tap
              rg '^# cancelled 0$' build/reviewed-fin-refusals/acceptance.tap
              rg '^# skipped 0$' build/reviewed-fin-refusals/acceptance.tap
              rg '^# todo 0$' build/reviewed-fin-refusals/acceptance.tap
              test -s build/reviewed-fin-refusals/native-fin.json
              test -s build/reviewed-fin-refusals/fin-containers.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=c,cpp node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/c-cpp.json
              LEAN_BRIDGE_REVIEWED_SPECIALIZATION_TEST=1 LEAN_BRIDGE_REVIEWED_SPECIALIZATION_PROFILES=c,cpp node --test --test-concurrency=1 tests/reviewed-specializations.test.mjs
              test -s build/reviewed-specializations/c-cpp.json
              LEAN_BRIDGE_FIN_CONTAINER_ENTRY_COUNTERS=1 LEAN_BRIDGE_FIN_CONTAINER_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=c,cpp node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/c-cpp.json
              test -s build/native-fin-containers/reviewed-c-cpp.json
              node scripts/check-fin-container-entry-reports.mjs c,cpp build/native-fin-containers/c-cpp.json build/native-fin-containers/reviewed-c-cpp.json
              LEAN_BRIDGE_FIN_CONTAINER_EDGE_PROFILES=c,cpp LEAN_BRIDGE_FIN_CONTAINER_EDGE_DISPATCH=1 LEAN_BRIDGE_FIN_CONTAINER_EDGE_REPORT=build/native-fin-container-edges/edges-c-cpp.json node --test --test-concurrency=1 --test-name-pattern='^installed source-free native packages execute zero-bound and nested-position Fin edge cases$' tests/fin-container-edges.test.mjs
              test -s build/native-fin-container-edges/edges-c-cpp.json
              node scripts/check-fin-container-foreign-report.mjs c,cpp build/native-fin-container-edges/edges-c-cpp.json
              LEAN_BRIDGE_FIN_PRODUCT_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_PROFILES=c,cpp node --test tests/native-fin-products.test.mjs
              test -s build/native-fin-products/c-cpp.json
              test -s build/native-fin-products/reviewed-c-cpp.json
              LEAN_BRIDGE_FIN_PRODUCT_ARRAY_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_PRODUCT_ARRAY_PROFILES=c,cpp node --test tests/native-fin-product-arrays.test.mjs
              test -s build/native-fin-product-arrays/c-cpp.json
              test -s build/native-fin-product-arrays/reviewed-c-cpp.json
              LEAN_BRIDGE_FIN_RECORD_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_RECORD_PROFILES=c,cpp node --test tests/native-fin-records.test.mjs
              test -s build/native-fin-records/c-cpp.json
              test -s build/native-fin-records/reviewed-c-cpp.json
              LEAN_BRIDGE_FIN_RECORD_ZERO_PROFILES=c,cpp LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_PROFILES=c,cpp LEAN_BRIDGE_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/c-cpp.json LEAN_BRIDGE_REVIEWED_FIN_RECORD_ZERO_REPORT=build/native-fin-record-zero/reviewed-c-cpp.json node --test --test-concurrency=1 tests/native-fin-record-zero.test.mjs
              test -s build/native-fin-record-zero/c-cpp.json
              test -s build/native-fin-record-zero/reviewed-c-cpp.json
              node scripts/check-fin-record-zero-report.mjs c,cpp build/native-fin-record-zero/c-cpp.json build/native-fin-record-zero/reviewed-c-cpp.json
              mkdir -p build/native-fin-replies
              set -o pipefail
              LEAN_BRIDGE_NATIVE_FIN_CALLBACK_LEAN_TEST=1 LEAN_BRIDGE_FIN_CALLBACK_PROFILES=c,cpp LEAN_BRIDGE_NATIVE_FIN_REPLY_TEST=1 LEAN_BRIDGE_FIN_REPLY_PROFILES=c,cpp node --test --test-reporter=tap --test-concurrency=1 tests/native-fin-callbacks.test.mjs | tee build/native-fin-replies/acceptance.tap
              rg "^ok [0-9]+ - fresh Lean admits every safe direction and compiles the generated adapter$" build/native-fin-replies/acceptance.tap
              rg "^ok [0-9]+ - fresh Lean refuses a host callback's result without a Fin-free failure value and admits one with it$" build/native-fin-replies/acceptance.tap
              rg "^ok [0-9]+ - fresh Lean admits every checked host reply family and compiles each typed reconstruction$" build/native-fin-replies/acceptance.tap
              test -s build/native-fin-callbacks/c-cpp.json
              test -s build/native-fin-replies/c-bypass.json
              test -s build/native-fin-replies/installed-c-cpp.json
              LEAN_BRIDGE_SUBTYPE_PROFILES=c,cpp node --test tests/native-subtype.test.mjs
              test -s build/native-subtype/c-cpp.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=c,cpp node --test tests/generic-records.test.mjs
              test -s build/generic-records/c-cpp.json
              test -s build/generic-records/specialized-c-cpp.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=c,cpp node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-c-cpp.json
              LEAN_BRIDGE_CHECKED_RECORD_PROFILES=c,cpp node --test --test-concurrency=1 --test-name-pattern='C and C' tests/checked-records.test.mjs
              test -s build/checked-records/ordinary-c-cpp.json
              test -s build/checked-records/reviewed-c-cpp.json
              test -s build/checked-records/result-only-c-cpp.json
              LEAN_BRIDGE_CPP_VARIANT_TEST=1 node --test tests/cpp-variants.test.mjs
              test -s build/variants/cpp.json
              LEAN_BRIDGE_C_VARIANT_TEST=1 node --test tests/c-variants.test.mjs
              test -s build/variants/c.json
              LEAN_BRIDGE_C_CALLABLE_TEST=1 node --test tests/c-callables.test.mjs
              test -s build/callables/c.json
              LEAN_BRIDGE_C_STRUCTURED_CALLABLE_TEST=1 node --test tests/c-structured-callables.test.mjs
              test -s build/structured-callables/c.json
              LEAN_BRIDGE_C_CLOSURE_THREAD_TEST=1 node --test tests/closure-thread-contract.test.mjs tests/closure-thread-installed.test.mjs
              test -s build/closure-thread/installed.json
              LEAN_BRIDGE_CPP_CALLABLE_TEST=1 node --test tests/cpp-callables.test.mjs
              test -s build/callables/cpp.json
              LEAN_BRIDGE_CPP_STRUCTURED_CALLABLE_TEST=1 node --test tests/cpp-structured-callables.test.mjs
              test -s build/structured-callables/cpp.json
              LEAN_BRIDGE_NATIVE_RECURSIVE_CALLABLE_TEST=1 node --test tests/native-recursive-callable-compile.test.mjs
              test -s build/native-recursive-callables/transport.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-aggregate-native.test.mjs
              test -s build/owned-aggregate-native/transport.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-native-values.test.mjs tests/owned-native-scalars.test.mjs
              test -s build/owned-aggregate-native/values.json
              test -s build/owned-aggregate-native/scalars.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-c-values.test.mjs
              test -s build/owned-aggregate-native/public-c.json
              test -s build/owned-aggregate-native/public-c-scalars.json
              npm run test:owned-transfers
              test -s build/owned-transfers/native.json
              test -s build/owned-transfers/ordinary-c.json
              test -s build/owned-transfers/reviewed-c.json
              npm run test:owned-transfer-packages
              test -s build/owned-transfer-packaging/analysis-ordinary.json
              test -s build/owned-transfer-packaging/analysis-reviewed.json
              test -s build/owned-transfer-packaging/ordinary.json
              test -s build/owned-transfer-packaging/reviewed.json
              npm run test:owned-borrows > build/owned-borrows-runtime.log 2>&1
              rg '^# pass 8$' build/owned-borrows-runtime.log
              rg '^# fail 0$' build/owned-borrows-runtime.log
              rg '^# skipped 0$' build/owned-borrows-runtime.log
              npm run test:owned-borrow-packages > build/owned-borrows-installed.log 2>&1
              rg '^# pass 2$' build/owned-borrows-installed.log
              rg '^# fail 0$' build/owned-borrows-installed.log
              rg '^# skipped 0$' build/owned-borrows-installed.log
              test -s build/owned-borrows/native.json
              test -s build/owned-borrows/analysis-ordinary.json
              test -s build/owned-borrows/analysis-reviewed.json
              test -s build/owned-borrows/c-ordinary.json
              test -s build/owned-borrows/c-reviewed.json
              test -s build/owned-borrows/installed-ordinary.json
              test -s build/owned-borrows/installed-reviewed.json
              npm run test:owned-receivers > build/owned-receivers.log 2>&1
              cat build/owned-receivers.log
              rg '^# tests 8$' build/owned-receivers.log
              rg '^# pass 8$' build/owned-receivers.log
              rg '^# fail 0$' build/owned-receivers.log
              rg '^# cancelled 0$' build/owned-receivers.log
              rg '^# skipped 0$' build/owned-receivers.log
              test -s build/owned-receivers/ordinary.json
              test -s build/owned-receivers/reviewed.json
              test -s build/owned-receivers/ordinary-package.json
              test -s build/owned-receivers/reviewed-package.json
              test -s build/owned-receivers/ordinary-plain.json
              test -s build/owned-receivers/reviewed-plain.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/reviewed-owned-source.test.mjs
              test -s build/owned-aggregate-native/reviewed-public-c.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-c-packaging.test.mjs
              test -s build/owned-c-packaging/ordinary.json
              test -s build/owned-c-packaging/reviewed.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-host-callbacks.test.mjs
              test -s build/owned-host-callbacks/ordinary.json
              test -s build/owned-host-callbacks/reviewed.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-host-packaging.test.mjs
              test -s build/owned-host-packaging/ordinary.json
              test -s build/owned-host-packaging/reviewed.json
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-cpp-runtime.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-cpp-callables.test.mjs
              LEAN_BRIDGE_OWNED_NATIVE_TEST=1 node --test tests/owned-cpp-packaging.test.mjs
              test -s build/owned-cpp-packaging/ordinary.json
              test -s build/owned-cpp-packaging/reviewed.json
              npm run test:owned-cpp-transfers
              npm run test:owned-cpp-borrows > build/owned-cpp-borrows.log 2>&1
              cat build/owned-cpp-borrows.log
              rg '^# pass 5$' build/owned-cpp-borrows.log
              rg '^# fail 0$' build/owned-cpp-borrows.log
              rg '^# skipped 0$' build/owned-cpp-borrows.log
              test -s build/owned-cpp-borrows/ordinary.json
              test -s build/owned-cpp-borrows/reviewed.json
              test -s build/owned-cpp-borrow-packaging/ordinary.json
              test -s build/owned-cpp-borrow-packaging/reviewed.json
              npm run test:owned-cpp-receivers > build/owned-cpp-receivers.log 2>&1
              cat build/owned-cpp-receivers.log
              rg '^# tests 10$' build/owned-cpp-receivers.log
              rg '^# pass 10$' build/owned-cpp-receivers.log
              rg '^# fail 0$' build/owned-cpp-receivers.log
              rg '^# cancelled 0$' build/owned-cpp-receivers.log
              rg '^# skipped 0$' build/owned-cpp-receivers.log
              test -s build/owned-cpp-receivers/ordinary.json
              test -s build/owned-cpp-receivers/reviewed.json
              test -s build/owned-cpp-receivers/ordinary-package.json
              test -s build/owned-cpp-receivers/reviewed-package.json
              test -s build/owned-cpp-receivers/ordinary-plain.json
              test -s build/owned-cpp-receivers/reviewed-plain.json
              test -s build/owned-cpp-receivers/ordinary-consuming.json
              test -s build/owned-cpp-receivers/reviewed-consuming.json
              test -s build/owned-cpp-transfers/ordinary.json
              test -s build/owned-cpp-transfers/reviewed.json
              test -s build/owned-cpp-transfer-packaging/ordinary.json
              test -s build/owned-cpp-transfer-packaging/reviewed.json
              LEAN_BRIDGE_C_RECURSIVE_CALLABLE_TEST=1 node --test tests/c-recursive-callable-package.test.mjs
              test -s build/recursive-callables/c.json
              LEAN_BRIDGE_CPP_RECURSIVE_CALLABLE_TEST=1 node --test tests/cpp-recursive-callable-package.test.mjs
              test -s build/recursive-callables/cpp.json
              LEAN_BRIDGE_C_FAMILY_RECURSIVE_DOCUMENTATION_TEST=1 node --test tests/c-family-recursive-documentation.test.mjs
              test -s build/recursive-callables/c-family-documentation.json
              LEAN_BRIDGE_NATIVE_GRAPH_PACKAGE_TEST=1 node --test tests/native-graph-package.test.mjs
              test -s build/recursive/c-family.json
              test -s build/type-corpus/c-cpp.json
              test -s build/type-corpus/reviewed-native-c-cpp.json
          - name: Upload installed C and C++ corpus observations
            if: always() && matrix.profile == 'c-family'
            uses: actions/upload-artifact@v7
            with:
              name: type-corpus-c-family-${{ github.sha }}
              path: |
                build/type-corpus/c-cpp.json
                build/type-corpus/reviewed-native-c-cpp.json
                build/char-native/c-cpp.json
                build/word-native/c-cpp.json
                build/callables/c.json
                build/structured-callables/c.json
                build/closure-thread/installed.json
                build/callables/cpp.json
                build/structured-callables/cpp.json
                build/native-recursive-callables/transport.json
                build/owned-aggregate-native/transport.json
                build/owned-aggregate-native/values.json
                build/owned-aggregate-native/scalars.json
                build/owned-aggregate-native/public-c.json
                build/owned-aggregate-native/public-c-scalars.json
                build/owned-transfers/
                build/owned-transfer-packaging/
                build/owned-borrows/
                build/owned-borrows-runtime.log
                build/owned-borrows-installed.log
                build/owned-receivers/
                build/owned-receivers.log
                build/owned-aggregate-native/reviewed-public-c.json
                build/owned-c-packaging/
                build/owned-host-callbacks/ordinary.json
                build/owned-host-callbacks/reviewed.json
                build/owned-host-packaging/ordinary.json
                build/owned-host-packaging/reviewed.json
                build/owned-cpp-runtime/
                build/owned-cpp-callables/
                build/owned-cpp-packaging/ordinary.json
                build/owned-cpp-packaging/reviewed.json
                build/owned-cpp-transfers/
                build/owned-cpp-borrows/
                build/owned-cpp-borrow-packaging/
                build/owned-cpp-borrows.log
                build/owned-cpp-receivers/
                build/owned-cpp-receivers.log
                build/owned-cpp-transfer-packaging/
                build/recursive-callables/c.json
                build/recursive-callables/cpp.json
                build/recursive-callables/c-family-documentation.json
                build/compounds/native.json
                build/lists/native.json
                build/collections/native.json
                build/aliases/native.json
                build/native-fin/native.json
                build/native-fin/native-reviewed.json
                build/reviewed-fin-refusals/
                build/native-specializations/c-cpp.json
                build/reviewed-specializations/c-cpp.json
                build/native-fin-containers/c-cpp.json
                build/native-fin-containers/reviewed-c-cpp.json
                build/native-fin-container-edges/edges-c-cpp.json
                build/native-fin-products/c-cpp.json
                build/native-fin-products/reviewed-c-cpp.json
                build/native-fin-product-arrays/c-cpp.json
                build/native-fin-product-arrays/reviewed-c-cpp.json
                build/native-fin-records/c-cpp.json
                build/native-fin-records/reviewed-c-cpp.json
                build/native-fin-record-zero/c-cpp.json
                build/native-fin-record-zero/reviewed-c-cpp.json
                build/native-fin-callbacks/c-cpp.json
                build/native-fin-replies/
                build/native-subtype/c-cpp.json
                build/generic-records/c-cpp.json
                build/generic-records/specialized-c-cpp.json
                build/generic-records/array-c-cpp.json
                build/checked-records/ordinary-c-cpp.json
                build/checked-records/reviewed-c-cpp.json
                build/checked-records/result-only-c-cpp.json
                build/variants/cpp.json
                build/variants/c.json
                build/recursive/c-family.json
              if-no-files-found: error
              overwrite: true
              retention-days: 30
          - name: Select Python 3.11 for backported type aliases
            id: collection_python311
            if: matrix.profile == 'python'
            uses: actions/setup-python@v7
            with:
              python-version: "3.11"
          - name: Select Python 3.12 for standard-library type aliases
            id: collection_python312
            if: matrix.profile == 'python'
            uses: actions/setup-python@v7
            with:
              python-version: "3.12"
          - name: Install dependencies for ordinary_python
            timeout-minutes: 20
            if: matrix.profile == 'python'
            run: |
              sudo apt-get update && sudo apt-get install -y python3-venv
          - name: Build ordinary Lean APIs and install relocated Python wheels
            id: ordinary_python
            if: matrix.profile == 'python'
            continue-on-error: true
            env:
              LEAN_BRIDGE_NATIVE_PYTHON_TEST: "1"
            run: |
              source scripts/env.sh
              node --test tests/native-python.test.mjs
          - name: Compare installed Python corpus packages with fresh Lean results
            id: type_corpus_python
            if: matrix.profile == 'python'
            continue-on-error: true
            env:
              LEAN_BRIDGE_PYTHON: ${{ steps.collection_python311.outputs.python-path }}
              LEAN_BRIDGE_COLLECTION_PYTHONS: '["${{ steps.collection_python311.outputs.python-path }}", "${{ steps.collection_python312.outputs.python-path }}"]'
            run: |
              source scripts/env.sh
              python3 -m pip download --no-cache-dir --only-binary=:all: --no-deps --dest build/python-typing-wheels/4.6.0 typing_extensions==4.6.0
              python3 -m pip download --no-cache-dir --only-binary=:all: --no-deps --dest build/python-typing-wheels/4.16.0 typing_extensions==4.16.0
              python3 -m venv build/python-collection-typecheck
              build/python-collection-typecheck/bin/python -m pip install --no-cache-dir mypy==2.3.1 typing_extensions==4.16.0 mypy_extensions==1.1.0 pathspec==1.1.1 librt==0.15.0 ast-serialize==0.11.2
              LEAN_BRIDGE_PYTHON_WHEEL_INSTALL_TEST=1 node --test tests/python-wheel-install.test.mjs
              npm run test:type-corpus:python && LEAN_BRIDGE_REVIEWED_NATIVE_PROFILES=python node --test tests/type-corpus-reviewed-native.test.mjs
              LEAN_BRIDGE_CHAR_PROFILES=python node --test tests/native-char.test.mjs
              LEAN_BRIDGE_WORD_PROFILES=python node --test tests/native-words.test.mjs
              LEAN_BRIDGE_PYTHON_CALLABLE_TEST=1 node --test tests/python-callables.test.mjs
              test -s build/callables/python.json
              LEAN_BRIDGE_PYTHON_STRUCTURED_CALLABLE_TEST=1 node --test tests/python-structured-callables.test.mjs
              test -s build/structured-callables/python.json
              LEAN_BRIDGE_PYTHON_RECURSIVE_CALLABLE_TEST=1 node --test tests/python-recursive-callables.test.mjs
              test -s build/recursive-callables/python.json
              LEAN_BRIDGE_PYTHON_COMPOUND_TEST=1 node --test tests/python-compounds.test.mjs
              test -s build/compounds/python.json
              LEAN_BRIDGE_PYTHON_LIST_TEST=1 node --test tests/python-lists.test.mjs
              test -s build/lists/python.json
              python3 -m venv build/python-alias-typecheck
              build/python-alias-typecheck/bin/python -m pip install --no-cache-dir mypy==1.17.1 typing_extensions==4.16.0 mypy_extensions==1.1.0 pathspec==1.1.1
              LEAN_BRIDGE_PYTHON_ALIAS_TEST=1 node --test tests/python-aliases.test.mjs
              test -s build/aliases/python.json
              LEAN_BRIDGE_PYTHON_FIN_TEST=1 node --test tests/python-fin.test.mjs
              test -s build/native-fin/python.json
              test -s build/native-fin/python-reviewed.json
              LEAN_BRIDGE_SPECIALIZATION_PROFILES=python node --test tests/native-specializations.test.mjs
              test -s build/native-specializations/python.json
              LEAN_BRIDGE_GENERIC_RECORD_PROFILES=python node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/python.json
              test -s build/generic-records/specialized-python.json
              LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=python node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-python.json
              LEAN_BRIDGE_PYTHON="${{ steps.collection_python312.outputs.python-path }}" LEAN_BRIDGE_GENERIC_RECORD_REPORT=build/generic-records/python312.json LEAN_BRIDGE_GENERIC_RECORD_SPECIALIZED_REPORT=build/generic-records/specialized-python312.json LEAN_BRIDGE_GENERIC_RECORD_PROFILES=python node --test --test-name-pattern='relocated source-free native packages construct' tests/generic-records.test.mjs
              test -s build/generic-records/python312.json
              test -s build/generic-records/specialized-python312.json
              LEAN_BRIDGE_PYTHON="${{ steps.collection_python312.outputs.python-path }}" LEAN_BRIDGE_GENERIC_RECORD_ARRAY_REPORT=build/generic-records/array-python312.json LEAN_BRIDGE_GENERIC_RECORD_ARRAY_PROFILES=python node --test --test-concurrency=1 tests/generic-record-arrays.test.mjs
              test -s build/generic-records/array-python312.json
              LEAN_BRIDGE_FIN_CONTAINER_PROFILES=python LEAN_BRIDGE_REVIEWED_FIN_CONTAINER_PROFILES=python node --test tests/native-fin-containers.test.mjs
              test -s build/native-fin-containers/python.json
              test -s build/native-fin-containers/reviewed-python.json
