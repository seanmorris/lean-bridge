2026-10-10T13:00:27.1049430Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-10T13:00:27.1049905Z 
2026-10-10T13:00:27.1050445Z # To enable the settings / commands in this file for login shells as well,
2026-10-10T13:00:27.1051303Z # this file has to be sourced in /etc/profile.
2026-10-10T13:00:27.1051689Z 
2026-10-10T13:00:27.1052040Z # If not running interactively, don't do anything
2026-10-10T13:00:27.1052627Z [ -z "$PS1" ] && return
2026-10-10T13:00:27.1052885Z 
2026-10-10T13:00:27.1053307Z # check the window size after each command and, if necessary,
2026-10-10T13:00:27.1054035Z # update the values of LINES and COLUMNS.
2026-10-10T13:00:27.1054584Z shopt -s checkwinsize
2026-10-10T13:00:27.1054839Z 
2026-10-10T13:00:27.1055379Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-10T13:00:27.1056371Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-10T13:00:27.1057130Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-10T13:00:27.1057457Z fi
2026-10-10T13:00:27.1057566Z 
2026-10-10T13:00:27.1057841Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-10T13:00:27.1058418Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-10T13:00:27.1059194Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-10T13:00:27.1059905Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-10T13:00:27.1060454Z fi
2026-10-10T13:00:27.1060713Z 
2026-10-10T13:00:27.1061486Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-10T13:00:27.1062117Z # If this is an xterm set the title to user@host:dir
2026-10-10T13:00:27.1062465Z #case "$TERM" in
2026-10-10T13:00:27.1062700Z #xterm*|rxvt*)
2026-10-10T13:00:27.1063102Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-10T13:00:27.1063473Z #    ;;
2026-10-10T13:00:27.1063666Z #*)
2026-10-10T13:00:27.1063844Z #    ;;
2026-10-10T13:00:27.1064021Z #esac
