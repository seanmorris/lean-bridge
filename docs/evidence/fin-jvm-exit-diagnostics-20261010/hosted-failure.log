2026-10-10T13:00:27.1067002Z 
2026-10-10T13:00:27.1067106Z # sudo hint
2026-10-10T13:00:27.1067748Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-10T13:00:27.1068234Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-10T13:00:27.1068561Z     if [ -x /usr/bin/sudo ]; then
