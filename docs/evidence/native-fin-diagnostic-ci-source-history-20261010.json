    {
      "path": "tests/fin-container-entry-ci.test.mjs",
      "currentSha256": "a39904fa40eaed73425bfeef7ace872766df72931980758dde347cf6052c5b64",
      "previousSha256": "adcad1e8a52d49ab0e9495f737c964411f7bb10d628dbfc57f462e13aae8a008",
      "edits": [
        {
          "start": 575,
          "previous": "",
          "current": "import { sha256 } from \"../src/capsule/node.mjs\";\n"
        },
        {
          "start": 1042,
          "previous": "",
          "current": "import { finContainerEntrySourceDigests } from \"./helpers/fin-container-entry-probes.mjs\";\nimport { cppFinContainerEntryProbe } from \"./helpers/cpp-fin-container-entry-probe.mjs\";\nimport { assertContainerEntryItem } from \"./helpers/fin-container-entry-evidence.mjs\";\n"
        },
        {
          "start": 6800,
          "previous": "test(\"the report gate accepts the actual installed reports of all seven hosts in their CI selections\", async () => {\n\tlet hosts = 0;\n",
          "current": "test(\"original seven-host reports retain their archived diagnostic probes and rows\", async () => {\n"
        },
        {
          "start": 7037,
          "previous": "",
          "current": "\t\tfor(const report of value.reports.filter(report => report.profile !== \"c\")) assertContainerEntryItem(report, route);\n\t\tassert.throws(() => assertFinContainerEntryCiReport(value, item.profiles, route), assert.AssertionError, \"old diagnostics cannot stand in for current acceptance\");\n\t}\n});\n\n// In-memory checker fixtures only, not new execution evidence. Original archive bytes above remain unchanged.\n// Keep the historical package/definer structure and substitute current probe identities and expected rows so\n// every negative control starts from a passing current-format report instead of an already-stale archive.\nconst fixture = async (profiles, route) => {\n\tconst value = await actual(profiles, route), sources = finContainerEntrySourceDigests();\n\tconst probes = { cpp: sha256(cppFinContainerEntryProbe())\n\t\t, \"php-native\": sources.php, \"wit-wasi\": sources.wit, ruby: sources.ruby\n\t\t, dotnet: sources.dotnet, java: sources.java, kotlin: sources.kotlin };\n\tfor(const report of value.reports.filter(report => report.profile !== \"c\"))\n\t{\n\t\treport.dispatch.public.probeSha256 = probes[report.profile];\n\t\treport.dispatch.public.observed = structuredClone(finContainerEntryExpected);\n\t}\n\treturn value;\n};\n\ntest(\"the current report gate accepts synthetic format fixtures for all seven hosted selections\", async () => {\n\tlet hosts = 0;\n\tfor(const item of finContainerEntryCiSelections) for(const route of routes(item))\n\t{\n\t\tconst value = await fixture(item.profiles, route);\n"
        },
        {
          "start": 15592,
          "previous": "\t\tconst route = profiles.includes(\"c\") ? \"reviewed-ir\" : \"ordinary-source\", value = await actual(profiles, route);\n",
          "current": "\t\tconst route = profiles.includes(\"c\") ? \"reviewed-ir\" : \"ordinary-source\", value = await fixture(profiles, route);\n\t\tassertFinContainerEntryCiReport(value, profiles, route);\n"
        },
        {
          "start": 16371,
          "previous": "\t\tconst value = await actual(profiles, route === \"relocated\" ? \"ordinary-source\" : route);\n",
          "current": "\t\tconst value = await fixture(profiles, route === \"relocated\" ? \"ordinary-source\" : route);\n"
        },
        {
          "start": 17224,
          "previous": "",
          "current": "\tassert.notEqual(run(\"dotnet\", ordinary, reviewed).status, 0, \"historical probes cannot pass the live checker\");\n\tawait writeFile(ordinary, JSON.stringify(await fixture([\"dotnet\"], \"ordinary-source\")));\n\tawait writeFile(reviewed, JSON.stringify(await fixture([\"dotnet\"], \"reviewed-ir\")));\n"
        },
        {
          "start": 17984,
          "previous": "\tconst unobserved = await actual([\"dotnet\"], \"reviewed-ir\"); unobserved.reports[0].dispatch = { observed: false };\n",
          "current": "\tconst unobserved = await fixture([\"dotnet\"], \"reviewed-ir\"); unobserved.reports[0].dispatch = { observed: false };\n"
        }
      ]
    },
