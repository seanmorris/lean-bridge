      "currentSha256": "3f42de7adffc19c47844f0768be3451e810e8f51ac5a6ca83cee7af3f45001c2",
      "edits": [
        {
          "current": "  # The documentation contract validates links to selected nested JSON\n  # receipts. It needs those text receipts, but never the retained package,\n  # archive, object or executable payloads beside them.\n  LEAN_BRIDGE_DOCUMENTATION_SPARSE_CHECKOUT: |\n    /*\n    !/*/\n    /.github/\n    /acceptance/\n    /config/\n    /containers/\n    /demos/\n    /nix/\n    /notices/\n    /patches/\n    /poc/\n    /schema/\n    /scripts/\n    /site/\n    /src/\n    /tests/\n    /docs/\n    !/docs/evidence/*\n    /docs/evidence/*.json\n    /docs/evidence/*.md\n    /docs/evidence/*.xml\n    /docs/evidence/**/*.json\n    /docs/evidence/**/*.md\n    /docs/evidence/**/*.xml\n",
          "previous": "",
          "start": 892
        },
        {
