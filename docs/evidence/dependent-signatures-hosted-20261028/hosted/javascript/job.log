2026-10-29T21:56:12.4057936Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-29T21:56:12.4058271Z 
2026-10-29T21:56:12.4058532Z # To enable the settings / commands in this file for login shells as well,
2026-10-29T21:56:12.4058964Z # this file has to be sourced in /etc/profile.
2026-10-29T21:56:12.4059182Z 
2026-10-29T21:56:12.4059349Z # If not running interactively, don't do anything
2026-10-29T21:56:12.4059674Z [ -z "$PS1" ] && return
2026-10-29T21:56:12.4059808Z 
2026-10-29T21:56:12.4060023Z # check the window size after each command and, if necessary,
