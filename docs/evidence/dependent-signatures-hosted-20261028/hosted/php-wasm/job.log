2026-10-29T22:57:01.6189184Z                    return $?
2026-10-29T22:57:01.6189563Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-10-29T22:57:01.6190029Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-10-29T22:57:01.6190358Z                    return $?
2026-10-29T22:57:01.6190577Z 		else
2026-10-29T22:57:01.6190826Z 		   printf "%s: command not found\n" "$1" >&2
2026-10-29T22:57:01.6191146Z 		   return 127
2026-10-29T22:57:01.6191340Z 		fi
2026-10-29T22:57:01.6191513Z 	}
