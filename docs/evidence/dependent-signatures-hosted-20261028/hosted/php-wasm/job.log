2026-10-29T22:57:01.6164670Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-29T22:57:01.6165136Z 
2026-10-29T22:57:01.6165643Z # To enable the settings / commands in this file for login shells as well,
2026-10-29T22:57:01.6166511Z # this file has to be sourced in /etc/profile.
2026-10-29T22:57:01.6166902Z 
2026-10-29T22:57:01.6167259Z # If not running interactively, don't do anything
2026-10-29T22:57:01.6167854Z [ -z "$PS1" ] && return
2026-10-29T22:57:01.6168094Z 
2026-10-29T22:57:01.6168524Z # check the window size after each command and, if necessary,
2026-10-29T22:57:01.6169296Z # update the values of LINES and COLUMNS.
2026-10-29T22:57:01.6169863Z shopt -s checkwinsize
2026-10-29T22:57:01.6170120Z 
2026-10-29T22:57:01.6170685Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-29T22:57:01.6171656Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-29T22:57:01.6172428Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-29T22:57:01.6172897Z fi
2026-10-29T22:57:01.6173313Z 
2026-10-29T22:57:01.6173768Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-29T22:57:01.6174778Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-29T22:57:01.6175361Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-29T22:57:01.6175862Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-29T22:57:01.6176181Z fi
2026-10-29T22:57:01.6176282Z 
2026-10-29T22:57:01.6176587Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-29T22:57:01.6177181Z # If this is an xterm set the title to user@host:dir
2026-10-29T22:57:01.6177726Z #case "$TERM" in
2026-10-29T22:57:01.6178077Z #xterm*|rxvt*)
2026-10-29T22:57:01.6178472Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-29T22:57:01.6178861Z #    ;;
2026-10-29T22:57:01.6179041Z #*)
2026-10-29T22:57:01.6179214Z #    ;;
2026-10-29T22:57:01.6179393Z #esac
2026-10-29T22:57:01.6179494Z 
2026-10-29T22:57:01.6179715Z # enable bash completion in interactive shells
2026-10-29T22:57:01.6180124Z #if ! shopt -oq posix; then
2026-10-29T22:57:01.6180582Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-29T22:57:01.6181016Z #    . /usr/share/bash-completion/bash_completion
2026-10-29T22:57:01.6181383Z #  elif [ -f /etc/bash_completion ]; then
