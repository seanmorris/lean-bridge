2026-10-29T22:57:01.6182207Z #  fi
2026-10-29T22:57:01.6182384Z #fi
2026-10-29T22:57:01.6182623Z 
2026-10-29T22:57:01.6182704Z # sudo hint
2026-10-29T22:57:01.6183478Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-29T22:57:01.6183984Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-29T22:57:01.6184326Z     if [ -x /usr/bin/sudo ]; then
2026-10-29T22:57:01.6184597Z 	cat <<-EOF
2026-10-29T22:57:01.6184942Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-29T22:57:01.6185354Z 	See "man sudo_root" for details.
2026-10-29T22:57:01.6185608Z 	
2026-10-29T22:57:01.6185780Z 	EOF
2026-10-29T22:57:01.6185958Z     fi
2026-10-29T22:57:01.6186139Z     esac
2026-10-29T22:57:01.6186320Z fi
2026-10-29T22:57:01.6186416Z 
2026-10-29T22:57:01.6186624Z # if the command-not-found package is installed, use it
2026-10-29T22:57:01.6187243Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-29T22:57:01.6187744Z 	function command_not_found_handle {
