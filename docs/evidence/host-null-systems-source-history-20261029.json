          "current": "  host-null-systems:\n    name: Systems HostNull acceptance\n    runs-on: ubuntu-24.04\n    timeout-minutes: 150\n    steps:\n      - name: Check out the exact revision\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n      - name: Install Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: ${{ env.NODE_VERSION }}\n          cache: npm\n      - name: Install Nix\n        uses: cachix/install-nix-action@v31\n      - name: Install dependencies without lifecycle scripts\n        run: npm ci --ignore-scripts\n      - name: Bound apt network waits\n        uses: ./.github/actions/bounded-apt\n        timeout-minutes: 1\n      - name: Install systems build dependencies\n        timeout-minutes: 20\n        run: |\n          sudo apt-get update\n          sudo apt-get install -y build-essential cmake pkg-config zstd ripgrep libgmp-dev\n      - name: Prepare pinned systems toolchains\n        shell: bash\n        run: |\n          set -euo pipefail\n          bash scripts/bootstrap-toolchains.sh --lean-only\n          bash scripts/bootstrap-toolchains.sh --wasm-tools-only\n          bash scripts/bootstrap-rust-ci.sh\n          (\n            set -euo pipefail\n            test \"$(uname -sm)\" = 'Linux x86_64'\n            mkdir -p build\n            test ! -e build/wasmtime-c-api && test ! -L build/wasmtime-c-api\n            WASMTIME_CAPI_STAGING=$(mktemp -d build/wasmtime-c-api.XXXXXX)\n            trap 'rm -rf -- \"$WASMTIME_CAPI_STAGING\"' EXIT\n            curl --fail --location --retry 3 --retry-delay 2 --connect-timeout 20 --max-time 300 \\\n              --output \"$WASMTIME_CAPI_STAGING/wasmtime.tar.xz\" \\\n              'https://github.com/bytecodealliance/wasmtime/releases/download/v42.0.1/wasmtime-v42.0.1-x86_64-linux-c-api.tar.xz'\n            echo '2097a47351918a446b26c7e65f487278f63bc947591b71897db547cd90c05082'\"  $WASMTIME_CAPI_STAGING/wasmtime.tar.xz\" | sha256sum --check --status\n            mkdir \"$WASMTIME_CAPI_STAGING/unpacked\"\n            tar -xJf \"$WASMTIME_CAPI_STAGING/wasmtime.tar.xz\" --strip-components=1 -C \"$WASMTIME_CAPI_STAGING/unpacked\"\n            test -s \"$WASMTIME_CAPI_STAGING/unpacked/include/wasmtime.h\"\n            test -s \"$WASMTIME_CAPI_STAGING/unpacked/include/wasm.h\"\n            test -s \"$WASMTIME_CAPI_STAGING/unpacked/lib/libwasmtime.so\"\n            test -s \"$WASMTIME_CAPI_STAGING/unpacked/lib/libwasmtime.a\"\n            mv -T \"$WASMTIME_CAPI_STAGING/unpacked\" build/wasmtime-c-api\n          )\n      - name: Qualify HostNull in prepared systems packages\n        id: host_null_systems\n        continue-on-error: true\n        timeout-minutes: 120\n        env:\n          LEAN_BRIDGE_WASMTIME_C_API: ${{ github.workspace }}/build/wasmtime-c-api\n          LEAN_BRIDGE_WASM_TOOLS: ${{ github.workspace }}/.toolchains/wasm-tools/bin/wasm-tools\n        run: bash scripts/run-host-null-systems-ci.sh\n      - name: Preserve systems HostNull acceptance\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: host-null-systems-${{ github.sha }}\n          path: build/host-null-systems-ci/\n          if-no-files-found: error\n          overwrite: true\n          retention-days: 30\n      - name: Enforce systems HostNull support\n        if: steps.host_null_systems.outcome != 'success'\n        run: exit 1\n\n",
          "previous": "",
          "start": 332239
        }
