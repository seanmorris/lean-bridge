      "path": "tests/reviewed-fin-wasm-entry-controls.test.mjs",
      "currentSha256": "f3fa6f59a35698a31cde6908351331a2c56de617e4c9106d5acb6ae4193d9c2c",
      "previousSha256": "8c4a04da002d520dc583fc4fad62a99a8f469933cc9fe204ddcf760ca9b005cb",
      "edits": [
        {
          "start": 7211,
          "previous": "\t// Each changed contract keeps a freshly rederived private ABI, as a rebuilt package would.\n",
          "current": "\t// Each well-formed changed contract keeps a freshly rederived private ABI, as a rebuilt package would.\n"
        },
        {
          "start": 8908,
          "previous": "\t\t, [\"parameter type\", changed(\"scalar\", \"original\", ir => { ir.declarations[0].parameters[0].type = { kind: \"primitive\", name: \"int\" }; })]\n\t\t, [\"bound position\", changed(\"scalar\", \"original\", ir => { const value = refinement(ir, \"label\"); value.parameters = [value.parameters[1], value.parameters[0], value.parameters[2]]; })]\n",
          "current": ""
        },
        {
          "start": 10811,
          "previous": "",
          "current": "\t// Mismatched refinement/transport pairs cannot produce a private ABI at all.\n\t// Keep these separate from valid rebuilt descriptors rejected by selection.\n\tfor(const [label, change] of [\n\t\t[\"parameter type\", ir => { ir.declarations[0].parameters[0].type = { kind: \"primitive\", name: \"int\" }; }]\n\t\t, [\"bound position\", ir => { const value = refinement(ir, \"label\"); value.parameters = [value.parameters[1], value.parameters[0], value.parameters[2]]; }]\n\t]) assert.throws(() => changed(\"scalar\", \"original\", change), { name: \"TypeError\", message: \"Refinement does not match its transport type\" }, label);\n"
        }
      ]
    }
