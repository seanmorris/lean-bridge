      "currentSha256": "b52c93fc0af1fc5159a132ed5299a5fbbadd94bc44f89972656bb1546cd4d904",
      "edits": [
        {
          "current": "import {\n\tbeforeCoreInheritedRecordTypeSurfaceBatchSource\n\t, coreInheritedRecordTypeSurfaceBatchHistoryAdditions\n\t, coreInheritedRecordTypeSurfaceBatchHistoryPath\n\t, coreInheritedRecordTypeSurfaceBatchImplementation\n\t, coreInheritedRecordTypeSurfaceBatchImplementationPaths\n\t, coreInheritedRecordTypeSurfaceBatchIntegrationPaths\n\t, coreInheritedRecordTypeSurfaceBatchPredecessor\n\t, reverseCoreInheritedRecordTypeSurfaceBatchUpdate\n} from \"./core-inherited-record-type-surface-batch-source-history.mjs\";\n",
          "previous": "",
          "start": 357
        },
        {
          "current": "const readCoreInheritedRecordTypeSurfaceBatch = async () => JSON.parse(\n\tawait readFile(coreInheritedRecordTypeSurfaceBatchHistoryPath, \"utf8\")\n);\n",
          "previous": "",
          "start": 15804
        },
        {
          "current": "test(\"Core inherited-record type-surface batching records its exact repair\", async () => {\n\tconst record = await readCoreInheritedRecordTypeSurfaceBatch();\n\tassert.equal(record.schemaVersion, 1);\n\tassert.equal(record.milestone\n\t\t, \"core-inherited-record-type-surface-batch-source-v1\");\n\tassert.equal(record.predecessorCommit\n\t\t, coreInheritedRecordTypeSurfaceBatchPredecessor);\n\tassert.equal(record.implementationCommit\n\t\t, coreInheritedRecordTypeSurfaceBatchImplementation);\n\tassert.deepEqual(record.updates.map(update => update.path)\n\t\t, coreInheritedRecordTypeSurfaceBatchImplementationPaths);\n\tassert.deepEqual(record.historyAdditions.map(addition => addition.path)\n\t\t, coreInheritedRecordTypeSurfaceBatchHistoryAdditions);\n\tassert.deepEqual(record.integrationUpdates.map(update => update.path)\n\t\t, coreInheritedRecordTypeSurfaceBatchIntegrationPaths);\n\tassert.equal(git([\"rev-parse\"\n\t\t, `${coreInheritedRecordTypeSurfaceBatchImplementation}^`]).trim()\n\t, coreInheritedRecordTypeSurfaceBatchPredecessor);\n\tassert.deepEqual(git([\"diff\", \"--name-only\", \"--diff-filter=M\"\n\t\t, coreInheritedRecordTypeSurfaceBatchPredecessor\n\t\t, coreInheritedRecordTypeSurfaceBatchImplementation])\n\t\t.trim().split(\"\\n\").sort()\n\t, [...coreInheritedRecordTypeSurfaceBatchImplementationPaths].sort());\n});\n\ntest(\"Core inherited-record type-surface batching reverses every transition\", async () => {\n\tconst record = await readCoreInheritedRecordTypeSurfaceBatch();\n\tfor(const update of [...record.updates, ...record.integrationUpdates])\n\t{\n\t\tconst integration = record.integrationUpdates.includes(update);\n\t\tconst current = integration\n\t\t\t? await sourceAtFinHistoryRecordSource(\n\t\t\t\tcoreInheritedRecordTypeSurfaceBatchHistoryPath, update.path\n\t\t\t\t\t, update.currentSha256\n\t\t\t\t\t, beforeCoreInheritedRecordTypeSurfaceBatchSource\n\t\t\t)\n\t\t\t: await sourceAtFinHistoryRecord(\n\t\t\t\tcoreInheritedRecordTypeSurfaceBatchHistoryPath, update.path\n\t\t\t\t\t, beforeCoreInheritedRecordTypeSurfaceBatchSource\n\t\t\t);\n\t\tconst base = integration\n\t\t\t? coreInheritedRecordTypeSurfaceBatchImplementation\n\t\t\t: coreInheritedRecordTypeSurfaceBatchPredecessor;\n\t\tconst previous = git([\"show\", `${base}:${update.path}`]);\n\t\tassert.equal(reverseCoreInheritedRecordTypeSurfaceBatchUpdate(\n\t\t\tcurrent, update), previous, update.path);\n\t\tassert.equal(beforeFinRefinementSource(\n\t\t\tupdate.path, current, update.previousSha256), previous, update.path);\n\t\tassert.ok(finRefinementNormalizationPaths.includes(update.path));\n\t}\n\tfor(const addition of record.historyAdditions)\n\t\tassert.equal(sha256(await sourceAtFinHistoryRecordSource(\n\t\t\tcoreInheritedRecordTypeSurfaceBatchHistoryPath\n\t\t\t, addition.path, addition.currentSha256\n\t\t)), addition.currentSha256, addition.path);\n});\n\ntest(\"Core inherited-record type-surface batching rejects altered transitions\", async () => {\n\tconst update = (await readCoreInheritedRecordTypeSurfaceBatch()).updates[0];\n\tconst current = await sourceAtFinHistoryRecord(\n\t\tcoreInheritedRecordTypeSurfaceBatchHistoryPath, update.path\n\t\t, beforeCoreInheritedRecordTypeSurfaceBatchSource\n\t);\n\tfor(const forged of [{ ...update, currentSha256: \"0\".repeat(64) }\n\t\t, { ...update, previousSha256: \"0\".repeat(64) }\n\t\t, { ...update, path: \"unrelated.mjs\" }\n\t\t, { ...update, edits: [] }\n\t\t, { ...update, edits: [...update.edits, update.edits[0]] }])\n\t\tassert.throws(() => reverseCoreInheritedRecordTypeSurfaceBatchUpdate(\n\t\t\tcurrent, forged));\n\tassert.equal(beforeCoreInheritedRecordTypeSurfaceBatchSource(\n\t\tupdate.path, current + \"unknown\"), current + \"unknown\");\n});\n\ntest(\"Core inherited-record type-surface batch writer refuses another checkout\", async t => {\n\tconst root = await mkdtemp(join(\n\t\ttmpdir(), \"lean-core-inherited-type-surface-batch-history-guard-\"));\n\tt.after(() => rm(root, { recursive: true }));\n\tconst result = spawnSync(process.execPath, [resolve(\n\t\t\"scripts/update-core-inherited-record-type-surface-batch-source-history.mjs\"\n\t)], { cwd: root, encoding: \"utf8\", timeout: 15_000 });\n\tassert.notEqual(result.status, 0);\n\tassert.equal(result.stdout, \"\");\n\tassert.deepEqual(await readdir(root), []);\n});\n\n",
          "previous": "",
          "start": 20127
        }
      ],
