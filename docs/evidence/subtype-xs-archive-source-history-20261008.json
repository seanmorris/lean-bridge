      "edits": [
        {
          "start": 922,
          "previous": "import { installNativeSubtypeConsumer, nativeSubtypeContracts, nativeSubtypeEnvironment, nativeSubtypeRefinements, nativeSubtypeTargets } from \"./helpers/native-subtype-install.mjs\";\n",
          "current": "import { installNativeSubtypeConsumer, nativeSubtypeContracts, nativeSubtypeEnvironment, nativeSubtypeRefinements, nativeSubtypeTargets, readArchivedSubtypeXs } from \"./helpers/native-subtype-install.mjs\";\n"
        },
        {
          "start": 1695,
          "previous": "",
          "current": "import \"./helpers/subtype-xs-archive-source-history-tests.mjs\";\n"
        },
        {
          "start": 2585,
          "previous": "",
          "current": "test(\"archived Subtype XS remains readable without a PATH-provided decompressor\", { skip: process.platform !== \"linux\" }, async t => {\n\tconst directory = await mkdtemp(join(tmpdir(), \"lean-bridge-subtype-xs-archive-\"));\n\tt.after(() => rm(directory, { recursive: true, force: true }));\n\tconst archive = join(directory, \"example.tar.gz\"), source = \"MODULE = Example PACKAGE = Example\\n/* exact archived XS bytes */\\n\";\n\tawait saveLakeFile(directory, \"Example/Component.xs\", source);\n\tawait runCopied(\"/usr/bin/tar\", [\"--use-compress-program=/usr/bin/gzip\", \"-cf\", archive, \"Example/Component.xs\"], directory, copiedCleanEnvironment);\n\t// The original command really fails in this environment; do not restore PATH to pass the test.\n\tawait assert.rejects(() => runCopied(\"/usr/bin/tar\", [\"-xOzf\", archive, \"--wildcards\", \"*/Component.xs\"], directory, copiedCleanEnvironment), error => {\n\t\tassert.equal(error.code, \"build-command-failed\");\n\t\tassert.match(error.details.stderr, /gzip: Cannot exec: No such file or directory/u);\n\t\treturn true;\n\t});\n\tassert.equal(await readArchivedSubtypeXs(archive, directory), source);\n});\n\n"
        },
        {
          "start": 18925,
          "previous": "\t\t\tconst xs = (await runCopied(\"/usr/bin/tar\", [\"-xOzf\", join(handoff, archive), \"--wildcards\", \"*/Component.xs\"], consumer, copiedCleanEnvironment)).stdout;\n",
          "current": "\t\t\tconst xs = await readArchivedSubtypeXs(join(handoff, archive), consumer);\n"
        }
      ]
    },
