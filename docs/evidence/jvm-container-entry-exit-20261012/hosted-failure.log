2026-10-12T09:51:30.3524950Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-12T09:51:30.3525243Z 
2026-10-12T09:51:30.3525545Z # To enable the settings / commands in this file for login shells as well,
2026-10-12T09:51:30.3526118Z # this file has to be sourced in /etc/profile.
2026-10-12T09:51:30.3526346Z 
2026-10-12T09:51:30.3526556Z # If not running interactively, don't do anything
2026-10-12T09:51:30.3526942Z [ -z "$PS1" ] && return
2026-10-12T09:51:30.3527099Z 
2026-10-12T09:51:30.3527354Z # check the window size after each command and, if necessary,
2026-10-12T09:51:30.3528051Z # update the values of LINES and COLUMNS.
2026-10-12T09:51:30.3528380Z shopt -s checkwinsize
2026-10-12T09:51:30.3528527Z 
2026-10-12T09:51:30.3528827Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-12T09:51:30.3529387Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-12T09:51:30.3529819Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-12T09:51:30.3530095Z fi
2026-10-12T09:51:30.3530202Z 
2026-10-12T09:51:30.3530463Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-12T09:51:30.3531422Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-12T09:51:30.3532286Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-12T09:51:30.3532980Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-12T09:51:30.3533435Z fi
2026-10-12T09:51:30.3533545Z 
