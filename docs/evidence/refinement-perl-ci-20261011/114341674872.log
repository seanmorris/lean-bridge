2026-10-10T23:42:14.5539816Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-10T23:42:14.5540040Z 
2026-10-10T23:42:14.5540486Z # To enable the settings / commands in this file for login shells as well,
2026-10-10T23:42:14.5540952Z # this file has to be sourced in /etc/profile.
2026-10-10T23:42:14.5541172Z 
2026-10-10T23:42:14.5541373Z # If not running interactively, don't do anything
2026-10-10T23:42:14.5541702Z [ -z "$PS1" ] && return
2026-10-10T23:42:14.5541868Z 
2026-10-10T23:42:14.5542117Z # check the window size after each command and, if necessary,
2026-10-10T23:42:14.5542540Z # update the values of LINES and COLUMNS.
2026-10-10T23:42:14.5542795Z shopt -s checkwinsize
2026-10-10T23:42:14.5542923Z 
2026-10-10T23:42:14.5543184Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-10T23:42:14.5543656Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-10T23:42:14.5543989Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-10T23:42:14.5544231Z fi
2026-10-10T23:42:14.5544321Z 
2026-10-10T23:42:14.5544547Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-10T23:42:14.5545035Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-10T23:42:14.5545442Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-10T23:42:14.5545773Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-10T23:42:14.5546028Z fi
2026-10-10T23:42:14.5546130Z 
2026-10-10T23:42:14.5546337Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
