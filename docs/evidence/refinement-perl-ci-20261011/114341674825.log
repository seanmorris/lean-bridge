2026-10-10T23:42:19.0420270Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-10T23:42:19.0420501Z 
2026-10-10T23:42:19.0420754Z # To enable the settings / commands in this file for login shells as well,
2026-10-10T23:42:19.0421188Z # this file has to be sourced in /etc/profile.
2026-10-10T23:42:19.0421410Z 
2026-10-10T23:42:19.0421576Z # If not running interactively, don't do anything
2026-10-10T23:42:19.0421878Z [ -z "$PS1" ] && return
2026-10-10T23:42:19.0422003Z 
2026-10-10T23:42:19.0422198Z # check the window size after each command and, if necessary,
2026-10-10T23:42:19.0422531Z # update the values of LINES and COLUMNS.
2026-10-10T23:42:19.0422769Z shopt -s checkwinsize
2026-10-10T23:42:19.0422890Z 
2026-10-10T23:42:19.0423123Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-10T23:42:19.0423567Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-10T23:42:19.0423889Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-10T23:42:19.0424114Z fi
2026-10-10T23:42:19.0424203Z 
2026-10-10T23:42:19.0424415Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-10T23:42:19.0425188Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-10T23:42:19.0425762Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-10T23:42:19.0426248Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-10T23:42:19.0426618Z fi
2026-10-10T23:42:19.0426750Z 
