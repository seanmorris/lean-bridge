      "edits": [
        {
          "start": 252012,
          "previous": "",
          "current": "      - name: Require nominal Java and Kotlin packages\n        if: matrix.profile == 'jvm'\n        id: nominal_jvm\n        timeout-minutes: 45\n        run: |\n          set -euo pipefail\n          source scripts/env.sh\n          bash scripts/run-nominal-subtype-jvm-ci.sh \"$JAVA_HOME/bin/java\" \"$JAVA_HOME/bin/javac\" \"$PWD/build/kotlin-tools/kotlinc/bin/kotlinc\"\n      - name: Preserve complete and partial nominal JVM records\n        if: always() && matrix.profile == 'jvm'\n        uses: actions/upload-artifact@v7\n        with:\n          name: nominal-subtype-jvm-${{ github.sha }}\n          path: build/nominal-subtype-jvm-ci/\n          if-no-files-found: error\n          retention-days: 30\n"
        },
        {
          "start": 281497,
          "previous": "              if [ \"${{ steps.ordinary_jvm.outcome }}\" != success ] || [ \"${{ steps.type_corpus_jvm.outcome }}\" != success ]; then\n",
          "current": "              consumer_command=\"$consumer_command && bash scripts/run-nominal-subtype-jvm-ci.sh \\\"$JAVA_HOME/bin/java\\\" \\\"$JAVA_HOME/bin/javac\\\" \\\"$PWD/build/kotlin-tools/kotlinc/bin/kotlinc\\\"\"\n              if [ \"${{ steps.ordinary_jvm.outcome }}\" != success ] || [ \"${{ steps.type_corpus_jvm.outcome }}\" != success ] || [ \"${{ steps.nominal_jvm.outcome }}\" != success ]; then\n"
        },
        {
          "start": 288428,
          "previous": "        if: always() && (steps.consumer.outcome != 'success' || (matrix.profile == 'dotnet' && (steps.ordinary_dotnet.outcome != 'success' || steps.type_corpus_dotnet.outcome != 'success')) || (matrix.profile == 'jvm' && (steps.ordinary_jvm.outcome != 'success' || steps.type_corpus_jvm.outcome != 'success')) || (matrix.profile == 'ruby' && (steps.ordinary_ruby.outcome != 'success' || steps.type_corpus_ruby.outcome != 'success')))\n",
          "current": "        if: always() && (steps.consumer.outcome != 'success' || (matrix.profile == 'dotnet' && (steps.ordinary_dotnet.outcome != 'success' || steps.type_corpus_dotnet.outcome != 'success')) || (matrix.profile == 'jvm' && (steps.ordinary_jvm.outcome != 'success' || steps.type_corpus_jvm.outcome != 'success' || steps.nominal_jvm.outcome != 'success')) || (matrix.profile == 'ruby' && (steps.ordinary_ruby.outcome != 'success' || steps.type_corpus_ruby.outcome != 'success')))\n"
        }
      ]
    },
