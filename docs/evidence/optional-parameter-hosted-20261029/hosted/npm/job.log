2026-10-29T14:44:50.5334028Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-29T14:44:50.5338467Z 
2026-10-29T14:44:50.5342025Z # To enable the settings / commands in this file for login shells as well,
2026-10-29T14:44:50.5353077Z # this file has to be sourced in /etc/profile.
2026-10-29T14:44:50.5354962Z 
2026-10-29T14:44:50.5355254Z # If not running interactively, don't do anything
2026-10-29T14:44:50.5358770Z [ -z "$PS1" ] && return
2026-10-29T14:44:50.5360778Z 
2026-10-29T14:44:50.5361115Z # check the window size after each command and, if necessary,
2026-10-29T14:44:50.5363394Z # update the values of LINES and COLUMNS.
2026-10-29T14:44:50.5365773Z shopt -s checkwinsize
2026-10-29T14:44:50.5365956Z 
2026-10-29T14:44:50.5366282Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-29T14:44:50.5366894Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-29T14:44:50.5367311Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-29T14:44:50.5367615Z fi
2026-10-29T14:44:50.5367719Z 
2026-10-29T14:44:50.5368001Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-29T14:44:50.5368597Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-29T14:44:50.5369197Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-29T14:44:50.5369631Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-29T14:44:50.5369948Z fi
2026-10-29T14:44:50.5370068Z 
2026-10-29T14:44:50.5370377Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-29T14:44:50.5370883Z # If this is an xterm set the title to user@host:dir
2026-10-29T14:44:50.5371198Z #case "$TERM" in
2026-10-29T14:44:50.5371425Z #xterm*|rxvt*)
2026-10-29T14:44:50.5371825Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-29T14:44:50.5372251Z #    ;;
2026-10-29T14:44:50.5374012Z #*)
2026-10-29T14:44:50.5376282Z #    ;;
2026-10-29T14:44:50.5378165Z #esac
