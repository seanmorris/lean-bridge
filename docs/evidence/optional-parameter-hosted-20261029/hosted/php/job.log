2026-10-29T14:55:43.5161075Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-29T14:55:43.5161289Z 
2026-10-29T14:55:43.5161517Z # To enable the settings / commands in this file for login shells as well,
2026-10-29T14:55:43.5161881Z # this file has to be sourced in /etc/profile.
2026-10-29T14:55:43.5162048Z 
2026-10-29T14:55:43.5162201Z # If not running interactively, don't do anything
2026-10-29T14:55:43.5162471Z [ -z "$PS1" ] && return
2026-10-29T14:55:43.5162590Z 
2026-10-29T14:55:43.5162775Z # check the window size after each command and, if necessary,
2026-10-29T14:55:43.5163091Z # update the values of LINES and COLUMNS.
2026-10-29T14:55:43.5163341Z shopt -s checkwinsize
2026-10-29T14:55:43.5163450Z 
2026-10-29T14:55:43.5163680Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-29T14:55:43.5164098Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-29T14:55:43.5164399Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-29T14:55:43.5164623Z fi
2026-10-29T14:55:43.5164708Z 
2026-10-29T14:55:43.5164904Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-29T14:55:43.5165307Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-29T14:55:43.5165683Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-29T14:55:43.5166003Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-29T14:55:43.5166250Z fi
2026-10-29T14:55:43.5166329Z 
2026-10-29T14:55:43.5166560Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
