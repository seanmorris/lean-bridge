package lean-bridge:dependentrecords@1.0.0;

interface native {
  type bridge-value-0 = list<u32>;
  record dependent { bound: bridge-value-0, below: bridge-value-0 }
  dependent-result: func(arg0: bridge-value-0) -> dependent;
}

interface api {
