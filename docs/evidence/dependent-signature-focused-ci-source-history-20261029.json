          "current": "    if: inputs.suite != 'produce'\n",
          "previous": "",
          "start": 2210
        },
        {
          "current": "\n  javascript:\n    name: JavaScript and browser producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-browser.yml\n\n  native:\n    name: C and C++ producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-native.yml\n\n  perl:\n    name: Perl producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-perl.yml\n\n  python:\n    name: Python producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-python.yml\n\n  rust:\n    name: Rust producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-rust.yml\n\n  dotnet:\n    name: .NET producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-dotnet.yml\n\n  jvm:\n    name: Java and Kotlin producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-jvm.yml\n\n  ruby:\n    name: Ruby producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-ruby.yml\n\n  php-native:\n    name: Native PHP producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-php.yml\n\n  php-wasm:\n    name: PHP-Wasm producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-php-wasm.yml\n\n  wit:\n    name: WIT and WASI producer\n    if: inputs.suite == 'produce'\n    uses: ./.github/workflows/dependent-checked-record-wit.yml\n\n  receipt:\n    name: Reconcile the exact same-run receipt\n    if: always() && inputs.suite == 'produce'\n    needs:\n      - javascript\n      - native\n      - perl\n      - python\n      - rust\n      - dotnet\n      - jvm\n      - ruby\n      - php-native\n      - php-wasm\n      - wit\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    steps:\n      - name: Check out the exact producer revision\n        uses: actions/checkout@v6\n        with:\n          fetch-depth: 1\n          persist-credentials: false\n      - name: Install Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: \"22\"\n      - name: Download every same-run dependent-signature artifact\n        id: download\n        continue-on-error: true\n        uses: actions/download-artifact@v5\n        with:\n          pattern: dependent-checked-record-*-${{ github.sha }}\n          path: build/dependent-signature-matrix-input\n      - name: Reconcile every profile, author route, and API mode\n        id: reconciliation\n        if: always()\n        continue-on-error: true\n        run: |\n          node scripts/reconcile-dependent-signature-matrix.mjs \\\n            --directory build/dependent-signature-matrix-input \\\n            --output build/dependent-signature-matrix/receipt.json \\\n            --producer \"${{ github.sha }}\" \\\n            --repository \"${{ github.repository }}\" \\\n            --workflow \".github/workflows/dependent-signature-complete.yml\" \\\n            --run-id \"${{ github.run_id }}\" \\\n            --run-attempt \"${{ github.run_attempt }}\"\n      - name: Preserve the complete dependent-signature receipt\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: dependent-signature-matrix-${{ github.sha }}\n          path: build/dependent-signature-matrix/receipt.json\n          if-no-files-found: error\n          overwrite: true\n          retention-days: 30\n      - name: Enforce every producer and exact receipt reconciliation\n        if: >-\n          always() &&\n          (needs.javascript.result != 'success' ||\n           needs.native.result != 'success' ||\n           needs.perl.result != 'success' ||\n           needs.python.result != 'success' ||\n           needs.rust.result != 'success' ||\n           needs.dotnet.result != 'success' ||\n           needs.jvm.result != 'success' ||\n           needs.ruby.result != 'success' ||\n           needs.php-native.result != 'success' ||\n           needs.php-wasm.result != 'success' ||\n           needs.wit.result != 'success' ||\n           steps.download.outcome != 'success' ||\n           steps.reconciliation.outcome != 'success')\n        run: exit 1\n",
