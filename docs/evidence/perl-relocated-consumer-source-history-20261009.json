        {
          "start": 376,
          "previous": "",
          "current": "import { relocatePerlConsumer } from \"./helpers/perl-relocated-consumer.mjs\";\n"
        },
        {
          "start": 14664,
          "previous": " * @param consumer - Consumer root containing the installed CPAN package.\n",
          "current": " * @param installed - The moved installed CPAN consumer tree.\n"
        },
        {
          "start": 14866,
          "previous": "const observePerlDispatch = async (consumer, command, adapters) => {\n\tconst installed = join(consumer, \"perl\"), library = join(installed, \"installed/lib/perl5\");\n",
          "current": "const observePerlDispatch = async (installed, command, adapters) => {\n\tconst library = join(installed, \"installed/lib/perl5\");\n"
        },
        {
          "start": 20112,
          "previous": "",
          "current": "\t\t\t// The installed CPAN tree moves after its first full run; the unchanged consumer reruns there and the counters run in it.\n\t\t\tconst moved = profile === \"perl\" ? await relocatePerlConsumer({ root: join(consumer, \"perl\"), command, success: \"fin-container-ok\", checks: observation.checks }) : null;\n"
        },
        {
          "start": 20614,
          "previous": "\t\t\t\t: profile === \"perl\" ? await observePerlDispatch(consumer, command, Object.fromEntries(model.exports.map(item => [item.name, item.symbol])))\n",
          "current": "\t\t\t\t: profile === \"perl\" ? await observePerlDispatch(moved.installed, command, Object.fromEntries(model.exports.map(item => [item.name, item.symbol])))\n"
        },
        {
          "start": 21539,
          "previous": "\t\t\t\t, sourceRemovedBeforeInstallation: true });\n\t\t\tawait rm(join(consumer, profile), { recursive: true, force: true });\n",
          "current": "\t\t\t\t, sourceRemovedBeforeInstallation: true\n\t\t\t\t, ...moved ? { relocatedInstallation: moved.relocatedInstallation, repeatExecution: moved.repeatExecution } : {} });\n\t\t\tif(moved) assert.equal(existsSync(join(consumer, \"perl\")), false, \"the counters ran without the old tree\");\n\t\t\tawait rm(moved?.installed ?? join(consumer, profile), { recursive: true, force: true });\n"
        }
      ]
