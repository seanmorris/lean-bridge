2026-10-08T07:19:39.1880004Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-08T07:19:39.1880530Z 
2026-10-08T07:19:39.1880933Z # To enable the settings / commands in this file for login shells as well,
2026-10-08T07:19:39.1881443Z # this file has to be sourced in /etc/profile.
2026-10-08T07:19:39.1881665Z 
2026-10-08T07:19:39.1881858Z # If not running interactively, don't do anything
2026-10-08T07:19:39.1882215Z [ -z "$PS1" ] && return
2026-10-08T07:19:39.1882365Z 
2026-10-08T07:19:39.1882600Z # check the window size after each command and, if necessary,
2026-10-08T07:19:39.1883015Z # update the values of LINES and COLUMNS.
2026-10-08T07:19:39.1883343Z shopt -s checkwinsize
2026-10-08T07:19:39.1883510Z 
2026-10-08T07:19:39.1883804Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-08T07:19:39.1884661Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-08T07:19:39.1885051Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-08T07:19:39.1885325Z fi
2026-10-08T07:19:39.1885432Z 
2026-10-08T07:19:39.1885695Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-08T07:19:39.1886236Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-08T07:19:39.1886706Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-08T07:19:39.1887100Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-08T07:19:39.1887399Z fi
2026-10-08T07:19:39.1887506Z 
2026-10-08T07:19:39.1887791Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-08T07:19:39.1888291Z # If this is an xterm set the title to user@host:dir
2026-10-08T07:19:39.1888601Z #case "$TERM" in
2026-10-08T07:19:39.1888829Z #xterm*|rxvt*)
2026-10-08T07:19:39.1889217Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
