      "edits": [
        {
          "current": "import {\n\tcomponentStructuredCallableMirrors, componentStructuredCallablePrefix\n\t, componentStructuredCopiedView, componentStructuredRuntimeRefinements\n} from \"./component-structured-callable-lean.mjs\";\n",
          "previous": "import { componentStructuredCallablePrefix, componentStructuredCopiedView, componentStructuredRuntimeRefinements } from \"./component-structured-callable-lean.mjs\";\n",
          "start": 623
        },
        {
          "current": "",
          "previous": "\tconst callbackRefinements = new Map(abi.callbacks.map(type => [type.id, runtimeRefinements(type, type.refinements)]));\n",
          "start": 1692
        },
        {
          "current": "\t// The Lean wrappers and native callback trampolines must validate the same\n\t// normalized mirror. In particular, shared nominal Fin bounds are not part of\n\t// the structural copied-graph codec: the mirror validator owns those bounds.\n\tconst conversion = componentStructuredCallableMirrors(\n\t\tabi, exports, callbackDirections, nominalRefinements);\n\tconst callbackRefinements = new Map(abi.callbacks.map(type => [\n\t\ttype.id\n\t\t, conversion ? conversion.refinementsFor(type.id)\n\t\t\t: runtimeRefinements(type, type.refinements)\n\t]));\n",
          "previous": "",
          "start": 1819
        }
