        },
        {
          "current": "import {\n\tcheckedRecordValueIndexPhpWasmPromotionHistoryPath\n} from \"./checked-record-value-index-php-wasm-promotion-source-history.mjs\";\n",
          "previous": "",
          "start": 718
        },
        {
          "current": "/** History commit whose inventory the promotion ledger records. */\nconst checkedRecordValueIndexPhpWasmPromotionMilestone\n\t= \"dd2ee7a08530f5956912616442bc0a110c5708e9\";\n\n",
          "previous": "",
          "start": 3510
        },
        {
          "current": "\tconst show = path => execFileSync(\"git\", [\"show\"\n\t\t, `${checkedRecordValueIndexPhpWasmPromotionMilestone}:${path}`]\n\t, { maxBuffer: 512 * 1024 * 1024 });\n\tconst history = JSON.parse(await readFile(\n\t\tcheckedRecordValueIndexPhpWasmPromotionHistoryPath, \"utf8\"));\n\tassert.equal(execFileSync(\"git\", [\"rev-parse\"\n\t\t, `${checkedRecordValueIndexPhpWasmPromotionMilestone}^`], { encoding: \"utf8\" })\n\t\t.trim(), history.draftParentCommit);\n\tconst inventory = show(\"docs/type-surface.v1.json\");\n\tassert.equal(sha256(inventory), history.updates.find(update =>\n\t\tupdate.path === \"docs/type-surface.v1.json\").currentSha256);\n",
          "previous": "",
          "start": 3799
        },
        {
          "current": "\t\t, async path => show(path)\n",
          "previous": "",
          "start": 4589
        },
        {
          "current": "\tassert.deepEqual(JSON.parse(inventory), proposed);\n",
          "previous": "\tassert.deepEqual(JSON.parse(await readFile(\"docs/type-surface.v1.json\"))\n\t\t, proposed);\n",
          "start": 4622
