  record ab { size: bridge-value-0 }
  type bridge-value-2 = list<bridge-value-0>;
  record empty-sized { data: bridge-value-2 }
  record empty-token { count: bridge-value-0 }
  record off { count: bridge-value-0 }
  record on { count: bridge-value-0 }
  record unicode-token { count: bridge-value-0 }
  record wide-token { count: bridge-value-0 }
