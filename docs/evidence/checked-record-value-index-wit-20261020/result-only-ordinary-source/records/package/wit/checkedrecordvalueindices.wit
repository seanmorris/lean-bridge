  produce-empty-sized: func() -> empty-sized;
  produce-empty-string: func(arg0: bridge-value-0) -> empty-token;
  produce-false-bool: func() -> off;
  produce-true-bool: func() -> on;
  produce-unicode-string: func(arg0: bridge-value-0) -> unicode-token;
  produce-wide-nat: func(arg0: bridge-value-0) -> wide-token;
  produce-zero-nat: func(arg0: bridge-value-0) -> zero-token;
