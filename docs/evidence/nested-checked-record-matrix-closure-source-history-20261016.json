      "edits": [
        {
          "start": 13821,
          "previous": "\tassert.equal(row, \"| Record with erased proof fields and a checked input constructor | Node, browser, React and worker installed for top-level and the archived nested fields/containers, both source routes | C/C++ installed for top-level and the archived nested fields/containers; Python, Rust, Ruby, .NET, Java, Kotlin, native PHP and WIT/WASI installed at top level | Installed at top level, both source routes on four ABIs | Installed at top level, both source routes in Node/Chromium | All seventeen profiles have installed top-level input/result checks; npm and C/C++ additionally have nested parameter/result/field checks; other nested hosts and callback/owned positions remain unfinished |\");\n",
          "current": "\tassert.equal(row, \"| Record with erased proof fields and a checked input constructor | Node, browser, React and worker installed for the archived nested fields/containers, both source routes | C/C++, Python, Rust, Ruby, .NET, Java, Kotlin, native PHP and WIT/WASI installed for the archived nested fields/containers, both source routes | Installed for the archived nested fields/containers, both source routes on four ABIs | Installed for the archived nested fields/containers in Node/Chromium, both source routes | All seventeen profiles have installed nested parameter/result/field checks for the archived acyclic forms; callback/owned and unarchived combinations remain unfinished |\");\n"
        }
      ]
    },
    {
      "path": "tests/type-surface-docs.test.mjs",
