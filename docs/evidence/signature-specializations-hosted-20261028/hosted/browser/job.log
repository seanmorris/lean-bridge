2026-10-28T09:08:21.7746859Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-28T09:08:21.7747093Z 
2026-10-28T09:08:21.7747474Z # To enable the settings / commands in this file for login shells as well,
2026-10-28T09:08:21.7747897Z # this file has to be sourced in /etc/profile.
2026-10-28T09:08:21.7748087Z 
2026-10-28T09:08:21.7748257Z # If not running interactively, don't do anything
2026-10-28T09:08:21.7748573Z [ -z "$PS1" ] && return
2026-10-28T09:08:21.7748709Z 
2026-10-28T09:08:21.7748919Z # check the window size after each command and, if necessary,
2026-10-28T09:08:21.7749288Z # update the values of LINES and COLUMNS.
2026-10-28T09:08:21.7749562Z shopt -s checkwinsize
2026-10-28T09:08:21.7749694Z 
2026-10-28T09:08:21.7749963Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-28T09:08:21.7750451Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-28T09:08:21.7750793Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-28T09:08:21.7751045Z fi
2026-10-28T09:08:21.7751138Z 
2026-10-28T09:08:21.7751369Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-28T09:08:21.7751840Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-28T09:08:21.7752290Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-28T09:08:21.7752634Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-28T09:08:21.7752900Z fi
2026-10-28T09:08:21.7753002Z 
