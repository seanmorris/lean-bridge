2026-10-28T10:42:18.1944916Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-28T10:42:18.1945317Z 
2026-10-28T10:42:18.1945776Z # To enable the settings / commands in this file for login shells as well,
2026-10-28T10:42:18.1946536Z # this file has to be sourced in /etc/profile.
2026-10-28T10:42:18.1947059Z 
2026-10-28T10:42:18.1947413Z # If not running interactively, don't do anything
2026-10-28T10:42:18.1947937Z [ -z "$PS1" ] && return
2026-10-28T10:42:18.1948160Z 
2026-10-28T10:42:18.1948532Z # check the window size after each command and, if necessary,
2026-10-28T10:42:18.1949171Z # update the values of LINES and COLUMNS.
2026-10-28T10:42:18.1949657Z shopt -s checkwinsize
2026-10-28T10:42:18.1950191Z 
2026-10-28T10:42:18.1950689Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-28T10:42:18.1951573Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-28T10:42:18.1952207Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-28T10:42:18.1952640Z fi
2026-10-28T10:42:18.1952805Z 
2026-10-28T10:42:18.1953222Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-28T10:42:18.1954035Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-28T10:42:18.1954520Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-28T10:42:18.1954923Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-28T10:42:18.1955242Z fi
2026-10-28T10:42:18.1955346Z 
2026-10-28T10:42:18.1955789Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
