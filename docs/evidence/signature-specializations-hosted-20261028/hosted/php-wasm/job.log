2026-10-28T10:42:18.1962431Z # sudo hint
2026-10-28T10:42:18.1962846Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-28T10:42:18.1963308Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
