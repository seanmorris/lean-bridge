2026-10-28T06:13:26.3226956Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-28T06:13:26.3227274Z 
2026-10-28T06:13:26.3227630Z # To enable the settings / commands in this file for login shells as well,
2026-10-28T06:13:26.3228173Z # this file has to be sourced in /etc/profile.
2026-10-28T06:13:26.3228343Z 
2026-10-28T06:13:26.3228488Z # If not running interactively, don't do anything
2026-10-28T06:13:26.3228757Z [ -z "$PS1" ] && return
2026-10-28T06:13:26.3228903Z 
2026-10-28T06:13:26.3229082Z # check the window size after each command and, if necessary,
2026-10-28T06:13:26.3229401Z # update the values of LINES and COLUMNS.
2026-10-28T06:13:26.3229639Z shopt -s checkwinsize
2026-10-28T06:13:26.3229943Z 
2026-10-28T06:13:26.3230170Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-28T06:13:26.3230592Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-28T06:13:26.3231148Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-28T06:13:26.3231366Z fi
2026-10-28T06:13:26.3231454Z 
2026-10-28T06:13:26.3231659Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-28T06:13:26.3232059Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-28T06:13:26.3232582Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-28T06:13:26.3233078Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-28T06:13:26.3233452Z fi
2026-10-28T06:13:26.3233581Z 
2026-10-28T06:13:26.3233942Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-28T06:13:26.3234592Z # If this is an xterm set the title to user@host:dir
2026-10-28T06:13:26.3234946Z #case "$TERM" in
2026-10-28T06:13:26.3235147Z #xterm*|rxvt*)
2026-10-28T06:13:26.3235454Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-28T06:13:26.3235739Z #    ;;
2026-10-28T06:13:26.3235892Z #*)
2026-10-28T06:13:26.3236046Z #    ;;
2026-10-28T06:13:26.3236210Z #esac
