2026-10-09T02:15:00.4499133Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:15:00.4499572Z 
2026-10-09T02:15:00.4500224Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:15:00.4501202Z # this file has to be sourced in /etc/profile.
2026-10-09T02:15:00.4501643Z 
2026-10-09T02:15:00.4502031Z # If not running interactively, don't do anything
2026-10-09T02:15:00.4502639Z [ -z "$PS1" ] && return
2026-10-09T02:15:00.4502895Z 
2026-10-09T02:15:00.4503334Z # check the window size after each command and, if necessary,
2026-10-09T02:15:00.4504061Z # update the values of LINES and COLUMNS.
2026-10-09T02:15:00.4504814Z shopt -s checkwinsize
2026-10-09T02:15:00.4505065Z 
2026-10-09T02:15:00.4505653Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:15:00.4506620Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:15:00.4507247Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:15:00.4507547Z fi
2026-10-09T02:15:00.4507656Z 
2026-10-09T02:15:00.4507981Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:15:00.4508590Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:15:00.4509343Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:15:00.4510052Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:15:00.4510582Z fi
2026-10-09T02:15:00.4510815Z 
2026-10-09T02:15:00.4511572Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T02:15:00.4512183Z # If this is an xterm set the title to user@host:dir
2026-10-09T02:15:00.4512489Z #case "$TERM" in
2026-10-09T02:15:00.4512708Z #xterm*|rxvt*)
2026-10-09T02:15:00.4513157Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T02:15:00.4513516Z #    ;;
2026-10-09T02:15:00.4513696Z #*)
2026-10-09T02:15:00.4513871Z #    ;;
2026-10-09T02:15:00.4514057Z #esac
2026-10-09T02:15:00.4514157Z 
2026-10-09T02:15:00.4514373Z # enable bash completion in interactive shells
2026-10-09T02:15:00.4515081Z #if ! shopt -oq posix; then
2026-10-09T02:15:00.4515542Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-09T02:15:00.4516003Z #    . /usr/share/bash-completion/bash_completion
2026-10-09T02:15:00.4516395Z #  elif [ -f /etc/bash_completion ]; then
2026-10-09T02:15:00.4516700Z #    . /etc/bash_completion
2026-10-09T02:15:00.4516923Z #  fi
2026-10-09T02:15:00.4517101Z #fi
2026-10-09T02:15:00.4517202Z 
2026-10-09T02:15:00.4517487Z # sudo hint
2026-10-09T02:15:00.4517978Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T02:15:00.4518486Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T02:15:00.4533470Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T02:15:00.4533970Z 	cat <<-EOF
2026-10-09T02:15:00.4534826Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T02:15:00.4535902Z 	See "man sudo_root" for details.
2026-10-09T02:15:00.4536510Z 	
2026-10-09T02:15:00.4536866Z 	EOF
2026-10-09T02:15:00.4537066Z     fi
2026-10-09T02:15:00.4537258Z     esac
2026-10-09T02:15:00.4537443Z fi
2026-10-09T02:15:00.4537549Z 
2026-10-09T02:15:00.4537776Z # if the command-not-found package is installed, use it
2026-10-09T02:15:00.4538403Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T02:15:00.4538909Z 	function command_not_found_handle {
2026-10-09T02:15:00.4539319Z 	        # check because c-n-f could've been removed in the meantime
2026-10-09T02:15:00.4539742Z                 if [ -x /usr/lib/command-not-found ]; then
2026-10-09T02:15:00.4540093Z 		   /usr/lib/command-not-found -- "$1"
2026-10-09T02:15:00.4540376Z                    return $?
2026-10-09T02:15:00.4540766Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T02:15:00.4541241Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-10-09T02:15:00.4541589Z                    return $?
2026-10-09T02:15:00.4541819Z 		else
2026-10-09T02:15:00.4542081Z 		   printf "%s: command not found\n" "$1" >&2
2026-10-09T02:15:00.4542376Z 		   return 127
2026-10-09T02:15:00.4542576Z 		fi
2026-10-09T02:15:00.4542756Z 	}
