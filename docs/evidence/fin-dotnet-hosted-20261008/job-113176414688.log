2026-10-08T06:12:05.7744180Z #  fi
2026-10-08T06:12:05.7744363Z #fi
2026-10-08T06:12:05.7744459Z 
2026-10-08T06:12:05.7744545Z # sudo hint
2026-10-08T06:12:05.7745115Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-08T06:12:05.7745600Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-08T06:12:05.7745934Z     if [ -x /usr/bin/sudo ]; then
2026-10-08T06:12:05.7746192Z 	cat <<-EOF
2026-10-08T06:12:05.7746547Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-08T06:12:05.7746961Z 	See "man sudo_root" for details.
2026-10-08T06:12:05.7747204Z 	
2026-10-08T06:12:05.7747378Z 	EOF
2026-10-08T06:12:05.7747553Z     fi
2026-10-08T06:12:05.7747738Z     esac
2026-10-08T06:12:05.7748487Z fi
2026-10-08T06:12:05.7748608Z 
2026-10-08T06:12:05.7748828Z # if the command-not-found package is installed, use it
2026-10-08T06:12:05.7749456Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-08T06:12:05.7749969Z 	function command_not_found_handle {
