2026-10-08T06:12:05.7731348Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-08T06:12:05.7731729Z 
2026-10-08T06:12:05.7732036Z # To enable the settings / commands in this file for login shells as well,
2026-10-08T06:12:05.7732547Z # this file has to be sourced in /etc/profile.
2026-10-08T06:12:05.7732771Z 
2026-10-08T06:12:05.7732960Z # If not running interactively, don't do anything
2026-10-08T06:12:05.7733312Z [ -z "$PS1" ] && return
2026-10-08T06:12:05.7733461Z 
2026-10-08T06:12:05.7733706Z # check the window size after each command and, if necessary,
2026-10-08T06:12:05.7734130Z # update the values of LINES and COLUMNS.
2026-10-08T06:12:05.7734438Z shopt -s checkwinsize
2026-10-08T06:12:05.7734586Z 
2026-10-08T06:12:05.7734901Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-08T06:12:05.7735465Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-08T06:12:05.7735861Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-08T06:12:05.7736176Z fi
2026-10-08T06:12:05.7736279Z 
2026-10-08T06:12:05.7736536Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-08T06:12:05.7737313Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-08T06:12:05.7738054Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-08T06:12:05.7738553Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-08T06:12:05.7738869Z fi
2026-10-08T06:12:05.7738969Z 
2026-10-08T06:12:05.7739269Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-08T06:12:05.7739782Z # If this is an xterm set the title to user@host:dir
2026-10-08T06:12:05.7740170Z #case "$TERM" in
2026-10-08T06:12:05.7740447Z #xterm*|rxvt*)
2026-10-08T06:12:05.7740882Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-08T06:12:05.7741258Z #    ;;
2026-10-08T06:12:05.7741447Z #*)
2026-10-08T06:12:05.7741624Z #    ;;
2026-10-08T06:12:05.7741798Z #esac
2026-10-08T06:12:05.7741911Z 
2026-10-08T06:12:05.7742092Z # enable bash completion in interactive shells
2026-10-08T06:12:05.7742435Z #if ! shopt -oq posix; then
2026-10-08T06:12:05.7742824Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-08T06:12:05.7743268Z #    . /usr/share/bash-completion/bash_completion
