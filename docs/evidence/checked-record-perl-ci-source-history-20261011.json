      "edits": [
        {
          "start": 108,
          "previous": "",
          "current": "  checked-records:\n    name: Checked records across all four Perl ABIs\n    runs-on: ubuntu-24.04\n    timeout-minutes: 120\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v6\n        with:\n          node-version: \"22\"\n          cache: npm\n      - name: Install the checkout dependencies\n        run: npm ci --ignore-scripts --no-audit --no-fund\n      - name: Bound apt network waits\n        uses: ./.github/actions/bounded-apt\n        timeout-minutes: 1\n      - name: Install the native build tools\n        timeout-minutes: 20\n        run: sudo apt-get update && sudo apt-get install -y build-essential curl zstd\n      - name: Install only the pinned Lean compiler\n        run: bash scripts/bootstrap-toolchains.sh --lean-only\n      - name: Restore the complete checksummed Perl toolchain matrix\n        uses: actions/cache@v4\n        with:\n          path: .toolchains/perl\n          key: perl-checked-record-abi-v1-${{ runner.os }}-${{ hashFiles('scripts/build-perl-toolchains.mjs') }}\n      - name: Build or verify every pinned Perl interpreter\n        run: |\n          node scripts/build-perl-toolchains.mjs 5.36.3 threaded\n          node scripts/build-perl-toolchains.mjs 5.36.3 unthreaded\n          node scripts/build-perl-toolchains.mjs 5.38.2 threaded\n          node scripts/build-perl-toolchains.mjs 5.38.2 unthreaded\n      - name: Require four source routes and both CPAN installation modes\n        env:\n          LEAN_NUM_THREADS: \"2\"\n        run: |\n          source scripts/env.sh\n          bash scripts/run-checked-record-perl-ci.sh\n      - name: Preserve complete and partial Perl checked-record observations\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: checked-record-perl-${{ github.sha }}\n          path: build/checked-record-perl-ci/\n          if-no-files-found: error\n\n"
        },
        {
          "start": 23355,
          "previous": "",
          "current": "      - checked-records\n"
        },
        {
          "start": 23994,
          "previous": "          PERL_ACCEPTED: ${{ needs.compiler-checks.result == 'success' && needs.nix-engine.result == 'success' && needs.perl.result == 'success' && steps.evidence.outcome == 'success' }}\n",
