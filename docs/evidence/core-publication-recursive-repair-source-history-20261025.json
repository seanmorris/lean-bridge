        {
          "current": "import { createReadStream } from \"node:fs\";\n",
          "previous": "",
          "start": 185
        },
        {
          "current": "import { gitSourceBytes } from \"./helpers/source-history-stream.mjs\";\nimport { readPromotionInventory } from \"./helpers/type-surface-promotion-io.mjs\";\nimport { phpWasmEntryProbeEvidenceId } from \"./helpers/php-wasm-refinement-entry-publication.mjs\";\nimport { renderPhpWasmEntryProbeBoundary } from \"./helpers/php-wasm-refinement-entry-publication-docs.mjs\";\n",
          "previous": "",
          "start": 981
        },
        {
          "current": "",
          "previous": "const baselineArgs = [\"show\"\n\t, `${promotionPredecessor}:docs/type-surface.v1.json`];\nconst baseline = execFileSync(\n\t\"git\", baselineArgs, { encoding: \"utf8\", maxBuffer: 512 * 1024 ** 2 }\n);\n",
          "start": 1487
        },
        {
          "current": "",
          "previous": "const document = JSON.parse(baseline);\n",
          "start": 1641
        },
        {
          "current": "const { document } = await readPromotionInventory(\n\tgitSourceBytes(promotionPredecessor, \"docs/type-surface.v1.json\"), contracts\n);\n",
          "previous": "",
          "start": 1826
        },
        {
          "current": "\tconst { document: currentDocument } = await readPromotionInventory(\n\t\tcreateReadStream(\"docs/type-surface.v1.json\"), contracts\n\t);\n",
          "previous": "",
          "start": 5937
        },
        {
          "current": "\t\troot: \".\", inventory: { document: currentDocument, ...contracts }\n",
          "previous": "\t\troot: \".\"\n\t\t, inventory: {\n\t\t\tdocument: await readJson(\"docs/type-surface.v1.json\"), ...contracts\n\t\t}\n",
          "start": 6114
        },
        {
          "current": "\t// Historical inventories predate hosted probe publication. The current\n\t// reference must instead bind its retained archive without promoting support.\n\tfor(const source of [before.reference, after.reference])\n",
          "previous": "\t// These are rendered with today's documentation generator. The configured\n\t// measurement topology is independent of the historical support observations.\n\tfor(const source of [before.reference, after.reference, current.reference])\n",
          "start": 7355
        },
        {
          "current": "\tfor(const inventory of [document, promoted])\n\t\tassert.ok(!inventory.evidence.some(entry => entry.id === phpWasmEntryProbeEvidenceId));\n\tconst probes = currentDocument.evidence.filter(entry => entry.id === phpWasmEntryProbeEvidenceId);\n\tassert.equal(probes.length, 1);\n\tassert.equal(current.reference.split(renderPhpWasmEntryProbeBoundary(probes[0])).length, 2);\n\tassert.match(current.reference, /leave unmodified prepared packages and their supported types unchanged/u);\n\tassert.doesNotMatch(current.reference, /is not a hosted result/u);\n\tfor(const observation of currentDocument.observations)\n\t\tfor(const stage of Object.values(observation.stages))\n\t\t\tassert.ok(!stage.evidence.includes(phpWasmEntryProbeEvidenceId));\n",
          "previous": "",
          "start": 7770
        }
