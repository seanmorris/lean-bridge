  "scope": "Dependent checked-record promotion requires every retained archive artifact to be a hosted part and refuses reuse of any individual artifact digest across language lanes.",
  "updates": [
    {
      "currentSha256": "4a5061a7bec175cf41f81f97fb9b5672a31648bcc1329163e1766ee59146f055",
      "edits": [
        {
          "current": "\t// Artifacts are hosted parts only, even when the cited file is retained.\n\treject(references => {\n\t\tfor(const item of references.slice(0, 4))\n\t\t\titem.artifacts = [structuredClone(references[0].files[1])];\n\t}, /is not a hosted part/u);\n\treject(references => {\n\t\tfor(const item of references.slice(0, 4))\n\t\t\titem.artifacts = [{ path: `${root(\"browser\")}/sources/producer/fixture.lean`, sha256: hex(\"source\", 64) }];\n\t}, /is not a hosted part/u);\n\t// One part of another lane is refused alone, reordered or alongside new parts.\n\tconst shareOnePart = (references, order) => {\n\t\tconst own = { path: `${root(\"native\")}/hosted/artifact.zip.part-001`, sha256: hex(\"native/extra\", 64) };\n\t\tconst borrowed = { path: `${root(\"native\")}/hosted/artifact.zip.part-000`, sha256: references[0].artifacts[0].sha256 };\n\t\tconst parts = order === \"first\" ? [borrowed, own] : [own, borrowed];\n\t\tfor(const item of references.slice(4, 8))\n\t\t{\n\t\t\titem.artifacts = structuredClone(parts);\n\t\t\titem.files = [item.files[0], item.files[1]\n\t\t\t\t, ...structuredClone(parts).sort((left, right) => left.path.localeCompare(right.path))];\n\t\t}\n\t};\n\treject(references => shareOnePart(references, \"first\"), /reuses another lane's artifact part/u);\n\treject(references => shareOnePart(references, \"last\"), /reuses another lane's artifact part/u);\n",
          "previous": "",
          "start": 8394
        }
      ],
      "path": "tests/dependent-checked-record-promotion.test.mjs",
      "previousSha256": "abd1bf0d9da1df9ad0de8fc05e5555c29fe40b3de632b59557363165f085ae24"
    },
    {
      "currentSha256": "31029a55e5824a7532196c14413299505516c83b56323bbc25fd41aac1c59881",
      "edits": [
        {
          "current": "\t\t\t\tassert.ok(artifact.path.startsWith(`${root}/hosted/`)\n\t\t\t\t\t, `${reference.id} artifact is not a hosted part: ${artifact.path}`);\n",
          "previous": "\t\t\t\tassert.ok(artifact.path.startsWith(`${root}/`), artifact.path);\n",
          "start": 8658
        },
        {
          "current": "",
          "previous": "\t\t\tconst parts = reference.artifacts.map(item => item.sha256).join();\n",
          "start": 9064
        },
        {
          "current": "\t\t\t\t// No single part may recur in another lane, whatever its order\n\t\t\t\t// or company.\n\t\t\t\tfor(const artifact of reference.artifacts)\n\t\t\t\t\tassert.ok(!artifactDigests.has(artifact.sha256)\n\t\t\t\t\t\t, `${reference.id} reuses another lane's artifact part`);\n\t\t\t\tfor(const artifact of reference.artifacts)\n\t\t\t\t\tartifactDigests.add(artifact.sha256);\n",
          "previous": "\t\t\t\tassert.ok(!artifactDigests.has(parts), `${reference.id} reuses another lane's artifact`);\n\t\t\t\tartifactDigests.add(parts);\n",
