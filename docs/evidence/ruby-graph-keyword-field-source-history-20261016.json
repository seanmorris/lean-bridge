    {
      "path": "src/backends/ruby/copied-graph-values.mjs",
      "previousSha256": "1bf99fe069be4a45ce7c8da1a0ec3d6fbfb7ee7803ac4bf57bd92c0433060067",
      "currentSha256": "603873e4e85ef9ea8d328c8637ab77152ef278e571924f0b1b7f13b22692b5e8",
      "edits": [
        {
          "start": 843,
          "previous": "",
          "current": "// Ruby keywords that are not Object methods remain valid readers, keyword arguments,\n// hash keys and pattern keys; only their initializer locals need a binding read.\nconst keywordFields = new Set(\"begin end rescue ensure alias and or not if unless while until case when then else elsif for in do break next redo retry undef\".split(\" \"));\n"
        },
        {
          "start": 2489,
          "previous": "${fields.map(field => `        @${field.publicName} = ${field.publicName}`).join(\"\\n\")}\n",
          "current": "${fields.map(field => `        @${field.publicName} = ${keywordFields.has(field.publicName) ? `binding.local_variable_get(:${field.publicName})` : field.publicName}`).join(\"\\n\")}\n"
        },
        {
          "start": 4765,
          "previous": "\t\t\tif(!/^[a-z][a-z0-9_]*$/.test(publicName) || reservedMembers.has(publicName) || seen.has(publicName))\n",
          "current": "\t\t\tif(!/^[a-z][a-z0-9_]*$/.test(publicName) || (reservedMembers.has(publicName) && !keywordFields.has(publicName))\n\t\t\t\t|| seen.has(publicName))\n"
        }
      ]
    },
