    {
      "path": "src/backends/ruby/copied-graph-conversions.mjs",
      "previousSha256": "1aab7ed78d91035febe851e157b78f3d9e58cb06f3b2b156f8caa37774b155f9",
      "currentSha256": "6a57793d82f2cb9c6bc332e6aafc84d413e16ed8ad019e88f11e526acf4dfd3b",
      "edits": [
        {
          "start": 246,
          "previous": "",
          "current": "// Read the adapter's one-shot checked-refinement text for an invalid input.\n// The adapter resets it at every call, so a missing text keeps the fixed one.\nconst diagnosticSupport = `      def graph_checked_status(status, diagnostic)\n        return graph_status(status) unless status == 1\n        message = diagnostic.call\n        return graph_status(status) if message.null?\n        text = message.to_s.force_encoding(::Encoding::UTF_8)\n        raise GraphInvalidNative, \"Malformed native refinement diagnostic\" unless text.valid_encoding?\n        raise LeanBridgeError.new(status, text)\n      end`;\n\n"
        },
        {
          "start": 1111,
          "previous": "",
          "current": " * @param options - Generated call features.\n * @param options.refinementDiagnostics - Report exact checked-refinement failures.\n"
