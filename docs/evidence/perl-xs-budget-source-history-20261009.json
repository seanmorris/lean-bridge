      "edits": [
        {
          "start": 363,
          "previous": "",
          "current": "import \"./helpers/perl-xs-budget-source-history-tests.mjs\";\n"
        },
        {
          "start": 33586,
          "previous": "",
          "current": "  // Each Perl ABI runs the installed Compare and Verify chain in one job; 120 minutes was exhausted.\n  const perlJob = perlWorkflow.split(\"  perl:\\n\")[1].split(\"\\n  perl-receivers:\\n\")[0];\n  assert.match(perlJob, /^ {4}timeout-minutes: 180$/m);\n  for(const step of [\"Compare installed Perl corpus packages with fresh Lean results\", \"Verify owned Perl values and installed CPAN archives\"])\n  {\n    const body = perlJob.split(`      - name: ${step}\\n`)[1]?.split(\"      - name:\")[0];\n    assert.ok(body, step);\n    assert.doesNotMatch(body, /timeout-minutes|continue-on-error|^ {8}if:/mu, step);\n  }\n"
        }
      ]
    },
