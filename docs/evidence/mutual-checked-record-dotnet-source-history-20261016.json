        {
          "start": 2050,
          "previous": "",
          "current": "\tconst diagnosticOffset = model.functions.length;\n\tconst lifecycleOffset = diagnosticOffset + (model.refinementDiagnostics ? 1 : 0);\n\tconst supportedFeatures = [\n\t\t\"direct-functions\", \"copied-values\", \"recursive-values\", \"deterministic-close\"\n\t];\n\tif(model.refinementDiagnostics)\n\t\tsupportedFeatures.push(\"checked-refinement-diagnostics\");\n"
        },
        {
          "start": 3880,
          "previous": "        var lifecycle = new GraphLifecycle((delegate* unmanaged[Cdecl]<uint>)symbols[${model.functions.length}], (delegate* unmanaged[Cdecl]<int>)symbols[${model.functions.length + 1}], (delegate* unmanaged[Cdecl]<void>)symbols[${model.functions.length + 2}]);\n        return GraphRuntime.Call${fn.publicName}((delegate* unmanaged[Cdecl]<${[...params.map(node => `${node.raw}*`), `${result.raw}*`, \"uint\"].join(\", \")}>)symbols[${index}], lifecycle${params.map((_, i) => `, arg${i}`).join(\"\")});\n",
          "current": "        var lifecycle = new GraphLifecycle((delegate* unmanaged[Cdecl]<uint>)symbols[${lifecycleOffset}], (delegate* unmanaged[Cdecl]<int>)symbols[${lifecycleOffset + 1}], (delegate* unmanaged[Cdecl]<void>)symbols[${lifecycleOffset + 2}]);\n\t\treturn GraphRuntime.Call${fn.publicName}((delegate* unmanaged[Cdecl]<${[...params.map(node => `${node.raw}*`), `${result.raw}*`, \"uint\"].join(\", \")}>)symbols[${index}], ${model.refinementDiagnostics ? `(delegate* unmanaged[Cdecl]<byte*>)symbols[${diagnosticOffset}], ` : \"\"}lifecycle${params.map((_, i) => `, arg${i}`).join(\"\")});\n"
        },
