  "source": "namespace CheckedRecordValueIndices\n\n/-- An array whose size is the closed natural-number index. -/\nstructure Sized (n : Nat) where\n  data : Array Nat\n  sized : data.size = n\n\n/-- A payload guarded by a closed boolean index. -/\nstructure Flagged (flag : Bool) where\n  count : Nat\n  set : (count == 0) = flag\n\n/-- A payload guarded by the length of a closed string index. -/\nstructure Labeled (label : String) where\n  size : Nat\n  named : label.length = size\n\n/-- One generic carrier covers closed Nat, Bool and String indices. -/\nstructure Token (alpha : Type) (index : alpha) where\n  count : Nat\n  fixed : index = index\n\nabbrev On := Flagged true\nabbrev Off := Flagged false\nabbrev Ab := Labeled \"ab\"\nabbrev EmptySized := Sized 0\nabbrev ZeroToken := Token Nat 0\nabbrev WideToken := Token Nat 340282366920938463463374607431768211457\nabbrev EmptyToken := Token String \"\"\nabbrev UnicodeToken := Token String \"λ🌱\"\n\n/-- Exact, site-selected constructors for host-supplied records. -/\n@[noinline, export lb_value_index_full_probe_constructor_mkOn]\ndef mkOn (count : Nat) : Option On :=\n  if h : (count == 0) = true then some ⟨count, h⟩ else none\n@[noinline, export lb_value_index_full_probe_constructor_mkOff]\ndef mkOff (count : Nat) : Option Off :=\n  if h : (count == 0) = false then some ⟨count, h⟩ else none\n@[noinline, export lb_value_index_full_probe_constructor_mkAb]\ndef mkAb (size : Nat) : Option Ab :=\n  if h : \"ab\".length = size then some ⟨size, h⟩ else none\n@[noinline, export lb_value_index_full_probe_constructor_mkEmptySized]\ndef mkEmptySized (data : Array Nat) : Option EmptySized :=\n  if h : data.size = 0 then some ⟨data, h⟩ else none\n@[noinline, export lb_value_index_full_probe_constructor_mkZeroToken]\ndef mkZeroToken (count : Nat) : Option ZeroToken := some ⟨count, rfl⟩\n@[noinline, export lb_value_index_full_probe_constructor_mkWideToken]\ndef mkWideToken (count : Nat) : Option WideToken := some ⟨count, rfl⟩\n@[noinline, export lb_value_index_full_probe_constructor_mkEmptyToken]\ndef mkEmptyToken (count : Nat) : Option EmptyToken := some ⟨count, rfl⟩\n@[noinline, export lb_value_index_full_probe_constructor_mkUnicodeToken]\ndef mkUnicodeToken (count : Nat) : Option UnicodeToken := some ⟨count, rfl⟩\n\n@[noinline, export lb_value_index_full_probe_source_trueBoolIndex]\ndef trueBoolIndex (value : On) : Nat := value.count\n@[noinline, export lb_value_index_full_probe_source_falseBoolIndex]\ndef falseBoolIndex (value : Off) : Nat := value.count\n@[noinline, export lb_value_index_full_probe_source_abStringIndex]\ndef abStringIndex (value : Ab) : Nat := value.size\n@[noinline, export lb_value_index_full_probe_source_emptyStringIndex]\ndef emptyStringIndex (value : EmptyToken) : Nat := value.count\n@[noinline, export lb_value_index_full_probe_source_unicodeStringIndex]\ndef unicodeStringIndex (value : UnicodeToken) : Nat := value.count\n@[noinline, export lb_value_index_full_probe_source_emptySizedIndex]\ndef emptySizedIndex (value : EmptySized) : Nat := value.data.size\n@[noinline, export lb_value_index_full_probe_source_zeroNatIndex]\ndef zeroNatIndex (value : ZeroToken) : Nat := value.count\n@[noinline, export lb_value_index_full_probe_source_wideNatIndex]\ndef wideNatIndex (value : WideToken) : Nat := value.count\n\n/-- Lean-produced records need no host-side checked constructor. -/\n@[noinline, export lb_value_index_full_probe_source_produceTrueBool]\ndef produceTrueBool : On := ⟨0, rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceFalseBool]\ndef produceFalseBool : Off := ⟨1, rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceAb]\ndef produceAb : Ab := ⟨\"ab\".length, rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceEmptyString]\ndef produceEmptyString (count : Nat) : EmptyToken := ⟨count, rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceUnicodeString]\ndef produceUnicodeString (count : Nat) : UnicodeToken := ⟨count, rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceEmptySized]\ndef produceEmptySized : EmptySized := ⟨#[], rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceZeroNat]\ndef produceZeroNat (count : Nat) : ZeroToken := ⟨count, rfl⟩\n@[noinline, export lb_value_index_full_probe_source_produceWideNat]\ndef produceWideNat (count : Nat) : WideToken := ⟨count, rfl⟩\n\nend CheckedRecordValueIndices\n"
}
