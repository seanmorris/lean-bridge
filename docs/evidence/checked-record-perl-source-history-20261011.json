      "edits": [
        {
          "start": 22985,
          "previous": "",
          "current": "const constructorRefinement = refinement => [\"subtype\", \"checked-record\"].includes(refinement.kind);\n"
        },
        {
          "start": 23330,
          "previous": "\t\t...refined.filter(([refinement]) => refinement.kind !== \"subtype\").map(([refinement, index]) => finGuard(parameters[index], refinement, `a${index}`, names[index]))\n\t\t, ...refined.filter(([refinement]) => refinement.kind === \"subtype\").map(([refinement, index]) => constructorGuard(parameters[index], symbol, index, refinement.constructor, names[index]))];\n\tconst rejection = refined.some(([refinement]) => refinement.kind === \"subtype\") ? \"Lean rejected an argument outside its checked refinement\" : \"Lean rejected an argument outside its Fin bound\";\n",
          "current": "\t\t...refined.filter(([refinement]) => !constructorRefinement(refinement)).map(([refinement, index]) => finGuard(parameters[index], refinement, `a${index}`, names[index]))\n\t\t, ...refined.filter(([refinement]) => constructorRefinement(refinement)).map(([refinement, index]) => constructorGuard(parameters[index], symbol, index, refinement.constructor, names[index]))];\n\tconst rejection = refined.some(([refinement]) => constructorRefinement(refinement)) ? \"Lean rejected an argument outside its checked refinement\" : \"Lean rejected an argument outside its Fin bound\";\n"
        },
        {
          "start": 34305,
          "previous": "\t\tif(bounds) pm.push(`Checked Lean ${bounds.includes(\" checked by \") ? \"refinements\" : \"Fin bounds\"}: ${bounds}.`, \"\");\n",
          "current": "\t\tif(bounds) pm.push(`Checked Lean ${bounds.includes(\" checked by \") || bounds.includes(\"proof-backed record\") ? \"refinements\" : \"Fin bounds\"}: ${bounds}.`, \"\");\n"
        },
        {
          "start": 39248,
          "previous": "\tif(model.exports.some(item => perlFinBounds(model, item))) pm.push(\"=head1 BOUNDED INTEGERS\", \"\"\n",
          "current": "\tconst checkedRecords = model.exports.some(item => item.refinements && [...item.refinements.parameters, item.refinements.result].some(tree => tree?.kind === \"checked-record\"));\n\tif(checkedRecords) pm.push(\"=head1 CHECKED RECORDS\", \"\"\n\t\t, \"Checked records use generated classes containing only payload fields. Pass L<Math::BigInt> for C<Nat> fields and plain array references for copied arrays. The selected Lean constructor validates each input before source dispatch. A rejected record dies with a message naming the parameter and constructor. A normalizing constructor changes the record received by Lean without changing the caller's record. Results project the payload fields after Lean constructs the proofs. No proof object or input constructor is needed for a result-only export. Ordinary and independently reviewed APIs preserve each parameter's constructor choice. Nested checked records, other dependent payloads and checked-record callbacks remain unsupported.\", \"\");\n\tif(model.exports.some(item => {\n\t\tconst bounds = perlFinBounds(model, item);\n\t\treturn bounds && (!checkedRecords || bounds.includes(\" < \"));\n\t})) pm.push(\"=head1 BOUNDED INTEGERS\", \"\"\n"
        }
      ]
