2026-10-11T19:00:26.8442326Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T19:00:26.8442631Z 
2026-10-11T19:00:26.8442983Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T19:00:26.8443610Z # this file has to be sourced in /etc/profile.
2026-10-11T19:00:26.8444038Z 
2026-10-11T19:00:26.8444270Z # If not running interactively, don't do anything
2026-10-11T19:00:26.8444667Z [ -z "$PS1" ] && return
2026-10-11T19:00:26.8444856Z 
2026-10-11T19:00:26.8445158Z # check the window size after each command and, if necessary,
2026-10-11T19:00:26.8445663Z # update the values of LINES and COLUMNS.
2026-10-11T19:00:26.8446036Z shopt -s checkwinsize
2026-10-11T19:00:26.8446264Z 
2026-10-11T19:00:26.8446637Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T19:00:26.8447321Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T19:00:26.8447809Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T19:00:26.8448162Z fi
2026-10-11T19:00:26.8448286Z 
2026-10-11T19:00:26.8448616Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T19:00:26.8449291Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T19:00:26.8449878Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T19:00:26.8450350Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T19:00:26.8450746Z fi
2026-10-11T19:00:26.8450891Z 
