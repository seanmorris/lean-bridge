          "start": 4
        },
        {
          "current": "const previousBudget = \"    # Run 37873560469 cut the c-family Compare step off at 240 minutes while it was still\\n    # passing tests. Python and Rust keep their 240-minute budget.\\n    timeout-minutes: ${{ matrix.profile == 'c-family' && 360 || 240 }}\\n\";\nconst newBudget = \"    # Run 37873560469 cut the c-family Compare step off at 240 minutes while it was still\\n    # passing tests. Run 42435025687 then cut Python off at the same whole-job ceiling\\n    # after every completed corpus stage had passed. Give both history-heavy profiles\\n    # the six-hour budget while keeping Rust at 240 minutes.\\n    timeout-minutes: ${{ (matrix.profile == 'c-family' || matrix.profile == 'python') && 360 || 240 }}\\n\";\n",
          "previous": "const newBudget = \"    # Run 37873560469 cut the c-family Compare step off at 240 minutes while it was still\\n    # passing tests. Python and Rust keep their 240-minute budget.\\n    timeout-minutes: ${{ matrix.profile == 'c-family' && 360 || 240 }}\\n\";\n",
          "start": 591
        },
        {
