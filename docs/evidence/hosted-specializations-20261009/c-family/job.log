2026-10-09T02:14:10.7942752Z #fi
2026-10-09T02:14:10.7942992Z 
2026-10-09T02:14:10.7943333Z # sudo hint
2026-10-09T02:14:10.7944348Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T02:14:10.7944861Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T02:14:10.7945203Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T02:14:10.7945827Z 	cat <<-EOF
2026-10-09T02:14:10.7946423Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T02:14:10.7946930Z 	See "man sudo_root" for details.
2026-10-09T02:14:10.7947521Z 	
2026-10-09T02:14:10.7947787Z 	EOF
2026-10-09T02:14:10.7947978Z     fi
2026-10-09T02:14:10.7948176Z     esac
2026-10-09T02:14:10.7948362Z fi
2026-10-09T02:14:10.7948460Z 
2026-10-09T02:14:10.7948713Z # if the command-not-found package is installed, use it
