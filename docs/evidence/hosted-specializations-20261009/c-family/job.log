2026-10-09T02:14:10.7911325Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:14:10.7911775Z 
2026-10-09T02:14:10.7912291Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:14:10.7913129Z # this file has to be sourced in /etc/profile.
2026-10-09T02:14:10.7913493Z 
2026-10-09T02:14:10.7913822Z # If not running interactively, don't do anything
2026-10-09T02:14:10.7914391Z [ -z "$PS1" ] && return
2026-10-09T02:14:10.7914641Z 
2026-10-09T02:14:10.7915052Z # check the window size after each command and, if necessary,
2026-10-09T02:14:10.7915774Z # update the values of LINES and COLUMNS.
2026-10-09T02:14:10.7916303Z shopt -s checkwinsize
2026-10-09T02:14:10.7916543Z 
2026-10-09T02:14:10.7917073Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:14:10.7918270Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:14:10.7918960Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:14:10.7919492Z fi
2026-10-09T02:14:10.7919672Z 
2026-10-09T02:14:10.7919940Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:14:10.7920508Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:14:10.7921197Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:14:10.7921893Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:14:10.7922419Z fi
2026-10-09T02:14:10.7922602Z 
2026-10-09T02:14:10.7923322Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T02:14:10.7924063Z # If this is an xterm set the title to user@host:dir
2026-10-09T02:14:10.7924374Z #case "$TERM" in
2026-10-09T02:14:10.7924618Z #xterm*|rxvt*)
2026-10-09T02:14:10.7925000Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T02:14:10.7925364Z #    ;;
2026-10-09T02:14:10.7925547Z #*)
2026-10-09T02:14:10.7925730Z #    ;;
2026-10-09T02:14:10.7925908Z #esac
2026-10-09T02:14:10.7926014Z 
2026-10-09T02:14:10.7926185Z # enable bash completion in interactive shells
2026-10-09T02:14:10.7926518Z #if ! shopt -oq posix; then
2026-10-09T02:14:10.7926895Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
