2026-10-09T02:14:08.1353696Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:14:08.1353834Z 
2026-10-09T02:14:08.1353984Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:14:08.1354238Z # this file has to be sourced in /etc/profile.
2026-10-09T02:14:08.1354500Z 
2026-10-09T02:14:08.1354669Z # If not running interactively, don't do anything
2026-10-09T02:14:08.1354857Z [ -z "$PS1" ] && return
2026-10-09T02:14:08.1354942Z 
2026-10-09T02:14:08.1355067Z # check the window size after each command and, if necessary,
2026-10-09T02:14:08.1355289Z # update the values of LINES and COLUMNS.
2026-10-09T02:14:08.1355453Z shopt -s checkwinsize
2026-10-09T02:14:08.1355534Z 
2026-10-09T02:14:08.1355694Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:14:08.1355984Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:14:08.1356192Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:14:08.1356344Z fi
2026-10-09T02:14:08.1356402Z 
2026-10-09T02:14:08.1356541Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:14:08.1356821Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:14:08.1357068Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:14:08.1357274Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:14:08.1357433Z fi
2026-10-09T02:14:08.1357494Z 
2026-10-09T02:14:08.1357649Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T02:14:08.1357916Z # If this is an xterm set the title to user@host:dir
2026-10-09T02:14:08.1358083Z #case "$TERM" in
2026-10-09T02:14:08.1358220Z #xterm*|rxvt*)
2026-10-09T02:14:08.1358450Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T02:14:08.1358643Z #    ;;
2026-10-09T02:14:08.1358748Z #*)
2026-10-09T02:14:08.1358850Z #    ;;
2026-10-09T02:14:08.1358952Z #esac
2026-10-09T02:14:08.1359014Z 
