2026-10-09T02:14:08.1360433Z # sudo hint
2026-10-09T02:14:08.1360763Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T02:14:08.1361011Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
