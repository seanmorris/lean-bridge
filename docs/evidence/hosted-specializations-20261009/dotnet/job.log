2026-10-09T02:14:06.8952373Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:14:06.8952636Z 
2026-10-09T02:14:06.8953088Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:14:06.8953667Z # this file has to be sourced in /etc/profile.
2026-10-09T02:14:06.8953889Z 
2026-10-09T02:14:06.8954105Z # If not running interactively, don't do anything
2026-10-09T02:14:06.8954447Z [ -z "$PS1" ] && return
2026-10-09T02:14:06.8954599Z 
2026-10-09T02:14:06.8954892Z # check the window size after each command and, if necessary,
2026-10-09T02:14:06.8955273Z # update the values of LINES and COLUMNS.
2026-10-09T02:14:06.8955595Z shopt -s checkwinsize
2026-10-09T02:14:06.8955787Z 
2026-10-09T02:14:06.8956119Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:14:06.8956694Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:14:06.8957165Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:14:06.8957544Z fi
2026-10-09T02:14:06.8957716Z 
2026-10-09T02:14:06.8958105Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:14:06.8958747Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:14:06.8959119Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:14:06.8959438Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:14:06.8959682Z fi
2026-10-09T02:14:06.8959778Z 
