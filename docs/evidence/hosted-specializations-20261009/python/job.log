2026-10-09T02:14:05.7972343Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:14:05.7972786Z 
2026-10-09T02:14:05.7973091Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:14:05.7973575Z # this file has to be sourced in /etc/profile.
2026-10-09T02:14:05.7973799Z 
2026-10-09T02:14:05.7973989Z # If not running interactively, don't do anything
2026-10-09T02:14:05.7974342Z [ -z "$PS1" ] && return
2026-10-09T02:14:05.7974488Z 
2026-10-09T02:14:05.7974728Z # check the window size after each command and, if necessary,
2026-10-09T02:14:05.7975159Z # update the values of LINES and COLUMNS.
2026-10-09T02:14:05.7975471Z shopt -s checkwinsize
2026-10-09T02:14:05.7975615Z 
2026-10-09T02:14:05.7975917Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:14:05.7976750Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:14:05.7977153Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:14:05.7977433Z fi
2026-10-09T02:14:05.7977541Z 
2026-10-09T02:14:05.7977809Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:14:05.7978644Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:14:05.7979603Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:14:05.7980314Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:14:05.7980873Z fi
2026-10-09T02:14:05.7981034Z 
2026-10-09T02:14:05.7981346Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T02:14:05.7981870Z # If this is an xterm set the title to user@host:dir
2026-10-09T02:14:05.7982188Z #case "$TERM" in
2026-10-09T02:14:05.7982415Z #xterm*|rxvt*)
2026-10-09T02:14:05.7982911Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T02:14:05.7983354Z #    ;;
2026-10-09T02:14:05.7983553Z #*)
2026-10-09T02:14:05.7983730Z #    ;;
2026-10-09T02:14:05.7983911Z #esac
2026-10-09T02:14:05.7984013Z 
2026-10-09T02:14:05.7984199Z # enable bash completion in interactive shells
2026-10-09T02:14:05.7984541Z #if ! shopt -oq posix; then
2026-10-09T02:14:05.7984924Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-10-09T02:14:05.7985351Z #    . /usr/share/bash-completion/bash_completion
2026-10-09T02:14:05.7985717Z #  elif [ -f /etc/bash_completion ]; then
2026-10-09T02:14:05.7986014Z #    . /etc/bash_completion
2026-10-09T02:14:05.7986610Z #  fi
2026-10-09T02:14:05.7986801Z #fi
2026-10-09T02:14:05.7986909Z 
2026-10-09T02:14:05.7986991Z # sudo hint
2026-10-09T02:14:05.7987653Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T02:14:05.7988130Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-09T02:14:05.7988460Z     if [ -x /usr/bin/sudo ]; then
2026-10-09T02:14:05.7988724Z 	cat <<-EOF
2026-10-09T02:14:05.7989078Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-09T02:14:05.7989488Z 	See "man sudo_root" for details.
2026-10-09T02:14:05.7989741Z 	
2026-10-09T02:14:05.7990072Z 	EOF
2026-10-09T02:14:05.7990257Z     fi
2026-10-09T02:14:05.8002933Z     esac
2026-10-09T02:14:05.8003288Z fi
2026-10-09T02:14:05.8003474Z 
2026-10-09T02:14:05.8003871Z # if the command-not-found package is installed, use it
2026-10-09T02:14:05.8004856Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-10-09T02:14:05.8005380Z 	function command_not_found_handle {
2026-10-09T02:14:05.8005799Z 	        # check because c-n-f could've been removed in the meantime
2026-10-09T02:14:05.8006645Z                 if [ -x /usr/lib/command-not-found ]; then
2026-10-09T02:14:05.8007038Z 		   /usr/lib/command-not-found -- "$1"
2026-10-09T02:14:05.8007331Z                    return $?
2026-10-09T02:14:05.8007763Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
