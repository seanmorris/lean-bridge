2026-10-09T02:14:10.0092400Z 
2026-10-09T02:14:10.0092476Z # sudo hint
2026-10-09T02:14:10.0092941Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-09T02:14:10.0093315Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
