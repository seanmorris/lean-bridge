2026-10-09T02:14:10.0078997Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:14:10.0079316Z 
2026-10-09T02:14:10.0079703Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:14:10.0080295Z # this file has to be sourced in /etc/profile.
2026-10-09T02:14:10.0080570Z 
2026-10-09T02:14:10.0080800Z # If not running interactively, don't do anything
2026-10-09T02:14:10.0081251Z [ -z "$PS1" ] && return
2026-10-09T02:14:10.0081430Z 
2026-10-09T02:14:10.0081731Z # check the window size after each command and, if necessary,
2026-10-09T02:14:10.0082264Z # update the values of LINES and COLUMNS.
2026-10-09T02:14:10.0082659Z shopt -s checkwinsize
2026-10-09T02:14:10.0082840Z 
2026-10-09T02:14:10.0083231Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:14:10.0083946Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:14:10.0084260Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:14:10.0084492Z fi
2026-10-09T02:14:10.0084575Z 
2026-10-09T02:14:10.0084812Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:14:10.0085409Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:14:10.0086123Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:14:10.0086616Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:14:10.0087011Z fi
2026-10-09T02:14:10.0087179Z 
2026-10-09T02:14:10.0087700Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-09T02:14:10.0088172Z # If this is an xterm set the title to user@host:dir
2026-10-09T02:14:10.0088427Z #case "$TERM" in
2026-10-09T02:14:10.0088630Z #xterm*|rxvt*)
2026-10-09T02:14:10.0088933Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-09T02:14:10.0089222Z #    ;;
2026-10-09T02:14:10.0089378Z #*)
2026-10-09T02:14:10.0089533Z #    ;;
2026-10-09T02:14:10.0089686Z #esac
2026-10-09T02:14:10.0089777Z 
