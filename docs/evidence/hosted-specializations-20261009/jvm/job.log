2026-10-09T02:14:09.8191477Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-09T02:14:09.8191959Z 
2026-10-09T02:14:09.8192499Z # To enable the settings / commands in this file for login shells as well,
2026-10-09T02:14:09.8193374Z # this file has to be sourced in /etc/profile.
2026-10-09T02:14:09.8193773Z 
2026-10-09T02:14:09.8194107Z # If not running interactively, don't do anything
2026-10-09T02:14:09.8194745Z [ -z "$PS1" ] && return
2026-10-09T02:14:09.8195003Z 
2026-10-09T02:14:09.8195722Z # check the window size after each command and, if necessary,
2026-10-09T02:14:09.8196487Z # update the values of LINES and COLUMNS.
2026-10-09T02:14:09.8197027Z shopt -s checkwinsize
2026-10-09T02:14:09.8197278Z 
2026-10-09T02:14:09.8197831Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T02:14:09.8198848Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T02:14:09.8199310Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T02:14:09.8199631Z fi
2026-10-09T02:14:09.8199741Z 
2026-10-09T02:14:09.8200012Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-09T02:14:09.8200598Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-09T02:14:09.8201408Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T02:14:09.8202138Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T02:14:09.8202760Z fi
2026-10-09T02:14:09.8203046Z 
