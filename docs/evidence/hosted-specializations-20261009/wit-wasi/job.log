2026-10-09T03:57:11.6664447Z 
2026-10-09T03:57:11.6664555Z # If not running interactively, don't do anything
2026-10-09T03:57:11.6664769Z [ -z "$PS1" ] && return
2026-10-09T03:57:11.6664889Z 
2026-10-09T03:57:11.6665022Z # check the window size after each command and, if necessary,
2026-10-09T03:57:11.6665250Z # update the values of LINES and COLUMNS.
2026-10-09T03:57:11.6665427Z shopt -s checkwinsize
2026-10-09T03:57:11.6665524Z 
2026-10-09T03:57:11.6665723Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-09T03:57:11.6666061Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-09T03:57:11.6666308Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-09T03:57:11.6666481Z fi
2026-10-09T03:57:11.6666552Z 
2026-10-09T03:57:11.6666706Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
