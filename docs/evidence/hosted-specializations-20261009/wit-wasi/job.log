2026-10-09T03:57:11.6667262Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-09T03:57:11.6667511Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-09T03:57:11.6667710Z fi
2026-10-09T03:57:11.6667813Z 
