    {
      "path": "src/analyze/reviewed-source.mjs",
      "currentSha256": "68494bee28ec301b8092c92134ce9fe7553ad2e9836bc38a3e29769539abe8ef",
      "previousSha256": "3eac3d33beb139602bd65618abb94a3661b921c175802bca368d296677af3cfd",
      "edits": [
        {
          "start": 580,
          "previous": "import { assertReviewedRefinements, assertReviewedFinNominal } from \"./reviewed-refinements.mjs\";\n",
          "current": "import { assertReviewedRefinements, assertReviewedFinCallback, assertReviewedFinNominal } from \"./reviewed-refinements.mjs\";\n"
        },
        {
          "start": 773,
          "previous": "",
          "current": "import { callbackSemanticSignature } from \"./callback-signature.mjs\";\n"
        },
        {
          "start": 6021,
          "previous": "\t\tconst refinementKey = declaration ? \"lean-lang.org/refinements\" : [\"alias\", \"record\", \"variant\"].includes(item.kind) ? \"lean-lang.org/nominal-refinements\" : null;\n",
          "current": "\t\tconst refinementKey = declaration || item.kind === \"callback\" ? \"lean-lang.org/refinements\" : [\"alias\", \"record\", \"variant\"].includes(item.kind) ? \"lean-lang.org/nominal-refinements\" : null;\n"
        },
        {
          "start": 6471,
          "previous": "\t\t\t{ (declaration ? assertReviewedRefinements : assertReviewedFinNominal)(item, item.source.extensions[refinementKey]); }\n",
          "current": "\t\t\t{ (declaration ? assertReviewedRefinements : item.kind === \"callback\" ? assertReviewedFinCallback : assertReviewedFinNominal)(item, item.source.extensions[refinementKey]); }\n"
        },
        {
          "start": 7916,
          "previous": "\t\t\tconst signature = { parameters: callable.parameters.map(parameter => parameter.type), result: callable.result.type };\n",
          "current": "\t\t\t// Match compiler identity exactly: an authored bound is part of the callback, not a selection hint.\n\t\t\tconst signature = { ...callbackSemanticSignature(callable)\n\t\t\t\t, ...(Object.hasOwn(definition.source.extensions, \"lean-lang.org/refinements\")\n\t\t\t\t\t? { refinements: definition.source.extensions[\"lean-lang.org/refinements\"] } : {}) };\n"
        }
      ]
    },
    {
      "path": "src/analyze/reviewed-refinements.mjs",
      "currentSha256": "bcb31c9f3eceedec76a42eceab6c6c47ec0241c7f126b1d6592ad629be54e807",
      "previousSha256": "d6c279c4bbd547b6ec91b1b5556bf88aa5d23ed0a8461b255a49030ebb5567fc",
      "edits": [
        {
          "start": 105,
          "previous": "import { assertRefinement, nominalRefinement } from \"../abi/refinements.mjs\";\n",
          "current": "import { assertRefinement, callbackDefinitionRefinement, nominalRefinement } from \"../abi/refinements.mjs\";\n"
        },
        {
          "start": 551,
          "previous": "",
          "current": "/**\n * Validate a callback's nonempty Fin trees against its erased signature.\n * Checked constructors are not available inside a callback contract.\n *\n * @param definition - Reviewed callback with an authored refinement extension.\n */\nexport const assertReviewedFinCallback = definition => {\n\tif(definition.kind !== \"callback\") throw new TypeError(\"Expected a reviewed callback\");\n\tconst refinement = callbackDefinitionRefinement(definition);\n\tif(refinement === null) throw new TypeError(\"Expected a reviewed callback refinement\");\n\trefinement.parameters.forEach(finOnly);\n\tfinOnly(refinement.result);\n};\n\n"
        }
      ]
    },
