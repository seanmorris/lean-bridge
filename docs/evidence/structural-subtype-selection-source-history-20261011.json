      "edits": [
        {
          "start": 7134,
          "previous": "          {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"constructor\"], \"properties\": {\"constructor\": {\"$ref\": \"#/$defs/specializationName\"}}}\n",
          "current": "          {\"$ref\": \"#/$defs/checkedRefinementSelection\"}\n"
        },
        {
          "start": 7423,
          "previous": "",
          "current": "    \"checkedRefinementSelection\": {\n      \"description\": \"Constructor choices only. Structural arguments use transport order, including [success, error] for result. A null child selects no constructor and does not erase compiler-owned Fin bounds. The configuration reader enforces 32 edges and 4096 visited nodes; fresh Lean must independently check each selection against the source type.\",\n      \"oneOf\": [\n        {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"constructor\"], \"properties\": {\"constructor\": {\"$ref\": \"#/$defs/specializationName\"}}},\n        {\n          \"type\": \"object\", \"additionalProperties\": false, \"required\": [\"kind\", \"arguments\"],\n          \"properties\": {\n            \"kind\": {\"enum\": [\"array\", \"list\", \"option\", \"tuple\", \"result\"]},\n            \"arguments\": {\n              \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2,\n              \"items\": {\"oneOf\": [{\"type\": \"null\"}, {\"$ref\": \"#/$defs/checkedRefinementSelection\"}]},\n              \"contains\": {\"not\": {\"type\": \"null\"}}, \"minContains\": 1\n            }\n          },\n          \"if\": {\"properties\": {\"kind\": {\"enum\": [\"array\", \"list\", \"option\"]}}},\n          \"then\": {\"properties\": {\"arguments\": {\"maxItems\": 1}}},\n          \"else\": {\"properties\": {\"arguments\": {\"minItems\": 2}}}\n        }\n      ]\n    },\n"
        }
      ]
    },
    {
      "path": "src/analyze/export-configuration.mjs",
      "currentSha256": "e1bf907dbeb4785b2497a2c2dbebbd43079bf7cc3c5f12eb4a50d1c102f3ab25",
      "previousSha256": "5a324d0e1c3dee2180625a59c7f21b1d2bd932676b5f567f0f9caebafa67bedb",
      "edits": [
        {
          "start": 638,
          "previous": "",
          "current": "import { validateCheckedRefinementSelection } from \"./checked-refinement-selection.mjs\";\n"
        },
        {
          "start": 6495,
          "previous": "\t\t\t\t\tclosed(site.refinement, [\"constructor\"], `Contract ${name} checked refinement`);\n\t\t\t\t\tif(typeof site.refinement.constructor !== \"string\" || !specializationName.test(site.refinement.constructor))\n\t\t\t\t\t\tfail(\"invalid-export-configuration\", `Contract ${name} refinement needs a checked constructor name`);\n",
          "current": "\t\t\t\t\ttry\n\t\t\t\t\t{ validateCheckedRefinementSelection(site.refinement); }\n\t\t\t\t\tcatch(error)\n\t\t\t\t\t{ fail(\"invalid-export-configuration\", `Contract ${name}: ${error.message}`); }\n"
        }
      ]
    },
