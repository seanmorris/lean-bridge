      "edits": [
        {
          "start": 1892,
          "previous": "",
          "current": "/**\n * Authenticate the inventory's original bytes before parsing its historical data.\n *\n * @param source - Complete raw inventory file, without JSON reserialization.\n */\nexport const phpRecursiveTypeSurface = source => JSON.parse(beforePhpWasmRecursiveCallables('docs/type-surface.v1.json', source));\n\n"
        },
        {
          "start": 18253,
          "previous": "\tconst document = JSON.parse(beforePhpWasmRecursiveCallables('docs/type-surface.v1.json', JSON.stringify(current, null, 2) + '\\n'));\n",
          "current": "\tassert.ok(current.contractVersion);\n\t// History authenticates file bytes, including whitespace, before JSON parsing.\n\tconst document = phpRecursiveTypeSurface(await readFile('docs/type-surface.v1.json', 'utf8'));\n"
        }
      ]
    },
    {
      "path": "tests/php-recursive-callable-evidence.test.mjs",
      "currentSha256": "827c0e09e618426fc4d88acb4337d064d699bb37b5ac3b86fa8abeb92f168976",
      "previousSha256": "ce5d00840fecac253cdef5267d1153cd20caab95a325f9d6e529cd388665ba17",
      "edits": [
        {
          "start": 267,
          "previous": "import { assertPhpRecursiveCallableExecution, assertPhpRecursiveCallableIntegration, assertPhpRecursiveInspection, phpRecursiveCallableExecutionPath } from './helpers/php-recursive-callable-evidence.mjs';\n",
          "current": "import { assertPhpRecursiveCallableExecution, assertPhpRecursiveCallableIntegration, assertPhpRecursiveInspection, phpRecursiveCallableExecutionPath, phpRecursiveTypeSurface } from './helpers/php-recursive-callable-evidence.mjs';\n"
        },
        {
          "start": 772,
          "previous": "",
          "current": "import { beforeFinRefinementSource } from './helpers/fin-refinement-source-history.mjs';\n"
        },
        {
          "start": 932,
          "previous": "",
          "current": "test('PHP historical inventory authentication preserves noncanonical whitespace', async () => {\n\tconst path = 'docs/type-surface.v1.json';\n\tconst expected = '8a319697940c5b471eb944adde08bc6de1b3fa6ccb5d51538b0cea949a4a2569';\n\tconst original = beforeFinRefinementSource(path, await readFile(path, 'utf8'), expected);\n\tassert.equal(sha256(original), expected);\n\tconst reformatted = JSON.stringify(JSON.parse(original), null, 2) + '\\n';\n\tassert.deepEqual(JSON.parse(original), JSON.parse(reformatted));\n\tassert.notEqual(sha256(original), sha256(reformatted));\n\tassert.equal(phpRecursiveTypeSurface(original).contractVersion, '0.105.0');\n\tassert.equal(beforePhpWasmRecursiveCallables(path, reformatted), reformatted);\n\tassert.notEqual(phpRecursiveTypeSurface(reformatted).contractVersion, '0.105.0');\n});\n\n"
        }
      ]
    },
