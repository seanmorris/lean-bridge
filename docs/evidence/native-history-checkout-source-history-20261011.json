        {
          "start": 908,
          "previous": "test(\"the exact Nix Perl source boundary imports its engine and detects a missing Fin diagnostic module\", async t => {\n",
          "current": "test(\"the exact Nix Perl source boundary imports its engine and detects missing refinement modules\", async t => {\n"
        },
        {
          "start": 2385,
          "previous": "",
          "current": "\tfor(const path of [\"src/build/refinement-mirrors.mjs\", \"src/build/component-refinement-mirrors.mjs\", \"src/build/component-fin-guards.mjs\"])\n\t{\n\t\tassert.ok(boundary.includedFiles.includes(path));\n\t\tawait rm(join(root, path));\n\t\tconst missing = run();\n\t\tassert.equal(missing.status, 1);\n\t\tassert.match(missing.stderr, /ERR_MODULE_NOT_FOUND/u);\n\t\tassert.ok(missing.stderr.includes(path));\n\t\tawait copyFile(path, join(root, path));\n\t\tassert.equal(run().status, 0);\n\t}\n"
        }
