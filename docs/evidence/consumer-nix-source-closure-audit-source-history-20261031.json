      "edits": [
        {
          "current": "  # Nix-backed consumer jobs need current source and evidence metadata, not the\n  # 51.8 GB retained payload corpus. Keep this one declaration shared so a new\n  # job cannot quietly restore the disk-exhausting full checkout.\n  LEAN_BRIDGE_CONSUMER_SPARSE_CHECKOUT: |\n    /*\n    !/*/\n    /.github/\n    /acceptance/\n    /config/\n    /containers/\n    /demos/\n    /nix/\n    /notices/\n    /patches/\n    /poc/\n    /schema/\n    /scripts/\n    /site/\n    /src/\n    /tests/\n    /docs/\n    !/docs/evidence/*\n    /docs/evidence/*.json\n    /docs/evidence/*.md\n    /docs/evidence/*.xml\n    /docs/evidence/*/index.json\n",
          "previous": "",
          "start": 299
        },
        {
          "current": "          sparse-checkout: ${{ env.LEAN_BRIDGE_CONSUMER_SPARSE_CHECKOUT }}\n          sparse-checkout-cone-mode: false\n      - name: Confirm the Nix consumer source closure is sparse and bounded\n        run: bash scripts/check-consumer-source-closure.sh\n",
