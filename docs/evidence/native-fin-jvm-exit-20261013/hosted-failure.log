2026-10-13T11:47:40.8968841Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-13T11:47:40.8969085Z fi
2026-10-13T11:47:40.8969178Z 
2026-10-13T11:47:40.8969403Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
