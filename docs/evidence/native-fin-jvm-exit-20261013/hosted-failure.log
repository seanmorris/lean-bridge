2026-10-13T11:47:40.8966201Z 
2026-10-13T11:47:40.8966372Z # If not running interactively, don't do anything
2026-10-13T11:47:40.8966671Z [ -z "$PS1" ] && return
2026-10-13T11:47:40.8966805Z 
2026-10-13T11:47:40.8967008Z # check the window size after each command and, if necessary,
2026-10-13T11:47:40.8967378Z # update the values of LINES and COLUMNS.
2026-10-13T11:47:40.8967643Z shopt -s checkwinsize
2026-10-13T11:47:40.8967769Z 
2026-10-13T11:47:40.8968029Z # set variable identifying the chroot you work in (used in the prompt below)
