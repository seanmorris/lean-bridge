      "currentSha256": "e12472bd8eebeb13f3b98d70395346cf89bd1937ebefe321f78ee1297a985b48",
      "edits": [
        {
          "current": "/**\n * Validate the closed archive path grammar shared by replay and promotion.\n * Labels distinguish immutable captures; they do not establish acceptance.\n *\n * @param root - Repository-relative original archive root.\n */\nexport const ownedCheckedRecordArchiveRootLane = root => {\n",
          "previous": "// A label distinguishes immutable captures from the same day. It conveys no\n// acceptance: the selected index, producer and every committed byte still bind.\nconst archiveRootLane = root => {\n",
          "start": 1105
        },
        {
          "current": "\t\tassert.equal(ownedCheckedRecordArchiveRootLane(entry.index.path.slice(0, -\"/index.json\".length))\n",
          "previous": "\t\tassert.equal(archiveRootLane(entry.index.path.slice(0, -\"/index.json\".length))\n",
          "start": 2851
        },
        {
          "current": "\townedCheckedRecordArchiveRootLane(root);\n",
