          "start": 9326,
          "previous": "",
          "current": "\t\tif(reviewed)\n\t\t{\n\t\t\tassert.equal(model.sourceIdentity.reviewedBindingIr.source, reviewedSource);\n\t\t\tassert.equal(model.sourceIdentity.reviewedBindingIr.sourceSha256, sha256(reviewedSource));\n\t\t}\n"
