      "edits": [
        {
          "start": 197414,
          "previous": "        if: always()\n",
          "current": "        if: always() && matrix.profile == 'c-family'\n"
        },
        {
          "start": 204971,
          "previous": "",
          "current": "            node scripts/consumer-ci.mjs record --consumer \"$consumer\" --output \"build/consumer-ci/results/native-${{ matrix.profile }}/$consumer.json\" --performance \"build/consumer-ci/performance/$consumer.json\" --test-result \"$result\" --package-installation \"$installed\" --real-lean-execution \"$installed\" --command \"$consumer_command\"\n          done\n      - name: Record native Python and Rust consumer observations\n        if: always() && (matrix.profile == 'python' || matrix.profile == 'rust')\n        shell: bash\n        run: |\n          test_result=\"${{ steps.consumer.outcome == 'success' && 'passed' || 'failed' }}\"\n          executed=\"${{ steps.consumer.outcome == 'success' && 'true' || 'false' }}\"\n          for consumer in ${{ matrix.consumers }}; do\n            result=\"$test_result\"\n            installed=\"$executed\"\n            consumer_command=\"npm run test:consumer:native\"\n"
        }
      ]
    },
    {
      "path": "tests/helpers/native-ci-isolation.mjs",
      "currentSha256": "a2ed3d3fd94e32942d0719064ac1862f1792bef109ba26eefdf653cfc4be1288",
      "previousSha256": "7a97fad57da31bbf033115b4a4aa1c9a33cace4edc1457a8cf62c94df383a621",
      "edits": [
        {
          "start": 3182,
          "previous": "export const nativeCiRecordScript = (workflow, profile, overrides = {}) => nativeCiCommands(\n\tnativeCiSteps(workflow).find(step => step.name === \"Record native consumer observations\")\n).replace(/\\$\\{\\{ (.+?) \\}\\}/gu, (_, expression) => String(evaluate(expression, profile, overrides)));\n",
          "current": "export const nativeCiRecordScript = (workflow, profile, overrides = {}) => {\n\tconst names = [\"Record native consumer observations\", \"Record native Python and Rust consumer observations\"];\n\tconst selected = nativeCiSteps(workflow).filter(step => names.includes(step.name)\n\t\t&& (!step.condition || evaluate(step.condition, profile, overrides)));\n\tassert.equal(selected.length, 1, `exactly one observation step for ${profile}`);\n\treturn nativeCiCommands(selected[0]).replace(/\\$\\{\\{ (.+?) \\}\\}/gu, (_, expression) => String(evaluate(expression, profile, overrides)));\n};\n"
        }
      ]
    },
    {
      "path": "tests/documentation.test.mjs",
