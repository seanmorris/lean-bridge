          "previous": "",
          "current": "import { assertWorkflowRunBudget, joinNativeObservations } from \"./helpers/native-observation-split.mjs\";\n"
        },
        {
          "start": 34027,
          "previous": "  const [lateWorkflow, packageDocument, currentPerlWorkflow, toolchainBootstrap] = await Promise.all([\n",
          "current": "  const [splitWorkflow, packageDocument, currentPerlWorkflow, toolchainBootstrap] = await Promise.all([\n"
        },
        {
          "start": 34375,
          "previous": "  // Validate all measured edge gates before checking the unchanged earlier command/upload order.\n  assertFinLateWorkflow(lateWorkflow);\n  const packageWorkflow = disableFinLateWorkflow(lateWorkflow);\n",
          "current": "  // Check the actual recording split and measured gates before earlier layout comparisons.\n  assertWorkflowRunBudget(splitWorkflow);\n  assertFinLateWorkflow(splitWorkflow);\n  const packageWorkflow = disableFinLateWorkflow(joinNativeObservations(splitWorkflow));\n"
        }
      ]
