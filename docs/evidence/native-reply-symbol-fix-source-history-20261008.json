    {
      "path": "tests/native-fin-callbacks.test.mjs",
      "currentSha256": "c1eaf527b359991c536ae4d87e4a626c216961876149bd6ac52f5055fff0bd94",
      "previousSha256": "b7d9aa9049e7b1ae3f3e1e879a96f9815d12015894870e3aadb2fbb4d453cbf7",
      "edits": [
        {
          "start": 1085,
          "previous": "",
          "current": "import \"./helpers/native-reply-symbol-fix-source-history-tests.mjs\";\n"
        },
        {
          "start": 33265,
          "previous": "",
          "current": "\t// The closure registry probe has no callbacks or component identity. Reply-free generation must\n\t// not even read an identity getter on either native pointer width.\n\tfor(const pointerBits of [32, 64])\n\t{\n\t\tconst minimal = { pointerBits, types: [] };\n\t\tObject.defineProperty(minimal, \"component\", { get: () => { throw new Error(\"reply-free component identity was read\"); } });\n\t\tconst surface = { prefix: \"sample\", callbacks: new Map([[\"present\", {}]]), functions: [] };\n\t\tconst registry = generateNativeCallables(minimal, surface).source;\n\t\tassert.match(registry, /typedef struct \\{ uintptr_t token;/u);\n\t\tassert.doesNotMatch(registry, /_reply_take_rejected|Lean rejected a host callback result/u);\n\t\tassert.equal(registry, generateNativeCallables({ pointerBits, types: [] }, surface).source);\n\t}\n"
        }
      ]
    },
