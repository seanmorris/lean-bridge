          "start": 3923,
          "previous": "\t// Only packages with checked host callback replies consume Lean's rejection flag; others keep their bytes.\n\tconst replies = types.some(type => type.reply), rejected = nativeReplyRejectedSymbol(model);\n",
          "current": "\t// Only packages with checked host callback replies consume Lean's rejection flag; others keep their bytes\n\t// and need no component identity to name it.\n\tconst replies = types.some(type => type.reply), rejected = replies ? nativeReplyRejectedSymbol(model) : null;\n"
        }
