2026-10-30T07:44:42.1375095Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-30T07:44:42.1375444Z 
2026-10-30T07:44:42.1375755Z # To enable the settings / commands in this file for login shells as well,
2026-10-30T07:44:42.1376243Z # this file has to be sourced in /etc/profile.
2026-10-30T07:44:42.1376462Z 
2026-10-30T07:44:42.1377071Z # If not running interactively, don't do anything
2026-10-30T07:44:42.1377453Z [ -z "$PS1" ] && return
2026-10-30T07:44:42.1377605Z 
2026-10-30T07:44:42.1377844Z # check the window size after each command and, if necessary,
2026-10-30T07:44:42.1378265Z # update the values of LINES and COLUMNS.
2026-10-30T07:44:42.1378580Z shopt -s checkwinsize
2026-10-30T07:44:42.1378718Z 
2026-10-30T07:44:42.1379022Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-30T07:44:42.1379582Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-30T07:44:42.1379986Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-30T07:44:42.1380263Z fi
2026-10-30T07:44:42.1380372Z 
2026-10-30T07:44:42.1380632Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-30T07:44:42.1381475Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-30T07:44:42.1382448Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-30T07:44:42.1383118Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-30T07:44:42.1383680Z fi
2026-10-30T07:44:42.1383872Z 
