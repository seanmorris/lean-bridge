2026-10-30T08:33:59.4307902Z # sudo hint
2026-10-30T08:33:59.4308233Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-30T08:33:59.4308492Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
