2026-10-30T08:33:59.4298203Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-30T08:33:59.4298352Z 
2026-10-30T08:33:59.4298515Z # To enable the settings / commands in this file for login shells as well,
2026-10-30T08:33:59.4298783Z # this file has to be sourced in /etc/profile.
2026-10-30T08:33:59.4298906Z 
2026-10-30T08:33:59.4299020Z # If not running interactively, don't do anything
2026-10-30T08:33:59.4299213Z [ -z "$PS1" ] && return
2026-10-30T08:33:59.4299301Z 
2026-10-30T08:33:59.4299433Z # check the window size after each command and, if necessary,
2026-10-30T08:33:59.4299727Z # update the values of LINES and COLUMNS.
2026-10-30T08:33:59.4299897Z shopt -s checkwinsize
2026-10-30T08:33:59.4299984Z 
2026-10-30T08:33:59.4300146Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-30T08:33:59.4300458Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-30T08:33:59.4300679Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-30T08:33:59.4300843Z fi
2026-10-30T08:33:59.4300905Z 
2026-10-30T08:33:59.4301983Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-30T08:33:59.4302457Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-30T08:33:59.4302875Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-30T08:33:59.4303225Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-30T08:33:59.4303492Z fi
2026-10-30T08:33:59.4303587Z 
2026-10-30T08:33:59.4303831Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-30T08:33:59.4304117Z # If this is an xterm set the title to user@host:dir
2026-10-30T08:33:59.4304296Z #case "$TERM" in
2026-10-30T08:33:59.4304421Z #xterm*|rxvt*)
2026-10-30T08:33:59.4304778Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-30T08:33:59.4304997Z #    ;;
2026-10-30T08:33:59.4305104Z #*)
2026-10-30T08:33:59.4305209Z #    ;;
2026-10-30T08:33:59.4305318Z #esac
2026-10-30T08:33:59.4305381Z 
