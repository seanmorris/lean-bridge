  "scope": "The Rust audit admits only exact copied Binding IR value declarations whose domain names resemble identity machinery, while retaining the generic-dispatch rejection for undeclared handles, tokens and dispatchers.",
  "updates": [
    {
      "currentSha256": "b606b07de538d3a230f1606ef3ceb1cf2f110c15fec8a8d23793d2fce8089fa5",
      "edits": [
        {
          "current": "/**\n * A copied nominal value can legitimately use a word such as Token without\n * exposing a runtime identity token. Require the exact Binding IR type and\n * Rust declaration kind before granting that narrow exemption.\n *\n * @param ir - Binding IR document.\n * @param declaration - Rust declaration keyword.\n * @param name - Exact public identifier.\n */\nconst explicitCopiedValue = (ir, declaration, name) => {\n\tconst kind = { struct: \"record\", type: \"alias\" }[declaration];\n\treturn kind !== undefined && ir.types.some(type =>\n\t\ttype.name === name\n\t\t&& type.kind === kind\n\t\t&& type.representation === \"copied\"\n\t\t&& type.resource === null\n\t);\n};\n\n",
          "previous": "",
          "start": 972
        },
        {
          "current": "\tconst generic = [...source.matchAll(\n\t\t/pub\\s+(fn|struct|type|trait)\\s+(invoke|dispatch|handle|token)\\b/giu\n\t)].find(match => !explicitCopiedValue(ir, match[1], match[2]));\n\tif(generic)\n",
          "previous": "\tif(/pub\\s+(?:fn|struct|type|trait)\\s+(?:invoke|dispatch|handle|token)\\b/i.test(source))\n",
          "start": 2906
        },
        {
          "current": "\t\tfail(\"generic-dispatch\"\n\t\t\t, \"the Rust public surface exposes a dispatcher or identity token\"\n\t\t\t, { declaration: generic[0] });\n",
          "previous": "\t\tfail(\"generic-dispatch\", \"the Rust public surface exposes a dispatcher or identity token\");\n",
          "start": 3096
        }
      ],
      "path": "src/backends/rust/package-audit.mjs",
      "previousSha256": "3894184d830b9cdc4c3f9f4f89eb910db6d0cce3021ce99848ff31f950295950"
    },
    {
      "currentSha256": "4a0f93f29e45340df6881f9ccc424acce8a26f23a6435b49832eb85fd8d7bfc3",
      "edits": [
        {
          "current": "import {\n\tauditRustPackage\n} from \"../../src/backends/rust/package-audit.mjs\";\n",
          "previous": "",
