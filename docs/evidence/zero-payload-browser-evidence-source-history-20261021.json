          "current": "\t\tconst retained = Object.fromEntries(retainedRoutePaths.map(path => [\n\t\t\tpath, get(`${run.route}/${path}`)\n\t\t]));\n\t\tconst tap = retained[\"run.tap\"]\n\t\t\t, verification = retained[\"verification.json\"];\n",
