      "edits": [
        {
          "current": "\t// Every native graph target admits callback Subtypes, and CPAN shares each target's layout.\n\tconst layout = compileNativeGraphProjection(ir, [\"cpan\"], moduleName).layoutSha256;\n",
          "previous": "",
          "start": 8211
        },
        {
          "current": "\t\tassert.equal(compileNativeGraphProjection(ir, [\"cpan\", target], moduleName).layoutSha256, layout, target);\n\tfor(const targets of [[], [\"cpan\", \"cpan\"], [\"cpan\", \"php-wasm\"], [\"unknown\"]])\n\t\tassert.throws(() => compileNativeGraphProjection(ir, targets, moduleName), { code: \"native-graph-projection-unavailable\" });\n\tassert.throws(() => compileNativeGraphProjection(ir, [\"cpan\"]), { code: \"native-graph-projection-unavailable\" });\n",
