2026-10-11T05:40:09.0584741Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T05:40:09.0585179Z 
2026-10-11T05:40:09.0585729Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T05:40:09.0586591Z # this file has to be sourced in /etc/profile.
2026-10-11T05:40:09.0586957Z 
2026-10-11T05:40:09.0587295Z # If not running interactively, don't do anything
2026-10-11T05:40:09.0587864Z [ -z "$PS1" ] && return
2026-10-11T05:40:09.0588130Z 
2026-10-11T05:40:09.0588539Z # check the window size after each command and, if necessary,
2026-10-11T05:40:09.0589265Z # update the values of LINES and COLUMNS.
2026-10-11T05:40:09.0589782Z shopt -s checkwinsize
2026-10-11T05:40:09.0590314Z 
2026-10-11T05:40:09.0590854Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T05:40:09.0591852Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T05:40:09.0592446Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T05:40:09.0592732Z fi
2026-10-11T05:40:09.0592835Z 
2026-10-11T05:40:09.0593154Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T05:40:09.0594063Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T05:40:09.0594912Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T05:40:09.0595761Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T05:40:09.0596259Z fi
2026-10-11T05:40:09.0596382Z 
2026-10-11T05:40:09.0596682Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
