2026-10-11T04:34:28.8547683Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T04:34:28.8547974Z 
2026-10-11T04:34:28.8548202Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T04:34:28.8548587Z # this file has to be sourced in /etc/profile.
2026-10-11T04:34:28.8548757Z 
2026-10-11T04:34:28.8548909Z # If not running interactively, don't do anything
2026-10-11T04:34:28.8549189Z [ -z "$PS1" ] && return
2026-10-11T04:34:28.8549308Z 
2026-10-11T04:34:28.8549515Z # check the window size after each command and, if necessary,
2026-10-11T04:34:28.8549869Z # update the values of LINES and COLUMNS.
2026-10-11T04:34:28.8550122Z shopt -s checkwinsize
2026-10-11T04:34:28.8550247Z 
2026-10-11T04:34:28.8550481Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T04:34:28.8550906Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T04:34:28.8551222Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T04:34:28.8551446Z fi
2026-10-11T04:34:28.8551537Z 
2026-10-11T04:34:28.8551737Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T04:34:28.8552154Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T04:34:28.8552515Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T04:34:28.8552817Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T04:34:28.8553058Z fi
2026-10-11T04:34:28.8553141Z 
2026-10-11T04:34:28.8553376Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
