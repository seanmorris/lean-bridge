2026-10-11T05:40:26.8656083Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T05:40:26.8656285Z 
2026-10-11T05:40:26.8656505Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T05:40:26.8656886Z # this file has to be sourced in /etc/profile.
2026-10-11T05:40:26.8657052Z 
2026-10-11T05:40:26.8657200Z # If not running interactively, don't do anything
2026-10-11T05:40:26.8657468Z [ -z "$PS1" ] && return
2026-10-11T05:40:26.8657597Z 
2026-10-11T05:40:26.8657786Z # check the window size after each command and, if necessary,
2026-10-11T05:40:26.8658158Z # update the values of LINES and COLUMNS.
2026-10-11T05:40:26.8658401Z shopt -s checkwinsize
2026-10-11T05:40:26.8658523Z 
2026-10-11T05:40:26.8658762Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T05:40:26.8659190Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T05:40:26.8659507Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T05:40:26.8659730Z fi
2026-10-11T05:40:26.8659820Z 
2026-10-11T05:40:26.8660016Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T05:40:26.8660431Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T05:40:26.8660791Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T05:40:26.8661133Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T05:40:26.8661388Z fi
2026-10-11T05:40:26.8661473Z 
2026-10-11T05:40:26.8661709Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-11T05:40:26.8662106Z # If this is an xterm set the title to user@host:dir
2026-10-11T05:40:26.8662386Z #case "$TERM" in
2026-10-11T05:40:26.8662593Z #xterm*|rxvt*)
2026-10-11T05:40:26.8662896Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-11T05:40:26.8663190Z #    ;;
2026-10-11T05:40:26.8663843Z #*)
2026-10-11T05:40:26.8664009Z #    ;;
