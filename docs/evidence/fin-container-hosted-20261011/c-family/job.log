2026-10-11T04:34:34.8694809Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T04:34:34.8695224Z 
2026-10-11T04:34:34.8695840Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T04:34:34.8696467Z # this file has to be sourced in /etc/profile.
2026-10-11T04:34:34.8696688Z 
2026-10-11T04:34:34.8696878Z # If not running interactively, don't do anything
2026-10-11T04:34:34.8697206Z [ -z "$PS1" ] && return
2026-10-11T04:34:34.8697476Z 
2026-10-11T04:34:34.8697785Z # check the window size after each command and, if necessary,
2026-10-11T04:34:34.8698256Z # update the values of LINES and COLUMNS.
2026-10-11T04:34:34.8698579Z shopt -s checkwinsize
2026-10-11T04:34:34.8698743Z 
2026-10-11T04:34:34.8699087Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T04:34:34.8699704Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T04:34:34.8700109Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T04:34:34.8700401Z fi
2026-10-11T04:34:34.8700505Z 
2026-10-11T04:34:34.8700757Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T04:34:34.8701297Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T04:34:34.8701759Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T04:34:34.8702149Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T04:34:34.8702503Z fi
2026-10-11T04:34:34.8702629Z 
