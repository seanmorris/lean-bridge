2026-10-11T05:23:23.7704587Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T05:23:23.7705030Z 
2026-10-11T05:23:23.7705385Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T05:23:23.7705905Z # this file has to be sourced in /etc/profile.
2026-10-11T05:23:23.7706134Z 
2026-10-11T05:23:23.7706319Z # If not running interactively, don't do anything
2026-10-11T05:23:23.7706662Z [ -z "$PS1" ] && return
2026-10-11T05:23:23.7706809Z 
2026-10-11T05:23:23.7707048Z # check the window size after each command and, if necessary,
2026-10-11T05:23:23.7708114Z # update the values of LINES and COLUMNS.
2026-10-11T05:23:23.7708430Z shopt -s checkwinsize
2026-10-11T05:23:23.7708579Z 
2026-10-11T05:23:23.7708876Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T05:23:23.7709439Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T05:23:23.7709832Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T05:23:23.7710113Z fi
2026-10-11T05:23:23.7710221Z 
2026-10-11T05:23:23.7710488Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T05:23:23.7711029Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T05:23:23.7711498Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T05:23:23.7711887Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T05:23:23.7712183Z fi
2026-10-11T05:23:23.7712291Z 
2026-10-11T05:23:23.7712574Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
