2026-10-11T05:31:58.5168405Z #fi
2026-10-11T05:31:58.5168462Z 
2026-10-11T05:31:58.5168510Z # sudo hint
2026-10-11T05:31:58.5168873Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-11T05:31:58.5169111Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-11T05:31:58.5169283Z     if [ -x /usr/bin/sudo ]; then
2026-10-11T05:31:58.5169421Z 	cat <<-EOF
2026-10-11T05:31:58.5169739Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-11T05:31:58.5169948Z 	See "man sudo_root" for details.
2026-10-11T05:31:58.5170081Z 	
2026-10-11T05:31:58.5170175Z 	EOF
2026-10-11T05:31:58.5170274Z     fi
