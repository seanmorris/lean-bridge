2026-10-11T05:31:58.5158796Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T05:31:58.5159003Z 
2026-10-11T05:31:58.5159238Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T05:31:58.5160101Z # this file has to be sourced in /etc/profile.
2026-10-11T05:31:58.5160279Z 
2026-10-11T05:31:58.5160436Z # If not running interactively, don't do anything
2026-10-11T05:31:58.5160715Z [ -z "$PS1" ] && return
2026-10-11T05:31:58.5160839Z 
2026-10-11T05:31:58.5161032Z # check the window size after each command and, if necessary,
2026-10-11T05:31:58.5161378Z # update the values of LINES and COLUMNS.
2026-10-11T05:31:58.5161627Z shopt -s checkwinsize
2026-10-11T05:31:58.5161748Z 
2026-10-11T05:31:58.5161990Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T05:31:58.5162427Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T05:31:58.5162748Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T05:31:58.5162977Z fi
2026-10-11T05:31:58.5163063Z 
2026-10-11T05:31:58.5163274Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T05:31:58.5163705Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T05:31:58.5164089Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T05:31:58.5164397Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T05:31:58.5164649Z fi
2026-10-11T05:31:58.5164723Z 
2026-10-11T05:31:58.5164893Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-11T05:31:58.5165188Z # If this is an xterm set the title to user@host:dir
2026-10-11T05:31:58.5165350Z #case "$TERM" in
2026-10-11T05:31:58.5165484Z #xterm*|rxvt*)
2026-10-11T05:31:58.5165687Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-11T05:31:58.5165874Z #    ;;
2026-10-11T05:31:58.5165996Z #*)
2026-10-11T05:31:58.5166094Z #    ;;
2026-10-11T05:31:58.5166191Z #esac
2026-10-11T05:31:58.5166248Z 
2026-10-11T05:31:58.5166415Z # enable bash completion in interactive shells
