2026-10-11T04:34:28.5084422Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T04:34:28.5084694Z 
2026-10-11T04:34:28.5084985Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T04:34:28.5085462Z # this file has to be sourced in /etc/profile.
2026-10-11T04:34:28.5085679Z 
2026-10-11T04:34:28.5085875Z # If not running interactively, don't do anything
2026-10-11T04:34:28.5086214Z [ -z "$PS1" ] && return
2026-10-11T04:34:28.5086373Z 
2026-10-11T04:34:28.5086605Z # check the window size after each command and, if necessary,
2026-10-11T04:34:28.5087047Z # update the values of LINES and COLUMNS.
2026-10-11T04:34:28.5087363Z shopt -s checkwinsize
2026-10-11T04:34:28.5087508Z 
2026-10-11T04:34:28.5087808Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-11T04:34:28.5088350Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-11T04:34:28.5088741Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T04:34:28.5089355Z fi
2026-10-11T04:34:28.5089556Z 
2026-10-11T04:34:28.5089954Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-11T04:34:28.5090510Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-11T04:34:28.5090977Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-11T04:34:28.5091360Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-11T04:34:28.5091664Z fi
2026-10-11T04:34:28.5091764Z 
2026-10-11T04:34:28.5092056Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-11T04:34:28.5092554Z # If this is an xterm set the title to user@host:dir
2026-10-11T04:34:28.5092935Z #case "$TERM" in
2026-10-11T04:34:28.5093221Z #xterm*|rxvt*)
2026-10-11T04:34:28.5093656Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-11T04:34:28.5094026Z #    ;;
2026-10-11T04:34:28.5094211Z #*)
2026-10-11T04:34:28.5094392Z #    ;;
2026-10-11T04:34:28.5094574Z #esac
