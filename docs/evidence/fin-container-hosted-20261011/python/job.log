2026-10-11T04:34:28.5097283Z # sudo hint
2026-10-11T04:34:28.5097894Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-11T04:34:28.5098375Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
