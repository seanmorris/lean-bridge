2026-10-11T04:50:53.3803677Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-11T04:50:53.3804108Z fi
2026-10-11T04:50:53.3804277Z 
2026-10-11T04:50:53.3804631Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
