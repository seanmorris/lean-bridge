2026-10-11T04:50:53.3796668Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-11T04:50:53.3797072Z 
2026-10-11T04:50:53.3797520Z # To enable the settings / commands in this file for login shells as well,
2026-10-11T04:50:53.3798275Z # this file has to be sourced in /etc/profile.
2026-10-11T04:50:53.3798606Z 
2026-10-11T04:50:53.3798905Z # If not running interactively, don't do anything
2026-10-11T04:50:53.3799446Z [ -z "$PS1" ] && return
2026-10-11T04:50:53.3799672Z 
2026-10-11T04:50:53.3800033Z # check the window size after each command and, if necessary,
2026-10-11T04:50:53.3800710Z # update the values of LINES and COLUMNS.
2026-10-11T04:50:53.3801225Z shopt -s checkwinsize
2026-10-11T04:50:53.3801445Z 
2026-10-11T04:50:53.3802150Z # set variable identifying the chroot you work in (used in the prompt below)
