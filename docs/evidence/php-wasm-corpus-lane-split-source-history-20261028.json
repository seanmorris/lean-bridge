  "schemaVersion": 1,
  "scope": "Split the PHP-Wasm corpus values lane of consumer-matrix.yml into values (through the owned wasm32 transport) and values-graph (the Lean graph builds and the compound, list, alias, variant and collection families) so no required lane carries the full serial corpus on one hosted runner, bound every multi-file node --test invocation of the corpus steps to --test-concurrency=1, and sample memory, top processes, disk and per-command timestamps into build/php-wasm-corpus-samples.log retained by the bootstrap diagnostics artifact. Every corpus command and evidence path is preserved across the two value uploads; only the three concurrency flags and the telemetry prologue differ. The 92 consumer-matrix type-surface pins are refreshed to the split workflow bytes. No record, support cell, evidence scope, product source or archive changes. Register the transition newest-first; hosted Core remains the terminal acceptance gate.",
  "updates": [
    {
      "currentSha256": "c089465825f56e761386757d6341a77f702ce3230720f621aa9884029733b81b",
      "edits": [
        {
          "current": "        # Values stop after the owned wasm32 transport so no lane carries the full serial corpus on one runner;\n        # the Lean graph builds and the remaining value families run on a fresh values-graph runner.\n        profile: [values, values-graph, refinements]\n",
          "previous": "        profile: [values, refinements]\n",
          "start": 142150
        },
        {
          "current": "          mkdir -p build\n          sampler() { while sleep 30; do date -u +%T; free -m | sed -n 2p; ps -eo rss,etimes,comm --sort=-rss | head -3; df -h / | tail -1; done; }\n          sampler >> build/php-wasm-corpus-samples.log 2>&1 &\n          LEAN_BRIDGE_CORPUS_SAMPLER=$!\n          trap 'kill \"$LEAN_BRIDGE_CORPUS_SAMPLER\" 2>/dev/null || true' EXIT\n          trap 'printf \"%s %s\\n\" \"$(date -u +%T)\" \"$BASH_COMMAND\" >> build/php-wasm-corpus-samples.log' DEBUG\n",
          "previous": "",
          "start": 145332
        },
        {
          "current": "          LEAN_BRIDGE_PHP_WASM_CALLABLE_TEST=1 node --test --test-concurrency=1 tests/php-wasm-callables.test.mjs tests/php-wasm-callable-contract.test.mjs\n",
          "previous": "          LEAN_BRIDGE_PHP_WASM_CALLABLE_TEST=1 node --test tests/php-wasm-callables.test.mjs tests/php-wasm-callable-contract.test.mjs\n",
          "start": 146217
        },
        {
          "current": "          test -s build/type-corpus/php-wasm.json\n          test -s build/type-corpus/reviewed-wasm-php-wasm.json\n      - name: Compare installed PHP-Wasm graph packages with the shared Lean corpus\n        id: type_corpus_php_wasm_graph\n        if: matrix.profile == 'values-graph'\n        continue-on-error: true\n        run: |\n          set -euo pipefail\n          source scripts/env.sh\n          mkdir -p build\n          sampler() { while sleep 30; do date -u +%T; free -m | sed -n 2p; ps -eo rss,etimes,comm --sort=-rss | head -3; df -h / | tail -1; done; }\n          sampler >> build/php-wasm-corpus-samples.log 2>&1 &\n          LEAN_BRIDGE_CORPUS_SAMPLER=$!\n          trap 'kill \"$LEAN_BRIDGE_CORPUS_SAMPLER\" 2>/dev/null || true' EXIT\n          trap 'printf \"%s %s\\n\" \"$(date -u +%T)\" \"$BASH_COMMAND\" >> build/php-wasm-corpus-samples.log' DEBUG\n",
          "previous": "",
          "start": 147383
        },
        {
          "current": "          LEAN_BRIDGE_PHP_WASM_COMPOUND_TEST=1 node --test --test-concurrency=1 tests/php-wasm-compounds.test.mjs tests/php-wasm-compound-contract.test.mjs tests/php-wasm-compound-zend.test.mjs\n",
          "previous": "          LEAN_BRIDGE_PHP_WASM_COMPOUND_TEST=1 node --test tests/php-wasm-compounds.test.mjs tests/php-wasm-compound-contract.test.mjs tests/php-wasm-compound-zend.test.mjs\n",
          "start": 148983
        },
        {
          "current": "          LEAN_BRIDGE_PHP_WASM_LIST_TEST=1 node --test --test-concurrency=1 tests/php-wasm-lists.test.mjs tests/php-wasm-list-contract.test.mjs tests/php-wasm-list-zend.test.mjs\n",
          "previous": "          LEAN_BRIDGE_PHP_WASM_LIST_TEST=1 node --test tests/php-wasm-lists.test.mjs tests/php-wasm-list-contract.test.mjs tests/php-wasm-list-zend.test.mjs\n",
          "start": 149285
        },
        {
          "current": "",
          "previous": "          test -s build/type-corpus/php-wasm.json\n          test -s build/type-corpus/reviewed-wasm-php-wasm.json\n",
          "start": 150460
        },
        {
          "current": "          mkdir -p build\n          sampler() { while sleep 30; do date -u +%T; free -m | sed -n 2p; ps -eo rss,etimes,comm --sort=-rss | head -3; df -h / | tail -1; done; }\n          sampler >> build/php-wasm-corpus-samples.log 2>&1 &\n          LEAN_BRIDGE_CORPUS_SAMPLER=$!\n          trap 'kill \"$LEAN_BRIDGE_CORPUS_SAMPLER\" 2>/dev/null || true' EXIT\n          trap 'printf \"%s %s\\n\" \"$(date -u +%T)\" \"$BASH_COMMAND\" >> build/php-wasm-corpus-samples.log' DEBUG\n",
