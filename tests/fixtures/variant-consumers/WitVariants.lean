import Variants

namespace Variants

abbrev SignalView := Signal
abbrev SignalBatch := Array (List SignalView)

inductive Aliased where
  | empty
  | values (label : String) (current : SignalView) (batch : SignalBatch)

inductive Joined where
  | small (value : UInt32)
  | large (value : UInt64)
  | single (value : Float32)
  | double (value : Float)

-- Lean's boxed constructor tags stop at 243. Empty cases above that limit
