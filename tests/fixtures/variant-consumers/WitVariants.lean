def echo_alias (value : SignalView) : SignalView := value
def echo_alias_batch (value : SignalBatch) : SignalBatch := value.map List.reverse
def echo_aliased (value : Aliased) : Aliased := value
def echo_wide (value : Wide) : Wide := value
def echo_joined (value : Joined) : Joined := value

