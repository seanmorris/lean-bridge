;; A downstream module uses just the public interface to start and read the
;; two compiled Lean functions. The embedding never inspects its result.
(component
  (import "@TASKS@" (instance $tasks
    (export "box" (type $b (sub resource))) (export "member-error" (type $e (sub resource)))
    (export "call-box-to-box" (type $c (sub resource)))
    (type $v (variant (case "callback" (own $e)) (case "io" string)))
    (export "callback-failure" (type $failure (eq $v)))
    (type $ok (own $b)) (type $t (future (result $ok (error $failure))))
    (export "relay" (func (param "box" (borrow $b)) (param "f" (borrow $c)) (result $t)))
    (export "relay-late" (func (param "box" (borrow $b)) (param "f" (borrow $c)) (result $t)))))
  (alias export $tasks "box" (type $b)) (alias export $tasks "member-error" (type $e))
  (alias export $tasks "call-box-to-box" (type $c)) (alias export $tasks "callback-failure" (type $failure))
  (type $ok (own $b)) (type $future (future (result $ok (error $failure))))
  (import "source" (func $source (result (own $b))))
  (import "register" (func $register (param "mode" u32) (result (own $c))))
  (import "same" (func $same (param "left" (borrow $b)) (param "right" (borrow $b)) (result bool)))
  (import "message" (func $message (param "self" (borrow $e)) (result string)))
  (core module $memory (memory (export "m") 1)
    (data (i32.const 96) "other error") (data (i32.const 112) "late λ")
    (global $top (mut i32) (i32.const 256))
    (func (export "realloc") (param $old i32) (param i32) (param $align i32) (param $len i32) (result i32)
      (local $p i32) (if (local.get $old) (then unreachable))
      (local.set $p (i32.and (i32.add (global.get $top) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $top (i32.add (local.get $p) (local.get $len))) (if (i32.gt_u (global.get $top) (i32.const 65536)) (then unreachable)) (local.get $p)))
  (core instance $mem (instantiate $memory))
  (core func $source (canon lower (func $source))) (core func $register (canon lower (func $register)))
  (core func $same (canon lower (func $same)))
  (core func $message (canon lower (func $message) (memory $mem "m") (realloc (func $mem "realloc"))))
  (core func $relay (canon lower (func $tasks "relay"))) (core func $late (canon lower (func $tasks "relay-late")))
  (core func $box (canon resource.drop $b)) (core func $cb (canon resource.drop $c)) (core func $err (canon resource.drop $e))
  (core func $read (canon future.read $future async (memory $mem "m") (realloc (func $mem "realloc"))))
  (core func $drop (canon future.drop-readable $future))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $poll (canon waitable-set.poll (memory $mem "m"))) (core func $del (canon waitable-set.drop))
  (core module $client (import "" "m" (memory 1))
    (import "" "source" (func $source (result i32))) (import "" "register" (func $register (param i32) (result i32)))
    (import "" "same" (func $same (param i32 i32) (result i32))) (import "" "message" (func $message (param i32 i32)))
    (import "" "relay" (func $relay (param i32 i32) (result i32))) (import "" "late" (func $late (param i32 i32) (result i32)))
    (import "" "box" (func $box (param i32))) (import "" "cb" (func $cb (param i32))) (import "" "err" (func $err (param i32)))
    (import "" "read" (func $read (param i32 i32) (result i32))) (import "" "drop" (func $drop (param i32)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "poll" (func $poll (param i32 i32) (result i32))) (import "" "del" (func $del (param i32)))
    (global $waiting (mut i32) (i32.const 0))
    (global $original (mut i32) (i32.const 0)) (global $mode (mut i32) (i32.const 0)) (global $reader (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $text (param $at i32) (param $bytes i32) (param $n i32) (local $i i32)
      (call $eq (i32.load offset=4 (local.get $at)) (local.get $n))
      (loop $chars (call $eq (i32.load8_u (i32.add (i32.load (local.get $at)) (local.get $i))) (i32.load8_u (i32.add (local.get $bytes) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $chars (i32.lt_u (local.get $i) (local.get $n)))))
    (func (export "begin") (param $m i32) (local $f i32)
      (global.set $original (call $source)) (global.set $mode (local.get $m))
      (local.set $f (call $register (select (i32.const 2) (i32.and (local.get $m) (i32.const 1)) (i32.eq (local.get $m) (i32.const 4)))))
      (global.set $reader (if (result i32) (i32.and (local.get $m) (i32.const 2))
        (then (call $late (global.get $original) (local.get $f))) (else (call $relay (global.get $original) (local.get $f)))))
      (call $cb (local.get $f)))
    (func $finish (export "discard") (call $drop (global.get $reader)) (call $box (global.get $original)))
    (func (export "receive") (call $eq (call $read (global.get $reader) (i32.const 16)) (i32.const 0)) (call $check))
    (func (export "request") (call $eq (call $read (global.get $reader) (i32.const 16)) (i32.const -1))
      (global.set $waiting (call $set)) (call $join (global.get $reader) (global.get $waiting)))
    (func (export "collect") (call $eq (call $poll (global.get $waiting) (i32.const 80)) (i32.const 4))
      (call $eq (i32.load (i32.const 80)) (global.get $reader)) (call $eq (i32.load (i32.const 84)) (i32.const 0))
      (call $join (global.get $reader) (i32.const 0)) (call $del (global.get $waiting)) (call $check))
    (func $check (local $h i32)
      (call $eq (i32.load8_u (i32.const 16)) (i32.ne (global.get $mode) (i32.const 0)))
      (if (i32.eqz (global.get $mode))
        (then (local.set $h (i32.load (i32.const 20))) (call $eq (call $same (global.get $original) (local.get $h)) (i32.const 1)) (call $box (local.get $h)))
        (else (call $eq (i32.load8_u (i32.const 20)) (i32.ge_u (global.get $mode) (i32.const 2)))
          (if (i32.eq (global.get $mode) (i32.const 1)) (then
            (local.set $h (i32.load (i32.const 24))) (call $message (local.get $h) (i32.const 48))
            (call $text (i32.const 48) (i32.const 96) (i32.const 11)) (call $err (local.get $h)))
            (else (call $text (i32.const 24) (i32.const 112) (i32.const 7))))))
      (call $finish)))
  (core instance $i (instantiate $client (with "" (instance (export "m" (memory $mem "m"))
    (export "source" (func $source)) (export "register" (func $register)) (export "same" (func $same)) (export "message" (func $message))
    (export "relay" (func $relay)) (export "late" (func $late)) (export "box" (func $box)) (export "err" (func $err)) (export "cb" (func $cb))
    (export "set" (func $set)) (export "join" (func $join)) (export "poll" (func $poll)) (export "del" (func $del))
    (export "read" (func $read)) (export "drop" (func $drop))))))
  (func (export "begin") (param "mode" u32) (canon lift (core func $i "begin")))
  (func (export "request") (canon lift (core func $i "request"))) (func (export "collect") (canon lift (core func $i "collect")))
  (func (export "discard") (canon lift (core func $i "discard"))) (func (export "receive") (canon lift (core func $i "receive"))))
