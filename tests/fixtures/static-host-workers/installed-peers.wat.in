    (export "reject" (func (param "box" (borrow $gb)) (result (result u32 (error (own $gb))))))))
  (core module $h (memory (export "m") 1)
    (func (export "alloc") (param i32 i32 i32 i32) (result i32) unreachable))
  (core instance $h (instantiate $h))
  (core func $make (canon lower (func $owner "[static]box.create") (memory $h "m")))
  (core func $read (canon lower (func $owner "[method]box.read") (memory $h "m")))
