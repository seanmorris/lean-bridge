      (call $make (i32.const 77777) (i32.const 0)) (local.set $counter (call $value (i32.const 0)))
      (call $make (i32.const 36) (i32.const 0)) (local.set $a (call $value (i32.const 0)))
      (call $choose (local.get $a) (i32.const 1) (i32.const 0)) (local.set $b (call $value (i32.const 0)))
      (call $eq (call $same (local.get $a) (local.get $b)) (i32.const 1))
      (call $increase (local.get $b) (i32.const 37) (i32.const 0)) (call $eq (call $value (i32.const 0)) (i32.const 73))
      (call $reject (local.get $b) (i32.const 0)) (local.set $error (call $value (i32.const 1)))
      (call $eq (call $same (local.get $a) (local.get $error)) (i32.const 1))
      (call $drop (local.get $a)) (call $drop (local.get $b))
      (call $mapped (local.get $error) (i32.const 0)) (local.set $answer (call $value (i32.const 0)))
      (call $drop (local.get $error))
      (call $read (local.get $counter) (i32.const 0)) (call $eq (call $value (i32.const 0)) (i32.const 1))
      (call $drop (local.get $counter)) (i64.extend_i32_u (local.get $answer))))
  (core instance $i (instantiate $body (with "" (instance (export "m" (memory $h "m"))
