;; A real defining guest. Each Box has its own location, so equal values do
;; not imply equal objects. The guest destructor counts canonical owners.
(module
  ;; @test-drop-import@
  (import "cm32p2|_ex_@IFACE@" "box_new" (func $new (param i32) (result i32)))
  (import "cm32p2|_ex_@IFACE@" "member-error_new" (func $error (param i32) (result i32)))
  (memory (export "cm32p2_memory") 1)
  (global $next (mut i32) (i32.const 256))
  (global $drops (mut i32) (i32.const 0))
  (global $armed (mut i32) (i32.const 0))
  (data (i32.const 100) "invalid box")
  (data (i32.const 112) "other error")
  ;; Small bump allocator for canonical string and list parameters.
  (func (export "cm32p2_realloc") (param $old i32) (param $length i32)
    (param $align i32) (param $size i32) (result i32) (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
                            (i32.sub (i32.const 0) (local.get $align))))
    (global.set $next (i32.add (local.get $p) (local.get $size)))
    (if (local.get $old) (then (memory.copy (local.get $p) (local.get $old)
      (select (local.get $size) (local.get $length) (i32.lt_u (local.get $size) (local.get $length))))))
    (local.get $p))
  ;; One synchronous call at a time; retptr 0 holds the result tag + payload.
  (func $result (param $tag i32) (param $v i32) (result i32)
    (i32.store8 (i32.const 0) (local.get $tag))
    (i32.store (i32.const 4) (local.get $v))
    (i32.const 0))
  (func (export "cm32p2|@IFACE@|[static]box.create") (param $v i32) (result i32) (local $p i32)
    (if (i32.eq (local.get $v) (i32.const -1)) (then
      (return (call $result (i32.const 1) (call $error (i32.const 7))))))
    (if (i32.eq (local.get $v) (i32.const -2)) (then
      (return (call $result (i32.const 1) (call $error (i32.const 9))))))
    (local.set $p (global.get $next))
    (global.set $next (i32.add (local.get $p) (i32.const 4)))
    (i32.store (local.get $p) (local.get $v))
    (call $result (i32.const 0) (call $new (local.get $p))))
  (func $read (export "cm32p2|@IFACE@|[method]box.read") (param $p i32) (result i32)
    ;; @installed-drop-observer@
    (if (i32.eq (i32.load (local.get $p)) (i32.const 64206)) (then
      (return (call $result (i32.const 1) (call $error (i32.const 8))))))
    (call $result (i32.const 0) (i32.load (local.get $p))))
  (export "cm32p2|@IFACE@|[method]box.get-level" (func $read))
  (func (export "cm32p2|@IFACE@|[method]box.set-level") (param $p i32) (param $v i32) (result i32)
    (i32.store (local.get $p) (local.get $v))
    (call $result (i32.const 0) (i32.const 0)))
  (func $identity (export "cm32p2|@IFACE@|[method]box.identity") (param $p i32) (result i32)
    (call $result (i32.const 0) (call $new (local.get $p))))
  (export "cm32p2|@IFACE@|[method]box.anchored" (func $identity))
  (func $keep (export "cm32p2|@IFACE@|[method]box.keep-other") (param i32) (param $owned i32) (result i32)
    (call $result (i32.const 0) (local.get $owned)))
  (export "cm32p2|@IFACE@|[method]box.take-other" (func $keep))
  (func $bytes (export "cm32p2|@IFACE@|[method]box.echo-bytes") (param i32) (param $ptr i32) (param $len i32) (result i32)
    (i32.store (i32.const 8) (local.get $len))
    (call $result (i32.const 0) (local.get $ptr)))
  (export "cm32p2|@IFACE@|[method]box.echo-text" (func $bytes))
  (func (export "cm32p2|@IFACE@|[method]box.shift") (param i32) (param $negative i32) (param $ptr i32) (param $len i32) (result i32)
    (i32.store (i32.const 8) (local.get $ptr))
    (i32.store (i32.const 12) (local.get $len))
    (call $result (i32.const 0) (local.get $negative)))
  (func (export "cm32p2|@IFACE@|retain-box") (param $p i32) (result i32)
    (call $new (local.get $p)))
  (func (export "cm32p2|@IFACE@|same-box") (param $a i32) (param $b i32) (result i32)
    (i32.eq (local.get $a) (local.get $b)))
  (func (export "cm32p2|@IFACE@|[method]member-error.message") (param $kind i32) (result i32)
    (i32.store (i32.const 0) (select (i32.const 112) (i32.const 100) (i32.eq (local.get $kind) (i32.const 9))))
    (i32.store (i32.const 4) (i32.const 11))
    (i32.const 0))
  (func $destroy (export "cm32p2|@IFACE@|box_dtor") (param i32)
    (if (global.get $armed) (then unreachable))
    ;; @test-drop-notify@
    (global.set $drops (i32.add (global.get $drops) (i32.const 1))))
  (export "cm32p2|@IFACE@|member-error_dtor" (func $destroy))
  (func (export "cm32p2||drops") (result i32) (global.get $drops))
  (func (export "cm32p2||arm-drop") (global.set $armed (i32.const 1))))
