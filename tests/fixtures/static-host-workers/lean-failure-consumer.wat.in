;; The typed factory error is synchronous. An ordinary Except in a Task is
;; data read from a future. No native marker, polling key or adapter import.
(component
  (import "@TASKS@" (instance $t
    (export "box" (type $b (sub resource)))
    (type $numbers (future u32))
    (export "reject" (func (param "box" (borrow $b)) (result (result $numbers (error (own $b))))))
    (export "accept" (func (param "box" (borrow $b)) (result (result $numbers (error (own $b))))))
    (export "outcome" (func (param "box" (borrow $b)) (result (future (result u32 (error (own $b)))))))
    (export "completed" (func (param "box" (borrow $b)) (result (future (result u32 (error (own $b)))))))))
  (alias export $t "box" (type $box))
  (type $scalar (future u32)) (type $tagged (future (result u32 (error (own $box)))))
  (import "source" (func $source (result (own $box))))
  (import "same" (func $same (param "left" (borrow $box)) (param "right" (borrow $box)) (result bool)))
  (core module $memory (memory (export "m") 1)) (core instance $mem (instantiate $memory))
  (core func $source (canon lower (func $source))) (core func $same (canon lower (func $same)))
  (core func $release (canon resource.drop $box))
  (core func $reject (canon lower (func $t "reject") (memory $mem "m")))
  (core func $accept (canon lower (func $t "accept") (memory $mem "m")))
  (core func $outcome (canon lower (func $t "outcome"))) (core func $completed (canon lower (func $t "completed")))
  (core func $read-s (canon future.read $scalar async (memory $mem "m")))
  (core func $read-t (canon future.read $tagged async (memory $mem "m")))
  (core func $drop-s (canon future.drop-readable $scalar)) (core func $drop-t (canon future.drop-readable $tagged))
  (core module $m (import "" "m" (memory 1))
    (import "" "source" (func $source (result i32))) (import "" "same" (func $same (param i32 i32) (result i32)))
    (import "" "release" (func $release (param i32)))
    (import "" "reject" (func $reject (param i32 i32))) (import "" "accept" (func $accept (param i32 i32)))
    (import "" "outcome" (func $outcome (param i32) (result i32))) (import "" "completed" (func $completed (param i32) (result i32)))
    (import "" "read-s" (func $read-s (param i32 i32) (result i32))) (import "" "read-t" (func $read-t (param i32 i32) (result i32)))
    (import "" "drop-s" (func $drop-s (param i32))) (import "" "drop-t" (func $drop-t (param i32)))
    (global $original (mut i32) (i32.const 0)) (global $reader (mut i32) (i32.const 0)) (global $mode (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $check-object (param $slot i32) (call $eq (call $same (global.get $original) (local.get $slot)) (i32.const 1))
      (call $release (local.get $slot)))
    (func (export "reject")
      (global.set $original (call $source)) (call $reject (global.get $original) (i32.const 8))
      (call $eq (i32.load8_u (i32.const 8)) (i32.const 1))
      (call $check-object (i32.load (i32.const 12))) (call $release (global.get $original)))
    (func (export "start") (param $mode i32)
      (global.set $original (call $source)) (global.set $mode (local.get $mode))
      (if (i32.eq (local.get $mode) (i32.const 2)) (then
        (call $accept (global.get $original) (i32.const 8)) (call $eq (i32.load8_u (i32.const 8)) (i32.const 0))
        (global.set $reader (i32.load (i32.const 12))) (return)))
      (global.set $reader (if (result i32) (local.get $mode) (then (call $completed (global.get $original))) (else (call $outcome (global.get $original))))))
    (func $discard (export "discard")
      (if (i32.eq (global.get $mode) (i32.const 2)) (then (call $drop-s (global.get $reader))) (else (call $drop-t (global.get $reader))))
      (call $release (global.get $original)))
    (func (export "receive")
      (if (i32.eq (global.get $mode) (i32.const 2)) (then
        (call $eq (call $read-s (global.get $reader) (i32.const 16)) (i32.const 0))
        (call $eq (i32.load (i32.const 16)) (i32.const -1)))
      (else
        (call $eq (call $read-t (global.get $reader) (i32.const 16)) (i32.const 0))
        (call $eq (i32.load8_u (i32.const 16)) (i32.eqz (global.get $mode)))
        (if (global.get $mode) (then (call $eq (i32.load (i32.const 20)) (i32.const 0))) (else (call $check-object (i32.load (i32.const 20)))))))
      (call $discard)))
  (core instance $i (instantiate $m (with "" (instance (export "m" (memory $mem "m")) (export "source" (func $source))
    (export "same" (func $same)) (export "release" (func $release)) (export "reject" (func $reject)) (export "accept" (func $accept))
    (export "outcome" (func $outcome)) (export "completed" (func $completed))
    (export "read-s" (func $read-s)) (export "read-t" (func $read-t)) (export "drop-s" (func $drop-s)) (export "drop-t" (func $drop-t))))))
  (func (export "reject") (canon lift (core func $i "reject")))
  (func (export "start-case") (param "mode" u32) (canon lift (core func $i "start")))
  (func (export "discard-case") (canon lift (core func $i "discard")))
  (func (export "receive-case") (canon lift (core func $i "receive"))))
