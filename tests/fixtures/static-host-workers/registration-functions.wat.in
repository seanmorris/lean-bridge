  (import "cm32p2|@FACTORY@" "remember" (func $capture (param i32 i32)))
  (import "cm32p2|@FACTORY@" "[method]remember-function.invoke" (func $invoke-capture (param i32 i32 i32)))
  (import "cm32p2|@FACTORY@" "remember-function_drop" (func $drop-capture (param i32)))
  (import "cm32p2|@HOST@" "same-box" (func $same-box (param i32 i32) (result i32)))
;; @capture-code@
  ;; Occupancy is separate from the canonical handle (zero can be valid).
  ;; Banks start at 128/144; offsets 32/36 are disjoint from the counters.
  (func (export "cm32p2|@CALLS@|[static]call-box-to-box.make-capturing")
    (param $mode i32) (param $box i32) (result i32) (local $p i32)
    (local.set $p (call $slot (local.get $mode)))
    (if (i32.or (i32.load (local.get $p)) (i32.load offset=36 (local.get $p))) (then unreachable))
    (call $capture (local.get $box) (i32.const 24))
    (if (i32.load8_u (i32.const 24)) (then unreachable))
    ;; The factory retains its own owner. End the constructor's borrowed
    ;; canonical handle before returning the independently owned registration.
    (call $end (local.get $box))
    (i32.store offset=32 (local.get $p) (i32.load (i32.const 28)))
    (i32.store offset=36 (local.get $p) (i32.const 1))
    (global.set $next (i32.add (global.get $next) (i32.const 4)))
    (call $counted-new (i32.or (global.get $next) (local.get $mode))))
  (func $invoke-held (param $p i32) (param $expected i32) (local $other i32) (local $out i32)
    (if (i32.ne (i32.load offset=36 (local.get $p)) (i32.const 1)) (then unreachable))
    (call $create (i32.const 42) (i32.const 24))
    (if (i32.load8_u (i32.const 24)) (then unreachable))
    (local.set $other (i32.load (i32.const 28)))
    (if (call $same-box (local.get $other) (local.get $expected)) (then unreachable))
    (call $invoke-capture (i32.load offset=32 (local.get $p)) (local.get $other) (i32.const 48))
    (if (i32.load8_u (i32.const 48)) (then unreachable))
    (local.set $out (i32.load (i32.const 52)))
    (if (i32.eqz (call $same-box (local.get $out) (local.get $expected))) (then unreachable))
    (call $end (local.get $out)) (call $end (local.get $other)))
  (func $release-last (param $p i32)
    (if (i32.eqz (i32.load (local.get $p))) (then
      (if (i32.ne (i32.load offset=36 (local.get $p)) (i32.const 1)) (then unreachable))
      (i32.store offset=36 (local.get $p) (i32.const 0))
      (call $drop-capture (i32.load offset=32 (local.get $p))))))
  (func $check-held (param $p i32)
    (if (i32.ne (i32.ne (i32.load (local.get $p)) (i32.const 0)) (i32.load offset=36 (local.get $p))) (then unreachable)))
