;; Component imports come only from the two installed WIT packages.
(module
  (import "cm32p2|@OBJECTS@" "[static]box.create" (func $create (param i32 i32)))
  (import "cm32p2|@OBJECTS@" "[method]box.read" (func $read (param i32 i32)))
  (import "cm32p2|@OBJECTS@" "same-box" (func $same (param i32 i32) (result i32)))
  (import "cm32p2|@OBJECTS@" "box_drop" (func $drop (param i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "remember" (func $workshop (param i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]remember-function.invoke" (func $call-a (param i32 i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]remember-function.close" (func $close-a (param i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "remember-function_drop" (func $drop-a (param i32)))
  (import "cm32p2|lean-bridge:gauge/api@1" "remember" (func $gauge (param i32 i32)))
  (import "cm32p2|lean-bridge:gauge/api@1" "[method]remember-function.invoke" (func $call-b (param i32 i32 i32)))
  (import "cm32p2|lean-bridge:gauge/api@1" "remember-function_drop" (func $drop-b (param i32)))
  (memory (export "cm32p2_memory") 1)
  (func (export "cm32p2_realloc") (param i32 i32 i32 i32) (result i32) (i32.const 128))
  (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
  (func $ok (result i32) (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (i32.load (i32.const 4)))
  (func (export "cm32p2||run") (result i64)
    (local $left i32) (local $right i32) (local $counter i32) (local $a i32) (local $b i32) (local $out i32)
    (call $create (i32.const 77777) (i32.const 0)) (local.set $counter (call $ok))
    (call $create (i32.const 42) (i32.const 0)) (local.set $left (call $ok))
    (call $create (i32.const 42) (i32.const 0)) (local.set $right (call $ok))
    (call $workshop (local.get $left) (i32.const 0)) (local.set $a (call $ok))
    (call $gauge (local.get $right) (i32.const 0)) (local.set $b (call $ok))
    (call $call-a (local.get $a) (local.get $right) (i32.const 0)) (local.set $out (call $ok))
    (call $eq (call $same (local.get $out) (local.get $left)) (i32.const 1))
    (call $eq (call $same (local.get $out) (local.get $right)) (i32.const 0)) (call $drop (local.get $out))
    (call $close-a (local.get $a)) (call $drop-a (local.get $a))
    (call $call-b (local.get $b) (local.get $left) (i32.const 0)) (local.set $out (call $ok))
    (call $eq (call $same (local.get $out) (local.get $right)) (i32.const 1))
    (call $drop (local.get $out)) (call $drop (local.get $left)) (call $drop (local.get $right)) (call $drop-b (local.get $b))
    ;; Exactly one owner is left in the guest, the counter we are reading.
    (call $read (local.get $counter) (i32.const 0)) (call $eq (call $ok) (i32.const 1))
    (call $drop (local.get $counter)) (i64.const 42)))
