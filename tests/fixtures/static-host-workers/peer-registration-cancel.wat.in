;; Two independently owned Workshop registrations. Both reads are pending
;; before cancellation. The survivor calls Gauge in the same Wasmtime store.
(component
  (import "@OBJECTS@" (instance $o (export "box" (type $b (sub resource)))
    (export "member-error" (type $e (sub resource)))
    (export "[static]box.create" (func (param "value" u32) (result (result (own $b) (error (own $e))))))
    (export "[method]box.get-level" (func (param "self" (borrow $b)) (result (result u32 (error (own $e))))))
    (export "same-box" (func (param "left" (borrow $b)) (param "right" (borrow $b)) (result bool)))))
  (alias export $o "box" (type $b)) (alias export $o "member-error" (type $e))
  (import "lean-bridge:workshop/callbacks@1.0.0" (instance $callbacks
    (export "call-box-to-box" (type $c (sub resource)))
    (export "[static]call-box-to-box.make" (func (param "mode" u32) (result (own $c))))
    (export "audit" (func (param "field" u32) (result u32)))))
  (alias export $callbacks "call-box-to-box" (type $c))
  (import "lean-bridge:workshop/object-tasks@1.0.0" (instance $jobs
    (export "box" (type $bi (eq $b))) (export "member-error" (type $ei (eq $e)))
    (export "call-box-to-box" (type $ci (eq $c)))
    (type $v (variant (case "callback" (own $ei)) (case "io" string))) (export "callback-failure" (type $err (eq $v)))
    (type $t (future (result (own $bi) (error $err))))
    (export "relay" (func (param "box" (borrow $bi)) (param "f" (borrow $ci)) (result $t)))))
  (alias export $jobs "callback-failure" (type $err))
  (type $t (future (result (own $b) (error $err))))
  (core module $mem (memory (export "m") 1) (func (export "alloc") (param i32 i32 i32 i32) (result i32) unreachable))
  (core instance $m (instantiate $mem))
  (core func $make (canon lower (func $o "[static]box.create") (memory $m "m")))
  (core func $level (canon lower (func $o "[method]box.get-level") (memory $m "m")))
  (core func $same (canon lower (func $o "same-box")))
  (core func $register (canon lower (func $callbacks "[static]call-box-to-box.make")))
  (core func $audit (canon lower (func $callbacks "audit")))
  (core func $relay (canon lower (func $jobs "relay")))
  (core func $read (canon future.read $t async (memory $m "m") (realloc (func $m "alloc"))))
  (core func $cancel (canon future.cancel-read $t)) (core func $drop (canon future.drop-readable $t))
  (core func $db (canon resource.drop $b)) (core func $dc (canon resource.drop $c))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $del (canon waitable-set.drop)) (core func $return (canon task.return (result s64)))
  (core module $code (import "" "m" (memory 1))
    (import "" "make" (func $make (param i32 i32))) (import "" "level" (func $level (param i32 i32)))
    (import "" "same" (func $same (param i32 i32) (result i32))) (import "" "audit" (func $audit (param i32) (result i32)))
    (import "" "register" (func $register (param i32) (result i32))) (import "" "relay" (func $relay (param i32 i32) (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32))) (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32))) (import "" "db" (func $db (param i32))) (import "" "dc" (func $dc (param i32)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32))) (import "" "return" (func $return (param i64)))
    (global $waits (mut i32) (i32.const 0)) (global $victim (mut i32) (i32.const 0))
    (global $keep (mut i32) (i32.const 0)) (global $original (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $box (result i32) (call $make (i32.const 42) (i32.const 0))
      (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (i32.load (i32.const 4)))
    (func $start (param $box i32) (param $mode i32) (result i32) (local $cb i32) (local $r i32)
      (local.set $cb (call $register (local.get $mode))) (local.set $r (call $relay (local.get $box) (local.get $cb)))
      (call $dc (local.get $cb)) (local.get $r))
    (func (export "run") (result i32) (local $other i32)
      (global.set $original (call $box)) (local.set $other (call $box))
      (call $eq (call $same (global.get $original) (local.get $other)) (i32.const 0))
      (if (i32.const @VICTIM_FIRST@)
        (then (global.set $victim (call $start (local.get $other) (i32.const 2))) (global.set $keep (call $start (global.get $original) (i32.const 0))))
        (else (global.set $keep (call $start (global.get $original) (i32.const 0))) (global.set $victim (call $start (local.get $other) (i32.const 2)))))
      (call $db (local.get $other))
      (i32.store (i32.const 96) (i32.const 0x12345678))
      (if (i32.const @READ_VICTIM_FIRST@)
        (then (call $eq (call $read (global.get $victim) (i32.const 96)) (i32.const -1))
              (call $eq (call $read (global.get $keep) (i32.const 48)) (i32.const -1)))
        (else (call $eq (call $read (global.get $keep) (i32.const 48)) (i32.const -1))
              (call $eq (call $read (global.get $victim) (i32.const 96)) (i32.const -1))))
      (call $eq (call $audit (i32.const 6)) (i32.const 0))
      (call $eq (call $cancel (global.get $victim)) (i32.const 2)) (call $drop (global.get $victim))
      (global.set $waits (call $set)) (call $join (global.get $keep) (global.get $waits))
      (i32.or (i32.const 2) (i32.shl (global.get $waits) (i32.const 4))))
    (func (export "cb") (param $ev i32) (param $id i32) (param $rc i32) (result i32)
      (local $result i32) (local $field i32) (local $n i32) (local $report i64)
      (call $eq (local.get $ev) (i32.const 4)) (call $eq (local.get $id) (global.get $keep)) (call $eq (local.get $rc) (i32.const 0))
      (call $eq (i32.load (i32.const 96)) (i32.const 0x12345678)) (call $eq (i32.load8_u (i32.const 48)) (i32.const 0))
      (local.set $result (i32.load (i32.const 52))) (call $eq (call $same (global.get $original) (local.get $result)) (i32.const 1))
      (call $level (local.get $result) (i32.const 16)) (call $eq (i32.load8_u (i32.const 16)) (i32.const 0))
      (call $eq (i32.load (i32.const 20)) (i32.const 73)) (call $db (local.get $result)) (call $db (global.get $original))
      (call $drop (global.get $keep)) (call $del (global.get $waits))
      (loop $fields (local.set $n (call $audit (local.get $field)))
        (if (i32.gt_u (local.get $n) (i32.const 127)) (then unreachable))
        (local.set $report (i64.or (local.get $report) (i64.shl (i64.extend_i32_u (local.get $n)) (i64.extend_i32_u (i32.shl (local.get $field) (i32.const 3))))))
        (local.set $field (i32.add (local.get $field) (i32.const 1))) (br_if $fields (i32.lt_u (local.get $field) (i32.const 8))))
      (call $return (local.get $report)) (i32.const 0)))
  (core instance $i (instantiate $code (with "" (instance (export "m" (memory $m "m"))
    (export "make" (func $make)) (export "level" (func $level)) (export "same" (func $same)) (export "audit" (func $audit))
    (export "register" (func $register)) (export "relay" (func $relay)) (export "read" (func $read)) (export "cancel" (func $cancel))
    (export "drop" (func $drop)) (export "db" (func $db)) (export "dc" (func $dc)) (export "set" (func $set))
    (export "join" (func $join)) (export "del" (func $del)) (export "return" (func $return))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
