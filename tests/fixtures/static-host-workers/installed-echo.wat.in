;; This application imports no synchronous Lean API and no registration.
;; Check identity after discarding the source's independent owner.
(component
  (import "@OBJECTS@" (instance $objects (export "box" (type $box (sub resource)))
    (export "member-error" (type $error (sub resource)))
    (export "[static]box.create" (func (param "value" u32) (result (result (own $box) (error (own $error))))))
    (export "[method]box.read" (func (param "self" (borrow $box)) (result (result u32 (error (own $error))))))
    (export "same-box" (func (param "left" (borrow $box)) (param "right" (borrow $box)) (result bool)))))
  (alias export $objects "box" (type $box))
  (import "@TASKS@" (instance $tasks (export "box" (type $b (eq $box)))
    (export "echo" (func (param "box" (borrow $b)) (result (future (own $b)))))))
  (type $f (future (own $box)))
  (core module $heap (memory (export "m") 1)) (core instance $h (instantiate $heap))
  (core func $new (canon lower (func $objects "[static]box.create") (memory $h "m")))
  (core func $value (canon lower (func $objects "[method]box.read") (memory $h "m")))
  (core func $same (canon lower (func $objects "same-box"))) (core func $drop (canon resource.drop $box))
  (core func $echo (canon lower (func $tasks "echo"))) (core func $read (canon future.read $f async (memory $h "m")))
  (core func $release (canon future.drop-readable $f)) (core func $return (canon task.return (result s64)))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join)) (core func $del (canon waitable-set.drop))
  (core module $program (import "" "m" (memory 1))
    (import "" "new" (func $new (param i32 i32))) (import "" "value" (func $value (param i32 i32)))
    (import "" "same" (func $same (param i32 i32) (result i32))) (import "" "drop" (func $drop (param i32)))
    (import "" "echo" (func $echo (param i32) (result i32))) (import "" "read" (func $read (param i32 i32) (result i32)))
    (import "" "release" (func $release (param i32))) (import "" "return" (func $return (param i64)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32))) (import "" "del" (func $del (param i32)))
    (global $orig (mut i32) (i32.const 0)) (global $reader (mut i32) (i32.const 0)) (global $wait (mut i32) (i32.const 0))
    (func $end (result i32) (local $v i32)
      (local.set $v (i32.load (i32.const 16)))
      (if (i32.eqz (call $same (global.get $orig) (local.get $v))) (then unreachable))
      (call $drop (global.get $orig)) (call $value (local.get $v) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (call $drop (local.get $v)) (call $release (global.get $reader)) (call $del (global.get $wait))
      (call $return (i64.extend_i32_u (i32.load (i32.const 4)))) (i32.const 0))
    (func (export "run") (result i32) (local $status i32)
      (call $new (i32.const 83) (i32.const 0)) (if (i32.load8_u (i32.const 0)) (then unreachable))
      (global.set $orig (i32.load (i32.const 4))) (global.set $reader (call $echo (global.get $orig)))
      (global.set $wait (call $set)) (local.set $status (call $read (global.get $reader) (i32.const 16)))
      (if (i32.eqz (local.get $status)) (then (return (call $end))))
      (if (i32.ne (local.get $status) (i32.const -1)) (then unreachable))
      (call $join (global.get $reader) (global.get $wait))
      (i32.or (i32.const 2) (i32.shl (global.get $wait) (i32.const 4))))
    (func (export "resume") (param $ev i32) (param $id i32) (param $rc i32) (result i32)
      (if (i32.or (i32.ne (local.get $ev) (i32.const 4)) (i32.or (i32.ne (local.get $id) (global.get $reader)) (local.get $rc))) (then unreachable))
      (call $end)))
  (core instance $p (instantiate $program (with "" (instance (export "m" (memory $h "m"))
    (export "new" (func $new)) (export "value" (func $value)) (export "same" (func $same)) (export "drop" (func $drop))
    (export "echo" (func $echo)) (export "read" (func $read)) (export "release" (func $release)) (export "return" (func $return))
    (export "set" (func $set)) (export "join" (func $join)) (export "del" (func $del))))))
  (func (export "run") async (result s64) (canon lift (core func $p "run") async (callback (func $p "resume")))))
