;; An independently compiled caller. It owns the reader and validates the
;; identity of every delivered object, including a terminal step error.
(component
  (import "@TASKS@" (instance $tasks
    (export "box" (type $b (sub resource))) (type $v (own $b))
    (export "finite" (func (param "box" (borrow $b)) (result (stream $v))))
    (export "series" (func (param "box" (borrow $b)) (result (stream (result $v (error $v))))))))
  (alias export $tasks "box" (type $b)) (type $v (own $b))
  (type $s (stream $v)) (type $t (stream (result $v (error $v))))
  (import "source" (func $source (result (own $b))))
  (import "same" (func $same (param "left" (borrow $b)) (param "right" (borrow $b)) (result bool)))
  (core module $memory (memory (export "m") 1)) (core instance $mem (instantiate $memory))
  (core func $source (canon lower (func $source))) (core func $same (canon lower (func $same)))
  (core func $finite (canon lower (func $tasks "finite"))) (core func $series (canon lower (func $tasks "series")))
  (core func $read-s (canon stream.read $s async (memory $mem "m"))) (core func $read-t (canon stream.read $t async (memory $mem "m")))
  (core func $cancel-s (canon stream.cancel-read $s)) (core func $cancel-t (canon stream.cancel-read $t))
  (core func $drop-s (canon stream.drop-readable $s)) (core func $drop-t (canon stream.drop-readable $t))
  (core func $new (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $poll (canon waitable-set.poll (memory $mem "m"))) (core func $del (canon waitable-set.drop))
  (core func $box (canon resource.drop $b))
  (core module $client (import "" "m" (memory 1))
    (import "" "source" (func $source (result i32))) (import "" "same" (func $same (param i32 i32) (result i32)))
    (import "" "finite" (func $finite (param i32) (result i32))) (import "" "series" (func $series (param i32) (result i32)))
    (import "" "read-s" (func $read-s (param i32 i32 i32) (result i32))) (import "" "read-t" (func $read-t (param i32 i32 i32) (result i32)))
    (import "" "cancel-s" (func $cancel-s (param i32) (result i32))) (import "" "cancel-t" (func $cancel-t (param i32) (result i32)))
    (import "" "drop-s" (func $drop-s (param i32))) (import "" "drop-t" (func $drop-t (param i32)))
    (import "" "new" (func $new (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "poll" (func $poll (param i32 i32) (result i32))) (import "" "del" (func $del (param i32))) (import "" "box" (func $box (param i32)))
    (global $orig (mut i32) (i32.const 0)) (global $r (mut i32) (i32.const 0))
    (global $typed (mut i32) (i32.const 0)) (global $set (mut i32) (i32.const 0)) (global $rc (mut i32) (i32.const 0))
    (global $ended (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func (export "start") (param $kind i32)
      (global.set $orig (call $source)) (global.set $typed (local.get $kind)) (global.set $ended (i32.const 0))
      (global.set $r (if (result i32) (global.get $typed) (then (call $series (global.get $orig))) (else (call $finite (global.get $orig))))))
    (func (export "request") (call $do-read (i32.const 1)))
    (func (export "probe") (call $do-read (i32.const 0)))
    (func $do-read (param $amount i32)
      (if (global.get $ended) (then (global.set $rc (i32.const 1)) (return)))
      (global.set $rc (if (result i32) (global.get $typed)
        (then (call $read-t (global.get $r) (i32.const 32) (local.get $amount)))
        (else (call $read-s (global.get $r) (i32.const 32) (local.get $amount)))))
      (if (i32.eq (global.get $rc) (i32.const -1)) (then
        (global.set $set (call $new)) (call $join (global.get $r) (global.get $set)))))
    (func $detach (call $join (global.get $r) (i32.const 0)) (call $del (global.get $set)))
    (func (export "cancel")
      (call $eq (global.get $rc) (i32.const -1)) (call $detach)
      (call $eq (if (result i32) (global.get $typed) (then (call $cancel-t (global.get $r))) (else (call $cancel-s (global.get $r)))) (i32.const 2)))
    (func (export "collect") (param $expect i32) (result i32) (local $h i32) (local $ev i32)
      (if (i32.eq (global.get $rc) (i32.const -1)) (then
        (local.set $ev (call $poll (global.get $set) (i32.const 0))) (if (i32.eqz (local.get $ev)) (then (return (i32.const 0))))
        (call $eq (local.get $ev) (i32.const 2)) (call $eq (i32.load (i32.const 0)) (global.get $r))
        (global.set $rc (i32.load (i32.const 4))) (call $detach)))
      (global.set $ended (i32.and (global.get $rc) (i32.const 1)))
      (if (i32.eq (local.get $expect) (i32.const 3)) (then (call $eq (global.get $rc) (i32.const 0)) (return (i32.const 1))))
      (if (i32.eq (local.get $expect) (i32.const 2)) (then (call $eq (global.get $rc) (i32.const 1)) (return (i32.const 1))))
      (call $eq (i32.shr_u (global.get $rc) (i32.const 4)) (i32.const 1))
      (if (global.get $typed) (then (call $eq (i32.load8_u (i32.const 32)) (local.get $expect)) (local.set $h (i32.load (i32.const 36))))
        (else (call $eq (local.get $expect) (i32.const 0)) (local.set $h (i32.load (i32.const 32)))))
      (call $eq (call $same (global.get $orig) (local.get $h)) (i32.const 1)) (call $box (local.get $h)) (i32.const 1))
    (func (export "finish")
      (if (global.get $typed) (then (call $drop-t (global.get $r))) (else (call $drop-s (global.get $r))))
      (call $box (global.get $orig))))
  (core instance $i (instantiate $client (with "" (instance (export "m" (memory $mem "m"))
    (export "source" (func $source)) (export "same" (func $same)) (export "finite" (func $finite)) (export "series" (func $series))
    (export "read-s" (func $read-s)) (export "read-t" (func $read-t)) (export "cancel-s" (func $cancel-s)) (export "cancel-t" (func $cancel-t))
    (export "drop-s" (func $drop-s)) (export "drop-t" (func $drop-t)) (export "new" (func $new)) (export "join" (func $join))
    (export "poll" (func $poll)) (export "del" (func $del)) (export "box" (func $box))))))
  (func (export "start") (param "kind" u32) (canon lift (core func $i "start")))
  (func (export "request") (canon lift (core func $i "request")))
  (func (export "probe") (canon lift (core func $i "probe")))
  (func (export "cancel") (canon lift (core func $i "cancel")))
  (func (export "collect") (param "expect" u32) (result bool) (canon lift (core func $i "collect")))
  (func (export "finish") (canon lift (core func $i "finish"))))
