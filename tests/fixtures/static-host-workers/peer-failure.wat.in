;; Workshop's callback calls Gauge.read on the original box. Gauge raises
;; a guest-owned member error. Its defining guest counts creation and drop.
(component
  (import "@OBJECTS@" (instance $o (export "box" (type $b (sub resource)))
    (export "member-error" (type $e (sub resource)))
    (export "[static]box.create" (func (param "value" u32) (result (result (own $b) (error (own $e))))))
    (export "[method]box.get-level" (func (param "self" (borrow $b)) (result (result u32 (error (own $e))))))))
  (alias export $o "box" (type $b)) (alias export $o "member-error" (type $e))
  (import "lean-bridge:workshop/callbacks@1.0.0" (instance $cb (export "call-box-to-box" (type $c (sub resource)))
    (export "[static]call-box-to-box.make" (func (param "mode" u32) (result (own $c))))))
  (alias export $cb "call-box-to-box" (type $c))
  (import "lean-bridge:workshop/object-tasks@1.0.0" (instance $jobs
    (export "box" (type $bi (eq $b))) (export "member-error" (type $ei (eq $e)))
    (export "call-box-to-box" (type $ci (eq $c)))
    (type $v (variant (case "callback" (own $ei)) (case "io" string))) (export "callback-failure" (type $err (eq $v)))
    (type $t (future (result (own $bi) (error $err))))
    (export "relay" (func (param "box" (borrow $bi)) (param "f" (borrow $ci)) (result $t)))))
  (alias export $jobs "callback-failure" (type $err))
  (type $t (future (result (own $b) (error $err))))
  (core module $mem (memory (export "m") 1) (func (export "alloc") (param i32 i32 i32 i32) (result i32) unreachable))
  (core instance $m (instantiate $mem))
  (core func $make (canon lower (func $o "[static]box.create") (memory $m "m")))
  (core func $level (canon lower (func $o "[method]box.get-level") (memory $m "m")))
  (core func $register (canon lower (func $cb "[static]call-box-to-box.make")))
  (core func $relay (canon lower (func $jobs "relay")))
  (core func $read (canon future.read $t async (memory $m "m") (realloc (func $m "alloc"))))
  (core func $df (canon future.drop-readable $t)) (core func $db (canon resource.drop $b))
  (core func $de (canon resource.drop $e)) (core func $dc (canon resource.drop $c))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join)) (core func $del (canon waitable-set.drop))
  (core func $return (canon task.return (result s64)))
  (core module $code (import "" "m" (memory 1))
    (import "" "make" (func $make (param i32 i32))) (import "" "level" (func $level (param i32 i32)))
    (import "" "register" (func $register (param i32) (result i32))) (import "" "relay" (func $relay (param i32 i32) (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32))) (import "" "df" (func $df (param i32)))
    (import "" "db" (func $db (param i32))) (import "" "de" (func $de (param i32))) (import "" "dc" (func $dc (param i32)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32))) (import "" "return" (func $return (param i64)))
    (global $s (mut i32) (i32.const 0)) (global $f (mut i32) (i32.const 0)) (global $observer (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $box (param $n i32) (result i32)
      (call $make (local.get $n) (i32.const 0)) (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (i32.load (i32.const 4)))
    (func $counts (result i32)
      (call $level (global.get $observer) (i32.const 16)) (call $eq (i32.load8_u (i32.const 16)) (i32.const 0)) (i32.load (i32.const 20)))
    (func (export "run") (result i32) (local $box i32) (local $cb i32)
      (global.set $observer (call $box (i32.const 77777))) (call $eq (call $counts) (i32.const 0))
      (local.set $box (call $box (i32.const 64206))) (local.set $cb (call $register (i32.const 1)))
      (global.set $f (call $relay (local.get $box) (local.get $cb))) (call $dc (local.get $cb)) (call $db (local.get $box))
      (call $eq (call $read (global.get $f) (i32.const 48)) (i32.const -1))
      (global.set $s (call $set)) (call $join (global.get $f) (global.get $s))
      (i32.or (i32.const 2) (i32.shl (global.get $s) (i32.const 4))))
    (func (export "cb") (param $ev i32) (param $id i32) (param $rc i32) (result i32) (local $n i32)
      (call $eq (local.get $id) (global.get $f)) (call $eq (local.get $ev) (i32.const 4)) (call $eq (local.get $rc) (i32.const 0))
      ;; result.error(callback(own<member-error>)); no string conversion or success substitution.
      (call $eq (i32.load8_u (i32.const 48)) (i32.const 1)) (call $eq (i32.load8_u (i32.const 52)) (i32.const 0))
      (call $eq (call $counts) (i32.const 65536)) (call $de (i32.load (i32.const 56)))
      (call $df (global.get $f)) (call $del (global.get $s)) (local.set $n (call $counts))
      (call $eq (local.get $n) (i32.const 65537)) (call $db (global.get $observer)) (call $return (i64.extend_i32_u (local.get $n))) (i32.const 0)))
  (core instance $i (instantiate $code (with "" (instance (export "m" (memory $m "m"))
    (export "make" (func $make)) (export "level" (func $level)) (export "register" (func $register)) (export "relay" (func $relay))
    (export "read" (func $read)) (export "df" (func $df)) (export "de" (func $de)) (export "db" (func $db)) (export "dc" (func $dc))
    (export "set" (func $set)) (export "join" (func $join)) (export "del" (func $del)) (export "return" (func $return))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
