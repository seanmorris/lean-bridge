  @MEMBERS@
  (instance $mi (instantiate $member-code (with "@OBJECTS@" (instance $obj)) (with "leases" (instance $vault))))
  (component $driver
    (import "objects" (instance $o (export "box" (type $b (sub resource)))
      (export "member-error" (type $e (sub resource)))))
    (import "set" (func $write (param "self" u64) (param "value" u32) (result (result (error u64)))))
    (import "get" (func $read (param "self" u64) (result (result u32 (error u64)))))
    (alias export $o "box" (type $b)) (alias export $o "member-error" (type $e))
    (import "turn" (func $turn (param "frame" u64) (param "owner" u64) (result (tuple u64 u64))))
    (import "leases" (instance $v
      (export "lease-k0" (func (param "value" (borrow $b)) (result u64)))
      (export "release-k0" (func (param "ticket" u64) (result bool)))
      (export "take-k1" (func (param "ticket" u64) (result (option (own $e)))))))
    (core module $mem (memory (export "m") 1)) (core instance $m (instantiate $mem))
    (core func $set (canon lower (func $write) (memory $m "m")))
    (core func $get (canon lower (func $read) (memory $m "m")))
    (core func $turn (canon lower (func $turn) (memory $m "m")))
    (core func $pin (canon lower (func $v "lease-k0")))
    (core func $unpin (canon lower (func $v "release-k0")))
    (core func $take (canon lower (func $v "take-k1") (memory $m "m")))
    (core func $release (canon resource.drop $b))
    (core module $body (import "" "m" (memory 1)) (import "" "turn" (func $turn (param i64 i64 i32)))
      (import "" "pin" (func $pin (param i32) (result i64)))
      (import "" "unpin" (func $unpin (param i64) (result i32)))
      (import "" "take" (func $take (param i64 i32)))
      (import "" "release" (func $release (param i32)))
      (import "" "set" (func $set (param i64 i32 i32))) (import "" "get" (func $get (param i64 i32)))
      (func $word (param i32 i32) (result i64)
        (i64.or (i64.shl (i64.extend_i32_u (local.get 0)) (i64.const 32)) (i64.extend_i32_u (local.get 1))))
      (func (export "update") (param $box i32) (param $value i32) (result i32)
        (local $event i64) (local $op i32) (local $error i32) (local $ticket i64) (local $original i64)
        (local.set $ticket (call $pin (local.get $box))) (call $release (local.get $box))
        (if (i64.eqz (local.get $ticket)) (then unreachable))
        (call $turn (call $word (i32.const 1) (local.get $value)) (local.get $ticket) (i32.const 32))
        ;; @inject-guest-trap@
        (loop $next
          (local.set $event (i64.load (i32.const 32)))
          (local.set $op (i32.wrap_i64 (i64.shr_u (local.get $event) (i64.const 32))))
          (if (i32.eq (local.get $op) (i32.const 4)) (then
            (if (local.get $error) (then unreachable))
            (if (i32.eqz (call $unpin (local.get $ticket))) (then unreachable))
            (i32.store8 (i32.const 0) (i32.const 0)) (i32.store (i32.const 4) (i32.wrap_i64 (local.get $event))) (return (i32.const 0))))
          (if (i32.eq (local.get $op) (i32.const 5)) (then
            (if (i32.eqz (local.get $error)) (then unreachable))
            (if (i32.eqz (call $unpin (local.get $ticket))) (then unreachable))
            (call $take (i64.load (i32.const 40)) (i32.const 0))
            (if (i32.ne (i32.load8_u (i32.const 0)) (i32.const 1)) (then unreachable))
            (return (i32.const 0))))
          (if (local.get $error) (then unreachable))
          (if (i32.eq (local.get $op) (i32.const 2))
            (then (call $set (i64.load (i32.const 40)) (i32.wrap_i64 (local.get $event)) (i32.const 0)))
            (else (if (i32.ne (local.get $op) (i32.const 3)) (then unreachable))
              (call $get (i64.load (i32.const 40)) (i32.const 0))))
          (local.set $error (i32.load8_u (i32.const 0)))
          (local.set $original (i64.load (i32.const 8)))
          (call $turn (call $word
            (select (i32.const 5) (i32.const 4) (local.get $error))
            (select (i32.const 0) (i32.load (i32.const 8)) (local.get $error))) (select (local.get $original) (i64.const 0) (local.get $error)) (i32.const 32))
          (br $next)) unreachable))
    (core instance $i (instantiate $body (with "" (instance (export "m" (memory $m "m")) (export "turn" (func $turn))
      (export "set" (func $set)) (export "get" (func $get)) (export "release" (func $release))
      (export "pin" (func $pin)) (export "unpin" (func $unpin))
      (export "take" (func $take))))))
    (func (export "update") (param "box" (borrow $b)) (param "value" u32) (result (result u32 (error (own $e))))
      (canon lift (core func $i "update") (memory $m "m"))))
  (instance $d (instantiate $driver (with "objects" (instance $obj)) (with "set" (func $mi "@SET@")) (with "get" (func $mi "@GET@")) (with "turn" (func $turn)) (with "leases" (instance $vault))))
