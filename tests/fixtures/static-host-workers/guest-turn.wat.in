;; The update is executed by compiled Lean. Only this generated-side loop can
;; see the private turn; its borrow and any original error stay in Wasm.
(component
  (import "turn" (func $turn (param "frame" u64) (result u64)))
  @OWNER@
  (instance $o (instantiate $owner))
  (alias export $o "@OBJECTS@" (instance $obj))
  (component $driver
    (import "objects" (instance $o (export "box" (type $b (sub resource)))
      (export "member-error" (type $e (sub resource)))
      (export "[method]box.set-level" (func (param "self" (borrow $b)) (param "value" u32) (result (result (error (own $e))))))
      (export "[method]box.get-level" (func (param "self" (borrow $b)) (result (result u32 (error (own $e))))))))
    (alias export $o "box" (type $b)) (alias export $o "member-error" (type $e))
    (import "turn" (func $turn (param "frame" u64) (result u64)))
    (core module $mem (memory (export "m") 1)) (core instance $m (instantiate $mem))
    (core func $set (canon lower (func $o "[method]box.set-level") (memory $m "m")))
    (core func $get (canon lower (func $o "[method]box.get-level") (memory $m "m")))
    (core func $turn (canon lower (func $turn)))
    (core func $release (canon resource.drop $b))
    (core module $body (import "" "m" (memory 1)) (import "" "turn" (func $turn (param i64) (result i64)))
      (import "" "release" (func $release (param i32)))
      (import "" "set" (func $set (param i32 i32 i32))) (import "" "get" (func $get (param i32 i32)))
      (func $word (param i32 i32) (result i64)
        (i64.or (i64.shl (i64.extend_i32_u (local.get 0)) (i64.const 32)) (i64.extend_i32_u (local.get 1))))
      (func (export "update") (param $box i32) (param $value i32) (result i32)
        (local $event i64) (local $op i32) (local $error i32)
        (local.set $event (call $turn (call $word (i32.const 1) (local.get $value))))
        ;; @inject-guest-trap@
        (loop $next
          (local.set $op (i32.wrap_i64 (i64.shr_u (local.get $event) (i64.const 32))))
          (if (i32.eq (local.get $op) (i32.const 4)) (then
            (if (local.get $error) (then unreachable))
            (call $release (local.get $box))
            (i32.store8 (i32.const 0) (i32.const 0)) (i32.store (i32.const 4) (i32.wrap_i64 (local.get $event))) (return (i32.const 0))))
          (if (i32.eq (local.get $op) (i32.const 5)) (then
            (if (i32.eqz (local.get $error)) (then unreachable)) (call $release (local.get $box)) (return (i32.const 0))))
          (if (local.get $error) (then unreachable))
          (if (i32.eq (local.get $op) (i32.const 2))
            (then (call $set (local.get $box) (i32.wrap_i64 (local.get $event)) (i32.const 0)))
            (else (if (i32.ne (local.get $op) (i32.const 3)) (then unreachable))
              (call $get (local.get $box) (i32.const 0))))
          (local.set $error (i32.load8_u (i32.const 0)))
          (local.set $event (call $turn (call $word
            (select (i32.const 5) (i32.const 4) (local.get $error))
            (select (i32.const 0) (i32.load (i32.const 4)) (local.get $error)))))
          (br $next)) unreachable))
    (core instance $i (instantiate $body (with "" (instance (export "m" (memory $m "m")) (export "turn" (func $turn))
      (export "set" (func $set)) (export "get" (func $get)) (export "release" (func $release))))))
    (func (export "update") (param "box" (borrow $b)) (param "value" u32) (result (result u32 (error (own $e))))
      (canon lift (core func $i "update") (memory $m "m"))))
  (instance $d (instantiate $driver (with "objects" (instance $obj)) (with "turn" (func $turn))))
  (component $guest
    (import "objects" (instance $o (export "box" (type $b (sub resource))) (export "member-error" (type $e (sub resource)))
      (export "[static]box.create" (func (param "value" u32) (result (result (own $b) (error (own $e))))))
      (export "[method]box.get-level" (func (param "self" (borrow $b)) (result (result u32 (error (own $e))))))))
    (alias export $o "box" (type $b)) (alias export $o "member-error" (type $e))
    (import "update" (func $update (param "box" (borrow $b)) (param "value" u32) (result (result u32 (error (own $e))))))
    (import "drops" (func $drops (result u32)))
    (core module $mem (memory (export "m") 1)) (core instance $m (instantiate $mem))
    (core func $make (canon lower (func $o "[static]box.create") (memory $m "m")))
    (core func $get (canon lower (func $o "[method]box.get-level") (memory $m "m")))
    (core func $update (canon lower (func $update) (memory $m "m")))
    (core func $drop (canon resource.drop $b)) (core func $drop-error (canon resource.drop $e))
    (core func $drops (canon lower (func $drops))) (core func $ret (canon task.return (result s64)))
    (core module $body (import "" "m" (memory 1)) (import "" "make" (func $make (param i32 i32)))
      (import "" "get" (func $get (param i32 i32))) (import "" "update" (func $update (param i32 i32 i32)))
      (import "" "drop" (func $drop (param i32))) (import "" "err" (func $err (param i32)))
      (import "" "drops" (func $drops (result i32))) (import "" "ret" (func $ret (param i64)))
      (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
      (func $ok (result i32) (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (i32.load (i32.const 4)))
      (func (export "run") (result i32) (local $a i32) (local $b i32) (local $n i32)
        (call $make (i32.const 42) (i32.const 0)) (local.set $a (call $ok))
        (call $make (i32.const 42) (i32.const 0)) (local.set $b (call $ok))
        (call $update (local.get $a) (i32.const 73) (i32.const 0)) (local.set $n (call $ok))
        (call $get (local.get $a) (i32.const 0)) (call $eq (call $ok) (local.get $n))
        (call $get (local.get $b) (i32.const 0)) (call $eq (call $ok) (i32.const 42))
        (call $update (local.get $b) (i32.const 64206) (i32.const 0)) (call $eq (i32.load8_u (i32.const 0)) (i32.const 1))
        (call $err (i32.load (i32.const 4))) (call $eq (call $drops) (i32.const 1))
        (call $get (local.get $a) (i32.const 0)) (call $eq (call $ok) (local.get $n))
        (call $drop (local.get $a)) (call $drop (local.get $b)) (call $eq (call $drops) (i32.const 3))
        (call $ret (i64.extend_i32_u (local.get $n))) (i32.const 0))
      (func (export "cb") (param i32 i32 i32) (result i32) unreachable))
    (core instance $i (instantiate $body (with "" (instance (export "m" (memory $m "m")) (export "make" (func $make))
      (export "get" (func $get)) (export "update" (func $update)) (export "drop" (func $drop)) (export "err" (func $drop-error))
      (export "drops" (func $drops)) (export "ret" (func $ret))))))
    (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
  (instance $app (instantiate $guest (with "objects" (instance $obj)) (with "update" (func $d "update")) (with "drops" (func $o "drops"))))
  (export "run" (func $app "run")))
