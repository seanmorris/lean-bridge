;; Independently compiled user application. Only public WIT imports appear:
;; it can borrow, inspect, and drop the same objects as the original guest.
(module
  (import "cm32p2|@OPS@" "first-error" (func $create (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "cursor-counts" (func $counts (result i64)))
  (import "cm32p2|@OPS@" "cursor-gate" (func $gate (param i32) (result i32)))
  (import "cm32p2|@OPS@" "update" (func $update (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "make" (func $make (param i32 i32)))
  (import "cm32p2|@OPS@" "read" (func $value (param i32 i32)))
  (import "cm32p2|@OPS@" "read-online" (func $online (param i32 i32)))
  (import "cm32p2|@OPS@" "mapped" (func $mapped (param i32 i32)))
  (import "cm32p2|@OPS@" "choose" (func $choose (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "fail-with" (func $fail (param i32 i32)))
  (import "cm32p2|@OPS@" "identity" (func $identity (param i32 i32)))
  (import "cm32p2|@OPS@" "anchored" (func $anchored (param i32 i32)))
  (import "cm32p2|@OPS@" "keep-other" (func $keep (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "take-other" (func $take (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "bytes" (func $bytes (param i32 i32 i32 i32)))
  (import "cm32p2|@OPS@" "text" (func $text (param i32 i32 i32 i32)))
  (import "cm32p2|@OPS@" "natural" (func $natural (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "shift" (func $shift (param i32 i32 i32 i32 i32)))
  (import "cm32p2|@OPS@" "pick-wide" (func $wide (param i32 i32)))
  (import "cm32p2|@IFACE@" "same-box" (func $same (param i32 i32) (result i32)))
  (import "cm32p2|@IFACE@" "box_drop" (func $drop (param i32)))
  (import "cm32p2|@IFACE@" "member-error_drop" (func $release-error (param i32)))
  (import "cm32p2|@IFACE@" "[method]member-error.message" (func $message (param i32 i32)))
  (import "cm32p2|@IFACE@" "[method]box.read" (func $read (param i32 i32)))
  (memory (export "cm32p2_memory") 1)
  ;; Each reply contains at most one live list/string, used before the next call.
  (func (export "cm32p2_realloc") (param i32 i32 i32 i32) (result i32) (i32.const 128))
  (data (i32.const 512) "meter disconnected")
  (data (i32.const 544) "host read failed")
  (data (i32.const 576) "snow \e2\98\83")
  (data (i32.const 592) "\ff\00\01\00\07")
  ;; uint32 little-endian limbs: 385 bits, including internal zero limbs.
  (data (i32.const 608) "\ff\ff\ff\ff")
  (data (i32.const 656) "\01\00\00\00")
  (func $expect (param $ok i32) (if (i32.eqz (local.get $ok)) (then unreachable)))
  (func $ok (result i32)
    (call $expect (i32.eqz (i32.load8_u (i32.const 0)))) (i32.load (i32.const 4)))
  (func $alias (param $a i32) (param $b i32)
    (call $expect (call $same (local.get $a) (local.get $b))) (call $drop (local.get $b)))
  (func (export "cm32p2||bad-input") (param $value i32)
    ;; Not a canonical Lean Int. The facade must release the temporary
    ;; guest owner it already staged before diagnosing the copied argument.
    (i32.store (i32.const 80) (i32.const 0))
    (call $shift (local.get $value) (i32.const 0) (i32.const 80) (i32.const 1) (i32.const 0))
    (call $drop (local.get $value)))
  (func $contents (param $pair i32) (param $expected i32) (param $n i32) (param $stride i32)
    (local $p i32) (local $i i32)
    (call $expect (i32.eq (i32.load offset=4 (local.get $pair)) (local.get $n)))
    (local.set $p (i32.load (local.get $pair)))
    (block $end (loop $next
      (br_if $end (i32.ge_u (local.get $i) (i32.mul (local.get $stride) (local.get $n))))
      (call $expect (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $i)))
                            (i32.load8_u (i32.add (local.get $expected) (local.get $i)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next))))
  (func (export "cm32p2||suite") (result i32) (local $a i32) (local $b i32) (local $p i32)
    (call $make (i32.const 0) (i32.const 0)) (local.set $a (call $ok))
    (call $make (i32.const 64206) (i32.const 0)) (local.set $b (call $ok))
    (call $value (local.get $a) (i32.const 0)) (call $expect (i32.eqz (call $ok)))
    (call $online (local.get $a) (i32.const 0))
    (call $expect (i32.and (i32.load8_u (i32.const 0)) (i32.load8_u (i32.const 4))))
    (call $contents (i32.const 8) (i32.const 512) (i32.const 18) (i32.const 1))
    (call $mapped (local.get $b) (i32.const 0))
    (call $expect (i32.load8_u (i32.const 0)))
    (call $contents (i32.const 4) (i32.const 544) (i32.const 16) (i32.const 1))
    (call $fail (local.get $b) (i32.const 0))
    (call $expect (i32.load8_u (i32.const 0)))
    (call $alias (local.get $b) (i32.load (i32.const 4)))
    (call $choose (local.get $a) (i32.const 1) (i32.const 0)) (call $alias (local.get $a) (call $ok))
    (call $choose (local.get $a) (i32.const 0) (i32.const 0))
    (call $expect (i32.and (i32.load8_u (i32.const 0)) (i32.eq (i32.load (i32.const 4)) (i32.const 17))))
    (call $identity (local.get $a) (i32.const 0)) (call $alias (local.get $a) (call $ok))
    (call $anchored (local.get $b) (i32.const 0)) (call $alias (local.get $b) (call $ok))
    (call $keep (local.get $a) (local.get $b) (i32.const 0)) (call $alias (local.get $b) (call $ok))
    (call $take (local.get $b) (local.get $a) (i32.const 0)) (call $alias (local.get $a) (call $ok))
    (local.set $p (i32.const 724))
    (loop $fill (i32.store (local.get $p) (i32.const 1)) (local.set $p (i32.add (local.get $p) (i32.const 4)))
      (br_if $fill (i32.lt_u (local.get $p) (i32.const 780))))
    (i32.store (i32.const 720) (local.get $a)) (i32.store (i32.const 780) (local.get $b))
    (i32.store (i32.const 784) (i32.const 9)) (call $wide (i32.const 720) (i32.const 0)) (call $alias (local.get $b) (call $ok))
    (i32.store (i32.const 784) (i32.const 8)) (call $wide (i32.const 720) (i32.const 0)) (call $alias (local.get $a) (call $ok))
    (call $bytes (local.get $a) (i32.const 592) (i32.const 5) (i32.const 0)) (drop (call $ok))
    (call $contents (i32.const 4) (i32.const 592) (i32.const 5) (i32.const 1))
    (call $text (local.get $b) (i32.const 576) (i32.const 8) (i32.const 0)) (drop (call $ok))
    (call $contents (i32.const 4) (i32.const 576) (i32.const 8) (i32.const 1))
    (call $natural (i32.const 608) (i32.const 13) (i32.const 0)) (drop (call $ok))
    (call $contents (i32.const 4) (i32.const 608) (i32.const 13) (i32.const 4))
    (call $shift (local.get $b) (i32.const 1) (i32.const 608) (i32.const 13) (i32.const 0)) (drop (call $ok))
    (call $expect (i32.load8_u (i32.const 4)))
    (call $contents (i32.const 8) (i32.const 608) (i32.const 13) (i32.const 4))
    (call $drop (local.get $b)) (call $drop (local.get $a)) (i32.const 1))
  (func (export "cm32p2||exercise") (param $seed i32) (param $next i32) (result i32) (local $v i32)
    (call $create (local.get $seed) (local.get $next) (i32.const 0))
    (local.set $v (i32.load (i32.const 4)))
    (if (i32.load8_u (i32.const 0)) (then
      (if (i32.load8_u (i32.const 4)) (then unreachable))
      (local.set $v (i32.load (i32.const 8)))
      (call $message (local.get $v) (i32.const 16))
      (call $release-error (local.get $v))
      (if (i32.ne (i32.load (i32.const 20)) (i32.const 11)) (then unreachable))
      (return (i32.load8_u (i32.load (i32.const 16))))))
    (call $update (local.get $v) (local.get $next) (i32.const 0))
    (if (i32.or (i32.load8_u (i32.const 0)) (i32.ne (i32.load (i32.const 4)) (local.get $next))) (then unreachable))
    (call $read (local.get $v) (i32.const 0))
    (if (i32.load8_u (i32.const 0)) (then unreachable))
    (call $drop (local.get $v))
    (i32.load (i32.const 4))))
