;; Compiled independently of the producer. The source supplies an original
;; guest object; neither it nor the returned object is a numeric ticket.
(component
  (import "@TASKS@" (instance $tasks
    (export "box" (type $nominal (sub resource)))
    (export "echo" (func (param "box" (borrow $nominal)) (result (future (own $nominal)))))))
  (alias export $tasks "box" (type $box))
  (alias export $tasks "echo" (func $echo))
  (type $f (future (own $box)))
  (import "source" (func $source (result (own $box))))
  (import "same" (func $same (param "left" (borrow $box)) (param "right" (borrow $box)) (result bool)))
  (core module $memory (memory (export "m") 1))
  (core instance $mem (instantiate $memory))
  (core func $source (canon lower (func $source)))
  (core func $echo (canon lower (func $echo)))
  (core func $same (canon lower (func $same)))
  (core func $read (canon future.read $f async (memory $mem "m")))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $poll (canon waitable-set.poll (memory $mem "m")))
  (core func $del (canon waitable-set.drop))
  (core func $drop (canon future.drop-readable $f))
  (core func $release (canon resource.drop $box))
  (core module $m
    (import "" "m" (memory 1))
    (import "" "source" (func $source (result i32)))
    (import "" "echo" (func $echo (param i32) (result i32)))
    (import "" "same" (func $same (param i32 i32) (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32)))
    (import "" "new-set" (func $new-set (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "poll" (func $poll (param i32 i32) (result i32)))
    (import "" "del" (func $del (param i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "release" (func $release (param i32)))
    (global $reader (mut i32) (i32.const 0)) (global $original (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (func (export "start")
      (global.set $original (call $source)) (global.set $reader (call $echo (global.get $original))))
    (func $discard (export "discard") (call $drop (global.get $reader)) (call $release (global.get $original)))
    (func (export "release-original") (call $release (global.get $original)))
    (func (export "request")
      (if (i32.ne (call $read (global.get $reader) (i32.const 16)) (i32.const -1)) (then unreachable))
      (global.set $set (call $new-set)) (call $join (global.get $reader) (global.get $set)))
    (func (export "collect") (result i32)
      (if (i32.ne (call $poll (global.get $set) (i32.const 32)) (i32.const 4)) (then unreachable))
      (if (i32.or (i32.ne (i32.load (i32.const 32)) (global.get $reader)) (i32.load (i32.const 36))) (then unreachable))
      (call $join (global.get $reader) (i32.const 0)) (call $del (global.get $set)) (call $check))
    (func (export "receive") (result i32)
      (if (call $read (global.get $reader) (i32.const 16)) (then unreachable)) (call $check))
    (func $check (result i32) (local $same-object i32)
      (local.set $same-object (call $same (global.get $original) (i32.load (i32.const 16))))
      (call $release (i32.load (i32.const 16))) (call $discard) (local.get $same-object)))
  (core instance $i (instantiate $m (with "" (instance (export "m" (memory $mem "m"))
    (export "source" (func $source)) (export "echo" (func $echo)) (export "same" (func $same))
    (export "new-set" (func $new-set)) (export "join" (func $join)) (export "poll" (func $poll)) (export "del" (func $del))
    (export "read" (func $read)) (export "drop" (func $drop)) (export "release" (func $release))))))
  (func (export "start") (canon lift (core func $i "start")))
  (func (export "discard") (canon lift (core func $i "discard")))
  (func (export "release-original") (canon lift (core func $i "release-original")))
  (func (export "request") (canon lift (core func $i "request")))
  (func (export "collect") (result bool) (canon lift (core func $i "collect")))
  (func (export "receive") (result bool) (canon lift (core func $i "receive"))))
