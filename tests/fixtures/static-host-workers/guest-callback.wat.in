;; The defining Wasm guest stores a registration identity and behavior.
;; Its successful callback re-enters the compiled Lean API to mutate the box.
(module
  (import "cm32p2|_ex_@CALLS@" "call-box-to-box_new" (func $new (param i32) (result i32)))
  (import "cm32p2|@IFACE@" "retain-box" (func $retain (param i32) (result i32)))
  (import "cm32p2|@IFACE@" "box_drop" (func $end (param i32)))
  (import "cm32p2|@IFACE@" "[static]box.create" (func $create (param i32 i32)))
  (import "cm32p2|@OPS@" "update" (func $update (param i32 i32 i32)))
  (import "cm32p2" "inside-callback" (func $inside))
  (memory (export "cm32p2_memory") 1)
  ;; Lean update's error type admits a string, though this fixture returns
  ;; an object on error. Reserve bounded canonical storage for that import.
  (global $top (mut i32) (i32.const 256))
  (func (export "cm32p2_realloc") (param $old i32) (param $len i32) (param $align i32) (param $size i32) (result i32) (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $top) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
    (if (i32.gt_u (local.get $size) (i32.sub (i32.const 65536) (local.get $p))) (then unreachable))
    (global.set $top (i32.add (local.get $p) (local.get $size)))
    (if (local.get $old) (then (memory.copy (local.get $p) (local.get $old) (select (local.get $size) (local.get $len) (i32.lt_u (local.get $size) (local.get $len))))))
    (local.get $p))
  (global $next (mut i32) (i32.const 4)) (global $drops (mut i32) (i32.const 0))
  (global $visits (mut i32) (i32.const 0))
  (func (export "cm32p2|@CALLS@|[static]call-box-to-box.make") (param i32) (result i32)
    (global.set $next (i32.add (global.get $next) (i32.const 4)))
    (call $new (i32.or (global.get $next) (local.get 0))))
  (func (export "cm32p2|@CALLS@|retain-call-box-to-box") (param i32) (result i32) (call $new (local.get 0)))
  (func (export "cm32p2|@CALLS@|same-call-box-to-box") (param i32 i32) (result i32) (i32.eq (local.get 0) (local.get 1)))
  (func (export "cm32p2|@CALLS@|call-box-to-box_dtor") (param i32)
    (global.set $drops (i32.add (global.get $drops) (i32.const 1))))
  (func (export "cm32p2||callback-drops") (result i32) (global.get $drops))
  (func (export "cm32p2||callback-visits") (result i32) (global.get $visits))
  (func (export "cm32p2|@CALLS@|[method]call-box-to-box.invoke") (param $self i32) (param $box i32) (result i32)
    (global.set $visits (i32.add (global.get $visits) (i32.const 1))) (call $inside)
    (if (i32.and (local.get $self) (i32.const 1))
      (then (call $create (i32.const -2) (i32.const 16))
        (if (i32.ne (i32.load8_u (i32.const 16)) (i32.const 1)) (then unreachable)))
      (else
        (call $update (local.get $box) (i32.const 73) (i32.const 16))
        (if (i32.or (i32.load8_u (i32.const 16)) (i32.ne (i32.load (i32.const 20)) (i32.const 73))) (then unreachable))
        (i32.store (i32.const 20) (call $retain (local.get $box)))))
    (call $end (local.get $box)) (i32.const 16)))
