;; One live registration. Its two owned captures stay alive until the last
;; registration alias is dropped. Only the defining guest compares box identity.
(module
  (import "cm32p2|_ex_@CALLS@" "call-box-to-box_new" (func $new (param i32) (result i32)))
  (import "cm32p2|@OBJECTS@" "same-box" (func $same (param i32 i32) (result i32)))
  (import "cm32p2|@OBJECTS@" "retain-box" (func $retain (param i32) (result i32)))
  (import "cm32p2|@OBJECTS@" "box_drop" (func $drop (param i32)))
  (memory (export "cm32p2_memory") 1)
  (global $refs (mut i32) (i32.const 0))
  (global $input (mut i32) (i32.const 0))
  (global $reply (mut i32) (i32.const 0))
  (global $released (mut i32) (i32.const 0))
  (func (export "cm32p2|@CALLS@|[static]call-box-to-box.capture") (param $a i32) (param $b i32) (result i32)
    (if (global.get $refs) (then unreachable))
    (if (call $same (local.get $a) (local.get $b)) (then unreachable))
    (global.set $input (local.get $a)) (global.set $reply (local.get $b))
    (global.set $refs (i32.const 1)) (call $new (i32.const 1)))
  (func (export "cm32p2|@CALLS@|retain-call-box-to-box") (param $self i32) (result i32)
    (if (i32.eqz (global.get $refs)) (then unreachable))
    (global.set $refs (i32.add (global.get $refs) (i32.const 1))) (call $new (local.get $self)))
  (func (export "cm32p2|@CALLS@|same-call-box-to-box") (param i32 i32) (result i32) (i32.eq (local.get 0) (local.get 1)))
  (func (export "cm32p2|@CALLS@|[method]call-box-to-box.invoke") (param i32) (param $arg i32) (result i32)
    (if (i32.eqz (call $same (local.get $arg) (global.get $input))) (then unreachable))
    (call $drop (local.get $arg))
    (i32.store8 (i32.const 0) (i32.const 0))
    (i32.store (i32.const 4) (call $retain (global.get @RETURNED_BOX@))) (i32.const 0))
  (func (export "cm32p2|@CALLS@|call-box-to-box_dtor") (param i32)
    (if (i32.eqz (global.get $refs)) (then unreachable))
    (global.set $refs (i32.sub (global.get $refs) (i32.const 1)))
    (if (i32.eqz (global.get $refs)) (then (call $drop (global.get $input)) (call $drop (global.get $reply))
      (global.set $released (i32.add (global.get $released) (i32.const 2))))))
  (func (export "cm32p2|@CALLS@|released-captures") (result i32) (global.get $released)))
