;; Typed facade under test. Neither consumers nor the embedding get access
;; to an object's representation. The exchange is a distinct, inactive
;; component when the native operation reenters the guest object provider.
(module
  (import "cm32p2" "dispatch-create" (func $create (param i32 i32) (result i32)))
  (import "cm32p2" "dispatch-update" (func $update (param i32 i32)))
  (import "cm32p2|@IFACE@" "retain-box" (func $retain (param i32) (result i32)))
  (import "cm32p2|@IFACE@" "box_drop" (func $end (param i32)))
  (import "cm32p2|@EXCHANGE@" "put-item0" (func $put (param i32)))
  (import "cm32p2|@EXCHANGE@" "take-item0" (func $box (result i32)))
  (import "cm32p2|@EXCHANGE@" "take-item1" (func $error (result i32)))
  (memory (export "cm32p2_memory") 1)
  (func (export "cm32p2|@OPS@|first-error") (param $a i32) (param $b i32) (result i32)
    (if (call $create (local.get $a) (local.get $b))
      (then (i32.store8 (i32.const 0) (i32.const 0)) (i32.store (i32.const 4) (call $box)))
      (else (i32.store8 (i32.const 0) (i32.const 1)) (i32.store (i32.const 4) (call $error))))
    (i32.const 0))
  (func (export "cm32p2|@OPS@|update") (param $borrow i32) (param $n i32) (result i32)
    (call $put (call $retain (local.get $borrow)))
    (call $end (local.get $borrow))
    (call $update (local.get $n) (i32.const 0))
    (if (i32.load8_u (i32.const 0)) (then (i32.store (i32.const 4) (call $error))))
    (i32.const 0)))
