
namespace Jobs
open LeanBridge.Host.C

def handoff (b : Box) (lookup : Box → IO Dial) (read : Dial → IO UInt32) :
    BaseIO (Task (Except IO.Error UInt32)) := IO.asTask do read (← lookup b)
def signedEcho (v : Int16) : Task Int16 := Task.pure v
def largeResult (v : Int) : Task (Except UInt8 Int) := Task.pure (.ok v)
def withBuffer (dial : Dial) (b : ByteArray) : Task ByteArray :=
  let _ := dial
  Task.pure b
def twice (b : Box) (f : Box → IO Box) : BaseIO (Task (Except IO.Error Box)) :=
  IO.asTask do f (← f b)
def prepareIO (b : Box) (fail : Bool) : IO (Task Box) := do
  if fail then throw (IO.userError "factory IO")
  return Task.pure b
def lateIO (b : Box) (fail : Bool) : BaseIO (Task (Except IO.Error Box)) :=
  IO.asTask do if fail then throw (IO.userError "late IO") else return b
def checkedRelay (b : Box) (fail : Bool) (f : Box → IO Box) : EIO Box (Task (Except IO.Error Box)) := do
  if fail then throw b
  IO.asTask (f b)
def finite (b : Box) : BaseIO Cursor := series b
def nextFinite (c : Cursor) : BaseIO (Task (Option Box)) := BaseIO.asTask do
  return if ← c.first.swap false then some c.box else none
def closeFinite (c : Cursor) : BaseIO Unit := close c
def broken (b : Box) : BaseIO Cursor := series b
def nextBroken (_ : Cursor) : BaseIO (Task (Except IO.Error (Option Box))) :=
  IO.asTask (throw (IO.userError "step IO"))
def closeBroken (c : Cursor) : BaseIO Unit := close c
initialize parked : IO.Ref (Option (IO.Promise UInt32)) ← IO.mkRef none
def dormant : BaseIO (Task UInt32) := do
  let p ← IO.Promise.new
  parked.set (some p)
  return p.result?.map fun n => n.getD 0
end Jobs
