;; Hold a copied future pending until an independently owned object arrives.
(component
  (import "@OBJECTS@" (instance $objects (export "box" (type $b (sub resource)))
    (export "member-error" (type $e (sub resource)))
    (export "[static]box.create" (func (param "value" u32) (result (result (own $b) (error (own $e))))))
    (export "same-box" (func (param "left" (borrow $b)) (param "right" (borrow $b)) (result bool)))))
  (alias export $objects "box" (type $b))
  (type $bytes (list u8)) (type $item (result $bytes (error $bytes))) (type $f (future $item))
  (type $object (future (own $b)))
  (import "lean-bridge:workshop/api@1.0.0" (instance $api (export "release" (func (param "slot" u32) (result bool)))))
  (import "lean-bridge:workshop/object-tasks@1.0.0" (instance $jobs (export "box" (type $box (eq $b)))
    (export "echo" (func (param "box" (borrow $box)) (result (future (own $box)))))
    (export "packet" (func (param "slot" u32) (param "mode" u8) (param "left" $bytes) (param "right" $bytes) (result (result $f (error $bytes)))))))
  (core module $heap (memory (export "m") 1)
    ;; There is one non-empty incoming byte array in this successful execution.
    (func (export "alloc") (param i32 i32 i32 i32) (result i32)
      (if (i32.ne (local.get 3) (i32.const 1)) (then unreachable)) (i32.const 96)))
  (core instance $h (instantiate $heap))
  (core func $packet (canon lower (func $jobs "packet") (memory $h "m") (realloc (func $h "alloc"))))
  (core func $echo (canon lower (func $jobs "echo"))) (core func $gate (canon lower (func $api "release")))
  (core func $make (canon lower (func $objects "[static]box.create") (memory $h "m")))
  (core func $same (canon lower (func $objects "same-box"))) (core func $drop (canon resource.drop $b))
  (core func $ro (canon future.read $object async (memory $h "m"))) (core func $do (canon future.drop-readable $object))
  (core func $rb (canon future.read $f async (memory $h "m") (realloc (func $h "alloc")))) (core func $db (canon future.drop-readable $f))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join)) (core func $del (canon waitable-set.drop))
  (core func $ret (canon task.return (result s64)))
  (core module $app (import "" "m" (memory 1))
    (import "" "packet" (func $packet (param i32 i32 i32 i32 i32 i32 i32)))
    (import "" "echo" (func $echo (param i32) (result i32))) (import "" "gate" (func $gate (param i32) (result i32)))
    (import "" "make" (func $make (param i32 i32))) (import "" "same" (func $same (param i32 i32) (result i32)))
    (import "" "drop" (func $drop (param i32))) (import "" "do" (func $do (param i32))) (import "" "db" (func $db (param i32)))
    (import "" "ro" (func $ro (param i32 i32) (result i32))) (import "" "rb" (func $rb (param i32 i32) (result i32)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32))) (import "" "ret" (func $ret (param i64)))
    (global $o (mut i32) (i32.const 0)) (global $b (mut i32) (i32.const 0)) (global $wait (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $park (param i32) (result i32) (call $join (local.get 0) (global.get $wait))
      (i32.or (i32.const 2) (i32.shl (global.get $wait) (i32.const 4))))
    (func $object-ready (result i32)
      (call $eq (call $same (i32.load (i32.const 4)) (i32.load (i32.const 16))) (i32.const 1))
      (call $drop (i32.load (i32.const 4))) (call $drop (i32.load (i32.const 16))) (call $do (global.get $o))
      ;; The packet must still be pending, and only this gate can release it.
      (call $eq (call $rb (global.get $b) (i32.const 32)) (i32.const -1))
      (call $eq (call $gate (i32.const 77)) (i32.const 1)) (call $park (global.get $b)))
    (func (export "run") (result i32) (local $s i32)
      (i32.store8 (i32.const 88) (i32.const 253))
      (call $packet (i32.const 77) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 88) (i32.const 1) (i32.const 32))
      (call $eq (i32.load8_u (i32.const 32)) (i32.const 0)) (global.set $b (i32.load (i32.const 36)))
      (i32.store8 (i32.const 88) (i32.const 0)) (call $make (i32.const 83) (i32.const 0))
      (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (global.set $o (call $echo (i32.load (i32.const 4))))
      (global.set $wait (call $set)) (local.set $s (call $ro (global.get $o) (i32.const 16)))
      (if (i32.eqz (local.get $s)) (then (return (call $object-ready))))
      (call $eq (local.get $s) (i32.const -1)) (call $park (global.get $o)))
    (func (export "resume") (param $ev i32) (param $id i32) (param $rc i32) (result i32)
      (call $eq (local.get $ev) (i32.const 4)) (call $eq (local.get $rc) (i32.const 0))
      (if (i32.eq (local.get $id) (global.get $o)) (then (return (call $object-ready))))
      (call $eq (local.get $id) (global.get $b)) (call $eq (i32.load8_u (i32.const 32)) (i32.const 1))
      (call $eq (i32.load (i32.const 40)) (i32.const 1))
      (call $db (global.get $b)) (call $del (global.get $wait))
      (call $ret (i64.load8_u (i32.load (i32.const 36)))) (i32.const 0)))
  (core instance $a (instantiate $app (with "" (instance (export "m" (memory $h "m"))
    (export "packet" (func $packet)) (export "echo" (func $echo)) (export "gate" (func $gate)) (export "make" (func $make))
    (export "same" (func $same)) (export "drop" (func $drop)) (export "do" (func $do)) (export "db" (func $db))
    (export "ro" (func $ro)) (export "rb" (func $rb)) (export "set" (func $set)) (export "join" (func $join))
    (export "del" (func $del)) (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $a "run") async (callback (func $a "resume")))))
