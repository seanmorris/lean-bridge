namespace Jobs
open LeanBridge.Host.WitWasi

-- Same types as reject and outcome, but the factory / returned Except succeed.
def accept (box : Box) : EIO Box (Task UInt32) :=
  let _ := box
  pure (Task.pure 4294967295)
def completed (box : Box) : Task (Except Box UInt32) :=
  let _ := box
  Task.pure (.ok 0)

-- A caught guest exception is *not* the terminal error of this task.
def relayLate (box : Box) (f : Box → IO Box) : BaseIO (Task (Except IO.Error Box)) :=
  IO.asTask do
    try
      let _ ← f box
    catch _ => pure ()
    throw (IO.userError "late λ")

def finite (box : Box) : BaseIO Cursor := series box
initialize finitePulls : IO.Ref UInt32 ← IO.mkRef 0
initialize finiteCloses : IO.Ref UInt32 ← IO.mkRef 0
initialize finiteGate : IO.Ref (Option (IO.Promise Bool)) ← IO.mkRef none
def cursorCounts : BaseIO UInt64 := do
  return (← finitePulls.get).toUInt64 * 4294967296 + (← finiteCloses.get).toUInt64
def cursorGate (hold : Bool) : BaseIO UInt32 := do
  if let some gate ← finiteGate.swap none then gate.resolve true
  if hold then finiteGate.set (some (← IO.Promise.new))
  return 0
def nextFinite (c : Cursor) : BaseIO (Task (Option Box)) := do
  finitePulls.modify (· + 1)
  let value := if (← c.first.swap false) then some c.box else none
  if let some gate ← finiteGate.get then return gate.result?.map (fun _ => value)
  return Task.pure value
def closeFinite (c : Cursor) : BaseIO Unit := do
  finiteCloses.modify (· + 1)
  close c

end Jobs
