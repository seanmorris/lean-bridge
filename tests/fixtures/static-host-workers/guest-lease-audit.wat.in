;; Run against the defining guest, never a host-created stand-in. Inspect
;; destructor deltas rather than relying on the bridge's own row count alone.
(component $audit
  (import "objects" (instance $o (export "box" (type $b (sub resource))) (export "member-error" (type $e (sub resource)))
    (export "[static]box.create" (func (param "value" u32) (result (result (own $b) (error (own $e))))))))
  (alias export $o "box" (type $b))
  (import "vault" (instance $v
    (export "hold-k0" (func (param "value" (own $b)) (result u64)))
    (export "lease-k0" (func (param "value" (borrow $b)) (result u64)))
    (export "take-k0" (func (param "ticket" u64) (result (option (own $b)))))
    (export "same-k0" (func (param "ticket" u64) (param "other" u64) (result bool)))
    (export "release-k0" (func (param "ticket" u64) (result bool)))
    (export "release-k1" (func (param "ticket" u64) (result bool)))
    (export "close" (func)) (export "count" (func (result u32)))))
  (import "foreign" (instance $f (export "lease-k0" (func (param "value" (borrow $b)) (result u64)))
    (export "release-k0" (func (param "ticket" u64) (result bool)))))
  (import "drops" (func $drops (result u32)))
  (core module $mem (memory (export "m") 1)) (core instance $m (instantiate $mem))
  (core func $make (canon lower (func $o "[static]box.create") (memory $m "m")))
  (core func $hold (canon lower (func $v "hold-k0"))) (core func $lease (canon lower (func $v "lease-k0")))
  (core func $foreign (canon lower (func $f "lease-k0"))) (core func $frelease (canon lower (func $f "release-k0")))
  (core func $take (canon lower (func $v "take-k0") (memory $m "m")))
  (core func $same (canon lower (func $v "same-k0"))) (core func $release (canon lower (func $v "release-k0")))
  (core func $wrong (canon lower (func $v "release-k1"))) (core func $drop (canon resource.drop $b))
  (core func $close (canon lower (func $v "close"))) (core func $count (canon lower (func $v "count")))
  (core func $drops (canon lower (func $drops)))
  (core module $body (import "" "m" (memory 1)) (import "" "make" (func $make (param i32 i32)))
    (import "" "hold" (func $hold (param i32) (result i64))) (import "" "lease" (func $lease (param i32) (result i64)))
    (import "" "foreign" (func $foreign (param i32) (result i64))) (import "" "frelease" (func $frelease (param i64) (result i32)))
    (import "" "take" (func $take (param i64 i32))) (import "" "same" (func $same (param i64 i64) (result i32)))
    (import "" "release" (func $release (param i64) (result i32))) (import "" "wrong" (func $wrong (param i64) (result i32)))
    (import "" "drop" (func $drop (param i32))) (import "" "close" (func $close)) (import "" "count" (func $count (result i32)))
    (import "" "drops" (func $drops (result i32)))
    (func $expect (param i32) (if (i32.eqz (local.get 0)) (then unreachable)))
    (func $new (result i32) (call $make (i32.const 7) (i32.const 0))
      (call $expect (i32.eqz (i32.load8_u (i32.const 0)))) (i32.load (i32.const 4)))
    (func (export "audit") (result i32)
      (local $a i32) (local $base i32) (local $x i64) (local $y i64) (local $z i64) (local $f i64) (local $i i32)
      (local.set $base (call $drops)) (local.set $a (call $new))
      (local.set $x (call $lease (local.get $a))) (local.set $y (call $lease (local.get $a)))
      (local.set $z (call $hold (call $new))) (local.set $f (call $foreign (local.get $a)))
      (call $expect (i64.ne (local.get $x) (local.get $y))) (call $expect (call $same (local.get $x) (local.get $y)))
      (call $expect (i32.eqz (call $same (local.get $x) (local.get $z))))
      (call $expect (i32.eqz (call $wrong (local.get $x)))) (call $expect (i32.eqz (call $release (local.get $f))))
      (call $expect (i32.eqz (call $frelease (local.get $x)))) (call $expect (call $frelease (local.get $f)))
      (call $take (local.get $x) (i32.const 0)) (call $expect (i32.load8_u (i32.const 0))) (call $drop (i32.load (i32.const 4)))
      (call $take (local.get $x) (i32.const 0)) (call $expect (i32.eqz (i32.load8_u (i32.const 0))))
      (call $expect (i32.eqz (call $release (local.get $x)))) (call $expect (call $release (local.get $z)))
      (call $expect (call $release (local.get $y))) (call $expect (i32.eqz (call $count)))
      (loop $fill (call $expect (i64.ne (call $lease (local.get $a)) (i64.const 0)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $fill (i32.lt_u (local.get $i) (i32.const 64))))
      (call $expect (i32.eq (call $count) (i32.const 64)))
      (call $expect (i64.eqz (call $hold (call $new)))) (call $expect (i32.eqz (call $release (local.get $x))))
      (call $expect (i32.eq (i32.sub (call $drops) (local.get $base)) (i32.const 5)))
      (call $close) (call $close) (call $drop (local.get $a)) (call $expect (i32.eqz (call $count)))
      (i32.eq (i32.sub (call $drops) (local.get $base)) (i32.const 70))))
  (core instance $i (instantiate $body (with "" (instance (export "m" (memory $m "m"))
    (export "make" (func $make)) (export "hold" (func $hold)) (export "lease" (func $lease))
    (export "foreign" (func $foreign)) (export "frelease" (func $frelease)) (export "take" (func $take))
    (export "same" (func $same)) (export "release" (func $release)) (export "wrong" (func $wrong))
    (export "drop" (func $drop)) (export "close" (func $close)) (export "count" (func $count)) (export "drops" (func $drops))))))
  (func (export "audit") (result bool) (canon lift (core func $i "audit"))))
