  (import "cm32p2|@OPS@" "remember" (func $remember (param i32 i32)))
  (import "cm32p2|@OPS@" "[method]remember-function.invoke" (func $invoke-fn (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "[method]remember-function.close" (func $close-fn (param i32)))
  (import "cm32p2|@OPS@" "remember-function_drop" (func $drop-fn (param i32)))
  (import "cm32p2|@OPS@" "reader" (func $reader (param i32 i32)))
  (import "cm32p2|@OPS@" "[method]reader-function.invoke" (func $read-fn (param i32 i32 i32)))
  (import "cm32p2|@OPS@" "reader-function_drop" (func $drop-reader (param i32)))
;; @functions@
  (func $check-functions (local $a i32) (local $b i32) (local $bad i32)
    (local $fn i32) (local $new i32) (local $answer i32) (local $scalar i32)
    (call $guest-box (i32.const 12) (i32.const 0)) (local.set $a (call $ok))
    (call $guest-box (i32.const 16) (i32.const 0)) (local.set $b (call $ok))
    (call $guest-box (i32.const 64206) (i32.const 0)) (local.set $bad (call $ok))
    (call $remember (local.get $bad) (i32.const 0))
    (call $expect (i32.eq (i32.load8_u (i32.const 0)) (i32.const 1)))
    (call $expect (i32.eqz (i32.load8_u (i32.const 4))))
    (call $release-error (i32.load (i32.const 8)))
    (call $remember (local.get $a) (i32.const 0)) (local.set $fn (call $ok))
    (call $invoke-fn (local.get $fn) (local.get $b) (i32.const 0))
    (call $alias (local.get $a) (call $ok))
    (call $invoke-fn (local.get $fn) (local.get $bad) (i32.const 0))
    (call $expect (i32.eq (i32.load8_u (i32.const 0)) (i32.const 1))) ;; err
    (call $expect (i32.eq (i32.load8_u (i32.const 4)) (i32.const 1))) ;; failed
    (call $expect (i32.eqz (i32.load8_u (i32.const 8)))) ;; original member error
    (call $release-error (i32.load (i32.const 12)))
    (call $reader (local.get $a) (i32.const 0)) (local.set $scalar (call $ok))
    (call $drop (local.get $a))
    (call $read-fn (local.get $scalar) (i32.const 30) (i32.const 0))
    (call $expect (i32.eq (call $ok) (i32.const 42)))
    (call $drop-reader (local.get $scalar)) ;; canonical destructor, no explicit close
    (call $invoke-fn (local.get $fn) (local.get $b) (i32.const 0)) (local.set $answer (call $ok))
    (call $read (local.get $answer) (i32.const 0)) (call $expect (i32.eq (call $ok) (i32.const 12)))
    (call $drop (local.get $answer))
    (call $close-fn (local.get $fn)) (call $close-fn (local.get $fn))
    (call $remember (local.get $b) (i32.const 0)) (local.set $new (call $ok))
    (call $invoke-fn (local.get $fn) (local.get $b) (i32.const 0))
    (call $expect (i32.eq (i32.load8_u (i32.const 0)) (i32.const 1)))
    (call $expect (i32.eqz (i32.load8_u (i32.const 4)))) ;; closed, not failed
    (call $drop-fn (local.get $fn))
    (call $invoke-fn (local.get $new) (local.get $b) (i32.const 0))
    (call $alias (local.get $b) (call $ok))
    (call $drop-fn (local.get $new)) (call $drop (local.get $b)) (call $drop (local.get $bad)))
