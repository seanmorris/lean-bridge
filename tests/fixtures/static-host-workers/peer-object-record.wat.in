;; Consumer uses only imports in the installed world. The original owner guest
;; counts real canonical resource acquisitions/releases (including errors).
(module
  (import "cm32p2|@OBJECTS@" "[static]box.create" (func $box (param i32 i32)))
  (import "cm32p2|@OBJECTS@" "[method]box.read" (func $read (param i32 i32)))
  (import "cm32p2|@OBJECTS@" "same-box" (func $same (param i32 i32) (result i32)))
  (import "cm32p2|@OBJECTS@" "box_drop" (func $drop (param i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[constructor]pair" (func $pair (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]pair.lead" (func $lead (param i32) (result i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]pair.spare" (func $spare (param i32) (result i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]pair.sample" (func $sample (param i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]pair.sequence" (func $sequence (param i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "pair_drop" (func $free (param i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "create-pair" (func $create (param i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "sum-read" (func $sum (param i32 i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "flip" (func $flip (param i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "select-meter" (func $select (param i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "[method]select-meter-function.invoke" (func $invoke (param i32 i32 i32)))
  (import "cm32p2|lean-bridge:workshop/api@1" "select-meter-function_drop" (func $release (param i32)))
  (import "cm32p2|lean-bridge:gauge/api@1" "increase" (func $increase (param i32 i32 i32)))
  (memory (export "cm32p2_memory") 2)
  (global $top (mut i32) (i32.const 256))
  (func (export "cm32p2_realloc") (param $old i32) (param $oldlen i32) (param $align i32) (param $n i32) (result i32) (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $top) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
    (global.set $top (i32.add (local.get $p) (local.get $n)))
    (if (i32.gt_u (global.get $top) (i32.const 131072)) (then unreachable))
    (if (local.get $old) (then (memory.copy (local.get $p) (local.get $old) (select (local.get $n) (local.get $oldlen) (i32.lt_u (local.get $n) (local.get $oldlen))))))
    (local.get $p))
  (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
  (func $ok (result i32) (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (i32.load (i32.const 4)))
  (func (export "cm32p2||run") (result i64)
    (local $left i32) (local $right i32) (local $counter i32) (local $input i32) (local $built i32)
    (local $out i32) (local $fn i32) (local $kept i32) (local $view i32)
    (call $box (i32.const 77777) (i32.const 0)) (local.set $counter (call $ok))
    (call $box (i32.const 23) (i32.const 0)) (local.set $left (call $ok))
    (call $box (i32.const 19) (i32.const 0)) (local.set $right (call $ok))
    (i32.store16 (i32.const 64) (i32.const 2057)) ;; bytes [9, 8]
    (i32.store (i32.const 80) (i32.const 5)) (i32.store (i32.const 96) (i32.const 4)) ;; 2^130 + 5
    (local.set $input (call $pair (local.get $left) (i32.const 64) (i32.const 2) (i32.const 80) (i32.const 5) (local.get $right)))
    (i32.store (i32.const 64) (i32.const 0)) (i32.store (i32.const 80) (i32.const 0))
    (call $create (local.get $left) (i32.const 0)) (local.set $built (call $ok))
    (call $sum (local.get $built) (local.get $input) (i32.const 0)) (call $eq (call $ok) (i32.const 42)) (call $free (local.get $built))
    (call $flip (local.get $input) (i32.const 0)) (local.set $out (call $ok))
    (call $select (local.get $input) (i32.const 0)) (local.set $fn (call $ok)) (call $free (local.get $input))
    (call $invoke (local.get $fn) (i32.const 0) (i32.const 0)) (local.set $view (call $ok))
    (call $eq (call $same (local.get $view) (local.get $right)) (i32.const 1)) (call $drop (local.get $view)) (call $release (local.get $fn))
    (local.set $view (call $lead (local.get $out))) (call $eq (call $same (local.get $view) (local.get $right)) (i32.const 1)) (call $drop (local.get $view))
    (call $sample (local.get $out) (i32.const 0)) (call $eq (i32.load (i32.const 4)) (i32.const 3))
    (local.set $view (i32.load (i32.const 0))) (call $eq (i32.load16_u (local.get $view)) (i32.const 2057)) (call $eq (i32.load8_u offset=2 (local.get $view)) (i32.const 23))
    (call $sequence (local.get $out) (i32.const 0)) (call $eq (i32.load (i32.const 4)) (i32.const 5))
    (local.set $view (i32.load (i32.const 0))) (call $eq (i32.load (local.get $view)) (i32.const 6)) (call $eq (i32.load offset=16 (local.get $view)) (i32.const 4))
    (local.set $kept (call $spare (local.get $out))) (call $eq (call $same (local.get $kept) (local.get $left)) (i32.const 1))
    (call $drop (local.get $left)) (call $drop (local.get $right)) (call $free (local.get $out))
    (call $increase (local.get $kept) (i32.const 19) (i32.const 0)) (call $eq (call $ok) (i32.const 42))
    (call $drop (local.get $kept)) (call $read (local.get $counter) (i32.const 0)) (call $eq (call $ok) (i32.const 1))
    (call $drop (local.get $counter)) (i64.const 42)))
