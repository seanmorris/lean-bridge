;; Independent downstream component. Only public constructors, methods and
;; canonical stream readers appear here, not a transport ticket or scheduler.
(component $client
  (import "objects" (instance $o (export "box" (type $b (sub resource))) (export "member-error" (type $e (sub resource)))
    (export "[static]box.create" (func (param "value" u32) (result (result (own $b) (error (own $e))))))
    (export "[method]box.get-level" (func (param "self" (borrow $b)) (result (result u32 (error (own $e))))))
    (export "same-box" (func (param "left" (borrow $b)) (param "right" (borrow $b)) (result bool)))))
  (alias export $o "box" (type $b)) (type $v (result (own $b) (error (own $b))))
  (type $series (stream $v)) (type $finite (stream (own $b)))
  (import "series" (func $series (param "box" (borrow $b)) (result $series)))
  (import "finite" (func $finite (param "box" (borrow $b)) (result $finite)))
  (core module $mem (memory (export "m") 1)) (core instance $m (instantiate $mem))
  (core func $make (canon lower (func $o "[static]box.create") (memory $m "m")))
  (core func $get (canon lower (func $o "[method]box.get-level") (memory $m "m")))
  (core func $same (canon lower (func $o "same-box"))) (core func $drop (canon resource.drop $b))
  (core func $open-s (canon lower (func $series))) (core func $open-f (canon lower (func $finite)))
  (core func $read-s (canon stream.read $series async (memory $m "m"))) (core func $end-s (canon stream.drop-readable $series))
  (core func $read-f (canon stream.read $finite async (memory $m "m"))) (core func $end-f (canon stream.drop-readable $finite))
  (core func $cancel-f (canon stream.cancel-read $finite))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join)) (core func $del (canon waitable-set.drop))
  (core func $ret (canon task.return (result s64)))
  (core module $body (import "" "m" (memory 1))
    (import "" "make" (func $make (param i32 i32))) (import "" "get" (func $get (param i32 i32)))
    (import "" "same" (func $same (param i32 i32) (result i32))) (import "" "drop" (func $drop (param i32)))
    (import "" "open-s" (func $open-s (param i32) (result i32))) (import "" "open-f" (func $open-f (param i32) (result i32)))
    (import "" "read-s" (func $read-s (param i32 i32 i32) (result i32))) (import "" "end-s" (func $end-s (param i32)))
    (import "" "read-f" (func $read-f (param i32 i32 i32) (result i32))) (import "" "end-f" (func $end-f (param i32)))
    (import "" "cancel-f" (func $cancel-f (param i32) (result i32)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32))) (import "" "ret" (func $ret (param i64)))
    (global $a (mut i32) (i32.const 0)) (global $b (mut i32) (i32.const 0))
    (global $sa (mut i32) (i32.const 0)) (global $sb (mut i32) (i32.const 0)) (global $f (mut i32) (i32.const 0))
    (global $reader (mut i32) (i32.const 0)) (global $set (mut i32) (i32.const 0)) (global $phase (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $ok (result i32) (call $eq (i32.load8_u (i32.const 0)) (i32.const 0)) (i32.load (i32.const 4)))
    (func $new (param i32) (result i32) (call $make (local.get 0) (i32.const 0)) (call $ok))
    (func $ask (result i32) (local $rc i32)
      (if (i32.lt_u (global.get $phase) (i32.const 4)) (then
        (global.set $reader (select (global.get $sa) (global.get $sb) (i32.and (global.get $phase) (i32.const 1))))
        (local.set $rc (call $read-s (global.get $reader) (i32.const 16) (i32.const 1))))
        (else (global.set $reader (global.get $f)) (local.set $rc (if (result i32) (i32.eq (global.get $phase) (i32.const 4))
          (then (i32.const -1)) (else (call $read-f (global.get $reader) (i32.const 48) (i32.const 1)))))))
      (if (i32.ne (local.get $rc) (i32.const -1)) (then (return (call $consume (local.get $rc)))))
      (call $join (global.get $reader) (global.get $set)) (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func $consume (param $rc i32) (result i32) (local $owned i32) (local $phase i32)
      (local.set $phase (global.get $phase))
      ;; @cancel-parked@
      (if (i32.eq (local.get $phase) (i32.const 5)) (then
        (call $eq (local.get $rc) (i32.const 1)) (call $end-f (global.get $f)) (call $del (global.get $set))
        (call $drop (global.get $a)) (call $drop (global.get $b)) (call $ret (i64.const 73)) (return (i32.const 0))))
      (call $eq (i32.shr_u (local.get $rc) (i32.const 4)) (i32.const 1))
      (if (i32.lt_u (local.get $phase) (i32.const 4)) (then
        (call $eq (i32.load8_u (i32.const 16)) (i32.ge_u (local.get $phase) (i32.const 2)))
        (local.set $owned (i32.load (i32.const 20)))
        (call $eq (call $same (local.get $owned) (select (global.get $a) (global.get $b) (i32.and (local.get $phase) (i32.const 1)))) (i32.const 1))
        (if (i32.ge_u (local.get $phase) (i32.const 2)) (then (call $end-s (global.get $reader)))))
        (else (local.set $owned (i32.load (i32.const 48))) (call $get (local.get $owned) (i32.const 0)) (call $eq (call $ok) (i32.const 99))))
      (call $drop (local.get $owned))
      ;; @finish-cancel@
      (global.set $phase (i32.add (local.get $phase) (i32.const 1))) (call $ask))
    (func (export "run") (result i32) (local $c i32)
      (global.set $a (call $new (i32.const 41))) (global.set $b (call $new (i32.const 73))) (local.set $c (call $new (i32.const 99)))
      (global.set $sa (call $open-s (global.get $a))) (global.set $sb (call $open-s (global.get $b)))
      (call $end-s (call $open-s (global.get $a)))
      (global.set $f (call $open-f (local.get $c))) (call $drop (local.get $c))
      (call $eq (call $read-f (global.get $f) (i32.const 48) (i32.const 1)) (i32.const -1))
      (global.set $set (call $set)) (call $ask))
    (func (export "cb") (param $ev i32) (param $id i32) (param $rc i32) (result i32)
      (call $eq (local.get $ev) (i32.const 2)) (call $eq (local.get $id) (global.get $reader)) (call $consume (local.get $rc))))
  (core instance $i (instantiate $body (with "" (instance (export "m" (memory $m "m"))
    (export "make" (func $make)) (export "get" (func $get)) (export "same" (func $same)) (export "drop" (func $drop))
    (export "open-s" (func $open-s)) (export "open-f" (func $open-f)) (export "read-s" (func $read-s))
      (export "end-s" (func $end-s)) (export "read-f" (func $read-f)) (export "end-f" (func $end-f)) (export "cancel-f" (func $cancel-f))
    (export "set" (func $set)) (export "del" (func $del)) (export "join" (func $join)) (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
