(component
  (type $f (future u32))
  (import "watch-task" (func $open (param "cooperate" bool) (result $f)))
  (import "ack" (func $ack (param "value" u32) (result $f)))
  (import "event" (func $event (param "which" u8) (result $f)))
  (import "release" (func $release (result u32)))
  (core module $memory (memory (export "m") 1))
  (core instance $mem (instantiate $memory))
  (core func $open (canon lower (func $open))) (core func $ack (canon lower (func $ack)))
  (core func $event (canon lower (func $event))) (core func $release (canon lower (func $release)))
  (core func $read (canon future.read $f async (memory $mem "m")))
  (core func $cancel (canon future.cancel-read $f async))
  (core func $drop (canon future.drop-readable $f))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $del (canon waitable-set.drop)) (core func $ret (canon task.return (result s64)))
  (core module $app
    (import "" "m" (memory 1))
    (import "" "open" (func $open (param i32) (result i32))) (import "" "ack" (func $ack (param i32) (result i32)))
    (import "" "event" (func $event (param i32) (result i32))) (import "" "release" (func $release (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32))) (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32))) (import "" "set" (func $set (result i32)))
    (import "" "join" (func $join (param i32 i32))) (import "" "del" (func $del (param i32)))
    (import "" "ret" (func $ret (param i64)))
    (global $waits (mut i32) (i32.const 0)) (global $victim (mut i32) (i32.const 0))
    (global $pending (mut i32) (i32.const 0)) (global $phase (mut i32) (i32.const 0))
    (global $round (mut i32) (i32.const 0)) (global $observed (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $wait (param $reader i32) (param $addr i32) (param $phase i32) (result i32)
      (global.set $pending (local.get $reader)) (global.set $phase (local.get $phase))
      (call $eq (call $read (local.get $reader) (local.get $addr)) (i32.const -1))
      (call $join (local.get $reader) (global.get $waits))
      (i32.or (i32.const 2) (i32.shl (global.get $waits) (i32.const 4))))
    (func $begin (result i32)
      (i32.store (i32.const 32) (i32.const 0x76543210))
      (global.set $victim (call $open (i32.ne (global.get $round) (i32.const 2))))
      ;; Two rounds start a read; the third drops a reader that never requested data.
      (if (i32.lt_u (global.get $round) (i32.const 2))
        (then (call $eq (call $read (global.get $victim) (i32.const 32)) (i32.const -1))))
      (call $wait (call $event (i32.const 0)) (i32.const 64) (i32.const 0)))
    (func (export "run") (result i32) (global.set $waits (call $set)) (call $begin))
    (func (export "cb") (param $kind i32) (param $id i32) (param $rc i32) (result i32)
      (call $eq (local.get $kind) (i32.const 4)) (call $eq (local.get $id) (global.get $pending))
      (call $eq (local.get $rc) (i32.const 0)) (call $drop (local.get $id))
      (if (i32.eqz (global.get $phase)) (then
        (call $eq (i32.load (i32.const 64)) (i32.const 1))
        (if (i32.lt_u (global.get $round) (i32.const 2))
          (then (call $eq (call $cancel (global.get $victim)) (i32.const 2))))
        (if (i32.eqz (global.get $round)) (then
          (call $eq (call $release) (i32.const 0))
          (return (call $wait (global.get $victim) (i32.const 32) (i32.const 2)))))
        (call $drop (global.get $victim))
        ;; An independent future gives the reactor a turn while the worker
        ;; is still gated. Its return is not evidence of cancellation.
        (return (call $wait (call $ack (i32.const 83)) (i32.const 64) (i32.const 1)))))
      (if (i32.eq (global.get $phase) (i32.const 1)) (then
        (call $eq (i32.load (i32.const 64)) (i32.const 83))
        (call $eq (call $release) (i32.const 0))
        (return (call $wait (call $event (i32.const 2)) (i32.const 64) (i32.const 3)))))
      (if (i32.eq (global.get $phase) (i32.const 2)) (then
        (call $eq (i32.load (i32.const 32)) (i32.const 73))
        (return (call $wait (call $event (i32.const 2)) (i32.const 64) (i32.const 3)))))
      (call $eq (global.get $phase) (i32.const 3))
      (if (global.get $round) (then (call $eq (i32.load (i32.const 32)) (i32.const 0x76543210))))
      (global.set $observed (i32.add (i32.mul (global.get $observed) (i32.const 10)) (i32.load (i32.const 64))))
      (global.set $round (i32.add (global.get $round) (i32.const 1)))
      (if (i32.lt_u (global.get $round) (i32.const 3)) (then (return (call $begin))))
      (call $del (global.get $waits)) (call $ret (i64.extend_i32_u (global.get $observed))) (i32.const 0)))
  (core instance $i (instantiate $app (with "" (instance (export "m" (memory $mem "m"))
    (export "open" (func $open)) (export "ack" (func $ack)) (export "event" (func $event)) (export "release" (func $release))
    (export "read" (func $read)) (export "cancel" (func $cancel)) (export "drop" (func $drop))
    (export "set" (func $set)) (export "join" (func $join)) (export "del" (func $del)) (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
