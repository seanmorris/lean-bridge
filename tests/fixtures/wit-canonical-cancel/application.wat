(component
  (type $s (stream u32)) (type $f (future u32))
  (import "feed" (func $feed (param "cooperate" bool) (result $s)))
  (import "event" (func $event (param "which" u8) (result $f)))
  (import "release" (func $release (result u32)))
  (import "closes" (func $closes (result u32)))
  (core module $memory (memory (export "m") 1))
  (core instance $mem (instantiate $memory))
  (core func $feed (canon lower (func $feed))) (core func $event (canon lower (func $event)))
  (core func $release (canon lower (func $release))) (core func $closes (canon lower (func $closes)))
  (core func $read (canon stream.read $s async (memory $mem "m")))
  (core func $cancel (canon stream.cancel-read $s async)) (core func $drop (canon stream.drop-readable $s))
  (core func $readf (canon future.read $f async (memory $mem "m"))) (core func $dropf (canon future.drop-readable $f))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $del (canon waitable-set.drop)) (core func $ret (canon task.return (result s64)))
  (core module $app
    (import "" "m" (memory 1))
    (import "" "feed" (func $feed (param i32) (result i32)))
    (import "" "event" (func $event (param i32) (result i32)))
    (import "" "release" (func $release (result i32))) (import "" "closes" (func $closes (result i32)))
    (import "" "read" (func $read (param i32 i32 i32) (result i32)))
    (import "" "cancel" (func $cancel (param i32) (result i32))) (import "" "drop" (func $drop (param i32)))
    (import "" "readf" (func $readf (param i32 i32) (result i32))) (import "" "dropf" (func $dropf (param i32)))
    (import "" "set" (func $set (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32))) (import "" "ret" (func $ret (param i64)))
    (global $waits (mut i32) (i32.const 0)) (global $reader (mut i32) (i32.const 0))
    (global $watch (mut i32) (i32.const 0)) (global $phase (mut i32) (i32.const 0))
    ;; 0: normal delivery; 1: abandon a cooperative step; 2: abandon an uncooperative step.
    (global $round (mut i32) (i32.const 0)) (global $observations (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $wait (result i32) (i32.or (i32.const 2) (i32.shl (global.get $waits) (i32.const 4))))
    (func $observe (param $phase i32) (result i32)
      (global.set $phase (local.get $phase))
      (global.set $watch (call $event (local.get $phase)))
      (call $eq (call $readf (global.get $watch) (i32.const 64)) (i32.const -1))
      (call $join (global.get $watch) (global.get $waits)) (call $wait))
    (func $begin (result i32)
      (i32.store (i32.const 32) (i32.const 0x76543210))
      (global.set $reader (call $feed (i32.ne (global.get $round) (i32.const 2))))
      (call $eq (call $read (global.get $reader) (i32.const 32) (i32.const 1)) (i32.const -1))
      (call $observe (i32.const 0)))
    (func (export "run") (result i32) (global.set $waits (call $set)) (call $begin))
    (func (export "cb") (param $kind i32) (param $id i32) (param $rc i32) (result i32) (local $actual i32)
      (if (i32.eq (global.get $phase) (i32.const 3)) (then
        (call $eq (local.get $kind) (i32.const 2)) (call $eq (local.get $id) (global.get $reader))
        (call $eq (local.get $rc) (i32.const 16)) (call $eq (i32.load (i32.const 32)) (i32.const 73))
        (call $drop (global.get $reader)) (return (call $observe (i32.const 1)))))
      (call $eq (local.get $kind) (i32.const 4)) (call $eq (local.get $id) (global.get $watch))
      (call $eq (local.get $rc) (i32.const 0)) (call $dropf (global.get $watch))
      (local.set $actual (i32.load (i32.const 64)))
      (if (i32.eqz (global.get $phase)) (then
        (call $eq (local.get $actual) (i32.const 1)) (call $eq (call $closes) (i32.const 0))
        (if (i32.eqz (global.get $round)) (then
          (call $eq (call $release) (i32.const 0)) (global.set $phase (i32.const 3))
          (call $join (global.get $reader) (global.get $waits)) (return (call $wait))))
        (call $eq (call $cancel (global.get $reader)) (i32.const 2))
        (call $drop (global.get $reader)) (return (call $observe (i32.const 1)))))
      (if (i32.eq (global.get $phase) (i32.const 1)) (then
        (call $eq (local.get $actual) (i32.const 1))
        (if (global.get $round) (then (call $eq (call $release) (i32.const 1))))
        (return (call $observe (i32.const 2)))))
      (call $eq (global.get $phase) (i32.const 2)) (call $eq (call $closes) (i32.const 1))
      (if (global.get $round) (then (call $eq (i32.load (i32.const 32)) (i32.const 0x76543210))))
      ;; Return the actual Lean observations, rather than manufacturing a success bit in the guest.
      (global.set $observations (i32.add (i32.mul (global.get $observations) (i32.const 10)) (local.get $actual)))
      (global.set $round (i32.add (global.get $round) (i32.const 1)))
      (if (i32.lt_u (global.get $round) (i32.const 3)) (then (return (call $begin))))
      (call $del (global.get $waits)) (call $ret (i64.extend_i32_u (global.get $observations))) (i32.const 0)))
  (core instance $i (instantiate $app (with "" (instance (export "m" (memory $mem "m"))
    (export "feed" (func $feed)) (export "event" (func $event)) (export "release" (func $release))
    (export "closes" (func $closes)) (export "read" (func $read)) (export "cancel" (func $cancel))
    (export "drop" (func $drop)) (export "readf" (func $readf)) (export "dropf" (func $dropf))
    (export "set" (func $set)) (export "join" (func $join)) (export "del" (func $del)) (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
