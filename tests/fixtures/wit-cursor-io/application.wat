(component
  (type $value (result u32 (error string)))
  (type $s (stream (result $value (error string))))
  (import "feed" (func $feed (param "failing" bool) (result $s)))
  (import "business" (func $business (result $s)))
  (import "closed-now" (func $closed (result u32)))
  (core module $mem
    (memory (export "m") 1)
    (global $top (mut i32) (i32.const 256))
    (func (export "alloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      (if (i32.or (local.get 0) (i32.ne (local.get 2) (i32.const 1))) (then unreachable))
      (local.set $p (global.get $top))
      (global.set $top (i32.add (local.get $p) (local.get 3))) (local.get $p)))
  (core instance $mem (instantiate $mem))
  (core func $feed (canon lower (func $feed)))
  (core func $business (canon lower (func $business)))
  (core func $closed (canon lower (func $closed)))
  (core func $read (canon stream.read $s async (memory $mem "m") (realloc (func $mem "alloc"))))
  (core func $drop (canon stream.drop-readable $s))
  (core func $set (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $del (canon waitable-set.drop)) (core func $ret (canon task.return (result s64)))
  (core module $m
    (import "" "m" (memory 1))
    (import "" "feed" (func $feed (param i32) (result i32)))
    (import "" "business" (func $business (result i32))) (import "" "closed" (func $closed (result i32)))
    (import "" "read" (func $read (param i32 i32 i32) (result i32))) (import "" "drop" (func $drop (param i32)))
    (import "" "set" (func $new (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32))) (import "" "ret" (func $ret (param i64)))
    (global $set (mut i32) (i32.const 0)) (global $reader (mut i32) (i32.const 0))
    ;; Route 0 exhausts, 1 raises IO.Error, 2 returns the declared String failure.
    (global $route (mut i32) (i32.const 0)) (global $step (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $done (param $rc i32)
      (if (i32.lt_u (global.get $step) (i32.const 2)) (then
        (call $eq (local.get $rc) (i32.const 16))
        (call $eq (i32.load8_u (i32.const 64)) (i32.const 0))
        (call $eq (i32.load8_u (i32.const 68)) (global.get $step))
        (if (global.get $step) (then
          (call $eq (i32.load (i32.const 76)) (i32.const 4))
          (call $eq (i32.load (i32.load (i32.const 72))) (i32.const 0x6d6f6f62)))
        (else (call $eq (i32.load (i32.const 72)) (i32.const 73))))
        (global.set $step (i32.add (global.get $step) (i32.const 1))) (return)))
      (if (global.get $route) (then
        (if (i32.eq (global.get $step) (i32.const 2)) (then
          (call $eq (i32.load8_u (i32.const 64)) (i32.const 1))
          (call $eq (i32.load (i32.const 72)) (i32.const 4))
          (call $eq (i32.load (i32.load (i32.const 68))) (i32.const 0x6d6f6f62))
          (if (i32.eq (local.get $rc) (i32.const 16)) (then (global.set $step (i32.const 3)) (return)))
          (call $eq (local.get $rc) (i32.const 17))))
        (if (i32.eq (global.get $step) (i32.const 3)) (then (call $eq (local.get $rc) (i32.const 1)))))
      (else (call $eq (local.get $rc) (i32.const 1))))
      (call $drop (global.get $reader)) (global.set $step (i32.const 0))
      (global.set $route (i32.add (global.get $route) (i32.const 1)))
      (if (i32.eq (global.get $route) (i32.const 1)) (then (global.set $reader (call $feed (i32.const 1)))))
      (if (i32.eq (global.get $route) (i32.const 2)) (then (global.set $reader (call $business)))))
    (func $drive (result i32) (local $rc i32)
      (loop $again
        (if (i32.eq (global.get $route) (i32.const 3)) (then
          (call $eq (call $closed) (i32.const 4)) (call $del (global.get $set))
          (call $ret (i64.const 4)) (return (i32.const 0))))
        (local.set $rc (call $read (global.get $reader) (i32.const 64) (i32.const 1)))
        (if (i32.eq (local.get $rc) (i32.const -1)) (then
          (call $join (global.get $reader) (global.get $set))
          (return (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))))
        (call $done (local.get $rc)) (br $again)) unreachable)
    (func (export "run") (result i32)
      (call $drop (call $feed (i32.const 1)))
      (global.set $reader (call $feed (i32.const 0))) (global.set $set (call $new)) (call $drive))
    (func (export "cb") (param i32 i32 i32) (result i32)
      (call $eq (local.get 0) (i32.const 2)) (call $eq (local.get 1) (global.get $reader))
      (call $done (local.get 2)) (call $drive)))
  (core instance $i (instantiate $m (with "" (instance (export "m" (memory $mem "m"))
    (export "feed" (func $feed)) (export "business" (func $business)) (export "closed" (func $closed))
    (export "read" (func $read)) (export "drop" (func $drop)) (export "set" (func $set))
    (export "join" (func $join)) (export "del" (func $del)) (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
