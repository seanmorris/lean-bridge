(component
  ;; Ordinary application imports: no private host ports or scheduler hooks.
  (type $f (future s64))
  (import "ready" (func $ready (param "value" s64) (result $f)))
  (import "parked" (func $parked (param "slot" u32) (param "value" s64) (result $f)))
  (import "release" (func $release (param "slot" u32) (result bool)))
  (core func $ready (canon lower (func $ready)))
  (core func $parked (canon lower (func $parked)))
  (core func $release (canon lower (func $release)))
  (core module $memory (memory (export "m") 1))
  (core instance $mem (instantiate $memory))
  (core func $read (canon future.read $f async (memory $mem "m")))
  (core func $drop (canon future.drop-readable $f))
  (core func $new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $del (canon waitable-set.drop))
  (core func $return (canon task.return (result s64)))
  (core module $m
    (import "" "m" (memory 1))
    (import "" "ready" (func $ready (param i64) (result i32)))
    (import "" "parked" (func $parked (param i32 i64) (result i32)))
    (import "" "release" (func $release (param i32) (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32)))
    (import "" "drop" (func $drop (param i32))) (import "" "new" (func $new (result i32)))
    (import "" "join" (func $join (param i32 i32))) (import "" "del" (func $del (param i32)))
    (import "" "return" (func $ret (param i64)))
    (global $set (mut i32) (i32.const 0))
    (global $slow (mut i32) (i32.const 0)) (global $fast (mut i32) (i32.const 0))
    (global $immediate (mut i32) (i32.const 0)) (global $phase (mut i32) (i32.const 0))
    (func $watch (param $reader i32) (param $at i32)
      (if (i32.ne (call $read (local.get $reader) (local.get $at)) (i32.const -1)) (then unreachable))
      (call $join (local.get $reader) (global.get $set)))
    (func $wait (result i32) (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func (export "run") (result i32)
      (global.set $set (call $new))
      (global.set $slow (call $parked (i32.const 1) (i64.const -800000000000000001)))
      (global.set $fast (call $parked (i32.const 2) (i64.const 900000000000000003)))
      (global.set $immediate (call $ready (i64.const -19)))
      (call $watch (global.get $slow) (i32.const 8)) (call $watch (global.get $fast) (i32.const 16))
      (call $watch (global.get $immediate) (i32.const 24)) (call $wait))
    (func (export "cb") (param $kind i32) (param $id i32) (param $status i32) (result i32)
      (if (i32.or (i32.ne (local.get $kind) (i32.const 4)) (local.get $status)) (then unreachable))
      (if (i32.eqz (global.get $phase))
        (then (if (i32.ne (local.get $id) (global.get $immediate)) (then unreachable))
          (if (i64.ne (i64.load (i32.const 24)) (i64.const -19)) (then unreachable))
          (call $drop (local.get $id)) (global.set $phase (i32.const 1))
          (if (i32.eqz (call $release (i32.const 2))) (then unreachable)) (return (call $wait))))
      (if (i32.eq (global.get $phase) (i32.const 1))
        (then (if (i32.ne (local.get $id) (global.get $fast)) (then unreachable))
          (if (i64.ne (i64.load (i32.const 16)) (i64.const 900000000000000003)) (then unreachable))
          (call $drop (local.get $id)) (global.set $phase (i32.const 2))
          (if (i32.eqz (call $release (i32.const 1))) (then unreachable)) (return (call $wait))))
      (if (i32.ne (local.get $id) (global.get $slow)) (then unreachable))
      (if (i64.ne (i64.load (i32.const 8)) (i64.const -800000000000000001)) (then unreachable))
      (call $drop (local.get $id)) (call $del (global.get $set))
      ;; No one ever opens this gate. Application exit must not wait for it.
      (call $drop (call $parked (i32.const 3) (i64.const 54)))
      (call $ret (i64.add (i64.load (i32.const 24)) (i64.add (i64.load (i32.const 8)) (i64.load (i32.const 16)))))
      (i32.const 0)))
  (core instance $i (instantiate $m (with "" (instance (export "m" (memory $mem "m"))
    (export "ready" (func $ready)) (export "parked" (func $parked)) (export "release" (func $release))
    (export "read" (func $read)) (export "drop" (func $drop)) (export "new" (func $new))
    (export "join" (func $join)) (export "del" (func $del)) (export "return" (func $return))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
