;; Three parties: native request protocol, callback provider, application.
;; The application owns one registration and uses it for three different
;; requests. The responder must neither consume it nor lose a request.
(component
  (component $issuer
    (type $local (resource (rep i32)))
    (export $request "request" (type $local))
    (core func $new (canon resource.new $local))
    (core func $rep (canon resource.rep $local))
    (core func $drop (canon resource.drop $local))
    (core module $body
      (import "" "rep" (func $rep (param i32) (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (memory (export "m") 1)
      (data (i32.const 256) "ABC\00")
      (global $count (mut i32) (i32.const 0))
      (func (export "count") (result i32) (global.get $count))
      (func (export "alloc") (param i32 i32 i32 i32) (result i32) (i32.const 512))
      (func (export "read") (param $number i32) (result i32)
        (i32.store8 (i32.const 260) (local.get $number))
        (i32.store (i32.const 8) (i32.const 256)) (i32.store (i32.const 12) (i32.const 5)) (i32.const 8))
      (func $consume (param $req i32) (result i32) (local $n i32)
        (local.set $n (call $rep (local.get $req)))
        (if (i32.ne (local.get $n) (i32.add (global.get $count) (i32.const 1))) (then unreachable))
        (call $drop (local.get $req)) (global.set $count (local.get $n)) (local.get $n))
      (func (export "resolve") (param i32 i64) (result i32)
        (if (i64.ne (local.get 1) (i64.const -8000000001)) (then unreachable))
        (i32.ne (call $consume (local.get 0)) (i32.const 3)))
      (func (export "reject") (param i32 i32 i32) (result i32)
        (if (i32.ne (local.get 2) (i32.const 6)) (then unreachable))
        (if (i32.ne (i32.load (local.get 1)) (i32.const 0x00646162)) (then unreachable))
        (if (i32.ne (i32.load16_u offset=4 (local.get 1)) (i32.const 0xbbce)) (then unreachable))
        (i32.eq (call $consume (local.get 0)) (i32.const 2))))
    (core instance $i (instantiate $body (with "" (instance (export "rep" (func $rep)) (export "drop" (func $drop))))))
    (func (export "make") (param "number" u32) (result (own $request)) (canon lift (core func $new)))
    (func (export "read") (param "request" (borrow $request)) (result (list u8)) (canon lift (core func $i "read") (memory $i "m")))
    (func (export "resolve") (param "request" (own $request)) (param "value" s64) (result bool) (canon lift (core func $i "resolve")))
    (func (export "reject") (param "request" (own $request)) (param "message" string) (result bool)
      (canon lift (core func $i "reject") (memory $i "m") (realloc (func $i "alloc"))))
    (func (export "count") (result u32) (canon lift (core func $i "count"))))
  (component $provider
    (type $local (resource (rep i32))) (export $reg "registration" (type $local))
    (core func $new (canon resource.new $local))
    (core module $m
      (memory (export "m") 1) (data (i32.const 128) "bad\00\ce\bb")
      (func (export "alloc") (param i32 i32 i32 i32) (result i32) (i32.const 512))
      (func (export "invoke") (param $capture i32) (param $bytes i32) (param $len i32) (result i32)
        (if (i32.ne (local.get $capture) (i32.const 42)) (then unreachable))
        (if (i32.ne (local.get $len) (i32.const 5)) (then unreachable))
        (if (i32.ne (i32.load (local.get $bytes)) (i32.const 0x00434241)) (then unreachable))
        (if (i32.eq (i32.load8_u offset=4 (local.get $bytes)) (i32.const 2))
          (then (i32.store8 (i32.const 0) (i32.const 1))
            (i32.store (i32.const 8) (i32.const 128)) (i32.store (i32.const 12) (i32.const 6)))
          (else (i32.store8 (i32.const 0) (i32.const 0)) (i64.store (i32.const 8) (i64.const -8000000001))))
        (i32.const 0)))
    (core instance $i (instantiate $m))
    (func (export "new") (param "capture" u32) (result (own $reg)) (canon lift (core func $new)))
    (func (export "invoke") (param "self" (borrow $reg)) (param "value" (list u8)) (result (result s64 (error string)))
      (canon lift (core func $i "invoke") (memory $i "m") (realloc (func $i "alloc")))))
  (instance $issued (instantiate $issuer)) (instance $guest (instantiate $provider))
  (alias export $issued "request" (type $request)) (alias export $guest "registration" (type $reg))
  ;; INSERT-RESPONDER
  (instance $r (instantiate $responder (with "registration" (type $reg)) (with "request" (type $request))
    (with "read" (func $issued "read")) (with "invoke" (func $guest "invoke"))
    (with "resolve" (func $issued "resolve")) (with "reject" (func $issued "reject"))))
  (component $client
  (import "registration" (type $reg (sub resource))) (import "request" (type $request (sub resource)))
  (import "new" (func $make (param "capture" u32) (result (own $reg))))
  (import "make" (func $issue (param "number" u32) (result (own $request))))
  (import "count" (func $n (result u32)))
  (import "dispatch" (func $dispatch (param "registration" (borrow $reg)) (param "request" (own $request)) (result bool)))
  (core func $new (canon lower (func $make))) (core func $req (canon lower (func $issue)))
  (core func $drop (canon resource.drop $reg)) (core func $count (canon lower (func $n)))
  (core func $call (canon lower (func $dispatch)))
  (core module $driver
    (import "" "new" (func $new (param i32) (result i32))) (import "" "req" (func $req (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32))) (import "" "count" (func $count (result i32)))
    (import "" "call" (func $call (param i32 i32) (result i32)))
    (func (export "run") (result i32) (local $reg i32)
      (local.set $reg (call $new (i32.const 42)))
      (if (i32.eqz (call $call (local.get $reg) (call $req (i32.const 1)))) (then unreachable))
      (if (i32.eqz (call $call (local.get $reg) (call $req (i32.const 2)))) (then unreachable))
      (if (call $call (local.get $reg) (call $req (i32.const 3))) (then unreachable))
      (call $drop (local.get $reg)) (call $count)))
  (core instance $driver (instantiate $driver (with "" (instance (export "new" (func $new))
    (export "req" (func $req)) (export "drop" (func $drop)) (export "count" (func $count)) (export "call" (func $call))))))
  (func (export "run") (result u32) (canon lift (core func $driver "run"))))
  (instance $app (instantiate $client (with "registration" (type $reg)) (with "request" (type $request))
    (with "new" (func $guest "new")) (with "make" (func $issued "make"))
    (with "count" (func $issued "count")) (with "dispatch" (func $r "dispatch"))))
  (export "run" (func $app "run")))
