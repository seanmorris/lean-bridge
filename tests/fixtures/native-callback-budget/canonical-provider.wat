;; The downstream provider owns the capture, its constructor and its counters.
(component
  (component $provider
    (core module $counts
      (global $live (mut i32) (i32.const 0)) (global $calls (mut i32) (i32.const 0))
      (func (export "retain") (param i32) (result i32)
        (global.set $live (i32.add (global.get $live) (i32.const 1))) (local.get 0))
      (func (export "drop") (param i32)
        (if (i32.eqz (global.get $live)) (then unreachable)) (global.set $live (i32.sub (global.get $live) (i32.const 1))))
      (func (export "live") (result i32) (global.get $live))
      (func (export "calls") (result i32) (global.get $calls))
      (memory (export "m") 1) (data (i32.const 64) "callback-already-invoked")
      (func (export "invoke") (param $fail i32) (param $v i32) (result i32)
        (if (i32.eqz (global.get $live)) (then unreachable))
        (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
        (i32.store8 (i32.const 0) (local.get $fail))
        (if (local.get $fail) (then (i32.store (i32.const 4) (i32.const 64)) (i32.store (i32.const 8) (i32.const 24)))
          (else (i32.store (i32.const 4) (i32.add (local.get $v) (i32.const 1)))))
        (i32.const 0)))
    (core instance $c (instantiate $counts))
    (type $local (resource (rep i32) (dtor (func $c "drop"))))
    (export $cb "callback-uint32-to-uint32" (type $local))
    (core func $new (canon resource.new $local))
    (core module $maker (import "" "ref" (func $ref (param i32) (result i32)))
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "make") (param i32) (result i32) (call $new (call $ref (local.get 0)))))
    (core instance $i (instantiate $maker (with "" (instance (export "ref" (func $c "retain")) (export "new" (func $new))))))
    (func (export "make") (param "fail" bool) (result (own $cb)) (canon lift (core func $i "make")))
    (func (export "retain-callback-uint32-to-uint32") (param "value" (borrow $cb)) (result (own $cb)) (canon lift (core func $i "make")))
    (func (export "invoke-callback-uint32-to-uint32") (param "self" (borrow $cb)) (param "value" u32) (result (result u32 (error string)))
      (canon lift (core func $c "invoke") (memory $c "m")))
    (func (export "live") (result u32) (canon lift (core func $c "live")))
    (func (export "calls") (result u32) (canon lift (core func $c "calls"))))
  (instance $provider (instantiate $provider)) (export "lean-bridge:budget/callbacks@1.0.0" (instance $provider)))
