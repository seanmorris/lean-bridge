;; An application starts three tasks with the same guest callback object.
;; It drops the middle future and waits for the two surviving readers.
(component
  (import "lean-bridge:budget/callbacks@1.0.0" (instance $provider
    (export "callback-uint32-to-uint32" (type $r (sub resource)))
    (export "make" (func (param "fail" bool) (result (own $r))))
    (export "live" (func (result u32))) (export "calls" (func (result u32)))))
  (alias export $provider "callback-uint32-to-uint32" (type $r))
  (import "lean-bridge:budget/callback-tasks@1.0.0" (instance $api
    (export "callback-uint32-to-uint32" (type $reg (eq $r)))
    (type $base (variant (case "cancelled") (case "worker-failed" string)
      (case "worker-callback-failed" string) (case "callback-already-invoked")))
    (export "single-failure" (type $failure (eq $base)))
    (export "single" (func (param "n" u32) (param "f" (borrow $reg))
      (result (future (result u32 (error $failure))))))))
  (alias export $api "single-failure" (type $failure))
  (type $future (future (result u32 (error $failure))))
  (core module $mem (memory (export "m") 1)
    (func (export "alloc") (param i32 i32 i32 i32) (result i32)
      (if (i32.gt_u (local.get 3) (i32.const 256)) (then unreachable)) (i32.const 512)))
  (core instance $m (instantiate $mem))
  (core func $make (canon lower (func $provider "make")))
  (core func $live (canon lower (func $provider "live")))
  (core func $calls (canon lower (func $provider "calls")))
  (core func $release (canon resource.drop $r))
  (core func $start (canon lower (func $api "single")))
  (core func $read (canon future.read $future async (memory $m "m") (realloc (func $m "alloc"))))
  (core func $drop (canon future.drop-readable $future))
  (core func $new (canon waitable-set.new)) (core func $join (canon waitable.join))
  (core func $end (canon waitable-set.drop)) (core func $ret (canon task.return (result s64)))
  (core module $body
    (import "" "m" (memory 1))
    (import "" "make" (func $make (param i32) (result i32)))
    (import "" "live" (func $live (result i32))) (import "" "calls" (func $calls (result i32)))
    (import "" "release" (func $release (param i32))) (import "" "start" (func $start (param i32 i32) (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32))) (import "" "drop" (func $drop (param i32)))
    (import "" "new" (func $new (result i32))) (import "" "join" (func $join (param i32 i32)))
    (import "" "end" (func $end (param i32))) (import "" "ret" (func $ret (param i64)))
    (global $set (mut i32) (i32.const 0)) (global $left (mut i32) (i32.const 0))
    (global $right (mut i32) (i32.const 0)) (global $second (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $wait (param i32) (result i32) (call $join (local.get 0) (global.get $set))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func (export "run") (result i32) (local $reg i32) (local $middle i32)
      (global.set $set (call $new)) (local.set $reg (call $make (i32.const 0)))
      (global.set $left (call $start (i32.const 20) (local.get $reg)))
      (local.set $middle (call $start (i32.const 60) (local.get $reg)))
      (global.set $right (call $start (i32.const 40) (local.get $reg)))
      (call $eq (call $live) (i32.const 4)) (call $release (local.get $reg))
      (call $eq (call $live) (i32.const 3)) (call $drop (local.get $middle))
      (call $eq (call $read (global.get $left) (i32.const 32)) (i32.const -1)) (call $wait (global.get $left)))
    (func $finish (result i32)
      (call $eq (i32.load8_u (i32.const 64)) (i32.const 0)) (call $eq (i32.load (i32.const 68)) (i32.const 41))
      (call $drop (global.get $right)) (call $end (global.get $set))
      (call $eq (call $calls) (i32.const 2)) (call $eq (call $live) (i32.const 0))
      (call $ret (i64.extend_i32_u (i32.add (i32.load (i32.const 36)) (i32.load (i32.const 68))))) (i32.const 0))
    (func (export "cb") (param $kind i32) (param $id i32) (param $status i32) (result i32) (local $rc i32)
      (call $eq (local.get $kind) (i32.const 4)) (call $eq (local.get $status) (i32.const 0))
      (if (global.get $second) (then (call $eq (local.get $id) (global.get $right)) (return (call $finish))))
      (call $eq (local.get $id) (global.get $left)) (call $drop (global.get $left))
      (call $eq (i32.load8_u (i32.const 32)) (i32.const 0)) (call $eq (i32.load (i32.const 36)) (i32.const 21))
      (global.set $second (i32.const 1)) (local.set $rc (call $read (global.get $right) (i32.const 64)))
      (if (i32.eq (local.get $rc) (i32.const -1)) (then (return (call $wait (global.get $right)))))
      (call $eq (local.get $rc) (i32.const 0)) (call $finish)))
  (core instance $b (instantiate $body (with "" (instance (export "m" (memory $m "m"))
    (export "make" (func $make)) (export "live" (func $live)) (export "calls" (func $calls))
    (export "release" (func $release)) (export "start" (func $start)) (export "read" (func $read))
    (export "drop" (func $drop)) (export "new" (func $new)) (export "join" (func $join))
    (export "end" (func $end)) (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $b "run") async (callback (func $b "cb")))))
