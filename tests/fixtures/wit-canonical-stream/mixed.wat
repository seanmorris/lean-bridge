    (export "dt" (func $dt))
    (export "set" (func $set))
    (export "join" (func $join))
    (export "del" (func $del))
    (export "ret" (func $ret))))))
  (func (export "run") async (result s64) (canon lift (core func $i "run") async (callback (func $i "cb")))))
