(component
  ;; Lean cannot resolve the parked task until the guest receives a stream item.
  (type $t (future s64)) (type $f (stream (result (result s64 (error string)) (error u16))))
  (import "parked" (func $parked (param "slot" u32) (param "value" s64) (result $t)))
  (import "release" (func $release (param "slot" u32) (result bool)))
  (import "feed" (func $feed (param "mode" u8) (param "limit" u32) (result (result $f (error u32)))))
  (core module $memory (memory (export "m") 1)
    ;; Only s64 items are expected in this guest; any string violates that contract.
    (func (export "alloc") (param i32 i32 i32 i32) (result i32) unreachable))
  (core instance $mem (instantiate $memory))
  (core func $parked (canon lower (func $parked))) (core func $release (canon lower (func $release)))
  (core func $feed (canon lower (func $feed) (memory $mem "m")))
