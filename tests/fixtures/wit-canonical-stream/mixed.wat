  (core func $ret (canon task.return (result s64)))
  (core module $m (import "" "m" (memory 1))
    (import "" "feed" (func $feed (param i32 i32 i32)))
    (import "" "parked" (func $parked (param i32 i64) (result i32)))
    (import "" "release" (func $release (param i32) (result i32)))
    (import "" "rf" (func $rf (param i32 i32 i32) (result i32)))
    (import "" "rt" (func $rt (param i32 i32) (result i32)))
    (import "" "df" (func $df (param i32)))
    (import "" "dt" (func $dt (param i32)))
    (import "" "set" (func $set (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "del" (func $del (param i32)))
    (import "" "ret" (func $ret (param i64)))
    (global $reader (mut i32) (i32.const 0)) (global $future (mut i32) (i32.const 0)) (global $s (mut i32) (i32.const 0))
    (func $eq (param i32 i32) (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $wait (result i32) (i32.or (i32.const 2) (i32.shl (global.get $s) (i32.const 4))))
    (func (export "run") (result i32)
      (global.set $s (call $set)) (global.set $future (call $parked (i32.const 4) (i64.const -700000000000000029)))
      (call $eq (call $rt (global.get $future) (i32.const 64)) (i32.const -1)) (call $join (global.get $future) (global.get $s))
      (call $feed (i32.const 0) (i32.const 1) (i32.const 16)) (call $eq (i32.load8_u (i32.const 16)) (i32.const 0))
      (global.set $reader (i32.load (i32.const 20))) (call $eq (call $rf (global.get $reader) (i32.const 32) (i32.const 1)) (i32.const -1))
      (call $join (global.get $reader) (global.get $s)) (call $wait))
    (func (export "cb") (param $event i32) (param $id i32) (param $rc i32) (result i32)
      (if (i32.eq (local.get $event) (i32.const 2)) (then
        (call $eq (local.get $id) (global.get $reader)) (call $eq (local.get $rc) (i32.const 16))
        (call $eq (i32.load8_u (i32.const 32)) (i32.const 0)) (call $eq (i32.load8_u (i32.const 40)) (i32.const 0))
        (if (i64.ne (i64.load (i32.const 48)) (i64.const 0)) (then unreachable))
        (call $df (global.get $reader)) (call $eq (call $release (i32.const 4)) (i32.const 1)) (return (call $wait))))
      (call $eq (local.get $event) (i32.const 4)) (call $eq (local.get $id) (global.get $future)) (call $eq (local.get $rc) (i32.const 0))
      (call $dt (global.get $future)) (call $del (global.get $s)) (call $ret (i64.load (i32.const 64))) (i32.const 0)))
  (core instance $i (instantiate $m (with "" (instance (export "m" (memory $mem "m"))
    (export "feed" (func $feed))
    (export "parked" (func $parked))
    (export "release" (func $release))
    (export "rf" (func $rf))
    (export "rt" (func $rt))
